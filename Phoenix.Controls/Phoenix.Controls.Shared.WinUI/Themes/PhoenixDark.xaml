    <!-- ============================================================
         In-chrome menu paint (redesign R2 / chrome.jsx — MenuItem).
         ============================================================ -->
    <Style x:Key="ChromeMenuFlyoutPresenterStyle" TargetType="MenuFlyoutPresenter">
        <!--  Force the dark theme so the menu parts NOT covered by the
             explicit setters below (accelerator-hint text, sub-item chevrons, and the
             hover / pressed / disabled visual states) resolve their system brushes from
             the DARK theme dictionary. A menu flyout mounts in a popup (a separate visual
             root) that does NOT inherit the app theme, so under an OS *light* theme those
             parts rendered as dark/near-invisible text on the dark Coal card (Majo: "menu
             texts switch with light/dark mode and become unreadable"). RequestedTheme
             cascades to the whole presenter subtree, fixing every MenuFlyoutItem at once. -->
        <Setter Property="RequestedTheme"    Value="Dark" />
        <Setter Property="Background"        Value="{StaticResource CoalRaisedBrush}" />
        <Setter Property="BorderBrush"       Value="{StaticResource CoalDividerBrush}" />
        <Setter Property="BorderThickness"   Value="1" />
        <Setter Property="CornerRadius"      Value="{StaticResource Radius2Corner}" />
        <Setter Property="MinWidth"          Value="220" />
        <Setter Property="Padding"           Value="4" />
        <Setter Property="FontFamily"        Value="{StaticResource SansFont}" />
        <Setter Property="FontSize"          Value="12" />
    </Style>

    <Style x:Key="ChromeMenuBarItemStyle" TargetType="MenuBarItem">
        <!--  Dark theme so the bar item's hover / pressed / selected
             visual-state brushes (system-sourced, not overridden below) read correctly
             on the always-dark chrome regardless of the OS light/dark setting. -->
        <Setter Property="RequestedTheme" Value="Dark" />
        <Setter Property="Foreground" Value="{StaticResource CoalBodyTextBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource SansFont}" />
        <Setter Property="FontSize"   Value="12" />
        <Setter Property="Padding"    Value="10,4" />
        <Setter Property="UseSystemFocusVisuals" Value="False" />
    </Style>

    <Style x:Key="ChromeMenuFlyoutItemStyle" TargetType="MenuFlyoutItem">
        <Setter Property="Foreground"        Value="{StaticResource CoalPrimaryTextBrush}" />
        <Setter Property="FontFamily"        Value="{StaticResource SansFont}" />
        <Setter Property="FontSize"          Value="12" />
        <Setter Property="Padding"           Value="10,5" />
        <Setter Property="UseSystemFocusVisuals" Value="False" />
    </Style>

    <Style x:Key="ChromeToggleMenuFlyoutItemStyle" TargetType="ToggleMenuFlyoutItem">
        <Setter Property="Foreground"        Value="{StaticResource CoalPrimaryTextBrush}" />
        <Setter Property="FontFamily"        Value="{StaticResource SansFont}" />
        <Setter Property="FontSize"          Value="12" />
        <Setter Property="Padding"           Value="10,5" />
        <Setter Property="UseSystemFocusVisuals" Value="False" />
    </Style>

    <!-- ============================================================
         0.10.0 redesign R6 — implicit MenuFlyout paint.

         The Chrome*MenuFlyout* styles above are explicit-keyed and used
         by HubChrome's MenuBar via a UserControl-scoped implicit
         subtree style (BasedOn=ChromeMenuFlyoutPresenterStyle). Outside
         the chrome bar — RMB context menus on the Architect canvas,
         Visualist canvas, LeftRail, NodeView, etc. — MenuFlyouts use
         the WinUI 3 default chrome (system-grey card) which doesn't
         match the forged identity.

         These implicit styles (no x:Key, by TargetType) repaint every
         MenuFlyout in the app onto the coal-3 card surface with the
         existing eyebrow / body cadence. HubChrome's UserControl-scoped
         override takes precedence inside the chrome bar, so the menus
         that already opt into ChromeMenuFlyoutPresenterStyle stay on
         CoalRaisedBrush.

         Centralising here means a new MenuFlyout anywhere in the app
         picks up the dark-card paint with zero per-call-site config —
         the spawn-palette RMB menu in LogicCanvasView.Menus.cs is the
         primary consumer; rail / pill / link / frame menus pick it up
         transitively because they construct bare MenuFlyout instances.
         ============================================================ -->
    <Style TargetType="MenuFlyoutPresenter">
        <!--  See ChromeMenuFlyoutPresenterStyle above — force dark so the
             app-wide RMB context menus (canvas / rail / pill / link / frame) keep their
             system-sourced text + visual-state brushes readable under an OS light theme. -->
        <Setter Property="RequestedTheme"    Value="Dark" />
        <Setter Property="Background"        Value="{StaticResource CoalCardBrush}" />
        <Setter Property="BorderBrush"       Value="{StaticResource CoalDividerBrush}" />
        <Setter Property="BorderThickness"   Value="1" />
        <Setter Property="CornerRadius"      Value="{StaticResource Radius2Corner}" />
        <Setter Property="MinWidth"          Value="220" />
        <Setter Property="Padding"           Value="4" />
        <Setter Property="FontFamily"        Value="{StaticResource SansFont}" />
        <Setter Property="FontSize"          Value="12" />
    </Style>

    <Style TargetType="MenuFlyoutItem">
        <Setter Property="Foreground"        Value="{StaticResource CoalPrimaryTextBrush}" />
        <Setter Property="FontFamily"        Value="{StaticResource SansFont}" />
        <Setter Property="FontSize"          Value="12" />
        <Setter Property="Padding"           Value="10,5" />
        <Setter Property="UseSystemFocusVisuals" Value="False" />
    </Style>

    <Style TargetType="ToggleMenuFlyoutItem">
        <Setter Property="Foreground"        Value="{StaticResource CoalPrimaryTextBrush}" />
        <Setter Property="FontFamily"        Value="{StaticResource SansFont}" />
        <Setter Property="FontSize"          Value="12" />
        <Setter Property="Padding"           Value="10,5" />
        <Setter Property="UseSystemFocusVisuals" Value="False" />
    </Style>

    <Style TargetType="MenuFlyoutSubItem">
        <Setter Property="Foreground"        Value="{StaticResource CoalPrimaryTextBrush}" />
        <Setter Property="FontFamily"        Value="{StaticResource SansFont}" />
        <Setter Property="FontSize"          Value="12" />
        <Setter Property="Padding"           Value="10,5" />
        <Setter Property="UseSystemFocusVisuals" Value="False" />
    </Style>

    <!-- LiveFeed filter chip — the small "ALL / CHAT / SUBS / RAIDS / VISUAL"
         pills in the LiveFeed header. Migrated from a bare Border + Tapped
         to a full ToggleButton (HUB-UX P1 — accessibility): Tab focuses the
         chip, Space / Enter toggles it, the VisualStateManager paints the
         hover / pressed / checked states consistently with the rest of the
         Hub chrome. PointerOver inside Checked stays ember (the toggle is
         already lit); Disabled fades to the same muted text tier the rest
         of the suite uses. -->
    <Style x:Key="LiveFeedChipStyle" TargetType="ToggleButton">
        <Setter Property="Background"      Value="{StaticResource CoalCardBrush}" />
        <Setter Property="Foreground"      Value="{StaticResource CoalBodyTextBrush}" />
        <Setter Property="BorderBrush"     Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FontFamily"      Value="{StaticResource SansFont}" />
        <Setter Property="FontSize"        Value="10" />
        <Setter Property="FontWeight"      Value="SemiBold" />
        <Setter Property="CharacterSpacing" Value="80" />
        <Setter Property="Padding"         Value="8,3" />
        <Setter Property="MinWidth"        Value="0" />
        <Setter Property="MinHeight"       Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment"   Value="Center" />
        <Setter Property="UseSystemFocusVisuals"      Value="True" />
        <Setter Property="FocusVisualPrimaryBrush"    Value="{StaticResource EmberPrimaryBrush}" />
        <Setter Property="FocusVisualSecondaryBrush"  Value="{StaticResource CoalCardBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="ChipBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="2"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter x:Name="ContentPresenter"
                                          Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          Foreground="{TemplateBinding Foreground}"
                                          FontFamily="{TemplateBinding FontFamily}"
                                          FontWeight="{TemplateBinding FontWeight}"
                                          FontSize="{TemplateBinding FontSize}"
                                          CharacterSpacing="{TemplateBinding CharacterSpacing}" />
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ChipBorder" Storyboard.TargetProperty="Background">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource CoalHoverBrush}" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ChipBorder" Storyboard.TargetProperty="Background">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource CoalDividerBrush}" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ContentPresenter" Storyboard.TargetProperty="Foreground">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource CoalMutedTextBrush}" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="CheckStates">
                                <VisualState x:Name="Unchecked" />
                                <VisualState x:Name="Checked">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ChipBorder" Storyboard.TargetProperty="Background">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource EmberShadowBrush}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ContentPresenter" Storyboard.TargetProperty="Foreground">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource CoalShellBrush}" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Indeterminate" />
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Visualist trigger-tab toggle (Widget Editor's per-trigger row).
         Same UE-Blueprints-flavoured "underline on checked" idiom as
         SubTabButtonStyle, but with a full ToggleButton ControlTemplate so
         the visual states (PointerOver/Pressed/Checked) actually render in
         coal+ember. Without the template, default WinUI 3 chrome paints
         system-blue on checked / light-grey hover. -->
    <Style x:Key="TriggerTabButtonStyle" TargetType="ToggleButton">
        <Setter Property="Background"      Value="Transparent" />
        <Setter Property="BorderBrush"     Value="Transparent" />
        <Setter Property="BorderThickness" Value="0,0,0,2" />
        <Setter Property="Foreground"      Value="{StaticResource CoalSecondaryTextBrush}" />
        <Setter Property="FontFamily"      Value="{StaticResource SansFont}" />
        <Setter Property="FontSize"        Value="11" />
        <Setter Property="Padding"         Value="10,4" />
        <Setter Property="MinWidth"        Value="0" />
        <Setter Property="MinHeight"       Value="0" />
        <Setter Property="Height"          Value="26" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment"   Value="Center" />
        <Setter Property="UseSystemFocusVisuals"      Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="RootBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter
                            x:Name="ContentPresenter"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                            Foreground="{TemplateBinding Foreground}"
                            FontFamily="{TemplateBinding FontFamily}"
                            FontSize="{TemplateBinding FontSize}" />
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="RootBorder" Storyboard.TargetProperty="Background">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource CoalHoverBrush}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ContentPresenter" Storyboard.TargetProperty="Foreground">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource CoalBodyTextBrush}" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="RootBorder" Storyboard.TargetProperty="Background">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource CoalDividerBrush}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ContentPresenter" Storyboard.TargetProperty="Foreground">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource CoalPrimaryTextBrush}" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ContentPresenter" Storyboard.TargetProperty="Foreground">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource CoalMutedTextBrush}" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="CheckStates">
                                <VisualState x:Name="Unchecked" />
                                <VisualState x:Name="Checked">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="RootBorder" Storyboard.TargetProperty="BorderBrush">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource EmberDeepBrush}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="ContentPresenter" Storyboard.TargetProperty="Foreground">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource CoalPrimaryTextBrush}" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Indeterminate" />
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
