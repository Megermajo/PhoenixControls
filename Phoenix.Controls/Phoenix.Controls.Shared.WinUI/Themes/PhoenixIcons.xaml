<!--
    Phoenix Controls — Phoenix Icon Suite (path-data strings).

    Source: phoenix-redesign/project/design-system.jsx ICONS array.

    Owned by Shared.WinUI alongside PhoenixDark.xaml. Loaded as a Page
    in each pillar's csproj via <Page Include="..\..\Shared.WinUI\Themes\
    PhoenixIcons.xaml" Link="Themes\PhoenixIcons.xaml" /> and merged into
    Hub.WinUI's Application.Resources at runtime via
    `ms-appx:///Themes/PhoenixIcons.xaml`. Architect / Visualist inherit
    from Hub's app-level merge (single-Hub-host model post-T15).

    Storage form: `<x:String>` holding the SVG-style geometry mini-language.
    WinUI 3's XAML compiler rejects `<PathGeometry x:Key="..."/>` as a
    top-level resource (compile-time error in the markup compiler), so we
    keep the data as strings here and let the Geometry TypeConverter on
    consumer-side `Data` properties parse at bind/use time. This mirrors
    how XAML's path mini-language is normally used:

        <PathIcon Data="{StaticResource PhoenixIcon_Phoenix}" />
        <Path     Data="{StaticResource PhoenixIcon_Phoenix}" />

    Both `PathIcon.Data` and `Path.Data` are `Geometry`; the StaticResource
    lookup returns the string and the property's converter does the
    string-to-Geometry parse. Confirmed-compatible commands: M, L, H, V,
    C, S, Q, T, A, Z. Spaces and commas are interchangeable as separators.

    Categories (post Sprint-8 orphan sweep):
      • Apps + chrome (1) — phoenix (badge fallback)
      • Panel chrome (3)  — popout, folderopen, scrolldown
      • Chat roles (5)    — broadcaster, mod, vip, sub, regular

    The Sprint-8 sweep removed 33 unused glyphs (Hub / Architect /
    Visualist sigils, file/edit chrome, node/wire/trigger graph glyphs,
    integration glyphs) — every entry below has at least one verified
    StaticResource consumer in Hub.WinUI's panel views or ChatRowVm.

    0.10.0 foundation re-merge: the dictionary is merged into
    Hub.WinUI's Application.Resources after PhoenixDark.xaml (see
    App.xaml). The live call-sites are the four panel-header pop-out
    buttons (Chat / LiveFeed / Script / SystemLog), the SystemLog
    "log folder" + "↓ latest" affordances, and ChatRowVm's role badge.
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ── Apps + chrome (1 retained of 6) ─────────────────────────────
         Phoenix sigil — used by ChatRowVm as the default badge geometry
         fallback when a role-specific glyph can't be resolved. The Hub /
         Architect / Visualist / Settings / Close siblings were retired
         () when verified to have zero StaticResource consumers. -->
    <x:String x:Key="PhoenixIcon_Phoenix">M12,2 L3,12 L8,12 L7,22 L17,22 L16,12 L21,12 Z</x:String>

    <!-- ── Panel chrome (2) — added 0.10.0 foundation ──────────────── -->
    <!-- PopOut: NE-arrow with origin box. Replaces the inline `↗`
         glyph in panel-header right-content (Chat / LiveFeed / Script /
         SystemLog). 24×24 viewbox; arrowhead at (20,4). -->
    <x:String x:Key="PhoenixIcon_PopOut">M14,4 H20 V10 M20,4 L12,12 M5,8 V19 H16 V13</x:String>
    <!-- FolderOpen: Open folder with raised flap. Replaces the inline
         `📂` glyph in SystemLog header ("📂 log folder" button). -->
    <x:String x:Key="PhoenixIcon_FolderOpen">M3,7 H10 L12,9 H21 V19 H3 Z M3,11 H21</x:String>
    <!-- ScrollDown: Down-arrow used for the SystemLog "↓ latest" jump-
         to-bottom button. Vertical shaft with chevron head; 24×24 viewbox
         centered on x=12. Added 0.10.0 (QC11-01) to replace the inline
         `↓` glyph that violated Design_Orders §9 (no emojis). -->
    <x:String x:Key="PhoenixIcon_ScrollDown">M12,4 V18 M6,12 L12,18 L18,12</x:String>

    <!-- ── Chat roles (5) — added 0.10.0 Hub chat-roles sweep ──────────
         Phoenix Chat (Hub) renders one of these to the left of every
         chat row's username, always-visible (no role permutation
         collapses to "no glyph"). Precedence: Broadcaster > Mod > VIP
         > Sub > Regular. See feedback_chat_role_coloring.md and
         RoleColorBrush.cs for the resolver. -->
    <!-- Crown — broadcaster -->
    <x:String x:Key="PhoenixIcon_ChatRoleBroadcaster">M4,18 H20 V20 H4 Z M4,16 L3,7 L8,11 L12,4 L16,11 L21,7 L20,16 Z</x:String>
    <!-- Shield — moderator -->
    <x:String x:Key="PhoenixIcon_ChatRoleMod">M12,3 L20,6 V12 C20,17 16,20 12,21 C8,20 4,17 4,12 V6 Z</x:String>
    <!-- Diamond — VIP -->
    <x:String x:Key="PhoenixIcon_ChatRoleVip">M12,3 L21,9 L12,21 L3,9 Z M3,9 H21 M8,9 L12,3 M16,9 L12,3 M8,9 L12,21 M16,9 L12,21</x:String>
    <!-- Five-point star — subscriber -->
    <x:String x:Key="PhoenixIcon_ChatRoleSub">M12,3 L14.5,9.5 L21,10 L16,14.5 L17.5,21 L12,17.5 L6.5,21 L8,14.5 L3,10 L9.5,9.5 Z</x:String>
    <!-- Person bust — regular viewer -->
    <x:String x:Key="PhoenixIcon_ChatRoleRegular">M12,4 A4,4 0 1 1 12,12 A4,4 0 1 1 12,4 M4,21 V18 A5,5 0 0 1 9,13 H15 A5,5 0 0 1 20,18 V21 Z</x:String>

</ResourceDictionary>
