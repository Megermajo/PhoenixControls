<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="Phoenix.Controls.Visualist.WinUI.Dialogs.RecentFilesDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Open Recent Layer"
    Background="{ThemeResource CoalSurfaceBrush}"
    PrimaryButtonText="Open"
    CloseButtonText="Cancel"
    DefaultButton="Primary">

    <Grid Width="520" Height="360">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Margin="0,0,0,6"
                   FontSize="11"
                   Foreground="{ThemeResource CoalSecondaryTextBrush}"
                   FontFamily="{ThemeResource MonoFont}"
                   Text="Visualist MRU — last 10 layers opened" />

        <ListView x:Name="RecentList"
                  Grid.Row="1"
                  SelectionMode="Single"
                  IsItemClickEnabled="True"
                  ItemClick="OnItemClick"
                  KeyDown="OnRecentListKeyDown">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <StackPanel Spacing="2" Margin="0,4,0,4">
                        <TextBlock Text="{Binding FileName}"
                                   FontFamily="{ThemeResource MonoFont}"
                                   FontSize="13"
                                   Foreground="{ThemeResource CoalPrimaryTextBrush}" />
                        <TextBlock Text="{Binding FullPath}"
                                   FontFamily="{ThemeResource MonoFont}"
                                   FontSize="10"
                                   Foreground="{ThemeResource CoalSecondaryTextBrush}"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <TextBlock x:Name="EmptyHint"
                   Grid.Row="1"
                   Visibility="Collapsed"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   FontSize="12"
                   Foreground="{ThemeResource CoalSecondaryTextBrush}"
                   Text="No recent layers yet — open a .phxlayer from File → Open Layer." />

        <Button x:Name="ClearButton"
                Grid.Row="2"
                Margin="0,8,0,0"
                HorizontalAlignment="Left"
                Content="Clear list"
                Click="OnClearClick" />
    </Grid>
</ContentDialog>
