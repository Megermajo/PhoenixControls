<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="Phoenix.Controls.Visualist.WinUI.Dialogs.MediaLibraryDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Media Library"
    Background="{StaticResource CoalSurfaceBrush}"
    CloseButtonText="Close"
    DefaultButton="Close">

    <Grid Width="560" Height="420">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   x:Name="HeaderLine"
                   Margin="0,0,0,6"
                   FontSize="11"
                   Foreground="{StaticResource CoalSecondaryTextBrush}"
                   FontFamily="{StaticResource MonoFont}"
                   Text="data/media — files served at /media/&lt;path&gt;" />

        <ListView x:Name="MediaList"
                  Grid.Row="1"
                  SelectionMode="Single"
                  SelectionChanged="OnSelectionChanged">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="0,4,0,4" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Spacing="2">
                            <TextBlock Text="{Binding FileName}"
                                       FontFamily="{StaticResource MonoFont}"
                                       FontSize="13"
                                       Foreground="{StaticResource CoalPrimaryTextBrush}" />
                            <TextBlock Text="{Binding RelativePath}"
                                       FontFamily="{StaticResource MonoFont}"
                                       FontSize="10"
                                       Foreground="{StaticResource CoalSecondaryTextBrush}"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>

                        <TextBlock Grid.Column="1"
                                   Text="{Binding SizeLabel}"
                                   VerticalAlignment="Center"
                                   FontFamily="{StaticResource MonoFont}"
                                   FontSize="10"
                                   Foreground="{StaticResource CoalMutedTextBrush}" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <TextBlock x:Name="EmptyHint"
                   Grid.Row="1"
                   Visibility="Collapsed"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   FontSize="12"
                   Foreground="{StaticResource CoalSecondaryTextBrush}"
                   Text="data/media is empty — drop image / video / audio files into the Hub media folder to populate this list." />

        <TextBlock Grid.Row="2"
                   x:Name="StatusLine"
                   Margin="0,8,0,0"
                   FontSize="10"
                   FontFamily="{StaticResource MonoFont}"
                   Foreground="{StaticResource CoalMutedTextBrush}"
                   TextWrapping="Wrap"
                   Text="Select a file to inspect or delete." />

        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,8,0,0"
                    Spacing="6">
            <Button x:Name="RefreshButton"
                    Content="Refresh"
                    Click="OnRefreshClick" />
            <Button x:Name="DeleteButton"
                    Content="Delete"
                    Foreground="{StaticResource ErrBrush}"
                    BorderBrush="{StaticResource ErrBrush}"
                    Background="Transparent"
                    BorderThickness="1"
                    IsEnabled="False"
                    Click="OnDeleteClick" />
        </StackPanel>
    </Grid>
</ContentDialog>
