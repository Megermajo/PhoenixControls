<?xml version="1.0" encoding="utf-8"?>
<!--
    Visualist WinUI 3 regression audit 2026-05-31 (Area 3 P1) — MediaPicker port.
    The pre-T15 WinForms shell shipped a modal MediaPickerDialog
    (Phoenix.Controls.Visualist/Forms/MediaPickerDialog.cs) behind the graph
    node "Browse Media…" gesture: a 96px thumbnail grid with kind filtering
    (Image / Video / Audio), async placeholder→real thumbnails, Import / Refresh,
    returning a RELATIVE media path to drop into a loader node's Path attribute.
    The WinUI rewrite shipped only the read-only MediaLibraryDialog (delete
    management), so the modal picker flow was severed. This dialog restores it.

    Data side reuses the existing MediaLibrary service (Enumerate / MediaRoot)
    that MediaLibraryDialog also consumes; the import + thumbnail decode live
    here in the dialog (Lane D owns only the dialog files).

    Visualist-local per feedback_visualist_architect_chrome_independence.md.
    Chrome mirrors MediaLibraryDialog + CurveEditorDialog: Coal* / Ember* tokens,
    mono captions, filter chips as ember-tinted ToggleButtons.
-->
<ContentDialog
    x:Class="Phoenix.Controls.Visualist.WinUI.Dialogs.MediaPickerDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Browse Media"
    Background="{StaticResource CoalShellBrush}"
    BorderBrush="{StaticResource CoalCardBrush}"
    BorderThickness="1"
    CornerRadius="6"
    PrimaryButtonText="Use Selected"
    CloseButtonText="Cancel"
    IsPrimaryButtonEnabled="False"
    DefaultButton="Primary">

    <ContentDialog.Resources>
        <Style x:Key="PickerEyebrow" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="CharacterSpacing" Value="180" />
            <Setter Property="Foreground" Value="{StaticResource EmberPrimaryBrush}" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>
        <Style x:Key="PickerChip" TargetType="ToggleButton">
            <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="Margin" Value="0,0,4,0" />
            <Setter Property="MinHeight" Value="26" />
            <Setter Property="MinWidth" Value="60" />
        </Style>
    </ContentDialog.Resources>

    <Grid Width="620" Height="460">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="2" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- header -->
        <StackPanel Grid.Row="0" Spacing="2" Margin="0,0,0,8">
            <TextBlock Text="VISUALIST · MEDIA" Style="{StaticResource PickerEyebrow}" />
            <TextBlock x:Name="HeaderLine"
                       FontFamily="{StaticResource MonoFont}"
                       FontSize="11"
                       Foreground="{StaticResource CoalSecondaryTextBrush}"
                       Text="data/media" />
        </StackPanel>

        <!-- filter chips -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="0" Margin="0,0,0,6">
            <ToggleButton x:Name="AllChip"   Content="All"    Style="{StaticResource PickerChip}" Click="OnFilterChipClick" />
            <ToggleButton x:Name="ImageChip" Content="Image"  Style="{StaticResource PickerChip}" Click="OnFilterChipClick" />
            <ToggleButton x:Name="VideoChip" Content="Video"  Style="{StaticResource PickerChip}" Click="OnFilterChipClick" />
            <ToggleButton x:Name="AudioChip" Content="Audio"  Style="{StaticResource PickerChip}" Click="OnFilterChipClick" />
        </StackPanel>

        <Rectangle Grid.Row="2" Fill="{StaticResource BrassGradientBrush}" />

        <!-- thumbnail grid -->
        <ScrollViewer Grid.Row="3"
                      Margin="0,8,0,0"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <GridView x:Name="MediaGrid"
                      SelectionMode="Single"
                      DoubleTapped="OnGridDoubleTapped"
                      SelectionChanged="OnGridSelectionChanged">
                <GridView.ItemTemplate>
                    <DataTemplate>
                        <Grid Width="110" Height="124" Padding="4" RowSpacing="3">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="96" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0"
                                    Width="96" Height="96"
                                    Background="{StaticResource CoalRaisedBrush}"
                                    BorderBrush="{StaticResource CoalCardBrush}"
                                    BorderThickness="1"
                                    CornerRadius="3">
                                <Grid>
                                    <!-- placeholder glyph; collapsed once a real
                                         thumbnail is bound (image kinds only) -->
                                    <TextBlock Text="{Binding KindGlyph}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               FontFamily="{StaticResource MonoFont}"
                                               FontSize="14"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource EmberPrimaryBrush}"
                                               Visibility="{Binding PlaceholderVisibility}" />
                                    <Image Source="{Binding Thumbnail}"
                                           Stretch="UniformToFill"
                                           HorizontalAlignment="Stretch"
                                           VerticalAlignment="Stretch" />
                                </Grid>
                            </Border>
                            <TextBlock Grid.Row="1"
                                       Text="{Binding FileName}"
                                       FontFamily="{StaticResource MonoFont}"
                                       FontSize="9"
                                       MaxWidth="100"
                                       TextAlignment="Center"
                                       TextTrimming="CharacterEllipsis"
                                       Foreground="{StaticResource CoalSecondaryTextBrush}" />
                        </Grid>
                    </DataTemplate>
                </GridView.ItemTemplate>
            </GridView>
        </ScrollViewer>

        <TextBlock x:Name="EmptyHint"
                   Grid.Row="3"
                   Visibility="Collapsed"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   FontSize="12"
                   Foreground="{StaticResource CoalSecondaryTextBrush}"
                   TextWrapping="Wrap"
                   MaxWidth="380"
                   TextAlignment="Center"
                   Text="No media in this category. Use Import to add files to data/media." />

        <TextBlock Grid.Row="4"
                   x:Name="StatusLine"
                   Margin="0,8,0,0"
                   FontSize="10"
                   FontFamily="{StaticResource MonoFont}"
                   Foreground="{StaticResource CoalMutedTextBrush}"
                   TextWrapping="Wrap"
                   Text="Select a file, then Use Selected — or double-click a tile." />

        <StackPanel Grid.Row="5"
                    Orientation="Horizontal"
                    HorizontalAlignment="Left"
                    Margin="0,8,0,0"
                    Spacing="6">
            <Button x:Name="ImportButton"  Content="Import…" Click="OnImportClick" />
            <Button x:Name="RefreshButton" Content="Refresh"  Click="OnRefreshClick" />
        </StackPanel>
    </Grid>
</ContentDialog>
