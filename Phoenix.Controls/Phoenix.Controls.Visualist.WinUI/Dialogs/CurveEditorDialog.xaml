<?xml version="1.0" encoding="utf-8"?>
<!--
    B27 (audit/winui-regressions-2026-05-24) — keyframe curve editor.
    Reached from the timeline's right-click "Edit Curve…" menu item on
    individual keyframes. Lets the user pick a curve type (Linear / Ease-In /
    Ease-Out / Bezier / Step) via a pill bar; the Bezier slot exposes a 2D
    handle editor where the user drags P1 and P2 inside the unit square and
    sees a live curve preview.

    Visualist-local — per feedback_visualist_architect_chrome_independence.md
    we do NOT lift this into a Shared dialog. Curves are an animation-pin
    concept that Architect doesn't surface today; if a future Architect timeline
    needs the same dialog, it gets its own copy.

    Chrome treatment mirrors NewLayerDialog: Coal* / Ember* / Brass* tokens,
    eyebrow header + brass hairline. Mono font for the numeric handle
    readouts (live X/Y of P1/P2) per the same convention as the Inspector.
-->
<ContentDialog
    x:Class="Phoenix.Controls.Visualist.WinUI.Dialogs.CurveEditorDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Edit Curve"
    Background="{StaticResource CoalShellBrush}"
    BorderBrush="{StaticResource CoalCardBrush}"
    BorderThickness="1"
    CornerRadius="6"
    PrimaryButtonText="Save"
    CloseButtonText="Cancel"
    DefaultButton="Primary">

    <ContentDialog.Resources>
        <Style x:Key="CurveDialogEyebrow" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="CharacterSpacing" Value="180" />
            <Setter Property="Foreground" Value="{StaticResource EmberPrimaryBrush}" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>
        <Style x:Key="CurveDialogFieldLabel" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource SansFont}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="CharacterSpacing" Value="80" />
            <Setter Property="Foreground" Value="{StaticResource CoalSecondaryTextBrush}" />
            <Setter Property="Margin" Value="0,8,0,4" />
        </Style>
        <Style x:Key="CurveDialogHint" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Foreground" Value="{StaticResource CoalMutedTextBrush}" />
            <Setter Property="Margin" Value="0,4,0,0" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="CurvePillButtonStyle" TargetType="ToggleButton">
            <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="Margin" Value="0,0,4,0" />
            <Setter Property="MinHeight" Value="26" />
            <Setter Property="MinWidth" Value="60" />
        </Style>
    </ContentDialog.Resources>

    <Grid Width="460">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="2" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Spacing="2" Margin="0,0,0,8">
            <TextBlock Text="VISUALIST · CURVE" Style="{StaticResource CurveDialogEyebrow}" />
            <TextBlock x:Name="SubtitleText"
                       FontFamily="{StaticResource SansFont}"
                       FontSize="13"
                       Foreground="{StaticResource CoalSecondaryTextBrush}"
                       Text="Pick an easing curve for this keyframe." />
        </StackPanel>

        <Rectangle Grid.Row="1" Fill="{StaticResource BrassGradientBrush}" />

        <StackPanel Grid.Row="2" Margin="0,10,0,0">
            <TextBlock x:Name="CurveTypeLabel" Text="CURVE TYPE" Style="{StaticResource CurveDialogFieldLabel}" />
            <StackPanel Orientation="Horizontal" Spacing="0">
                <ToggleButton x:Name="LinearPill"
                              Content="Linear"
                              Style="{StaticResource CurvePillButtonStyle}"
                              Click="OnPillClicked" />
                <ToggleButton x:Name="EaseInPill"
                              Content="Ease In"
                              Style="{StaticResource CurvePillButtonStyle}"
                              Click="OnPillClicked" />
                <ToggleButton x:Name="EaseOutPill"
                              Content="Ease Out"
                              Style="{StaticResource CurvePillButtonStyle}"
                              Click="OnPillClicked" />
                <ToggleButton x:Name="EaseInOutPill"
                              Content="Ease In-Out"
                              Style="{StaticResource CurvePillButtonStyle}"
                              Click="OnPillClicked" />
                <ToggleButton x:Name="BezierPill"
                              Content="Bezier"
                              Style="{StaticResource CurvePillButtonStyle}"
                              Click="OnPillClicked" />
                <ToggleButton x:Name="StepPill"
                              Content="Step"
                              Style="{StaticResource CurvePillButtonStyle}"
                              Click="OnPillClicked" />
            </StackPanel>

            <TextBlock x:Name="PreviewLabel" Text="PREVIEW" Style="{StaticResource CurveDialogFieldLabel}" />
            <Border Background="{StaticResource CoalShellBrush}"
                    BorderBrush="{StaticResource CoalCardBrush}"
                    BorderThickness="1"
                    CornerRadius="4"
                    HorizontalAlignment="Stretch">
                <Grid x:Name="BezierSurface"
                      Width="420"
                      Height="220"
                      HorizontalAlignment="Center"
                      SizeChanged="OnBezierSurfaceSizeChanged"
                      PointerPressed="OnBezierSurfacePointerPressed"
                      PointerMoved="OnBezierSurfacePointerMoved"
                      PointerReleased="OnBezierSurfacePointerReleased"
                      Background="Transparent" />
            </Border>

            <TextBlock x:Name="BezierHandleReadout"
                       Style="{StaticResource CurveDialogHint}"
                       Text="P1 (0.25, 0.10)  ·  P2 (0.25, 1.00)" />

            <TextBlock x:Name="BezierHint"
                       Style="{StaticResource CurveDialogHint}"
                       Text="Drag P1 and P2 inside the box. Non-Bezier curves use the preview only — the handles are inert."
                       Margin="0,4,0,0" />
        </StackPanel>
    </Grid>
</ContentDialog>
