<?xml version="1.0" encoding="utf-8" ?>
<!--
    Visualist — focus-visual brush sweep.

    Sprint E: WinUI 3's default Fluent focus ring is barely visible against
    CoalShellBrush (#0B0907). Override the two FocusVisual brushes app-wide
    so a Tab arrival reads as a clean ember outline on every focusable
    control inside Visualist.WinUI.

    Per `feedback_visualist_architect_chrome_independence.md`, this file
    is per-pillar. Architect owns its own copy at the equivalent path —
    don't extract to Phoenix.Controls.Shared.WinUI even though the values
    are currently identical. Visualist's Fusion-flavoured node chrome
    will eventually want a typed-data-coloured focus pin (Image / Color /
    Scalar / Vector) on its widget-graph sockets — when that diverges
    from Architect's UE-Blueprints flow-driven focus look, the change
    lands here, not in a shared file.

    The brushes referenced (EmberPrimaryBrush, CoalCardBrush) are tokens
    declared in Phoenix.Controls.Shared.WinUI/Themes/PhoenixDark.xaml,
    which Hub.WinUI's App.xaml merges before this file. WinUI 3
    StaticResource lookup walks the parent dictionary stack, so the
    implicit styles below resolve correctly when this dictionary is
    merged inside MainView.Resources.

    Implicit styles target each focusable control type explicitly because
    WinUI 3 only matches implicit Style on exact TargetType — `Control`
    as TargetType does NOT cascade to derived types the way WPF allows.
    Decorative `Border` / `TextBlock` chrome is intentionally left out;
    only controls authors actually Tab to.
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Buttons / button-shaped controls -->
    <Style TargetType="Button">
        <Setter Property="FocusVisualPrimaryBrush"   Value="{StaticResource EmberPrimaryBrush}" />
        <Setter Property="FocusVisualSecondaryBrush" Value="{StaticResource CoalCardBrush}" />
    </Style>
    <Style TargetType="ToggleButton">
        <Setter Property="FocusVisualPrimaryBrush"   Value="{StaticResource EmberPrimaryBrush}" />
        <Setter Property="FocusVisualSecondaryBrush" Value="{StaticResource CoalCardBrush}" />
    </Style>
    <Style TargetType="HyperlinkButton">
        <Setter Property="FocusVisualPrimaryBrush"   Value="{StaticResource EmberPrimaryBrush}" />
        <Setter Property="FocusVisualSecondaryBrush" Value="{StaticResource CoalCardBrush}" />
    </Style>
    <Style TargetType="RepeatButton">
        <Setter Property="FocusVisualPrimaryBrush"   Value="{StaticResource EmberPrimaryBrush}" />
        <Setter Property="FocusVisualSecondaryBrush" Value="{StaticResource CoalCardBrush}" />
    </Style>
    <Style TargetType="DropDownButton">
        <Setter Property="FocusVisualPrimaryBrush"   Value="{StaticResource EmberPrimaryBrush}" />
        <Setter Property="FocusVisualSecondaryBrush" Value="{StaticResource CoalCardBrush}" />
    </Style>
    <Style TargetType="SplitButton">
        <Setter Property="FocusVisualPrimaryBrush"   Value="{StaticResource EmberPrimaryBrush}" />
        <Setter Property="FocusVisualSecondaryBrush" Value="{StaticResource CoalCardBrush}" />
    </Style>

    <!-- Toggles / checks -->
    <Style TargetType="CheckBox">
        <Setter Property="FocusVisualPrimaryBrush"   Value="{StaticResource EmberPrimaryBrush}" />
        <Setter Property="FocusVisualSecondaryBrush" Value="{StaticResource CoalCardBrush}" />
    </Style>
    <Style TargetType="RadioButton">
        <Setter Property="FocusVisualPrimaryBrush"   Value="{StaticResource EmberPrimaryBrush}" />
        <Setter Property="FocusVisualSecondaryBrush" Value="{StaticResource CoalCardBrush}" />
    </Style>
    <Style TargetType="ToggleSwitch">
        <Setter Property="FocusVisualPrimaryBrush"   Value="{StaticResource EmberPrimaryBrush}" />
        <Setter Property="FocusVisualSecondaryBrush" Value="{StaticResource CoalCardBrush}" />
    </Style>

    <!-- Text input -->
    <Style TargetType="TextBox">
        <Setter Property="FocusVisualPrimaryBrush"   Value="{StaticResource EmberPrimaryBrush}" />
        <Setter Property="FocusVisualSecondaryBrush" Value="{StaticResource CoalCardBrush}" />
    </Style>
    <Style TargetType="PasswordBox">
        <Setter Property="FocusVisualPrimaryBrush"   Value="{StaticResource EmberPrimaryBrush}" />
        <Setter Property="FocusVisualSecondaryBrush" Value="{StaticResource CoalCardBrush}" />
    </Style>
    <Style TargetType="RichEditBox">
        <Setter Property="FocusVisualPrimaryBrush"   Value="{StaticResource EmberPrimaryBrush}" />
        <Setter Property="FocusVisualSecondaryBrush" Value="{StaticResource CoalCardBrush}" />
    </Style>
    <Style TargetType="AutoSuggestBox">
        <Setter Property="FocusVisualPrimaryBrush"   Value="{StaticResource EmberPrimaryBrush}" />
        <Setter Property="FocusVisualSecondaryBrush" Value="{StaticResource CoalCardBrush}" />
    </Style>
    <Style TargetType="NumberBox">
        <Setter Property="FocusVisualPrimaryBrush"   Value="{StaticResource EmberPrimaryBrush}" />
        <Setter Property="FocusVisualSecondaryBrush" Value="{StaticResource CoalCardBrush}" />
    </Style>

    <!-- Selection lists / pickers -->
    <Style TargetType="ListView">
        <Setter Property="FocusVisualPrimaryBrush"   Value="{StaticResource EmberPrimaryBrush}" />
        <Setter Property="FocusVisualSecondaryBrush" Value="{StaticResource CoalCardBrush}" />
    </Style>
    <Style TargetType="ListBox">
        <Setter Property="FocusVisualPrimaryBrush"   Value="{StaticResource EmberPrimaryBrush}" />
        <Setter Property="FocusVisualSecondaryBrush" Value="{StaticResource CoalCardBrush}" />
    </Style>
    <Style TargetType="GridView">
        <Setter Property="FocusVisualPrimaryBrush"   Value="{StaticResource EmberPrimaryBrush}" />
        <Setter Property="FocusVisualSecondaryBrush" Value="{StaticResource CoalCardBrush}" />
    </Style>
    <Style TargetType="ComboBox">
        <Setter Property="FocusVisualPrimaryBrush"   Value="{StaticResource EmberPrimaryBrush}" />
        <Setter Property="FocusVisualSecondaryBrush" Value="{StaticResource CoalCardBrush}" />
    </Style>

    <!-- Item containers (per-row focus rect on selection lists) -->
    <Style TargetType="ListViewItem">
        <Setter Property="FocusVisualPrimaryBrush"   Value="{StaticResource EmberPrimaryBrush}" />
        <Setter Property="FocusVisualSecondaryBrush" Value="{StaticResource CoalCardBrush}" />
    </Style>
    <Style TargetType="ListBoxItem">
        <Setter Property="FocusVisualPrimaryBrush"   Value="{StaticResource EmberPrimaryBrush}" />
        <Setter Property="FocusVisualSecondaryBrush" Value="{StaticResource CoalCardBrush}" />
    </Style>
    <Style TargetType="GridViewItem">
        <Setter Property="FocusVisualPrimaryBrush"   Value="{StaticResource EmberPrimaryBrush}" />
        <Setter Property="FocusVisualSecondaryBrush" Value="{StaticResource CoalCardBrush}" />
    </Style>
    <Style TargetType="ComboBoxItem">
        <Setter Property="FocusVisualPrimaryBrush"   Value="{StaticResource EmberPrimaryBrush}" />
        <Setter Property="FocusVisualSecondaryBrush" Value="{StaticResource CoalCardBrush}" />
    </Style>

    <!-- Scalars -->
    <Style TargetType="Slider">
        <Setter Property="FocusVisualPrimaryBrush"   Value="{StaticResource EmberPrimaryBrush}" />
        <Setter Property="FocusVisualSecondaryBrush" Value="{StaticResource CoalCardBrush}" />
    </Style>

    <!-- Menus / flyouts -->
    <Style TargetType="MenuFlyoutItem">
        <Setter Property="FocusVisualPrimaryBrush"   Value="{StaticResource EmberPrimaryBrush}" />
        <Setter Property="FocusVisualSecondaryBrush" Value="{StaticResource CoalCardBrush}" />
    </Style>
    <Style TargetType="ToggleMenuFlyoutItem">
        <Setter Property="FocusVisualPrimaryBrush"   Value="{StaticResource EmberPrimaryBrush}" />
        <Setter Property="FocusVisualSecondaryBrush" Value="{StaticResource CoalCardBrush}" />
    </Style>

</ResourceDictionary>
