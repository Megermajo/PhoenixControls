<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Phoenix.Controls.Visualist.WinUI.Controls.HexPatternOverlay"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    IsHitTestVisible="False">

    <!-- Hex stroke pattern overlay. Per feedback_visualist_architect_chrome_independence
         this is COPIED from Hub.WinUI's HexPatternOverlay rather than referenced —
         the two pillars never share paint code. Used as the Visualist layer-canvas
         pasteboard backdrop (the "Hex" preview-background variant): hex outside the
         layer rect, flat inside, so the layer bounds read clearly. Render-only —
         never hit-tests, so canvas pan/zoom/marquee keep their pointer routing.
         The Canvas is populated in code-behind on SizeChanged with a flat-top hex
         grid sized to fill its bounds. Stroke-only. -->
    <Canvas x:Name="HexCanvas"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            UseLayoutRounding="False" />
</UserControl>
