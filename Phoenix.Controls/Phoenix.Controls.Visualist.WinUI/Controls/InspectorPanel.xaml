<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Phoenix.Controls.Visualist.WinUI.Controls.InspectorPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="using:Phoenix.Controls.Visualist.WinUI.Localization">

    <Grid Background="{StaticResource CoalSurfaceBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border
            Grid.Row="0"
            Padding="12,10,12,6"
            BorderBrush="{StaticResource CoalDividerBrush}"
            BorderThickness="0,0,0,1">
            <TextBlock
                Style="{StaticResource EyebrowTextStyle}"
                Text="INSPECTOR"
                loc:Localize.Key="visualist.inspector.eyebrow" />
        </Border>

        <ScrollViewer
            Grid.Row="1"
            HorizontalScrollBarVisibility="Disabled"
            VerticalScrollBarVisibility="Auto">
            <StackPanel Padding="12,8" Spacing="14">

                <!-- ── LAYER section ──────────────────────────────────── -->
                <!-- R17 — collapsed in Widget Editor mode (SetEditorContext):
                     layer resolution/preset/name are irrelevant while authoring
                     a widget's node graph ("why do I need layer settings when
                     editing a widget?"). -->
                <StackPanel x:Name="LayerSection" Spacing="6">
                    <TextBlock
                        Style="{StaticResource EyebrowTextStyle}"
                        Text="LAYER"
                        loc:Localize.Key="visualist.inspector.layer.eyebrow" />

                    <Grid x:Name="LayerForm" RowSpacing="6" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="64" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition />
                            <RowDefinition />
                            <RowDefinition />
                            <RowDefinition />
                            <RowDefinition />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0"
                                   Style="{StaticResource MonoSmallTextStyle}"
                                   VerticalAlignment="Center"
                                   Text="name"
                                   loc:Localize.Key="visualist.inspector.layer.name.label" />
                        <TextBox   Grid.Row="0" Grid.Column="1"
                                   x:Name="LayerNameBox"
                                   FontFamily="{StaticResource MonoFont}"
                                   FontSize="12"
                                   TextChanged="OnLayerNameChanged" />

                        <!-- C13 (audit 2026-05-24) — width/height NumberBoxes flanked by a
                             chain-link ToggleButton. When the chain is locked the captured
                             aspect ratio at toggle-on time gets reapplied on every W/H
                             edit, so dragging width up snaps height proportionally and
                             vice-versa. The toggle uses Segoe MDL2 U+E71B (Link). -->
                        <TextBlock Grid.Row="1" Grid.Column="0"
                                   Style="{StaticResource MonoSmallTextStyle}"
                                   VerticalAlignment="Center"
                                   Text="width"
                                   loc:Localize.Key="visualist.inspector.layer.width.label" />
                        <Grid Grid.Row="1" Grid.Column="1" ColumnSpacing="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <NumberBox Grid.Column="0"
                                       x:Name="LayerWidthBox"
                                       Minimum="1" Maximum="16384"
                                       ValueChanged="OnLayerWidthChanged" />
                            <ToggleButton Grid.Column="1"
                                          x:Name="AspectLockToggle"
                                          Width="28" Height="28"
                                          Padding="0"
                                          MinWidth="28"
                                          ToolTipService.ToolTip="Lock aspect ratio"
                                          loc:Localize.TooltipKey="visualist.inspector.layer.aspect_lock.tip"
                                          Checked="OnAspectLockToggled"
                                          Unchecked="OnAspectLockToggled">
                                <FontIcon Glyph="&#xE71B;"
                                          FontFamily="Segoe MDL2 Assets"
                                          FontSize="12" />
                            </ToggleButton>
                        </Grid>

                        <TextBlock Grid.Row="2" Grid.Column="0"
                                   Style="{StaticResource MonoSmallTextStyle}"
                                   VerticalAlignment="Center"
                                   Text="height"
                                   loc:Localize.Key="visualist.inspector.layer.height.label" />
                        <NumberBox Grid.Row="2" Grid.Column="1"
                                   x:Name="LayerHeightBox"
                                   Minimum="1" Maximum="16384"
                                   ValueChanged="OnLayerHeightChanged" />

                        <TextBlock Grid.Row="3" Grid.Column="0"
                                   Style="{StaticResource MonoSmallTextStyle}"
                                   VerticalAlignment="Center"
                                   Text="preset"
                                   loc:Localize.Key="visualist.inspector.layer.preset.label" />
                        <ComboBox  Grid.Row="3" Grid.Column="1"
                                   x:Name="LayerPresetBox"
                                   HorizontalAlignment="Stretch"
                                   SelectionChanged="OnLayerPresetChanged" />

                        <!-- Default translation target for Caption.LiveCaption nodes on
                             this layer (BCP-47, e.g. "de", "ja"). Empty disables
                             translation. Commit on LostFocus / Enter (not per-keystroke). -->
                        <TextBlock Grid.Row="4" Grid.Column="0"
                                   Style="{StaticResource MonoSmallTextStyle}"
                                   VerticalAlignment="Center"
                                   ToolTipService.ToolTip="Default caption translation target (BCP-47, e.g. de / ja). Empty = no translation."
                                   loc:Localize.TooltipKey="visualist.inspector.layer.lang.tip"
                                   Text="lang"
                                   loc:Localize.Key="visualist.inspector.layer.lang.label" />
                        <TextBox   Grid.Row="4" Grid.Column="1"
                                   x:Name="LayerLanguageBox"
                                   FontFamily="{StaticResource MonoFont}"
                                   FontSize="12"
                                   PlaceholderText="(none)"
                                   loc:Localize.PlaceholderKey="visualist.inspector.layer.lang.placeholder"
                                   ToolTipService.ToolTip="Default caption translation target (BCP-47, e.g. de / ja). Empty = no translation."
                                   loc:Localize.TooltipKey="visualist.inspector.layer.lang.tip"
                                   LostFocus="OnLayerTargetLanguageLostFocus"
                                   KeyDown="OnLayerTargetLanguageKeyDown" />
                    </Grid>

                    <!-- Named item #4 — "Copy OBS URL" is a LAYER-level affordance
                         (the URL OBS pastes into the Browser Source is keyed on the
                         LayerID = .phxlayer file stem, NOT on any widget), so it
                         lives in the LAYER section and stays visible in Layer-Canvas
                         mode. Gated on a saved layer; the hint explains the gate. -->
                    <Button
                        x:Name="CopyObsUrlButton"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Left"
                        Padding="8,4"
                        FontSize="11"
                        Background="{StaticResource CoalCardBrush}"
                        BorderThickness="0"
                        Foreground="{StaticResource CoalBodyTextBrush}"
                        Click="OnCopyObsUrl"
                        ToolTipService.ToolTip="Copy the OBS Browser-Source URL for this layer"
                        loc:Localize.TooltipKey="visualist.inspector.layer.copy_obs_url.tip">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE71B;" FontFamily="Segoe MDL2 Assets" FontSize="11" />
                            <TextBlock Text="Copy OBS URL" FontSize="11" VerticalAlignment="Center"
                                       loc:Localize.Key="visualist.inspector.layer.copy_obs_url.label" />
                        </StackPanel>
                    </Button>

                    <!-- Unsaved hint — the OBS URL needs the layer saved so it has a
                         stable LayerID (the file stem). -->
                    <TextBlock
                        x:Name="LayerObsUnsavedHint"
                        FontFamily="{StaticResource MonoFont}"
                        FontSize="10"
                        Foreground="{StaticResource CoalMutedTextBrush}"
                        TextWrapping="Wrap"
                        Visibility="Collapsed"
                        Text="Save the layer to get a stable LayerID for the OBS URL."
                        loc:Localize.Key="visualist.inspector.layer.obs_unsaved.hint" />
                </StackPanel>

                <Border
                    x:Name="LayerSectionDivider"
                    Height="1"
                    Background="{StaticResource CoalDividerBrush}" />

                <!-- ── WIDGETS roster (R7) ─────────────────────────────
                     Restores the pre-WinUI left widget-tree picker: a flat list
                     of every widget in the layer so tiny / stacked / offscreen
                     widgets are always reachable (the canvas rect was otherwise
                     the ONLY selection surface). Single-click selects;
                     double-click enters that widget's editor. -->
                <StackPanel Spacing="6">
                    <TextBlock
                        Style="{StaticResource EyebrowTextStyle}"
                        Text="WIDGETS"
                        loc:Localize.Key="visualist.inspector.roster.eyebrow" />
                    <TextBlock
                        x:Name="WidgetRosterEmptyHint"
                        FontFamily="{StaticResource MonoFont}"
                        FontSize="10"
                        Foreground="{StaticResource CoalMutedTextBrush}"
                        TextWrapping="Wrap"
                        Text="No widgets yet — right-click the layer canvas to add one."
                        loc:Localize.Key="visualist.inspector.roster.empty.hint" />
                    <ListView
                        x:Name="WidgetRosterList"
                        SelectionMode="Single"
                        MaxHeight="180"
                        SelectionChanged="OnWidgetRosterSelectionChanged"
                        DoubleTapped="OnWidgetRosterDoubleTapped"
                        ToolTipService.ToolTip="Click to select · double-click to edit triggers"
                        loc:Localize.TooltipKey="visualist.inspector.roster.list.tip" />
                </StackPanel>

                <Border
                    Height="1"
                    Background="{StaticResource CoalDividerBrush}" />

                <!-- ── WIDGET section ─────────────────────────────────── -->
                <StackPanel Spacing="6">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Style="{StaticResource EyebrowTextStyle}"
                                   Text="WIDGET"
                                   loc:Localize.Key="visualist.inspector.widget.eyebrow" />
                        <Button    Grid.Column="1"
                                   x:Name="DeleteWidgetButton"
                                   Content="Delete"
                                   loc:Localize.Key="common.button.delete"
                                   FontSize="10"
                                   Padding="6,2"
                                   Background="Transparent"
                                   Foreground="{StaticResource ErrBrush}"
                                   BorderBrush="{StaticResource ErrBrush}"
                                   BorderThickness="1"
                                   IsEnabled="False"
                                   Click="OnDeleteWidget" />
                    </Grid>

                    <TextBlock
                        x:Name="WidgetEmptyHint"
                        FontFamily="{StaticResource MonoFont}"
                        FontSize="10"
                        Foreground="{StaticResource CoalMutedTextBrush}"
                        TextWrapping="Wrap"
                        Text="Select a widget on the layer canvas to edit its properties."
                        loc:Localize.Key="visualist.inspector.widget.empty.hint" />

                    <!-- Named item #2 — the WIDGET form splits into three blocks so
                         widget-editor mode (SetEditorContext) can collapse ONLY the
                         dead read-only geometry mirrors while keeping the editable
                         name + z-index. (Mirrors are stale noise while authoring a
                         node graph — edits live on the canvas pills; name + z-index
                         are real editors and stay.) -->
                    <StackPanel x:Name="WidgetForm" Spacing="6" Visibility="Collapsed">

                        <!-- Multi-select banner — shown only when 2+ widgets are
                             selected. In that mode the name row hides (each widget
                             keeps its own name) and every geometry / preset / z-index
                             / transition edit applies to ALL selected widgets in a
                             single undo. A blank field ("—") means the widgets
                             disagree; typing a value makes them all match. -->
                        <Border x:Name="WidgetMultiHeader"
                                Visibility="Collapsed"
                                Background="{StaticResource SelectionDimBrush}"
                                BorderBrush="{StaticResource SelectionBrush}"
                                BorderThickness="1"
                                CornerRadius="3"
                                Padding="8,5">
                            <TextBlock x:Name="WidgetMultiHeaderText"
                                       FontFamily="{StaticResource MonoFont}"
                                       FontSize="11"
                                       Foreground="{StaticResource SelectionBrush}"
                                       TextWrapping="Wrap"
                                       Text="" />
                        </Border>

                        <Grid x:Name="WidgetNameRow" RowSpacing="6" ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="64" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Style="{StaticResource MonoSmallTextStyle}"
                                       VerticalAlignment="Center"
                                       Text="name"
                                       loc:Localize.Key="visualist.inspector.widget.name.label" />
                            <TextBox   Grid.Column="1"
                                       x:Name="WidgetNameBox"
                                       FontFamily="{StaticResource MonoFont}"
                                       FontSize="12"
                                       TextChanged="OnWidgetNameChanged" />
                        </Grid>

                        <!-- Editable widget geometry (x / y / width / height) + preset picker.
                             Replaces the former read-only mirrors: committing NumberBoxes push
                             one undo per edit gesture, write widget.Rect, MarkDirty and re-render
                             the canvas. Each mono LABEL is wrapped in a transparent Border so its
                             whole cell is a Fusion-style drag-scrub handle (AttachLabelScrub) —
                             press + drag left/right to nudge the paired box (Shift = fine).
                             Kept in WidgetGeometryMirrors so widget-editor mode
                             (SetEditorContext) still collapses the whole block. -->
                        <Grid x:Name="WidgetGeometryMirrors" RowSpacing="6" ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="64" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition />
                                <RowDefinition />
                                <RowDefinition />
                                <RowDefinition />
                                <RowDefinition />
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0" Grid.Column="0"
                                    x:Name="WidgetXLabel"
                                    Background="Transparent"
                                    ToolTipService.ToolTip="Drag left/right to scrub · Shift = fine"
                                    loc:Localize.TooltipKey="visualist.inspector.widget.scrub.tip">
                                <TextBlock Style="{StaticResource MonoSmallTextStyle}"
                                           VerticalAlignment="Center" Text="x"
                                           loc:Localize.Key="visualist.inspector.widget.x.label" />
                            </Border>
                            <NumberBox Grid.Row="0" Grid.Column="1"
                                       x:Name="WidgetXBox"
                                       Minimum="0" Maximum="16384"
                                       SmallChange="1" LargeChange="10"
                                       PlaceholderText="—"
                                       SpinButtonPlacementMode="Hidden"
                                       ValueChanged="OnWidgetXChanged" />

                            <Border Grid.Row="1" Grid.Column="0"
                                    x:Name="WidgetYLabel"
                                    Background="Transparent"
                                    ToolTipService.ToolTip="Drag left/right to scrub · Shift = fine"
                                    loc:Localize.TooltipKey="visualist.inspector.widget.scrub.tip">
                                <TextBlock Style="{StaticResource MonoSmallTextStyle}"
                                           VerticalAlignment="Center" Text="y"
                                           loc:Localize.Key="visualist.inspector.widget.y.label" />
                            </Border>
                            <NumberBox Grid.Row="1" Grid.Column="1"
                                       x:Name="WidgetYBox"
                                       Minimum="0" Maximum="16384"
                                       SmallChange="1" LargeChange="10"
                                       PlaceholderText="—"
                                       SpinButtonPlacementMode="Hidden"
                                       ValueChanged="OnWidgetYChanged" />

                            <Border Grid.Row="2" Grid.Column="0"
                                    x:Name="WidgetWidthLabel"
                                    Background="Transparent"
                                    ToolTipService.ToolTip="Drag left/right to scrub · Shift = fine"
                                    loc:Localize.TooltipKey="visualist.inspector.widget.scrub.tip">
                                <TextBlock Style="{StaticResource MonoSmallTextStyle}"
                                           VerticalAlignment="Center" Text="width"
                                           loc:Localize.Key="visualist.inspector.widget.width.label" />
                            </Border>
                            <NumberBox Grid.Row="2" Grid.Column="1"
                                       x:Name="WidgetWidthBox"
                                       Minimum="1" Maximum="16384"
                                       SmallChange="1" LargeChange="10"
                                       PlaceholderText="—"
                                       SpinButtonPlacementMode="Hidden"
                                       ValueChanged="OnWidgetWidthChanged" />

                            <Border Grid.Row="3" Grid.Column="0"
                                    x:Name="WidgetHeightLabel"
                                    Background="Transparent"
                                    ToolTipService.ToolTip="Drag left/right to scrub · Shift = fine"
                                    loc:Localize.TooltipKey="visualist.inspector.widget.scrub.tip">
                                <TextBlock Style="{StaticResource MonoSmallTextStyle}"
                                           VerticalAlignment="Center" Text="height"
                                           loc:Localize.Key="visualist.inspector.widget.height.label" />
                            </Border>
                            <NumberBox Grid.Row="3" Grid.Column="1"
                                       x:Name="WidgetHeightBox"
                                       Minimum="1" Maximum="16384"
                                       SmallChange="1" LargeChange="10"
                                       PlaceholderText="—"
                                       SpinButtonPlacementMode="Hidden"
                                       ValueChanged="OnWidgetHeightChanged" />

                            <TextBlock Grid.Row="4" Grid.Column="0"
                                       Style="{StaticResource MonoSmallTextStyle}"
                                       VerticalAlignment="Center"
                                       Text="preset"
                                       loc:Localize.Key="visualist.inspector.widget.preset.label" />
                            <!-- The tooltip must NOT claim "tag only": picking Alert Box also
                                 COMPILES that widget's alert trigger from its settings (the one
                                 compiled preset), and generating a graph is not something an
                                 author should discover after the click. -->
                            <ComboBox  Grid.Row="4" Grid.Column="1"
                                       x:Name="WidgetPresetBox"
                                       HorizontalAlignment="Stretch"
                                       ToolTipService.ToolTip="Widget kind label (Image / Video / Text / …) — a tag only, EXCEPT Alert Box, which also generates this widget's alert trigger from the ALERT BOX settings below."
                                       loc:Localize.TooltipKey="visualist.inspector.widget.preset.tip"
                                       SelectionChanged="OnWidgetPresetChanged" />
                        </Grid>

                        <Grid RowSpacing="6" ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="64" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0"
                                    x:Name="WidgetZIndexLabel"
                                    Background="Transparent"
                                    ToolTipService.ToolTip="Drag left/right to scrub · Shift = fine"
                                    loc:Localize.TooltipKey="visualist.inspector.widget.scrub.tip">
                                <TextBlock Style="{StaticResource MonoSmallTextStyle}"
                                           VerticalAlignment="Center" Text="z-index"
                                           loc:Localize.Key="visualist.inspector.widget.zindex.label" />
                            </Border>
                            <NumberBox Grid.Column="1"
                                       x:Name="WidgetZIndexBox"
                                       Minimum="0"
                                       SmallChange="1" LargeChange="10"
                                       PlaceholderText="—"
                                       SpinButtonPlacementMode="Hidden"
                                       ValueChanged="OnWidgetZIndexChanged" />
                        </Grid>

                        <!-- Per-widget dip-to-blank event transition (0–1 s).
                             0 = instant cut (legacy). When a new event swaps this
                             widget's content at runtime, compositor.js fades the old
                             content out to blank then the new content in over this
                             duration so the change reads instead of hard-cutting. -->
                        <Grid RowSpacing="6" ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="64" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Style="{StaticResource MonoSmallTextStyle}"
                                       VerticalAlignment="Center"
                                       Text="transition"
                                       loc:Localize.Key="visualist.inspector.widget.transition.label" />
                            <Grid Grid.Column="1" ColumnSpacing="6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="72" />
                                </Grid.ColumnDefinitions>
                                <Slider Grid.Column="0"
                                        x:Name="WidgetTransitionSlider"
                                        Minimum="0" Maximum="1"
                                        StepFrequency="0.05"
                                        ToolTipService.ToolTip="Dip-to-blank transition between events, in seconds (0 = instant cut)"
                                        loc:Localize.TooltipKey="visualist.inspector.widget.transition.tip"
                                        ValueChanged="OnWidgetTransitionSliderChanged"
                                        VerticalAlignment="Center" />
                                <NumberBox Grid.Column="1"
                                           x:Name="WidgetTransitionBox"
                                           Minimum="0" Maximum="1"
                                           SmallChange="0.05" LargeChange="0.1"
                                           PlaceholderText="—"
                                           SpinButtonPlacementMode="Hidden"
                                           ValueChanged="OnWidgetTransitionBoxChanged"
                                           VerticalAlignment="Center" />
                            </Grid>
                        </Grid>
                    </StackPanel>
                </StackPanel>

                <!-- ── ALERT BOX section (V8) ──────────────────────────────────
                     Visible only for a WidgetPreset.AlertBox widget. This is the
                     ONLY compiled preset: the values here are the source of truth
                     and the widget's onTrigger:<id> graph is GENERATED from them,
                     so a hand edit to that graph is thrown away on the next commit.
                     That is a data-loss shape, so the banner states it permanently
                     rather than letting an author find out — and the one-way
                     "Detach to manual" button below is the sanctioned exit.

                     The per-kind media rows are built imperatively into
                     AlertBoxRowsPanel (the kind list is variable-length, exactly
                     like TriggerRowsPanel); the three scalar fields are persistent
                     named XAML so a commit-driven refresh can't tear down the box
                     the author is typing in. No Expander anywhere — the 1.1 tool
                     pages had to be de-Expandered after a crash. -->
                <Border
                    x:Name="AlertBoxSectionDivider"
                    Height="1"
                    Visibility="Collapsed"
                    Background="{StaticResource CoalDividerBrush}" />

                <StackPanel x:Name="AlertBoxSection" Spacing="6" Visibility="Collapsed">
                    <TextBlock
                        Style="{StaticResource EyebrowTextStyle}"
                        Text="ALERT BOX"
                        loc:Localize.Key="visualist.inspector.alertbox.eyebrow" />

                    <!-- Persistent ownership banner. Two states, never hidden while
                         the section is visible: settings-owned (regeneration warning)
                         or detached (hand-owned, one-way). -->
                    <Border
                        x:Name="AlertBoxOwnershipBanner"
                        Background="{StaticResource CoalRaisedBrush}"
                        BorderBrush="{StaticResource CoalDividerBrush}"
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="8,5">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Ellipse
                                x:Name="AlertBoxOwnershipDot"
                                Width="8" Height="8"
                                VerticalAlignment="Top"
                                Margin="0,3,0,0"
                                Fill="{StaticResource WarnBrush}" />
                            <TextBlock
                                x:Name="AlertBoxOwnershipText"
                                FontSize="10"
                                TextWrapping="Wrap"
                                Foreground="{StaticResource CoalSecondaryTextBrush}" />
                        </StackPanel>
                    </Border>

                    <Grid x:Name="AlertBoxForm" RowSpacing="6" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="64" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0"
                                   Style="{StaticResource MonoSmallTextStyle}"
                                   VerticalAlignment="Center"
                                   Text="trigger"
                                   loc:Localize.Key="visualist.inspector.alertbox.trigger.label" />
                        <TextBox   Grid.Row="0" Grid.Column="1"
                                   x:Name="AlertBoxTriggerBox"
                                   FontFamily="{StaticResource MonoFont}"
                                   FontSize="12"
                                   PlaceholderText="alert"
                                   ToolTipService.ToolTip="Bare trigger id — the graph lands on onTrigger:&lt;id&gt;. Put this same value in the Alerts tool's Trigger Name field. Letter first, then letters / digits / underscores."
                                   loc:Localize.TooltipKey="visualist.inspector.alertbox.trigger.tip"
                                   LostFocus="OnAlertBoxFieldLostFocus"
                                   KeyDown="OnAlertBoxFieldKeyDown" />

                        <TextBlock Grid.Row="1" Grid.Column="0"
                                   Style="{StaticResource MonoSmallTextStyle}"
                                   VerticalAlignment="Center"
                                   Text="message"
                                   loc:Localize.Key="visualist.inspector.alertbox.message.label" />
                        <!-- Placeholder mirrors AlertBoxSettings.DefaultMessageFormat, which is
                             {Args2} ALONE: Args3 is always present and is "0" for a follow (and
                             for a sub with no month count), so a size-bearing default prints a
                             literal 0 on stream. The tooltip is set in code from
                             AlertBoxSettings.MessageFormatTooltip so the "default omits the size
                             token, help text still names it" pair lives in one file. -->
                        <TextBox   Grid.Row="1" Grid.Column="1"
                                   x:Name="AlertBoxMessageBox"
                                   FontFamily="{StaticResource MonoFont}"
                                   FontSize="12"
                                   PlaceholderText="{}{Args2}"
                                   LostFocus="OnAlertBoxFieldLostFocus"
                                   KeyDown="OnAlertBoxFieldKeyDown" />

                        <TextBlock Grid.Row="2" Grid.Column="0"
                                   Style="{StaticResource MonoSmallTextStyle}"
                                   VerticalAlignment="Center"
                                   Text="hold (s)"
                                   loc:Localize.Key="visualist.inspector.alertbox.hold.label" />
                        <NumberBox Grid.Row="2" Grid.Column="1"
                                   x:Name="AlertBoxDurationBox"
                                   Minimum="0" Maximum="600"
                                   SmallChange="0.5" LargeChange="2"
                                   PlaceholderText="—"
                                   SpinButtonPlacementMode="Hidden"
                                   ToolTipService.ToolTip="How long the alert stays on screen, in seconds. The browser clamps the hold to 2–60 s, so anything under 2 s still holds for 2."
                                   loc:Localize.TooltipKey="visualist.inspector.alertbox.hold.tip"
                                   ValueChanged="OnAlertBoxDurationChanged" />
                    </Grid>

                    <!-- Fallback + per-kind media rows, built in RefreshAlertBoxSection. -->
                    <StackPanel x:Name="AlertBoxRowsPanel" Spacing="3" />

                    <TextBlock
                        x:Name="AlertBoxFeedback"
                        FontSize="10"
                        FontFamily="{StaticResource MonoFont}"
                        TextWrapping="Wrap"
                        Foreground="{StaticResource OkBrush}"
                        Visibility="Collapsed" />

                    <Button
                        x:Name="AlertBoxDetachButton"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Left"
                        Padding="8,4"
                        FontSize="11"
                        Background="{StaticResource CoalCardBrush}"
                        BorderThickness="0"
                        Foreground="{StaticResource CoalBodyTextBrush}"
                        Click="OnAlertBoxDetach"
                        ToolTipService.ToolTip="Stop generating this widget's graph from these settings and hand it over for manual editing. ONE-WAY — there is no re-attach (undo reverts it)."
                        loc:Localize.TooltipKey="visualist.inspector.alertbox.detach.tip">
                        <TextBlock x:Name="AlertBoxDetachLabel" FontSize="11" VerticalAlignment="Center"
                                   Text="Detach to manual editing…"
                                   loc:Localize.Key="visualist.inspector.alertbox.detach.label" />
                    </Button>
                </StackPanel>

                <!-- ── TRIGGERS section (named item #4 redesign) ───────────────
                     Per-widget trigger management lives here now: a list of the
                     widget's triggers (each row = name + Test / Copy / Delete) and
                     a "New Trigger" button. The raw Layer-ID / Widget-ID textboxes
                     were removed and "Copy OBS URL" moved up to the LAYER section
                     (it's layer-level). onStartup is the idle loop — it auto-fires
                     and can't be Architect-triggered, so its row hides Test / Copy /
                     Delete and shows an "auto-fires on load" hint instead.
                     Visualist-local chrome per
                     feedback_visualist_architect_chrome_independence. -->
                <Border
                    x:Name="TriggersSectionDivider"
                    Height="1"
                    Visibility="Collapsed"
                    Background="{StaticResource CoalDividerBrush}" />

                <StackPanel x:Name="TriggersSection" Spacing="6" Visibility="Collapsed">
                    <TextBlock
                        Style="{StaticResource EyebrowTextStyle}"
                        Text="TRIGGERS"
                        loc:Localize.Key="visualist.inspector.triggers.eyebrow" />

                    <!-- Per-trigger Test / Copy / Delete rows — built imperatively
                         in RefreshTriggersSection (Triggers is a plain List). -->
                    <StackPanel x:Name="TriggerRowsPanel" Spacing="3" />

                    <TextBlock
                        x:Name="TriggersEmptyHint"
                        FontFamily="{StaticResource MonoFont}"
                        FontSize="10"
                        Foreground="{StaticResource CoalMutedTextBrush}"
                        TextWrapping="Wrap"
                        Visibility="Collapsed"
                        Text="This widget has no triggers yet — use New Trigger below to add one."
                        loc:Localize.Key="visualist.inspector.triggers.empty.hint" />

                    <!-- Named item #4 — user-initiated trigger create. Prompts for a
                         name (modal TextBox dialog); a dup/invalid name surfaces as a
                         non-modal inline warning, not a modal error. -->
                    <Button
                        x:Name="NewTriggerButton"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Left"
                        Padding="8,4"
                        FontSize="11"
                        Background="{StaticResource CoalCardBrush}"
                        BorderThickness="0"
                        Foreground="{StaticResource CoalBodyTextBrush}"
                        Click="OnCreateTrigger"
                        ToolTipService.ToolTip="Create a new trigger for this widget"
                        loc:Localize.TooltipKey="visualist.inspector.triggers.new.tip">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="11" />
                            <TextBlock Text="New Trigger" FontSize="11" VerticalAlignment="Center"
                                       loc:Localize.Key="visualist.inspector.triggers.new.label" />
                        </StackPanel>
                    </Button>

                    <!-- R60 — persistent bus-offline hint. Shown whenever the Hub
                         bus is disconnected, explaining why the Test chips are
                         greyed (non-modal per
                         feedback_no_modal_dialogs_for_repeatable_rejections). -->
                    <Border
                        x:Name="BusOfflineHint"
                        Visibility="Collapsed"
                        Background="{StaticResource CoalRaisedBrush}"
                        BorderBrush="{StaticResource CoalDividerBrush}"
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="8,5">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Ellipse Width="8" Height="8" VerticalAlignment="Center"
                                     Fill="{StaticResource ErrBrush}" />
                            <TextBlock
                                FontSize="10"
                                TextWrapping="Wrap"
                                Foreground="{StaticResource CoalSecondaryTextBrush}"
                                Text="Hub bus offline — Test Run is disabled. Launch Hub to run triggers live."
                                loc:Localize.Key="visualist.inspector.triggers.bus_offline.hint" />
                        </StackPanel>
                    </Border>

                    <!-- Transient copy/test confirmation — cleared after ~2.5s. -->
                    <TextBlock
                        x:Name="TriggerActionFeedback"
                        FontSize="10"
                        FontFamily="{StaticResource MonoFont}"
                        Foreground="{StaticResource OkBrush}"
                        Visibility="Collapsed" />
                </StackPanel>

                <!-- ── NODE section (Track A — typed per-node inspector) ───────
                     Fusion-style: select a node in the widget graph and this
                     section renders that node's editable parameters as proper
                     controls (Scalar→slider+numbox, Color→picker, Bool→toggle,
                     String→textbox, Enum→dropdown, VectorN→N slider+numbox pairs,
                     MediaPath→Browse…). The node-body inline pills stay TEXT-ENTRY
                     only — the rich controls live ONLY here (per the locked user
                     requirement). Each animatable row carries a DaVinci-style
                     ◀ ◇/◆ ▶ keyframe cluster (add/remove at playhead, prev/next, ease).

                     The param rows are built imperatively in RefreshNodeForm
                     (mirrors RefreshTriggersSection) rather than via an
                     ItemsControl + DataTemplateSelector: NodeParamVm.VectorValues
                     is a double[] and WinUI two-way Binding can't bind array
                     elements, and the ColorPicker flyout + Browse… file picker
                     need code-behind glue. Imperative rows keep the NodeParamVm
                     contract byte-identical (read/write its props, invoke its
                     command) without fragile array/flyout XAML. Visible only when
                     _vm.SelectedNode != null. Visualist-local chrome per
                     feedback_visualist_architect_chrome_independence. -->
                <Border
                    x:Name="NodeSectionDivider"
                    Height="1"
                    Visibility="Collapsed"
                    Background="{StaticResource CoalDividerBrush}" />

                <StackPanel x:Name="NodeSection" Spacing="6" Visibility="Collapsed">
                    <TextBlock
                        Style="{StaticResource EyebrowTextStyle}"
                        Text="NODE"
                        loc:Localize.Key="visualist.inspector.node.eyebrow" />

                    <!-- Header — node Title + short description (template hint). -->
                    <StackPanel Spacing="1">
                        <TextBlock
                            x:Name="NodeTitleText"
                            FontFamily="{StaticResource MonoFont}"
                            FontSize="12"
                            Foreground="{StaticResource AccentValueBrush}"
                            TextTrimming="CharacterEllipsis" />
                        <TextBlock
                            x:Name="NodeDescriptionText"
                            FontFamily="{StaticResource MonoFont}"
                            FontSize="10"
                            Foreground="{StaticResource CoalMutedTextBrush}"
                            TextWrapping="Wrap" />
                    </StackPanel>

                    <!-- No-params hint — a node with no editable attributes
                         (pure flow / sink) still selects, so explain the empty
                         body rather than rendering a blank section. -->
                    <TextBlock
                        x:Name="NodeNoParamsHint"
                        FontFamily="{StaticResource MonoFont}"
                        FontSize="10"
                        Foreground="{StaticResource CoalMutedTextBrush}"
                        TextWrapping="Wrap"
                        Visibility="Collapsed"
                        Text="This node has no editable parameters."
                        loc:Localize.Key="visualist.inspector.node.no_params.hint" />

                    <!-- Per-parameter rows, built imperatively in RefreshNodeForm. -->
                    <StackPanel x:Name="NodeParamsPanel" Spacing="8" />
                </StackPanel>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
