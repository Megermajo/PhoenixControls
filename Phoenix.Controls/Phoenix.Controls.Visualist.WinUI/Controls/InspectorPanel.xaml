<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Phoenix.Controls.Visualist.WinUI.Controls.InspectorPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Background="{StaticResource CoalSurfaceBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border
            Grid.Row="0"
            Padding="12,10,12,6"
            BorderBrush="{StaticResource CoalCardBrush}"
            BorderThickness="0,0,0,1">
            <TextBlock
                Style="{StaticResource EyebrowTextStyle}"
                Text="INSPECTOR" />
        </Border>

        <ScrollViewer
            Grid.Row="1"
            HorizontalScrollBarVisibility="Disabled"
            VerticalScrollBarVisibility="Auto">
            <StackPanel Padding="12,8" Spacing="14">

                <!-- ── LAYER section ──────────────────────────────────── -->
                <!-- R17 — collapsed in Widget Editor mode (SetEditorContext):
                     layer resolution/preset/name are irrelevant while authoring
                     a widget's node graph ("why do I need layer settings when
                     editing a widget?"). -->
                <StackPanel x:Name="LayerSection" Spacing="6">
                    <TextBlock
                        Style="{StaticResource EyebrowTextStyle}"
                        Text="LAYER" />

                    <Grid x:Name="LayerForm" RowSpacing="6" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="64" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition />
                            <RowDefinition />
                            <RowDefinition />
                            <RowDefinition />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0"
                                   Style="{StaticResource MonoSmallTextStyle}"
                                   VerticalAlignment="Center"
                                   Text="name" />
                        <TextBox   Grid.Row="0" Grid.Column="1"
                                   x:Name="LayerNameBox"
                                   FontFamily="{StaticResource MonoFont}"
                                   FontSize="12"
                                   TextChanged="OnLayerNameChanged" />

                        <!-- C13 (audit 2026-05-24) — width/height NumberBoxes flanked by a
                             chain-link ToggleButton. When the chain is locked the captured
                             aspect ratio at toggle-on time gets reapplied on every W/H
                             edit, so dragging width up snaps height proportionally and
                             vice-versa. The toggle uses Segoe MDL2 U+E71B (Link). -->
                        <TextBlock Grid.Row="1" Grid.Column="0"
                                   Style="{StaticResource MonoSmallTextStyle}"
                                   VerticalAlignment="Center"
                                   Text="width" />
                        <Grid Grid.Row="1" Grid.Column="1" ColumnSpacing="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <NumberBox Grid.Column="0"
                                       x:Name="LayerWidthBox"
                                       Minimum="1" Maximum="16384"
                                       ValueChanged="OnLayerWidthChanged" />
                            <ToggleButton Grid.Column="1"
                                          x:Name="AspectLockToggle"
                                          Width="28" Height="28"
                                          Padding="0"
                                          MinWidth="28"
                                          ToolTipService.ToolTip="Lock aspect ratio"
                                          Checked="OnAspectLockToggled"
                                          Unchecked="OnAspectLockToggled">
                                <FontIcon Glyph="&#xE71B;"
                                          FontFamily="Segoe MDL2 Assets"
                                          FontSize="12" />
                            </ToggleButton>
                        </Grid>

                        <TextBlock Grid.Row="2" Grid.Column="0"
                                   Style="{StaticResource MonoSmallTextStyle}"
                                   VerticalAlignment="Center"
                                   Text="height" />
                        <NumberBox Grid.Row="2" Grid.Column="1"
                                   x:Name="LayerHeightBox"
                                   Minimum="1" Maximum="16384"
                                   ValueChanged="OnLayerHeightChanged" />

                        <TextBlock Grid.Row="3" Grid.Column="0"
                                   Style="{StaticResource MonoSmallTextStyle}"
                                   VerticalAlignment="Center"
                                   Text="preset" />
                        <ComboBox  Grid.Row="3" Grid.Column="1"
                                   x:Name="LayerPresetBox"
                                   HorizontalAlignment="Stretch"
                                   SelectionChanged="OnLayerPresetChanged" />
                    </Grid>

                    <!-- Named item #4 — "Copy OBS URL" is a LAYER-level affordance
                         (the URL OBS pastes into the Browser Source is keyed on the
                         LayerID = .phxlayer file stem, NOT on any widget), so it
                         lives in the LAYER section and stays visible in Layer-Canvas
                         mode. Gated on a saved layer; the hint explains the gate. -->
                    <Button
                        x:Name="CopyObsUrlButton"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Left"
                        Padding="8,4"
                        FontSize="11"
                        Background="{StaticResource CoalCardBrush}"
                        BorderThickness="0"
                        Foreground="{StaticResource CoalBodyTextBrush}"
                        Click="OnCopyObsUrl"
                        ToolTipService.ToolTip="Copy the OBS Browser-Source URL for this layer">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE71B;" FontFamily="Segoe MDL2 Assets" FontSize="11" />
                            <TextBlock Text="Copy OBS URL" FontSize="11" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <!-- Unsaved hint — the OBS URL needs the layer saved so it has a
                         stable LayerID (the file stem). -->
                    <TextBlock
                        x:Name="LayerObsUnsavedHint"
                        FontFamily="{StaticResource MonoFont}"
                        FontSize="10"
                        Foreground="{StaticResource CoalMutedTextBrush}"
                        TextWrapping="Wrap"
                        Visibility="Collapsed"
                        Text="Save the layer to get a stable LayerID for the OBS URL." />
                </StackPanel>

                <Border
                    x:Name="LayerSectionDivider"
                    Height="1"
                    Background="{StaticResource CoalCardBrush}" />

                <!-- ── WIDGETS roster (R7) ─────────────────────────────
                     Restores the pre-WinUI left widget-tree picker: a flat list
                     of every widget in the layer so tiny / stacked / offscreen
                     widgets are always reachable (the canvas rect was otherwise
                     the ONLY selection surface). Single-click selects;
                     double-click enters that widget's editor. -->
                <StackPanel Spacing="6">
                    <TextBlock
                        Style="{StaticResource EyebrowTextStyle}"
                        Text="WIDGETS" />
                    <TextBlock
                        x:Name="WidgetRosterEmptyHint"
                        FontFamily="{StaticResource MonoFont}"
                        FontSize="10"
                        Foreground="{StaticResource CoalMutedTextBrush}"
                        TextWrapping="Wrap"
                        Text="No widgets yet — right-click the layer canvas to add one." />
                    <ListView
                        x:Name="WidgetRosterList"
                        SelectionMode="Single"
                        MaxHeight="180"
                        SelectionChanged="OnWidgetRosterSelectionChanged"
                        DoubleTapped="OnWidgetRosterDoubleTapped"
                        ToolTipService.ToolTip="Click to select · double-click to edit triggers" />
                </StackPanel>

                <Border
                    Height="1"
                    Background="{StaticResource CoalCardBrush}" />

                <!-- ── WIDGET section ─────────────────────────────────── -->
                <StackPanel Spacing="6">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Style="{StaticResource EyebrowTextStyle}"
                                   Text="WIDGET" />
                        <Button    Grid.Column="1"
                                   x:Name="DeleteWidgetButton"
                                   Content="Delete"
                                   FontSize="10"
                                   Padding="6,2"
                                   Background="Transparent"
                                   Foreground="{StaticResource ErrBrush}"
                                   BorderBrush="{StaticResource ErrBrush}"
                                   BorderThickness="1"
                                   IsEnabled="False"
                                   Click="OnDeleteWidget" />
                    </Grid>

                    <TextBlock
                        x:Name="WidgetEmptyHint"
                        FontFamily="{StaticResource MonoFont}"
                        FontSize="10"
                        Foreground="{StaticResource CoalMutedTextBrush}"
                        TextWrapping="Wrap"
                        Text="Select a widget on the layer canvas to edit its properties." />

                    <!-- Named item #2 — the WIDGET form splits into three blocks so
                         widget-editor mode (SetEditorContext) can collapse ONLY the
                         dead read-only geometry mirrors while keeping the editable
                         name + z-index. (Mirrors are stale noise while authoring a
                         node graph — edits live on the canvas pills; name + z-index
                         are real editors and stay.) -->
                    <StackPanel x:Name="WidgetForm" Spacing="6" Visibility="Collapsed">

                        <Grid RowSpacing="6" ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="64" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Style="{StaticResource MonoSmallTextStyle}"
                                       VerticalAlignment="Center"
                                       Text="name" />
                            <TextBox   Grid.Column="1"
                                       x:Name="WidgetNameBox"
                                       FontFamily="{StaticResource MonoFont}"
                                       FontSize="12"
                                       TextChanged="OnWidgetNameChanged" />
                        </Grid>

                        <!--  (P1-U1) — read-only mirrors for x / y / w / h / preset.
                             Edits live on the widget body (Canvas/WidgetView.xaml inline
                             pills) per feedback_node_ui_inline_sockets.md. NumberBox/ComboBox
                             swapped for TextBlock — IsHitTestVisible="False" so a stray
                             click on the read-only text doesn't grab focus from the canvas.
                             Named item #2 — wrapped in WidgetGeometryMirrors so widget-editor
                             mode collapses the whole block (the mirrors lag the live pill
                             edits and are pure noise while authoring a node graph). -->
                        <Grid x:Name="WidgetGeometryMirrors" RowSpacing="6" ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="64" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition />
                                <RowDefinition />
                                <RowDefinition />
                                <RowDefinition />
                                <RowDefinition />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0"
                                       Style="{StaticResource MonoSmallTextStyle}"
                                       VerticalAlignment="Center"
                                       Text="x" />
                            <TextBlock Grid.Row="0" Grid.Column="1"
                                       x:Name="WidgetXMirror"
                                       FontFamily="{StaticResource MonoFont}"
                                       FontSize="12"
                                       Foreground="{StaticResource CoalSecondaryTextBrush}"
                                       IsHitTestVisible="False"
                                       VerticalAlignment="Center" />

                            <TextBlock Grid.Row="1" Grid.Column="0"
                                       Style="{StaticResource MonoSmallTextStyle}"
                                       VerticalAlignment="Center"
                                       Text="y" />
                            <TextBlock Grid.Row="1" Grid.Column="1"
                                       x:Name="WidgetYMirror"
                                       FontFamily="{StaticResource MonoFont}"
                                       FontSize="12"
                                       Foreground="{StaticResource CoalSecondaryTextBrush}"
                                       IsHitTestVisible="False"
                                       VerticalAlignment="Center" />

                            <TextBlock Grid.Row="2" Grid.Column="0"
                                       Style="{StaticResource MonoSmallTextStyle}"
                                       VerticalAlignment="Center"
                                       Text="width" />
                            <TextBlock Grid.Row="2" Grid.Column="1"
                                       x:Name="WidgetWidthMirror"
                                       FontFamily="{StaticResource MonoFont}"
                                       FontSize="12"
                                       Foreground="{StaticResource CoalSecondaryTextBrush}"
                                       IsHitTestVisible="False"
                                       VerticalAlignment="Center" />

                            <TextBlock Grid.Row="3" Grid.Column="0"
                                       Style="{StaticResource MonoSmallTextStyle}"
                                       VerticalAlignment="Center"
                                       Text="height" />
                            <TextBlock Grid.Row="3" Grid.Column="1"
                                       x:Name="WidgetHeightMirror"
                                       FontFamily="{StaticResource MonoFont}"
                                       FontSize="12"
                                       Foreground="{StaticResource CoalSecondaryTextBrush}"
                                       IsHitTestVisible="False"
                                       VerticalAlignment="Center" />

                            <TextBlock Grid.Row="4" Grid.Column="0"
                                       Style="{StaticResource MonoSmallTextStyle}"
                                       VerticalAlignment="Center"
                                       Text="preset" />
                            <TextBlock Grid.Row="4" Grid.Column="1"
                                       x:Name="WidgetPresetMirror"
                                       FontFamily="{StaticResource MonoFont}"
                                       FontSize="12"
                                       Foreground="{StaticResource CoalSecondaryTextBrush}"
                                       IsHitTestVisible="False"
                                       VerticalAlignment="Center" />
                        </Grid>

                        <Grid RowSpacing="6" ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="64" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Style="{StaticResource MonoSmallTextStyle}"
                                       VerticalAlignment="Center"
                                       Text="z-index" />
                            <NumberBox Grid.Column="1"
                                       x:Name="WidgetZIndexBox"
                                       Minimum="0"
                                       ValueChanged="OnWidgetZIndexChanged" />
                        </Grid>

                        <!-- Per-widget dip-to-blank event transition (0–1 s).
                             0 = instant cut (legacy). When a new event swaps this
                             widget's content at runtime, compositor.js fades the old
                             content out to blank then the new content in over this
                             duration so the change reads instead of hard-cutting. -->
                        <Grid RowSpacing="6" ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="64" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Style="{StaticResource MonoSmallTextStyle}"
                                       VerticalAlignment="Center"
                                       Text="transition" />
                            <Grid Grid.Column="1" ColumnSpacing="6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="72" />
                                </Grid.ColumnDefinitions>
                                <Slider Grid.Column="0"
                                        x:Name="WidgetTransitionSlider"
                                        Minimum="0" Maximum="1"
                                        StepFrequency="0.05"
                                        ToolTipService.ToolTip="Dip-to-blank transition between events, in seconds (0 = instant cut)"
                                        ValueChanged="OnWidgetTransitionSliderChanged"
                                        VerticalAlignment="Center" />
                                <NumberBox Grid.Column="1"
                                           x:Name="WidgetTransitionBox"
                                           Minimum="0" Maximum="1"
                                           SmallChange="0.05" LargeChange="0.1"
                                           SpinButtonPlacementMode="Hidden"
                                           ValueChanged="OnWidgetTransitionBoxChanged"
                                           VerticalAlignment="Center" />
                            </Grid>
                        </Grid>
                    </StackPanel>
                </StackPanel>

                <!-- ── TRIGGERS section (named item #4 redesign) ───────────────
                     Per-widget trigger management lives here now: a list of the
                     widget's triggers (each row = name + Test / Copy / Delete) and
                     a "New Trigger" button. The raw Layer-ID / Widget-ID textboxes
                     were removed and "Copy OBS URL" moved up to the LAYER section
                     (it's layer-level). onStartup is the idle loop — it auto-fires
                     and can't be Architect-triggered, so its row hides Test / Copy /
                     Delete and shows an "auto-fires on load" hint instead.
                     Visualist-local chrome per
                     feedback_visualist_architect_chrome_independence. -->
                <Border
                    x:Name="TriggersSectionDivider"
                    Height="1"
                    Visibility="Collapsed"
                    Background="{StaticResource CoalCardBrush}" />

                <StackPanel x:Name="TriggersSection" Spacing="6" Visibility="Collapsed">
                    <TextBlock
                        Style="{StaticResource EyebrowTextStyle}"
                        Text="TRIGGERS" />

                    <!-- Per-trigger Test / Copy / Delete rows — built imperatively
                         in RefreshTriggersSection (Triggers is a plain List). -->
                    <StackPanel x:Name="TriggerRowsPanel" Spacing="3" />

                    <TextBlock
                        x:Name="TriggersEmptyHint"
                        FontFamily="{StaticResource MonoFont}"
                        FontSize="10"
                        Foreground="{StaticResource CoalMutedTextBrush}"
                        TextWrapping="Wrap"
                        Visibility="Collapsed"
                        Text="This widget has no triggers yet — use New Trigger below to add one." />

                    <!-- Named item #4 — user-initiated trigger create. Prompts for a
                         name (modal TextBox dialog); a dup/invalid name surfaces as a
                         non-modal inline warning, not a modal error. -->
                    <Button
                        x:Name="NewTriggerButton"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Left"
                        Padding="8,4"
                        FontSize="11"
                        Background="{StaticResource CoalCardBrush}"
                        BorderThickness="0"
                        Foreground="{StaticResource CoalBodyTextBrush}"
                        Click="OnCreateTrigger"
                        ToolTipService.ToolTip="Create a new trigger for this widget">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="11" />
                            <TextBlock Text="New Trigger" FontSize="11" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <!-- R60 — persistent bus-offline hint. Shown whenever the Hub
                         bus is disconnected, explaining why the Test chips are
                         greyed (non-modal per
                         feedback_no_modal_dialogs_for_repeatable_rejections). -->
                    <Border
                        x:Name="BusOfflineHint"
                        Visibility="Collapsed"
                        Background="{StaticResource CoalRaisedBrush}"
                        BorderBrush="{StaticResource CoalCardBrush}"
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="8,5">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Ellipse Width="8" Height="8" VerticalAlignment="Center"
                                     Fill="{StaticResource ErrBrush}" />
                            <TextBlock
                                FontSize="10"
                                TextWrapping="Wrap"
                                Foreground="{StaticResource CoalSecondaryTextBrush}"
                                Text="Hub bus offline — Test Run is disabled. Launch Hub to run triggers live." />
                        </StackPanel>
                    </Border>

                    <!-- Transient copy/test confirmation — cleared after ~2.5s. -->
                    <TextBlock
                        x:Name="TriggerActionFeedback"
                        FontSize="10"
                        FontFamily="{StaticResource MonoFont}"
                        Foreground="{StaticResource OkBrush}"
                        Visibility="Collapsed" />
                </StackPanel>

                <!-- ── NODE section (Track A — typed per-node inspector) ───────
                     Fusion-style: select a node in the widget graph and this
                     section renders that node's editable parameters as proper
                     controls (Scalar→slider+numbox, Color→picker, Bool→toggle,
                     String→textbox, Enum→dropdown, VectorN→N slider+numbox pairs,
                     MediaPath→Browse…). The node-body inline pills stay TEXT-ENTRY
                     only — the rich controls live ONLY here (per the locked user
                     requirement). Each animatable row carries a DaVinci-style
                     ◀ ◇/◆ ▶ keyframe cluster (add/remove at playhead, prev/next, ease).

                     The param rows are built imperatively in RefreshNodeForm
                     (mirrors RefreshTriggersSection) rather than via an
                     ItemsControl + DataTemplateSelector: NodeParamVm.VectorValues
                     is a double[] and WinUI two-way Binding can't bind array
                     elements, and the ColorPicker flyout + Browse… file picker
                     need code-behind glue. Imperative rows keep the NodeParamVm
                     contract byte-identical (read/write its props, invoke its
                     command) without fragile array/flyout XAML. Visible only when
                     _vm.SelectedNode != null. Visualist-local chrome per
                     feedback_visualist_architect_chrome_independence. -->
                <Border
                    x:Name="NodeSectionDivider"
                    Height="1"
                    Visibility="Collapsed"
                    Background="{StaticResource CoalCardBrush}" />

                <StackPanel x:Name="NodeSection" Spacing="6" Visibility="Collapsed">
                    <TextBlock
                        Style="{StaticResource EyebrowTextStyle}"
                        Text="NODE" />

                    <!-- Header — node Title + short description (template hint). -->
                    <StackPanel Spacing="1">
                        <TextBlock
                            x:Name="NodeTitleText"
                            FontFamily="{StaticResource MonoFont}"
                            FontSize="12"
                            Foreground="{StaticResource AccentValueBrush}"
                            TextTrimming="CharacterEllipsis" />
                        <TextBlock
                            x:Name="NodeDescriptionText"
                            FontFamily="{StaticResource MonoFont}"
                            FontSize="10"
                            Foreground="{StaticResource CoalMutedTextBrush}"
                            TextWrapping="Wrap" />
                    </StackPanel>

                    <!-- No-params hint — a node with no editable attributes
                         (pure flow / sink) still selects, so explain the empty
                         body rather than rendering a blank section. -->
                    <TextBlock
                        x:Name="NodeNoParamsHint"
                        FontFamily="{StaticResource MonoFont}"
                        FontSize="10"
                        Foreground="{StaticResource CoalMutedTextBrush}"
                        TextWrapping="Wrap"
                        Visibility="Collapsed"
                        Text="This node has no editable parameters." />

                    <!-- Per-parameter rows, built imperatively in RefreshNodeForm. -->
                    <StackPanel x:Name="NodeParamsPanel" Spacing="8" />
                </StackPanel>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
