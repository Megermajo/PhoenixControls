<?xml version="1.0" encoding="utf-8" ?>
<!--
    Visualist canvas hotkey cheatsheet overlay — sibling of the Architect
    analogue at Phoenix.Controls.Architect.WinUI/Canvas/HotkeyCheatsheet.xaml.
    Per feedback_visualist_architect_chrome_independence.md the two are
    deliberately separate copies, not a shared control — paint and chrome
    code never lifts to Phoenix.Controls.Shared.UI.

    Anchored bottom-left of the canvas's outer Grid (parent UserControl
    decides which row it sits on); flows into VisualistSiblingWindow and
    any future pop-out hosts via XAML inheritance.

    Visual: chip header (always visible) + collapsible body (toggled by
    the chip's "—/+" button). Open/closed state persists across restarts
    via AppConfig.VisualistHotkeyCheatsheetExpanded.
-->
<UserControl
    x:Class="Phoenix.Controls.Visualist.WinUI.Canvas.HotkeyCheatsheet"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    HorizontalAlignment="Left"
    VerticalAlignment="Bottom"
    Margin="12,0,0,12"
    IsTabStop="False">

    <UserControl.Resources>
        <Style x:Key="CheatsheetEyebrow" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
            <Setter Property="FontSize" Value="9" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="CharacterSpacing" Value="220" />
            <Setter Property="Foreground" Value="{StaticResource EmberPrimaryBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="CheatsheetContextLabel" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource SansFont}" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="CharacterSpacing" Value="120" />
            <Setter Property="Foreground" Value="{StaticResource CoalSecondaryTextBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="CheatsheetCombo" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{StaticResource CoalPaperBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextWrapping" Value="NoWrap" />
        </Style>

        <Style x:Key="CheatsheetDescription" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource SansFont}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{StaticResource CoalBodyTextBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextWrapping" Value="NoWrap" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <Style x:Key="CheatsheetToggleButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="6,2,6,2" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Foreground" Value="{StaticResource CoalSecondaryTextBrush}" />
            <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
            <Setter Property="FontSize" Value="11" />
        </Style>
    </UserControl.Resources>

    <Border x:Name="OuterBorder"
            Background="{StaticResource CoalSurfaceBrush}"
            BorderBrush="{StaticResource CoalCardBrush}"
            BorderThickness="1"
            CornerRadius="6"
            Padding="0"
            MinWidth="0">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border x:Name="HeaderStrip"
                    Grid.Row="0"
                    Background="Transparent"
                    Padding="10,5,4,5"
                    PointerEntered="OnHeaderPointerEntered"
                    PointerExited="OnHeaderPointerExited"
                    Tapped="OnHeaderTapped">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0"
                                Orientation="Horizontal"
                                Spacing="8"
                                VerticalAlignment="Center">
                        <TextBlock Text="HOTKEYS"
                                   Style="{StaticResource CheatsheetEyebrow}" />
                        <TextBlock x:Name="ContextLabel"
                                   Text="LAYER CANVAS"
                                   Style="{StaticResource CheatsheetContextLabel}" />
                    </StackPanel>

                    <Button x:Name="ToggleButton"
                            Grid.Column="2"
                            Style="{StaticResource CheatsheetToggleButton}"
                            Content="—"
                            AutomationProperties.Name="Collapse hotkey cheatsheet"
                            ToolTipService.ToolTip="Collapse"
                            Click="OnToggleClicked" />
                </Grid>
            </Border>

            <Rectangle x:Name="BodyHairline"
                       Grid.Row="1"
                       Height="1"
                       Fill="{StaticResource BrassGradientBrush}"
                       Visibility="Visible" />

            <Border x:Name="BodyBorder"
                    Grid.Row="2"
                    Padding="10,8,10,10"
                    Visibility="Visible">
                <Grid x:Name="EntryGrid">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" MinWidth="110" />
                        <ColumnDefinition Width="Auto" MinWidth="180" />
                    </Grid.ColumnDefinitions>
                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>
