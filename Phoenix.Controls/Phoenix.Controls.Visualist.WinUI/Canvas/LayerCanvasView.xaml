<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Phoenix.Controls.Visualist.WinUI.Canvas.LayerCanvasView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Phoenix.Controls.Visualist.WinUI.Canvas"
    xmlns:controls="using:Phoenix.Controls.Visualist.WinUI.Controls"
    xmlns:loc="using:Phoenix.Controls.Visualist.WinUI.Localization">

    <Grid Background="{StaticResource CoalShellBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /> <!-- R23 command bar -->
            <RowDefinition Height="*" />    <!-- stage + overlays -->
        </Grid.RowDefinitions>

        <!-- ── R22/R23/R24 — Layer Canvas command bar ─────────────────────
             Restores the pre-WinUI authoring affordances that were menu /
             right-click-only after the rework: Add Widget + the shared
             Preview-Layer popout, the Canvas-Preview toggle, the preview
             backdrop swatches, and the Auto-Sync-on-edit toggle (all
             config-wired with no UI before this). Per-pillar chrome. -->
        <Border
            Grid.Row="0"
            Background="{StaticResource CoalSurfaceBrush}"
            BorderBrush="{StaticResource CoalDividerBrush}"
            BorderThickness="0,0,0,1"
            Padding="8,5">
            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <Button x:Name="AddWidgetButton"
                        Click="OnAddWidgetCommand"
                        ToolTipService.ToolTip="Add a widget to this layer"
                        loc:Localize.TooltipKey="visualist.canvas.toolbar.add_widget.tip"
                        Padding="10,4"
                        Background="{StaticResource CoalCardBrush}"
                        BorderThickness="0"
                        Foreground="{StaticResource CoalBodyTextBrush}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="11" />
                        <TextBlock Text="Add Widget" FontSize="12" VerticalAlignment="Center"
                                   loc:Localize.Key="visualist.canvas.context.add_widget" />
                    </StackPanel>
                </Button>

                <Button x:Name="PreviewLayerButton"
                        Click="OnPreviewLayerCommand"
                        ToolTipService.ToolTip="Open a popout preview of the whole layer"
                        loc:Localize.TooltipKey="visualist.canvas.toolbar.preview_layer.tip"
                        Padding="10,4"
                        Background="{StaticResource CoalCardBrush}"
                        BorderThickness="0"
                        Foreground="{StaticResource CoalBodyTextBrush}"
                        Content="Preview Layer"
                        loc:Localize.Key="visualist.canvas.toolbar.preview_layer" />

                <Border Width="1" Margin="4,2" Background="{StaticResource CoalDividerBrush}" />

                <!-- The "Preview" canvas-thumbnail ToggleButton was removed here as an
                     abandoned affordance. Its setting (VisualistUserConfig
                     .CanvasWidgetPreviewEnabled, default true) and the WidgetCanvasPreviewer
                     gate it drives are deliberately KEPT, so on-canvas widget thumbnails
                     behave exactly as before — only the control is gone. "Preview Layer"
                     above is the preview DISPLAY, and opening it is what now activates the
                     layer for design-time Test Runs (see LayerRegistry.IsLayerActive). -->

                <!-- Backdrop swatches — Transparent / Black / Gray / White. -->
                <TextBlock Text="BG" VerticalAlignment="Center" FontSize="10"
                           Foreground="{StaticResource CoalSecondaryTextBrush}"
                           loc:Localize.Key="visualist.canvas.toolbar.backdrop.label" />
                <StackPanel x:Name="BackdropSwatches" Orientation="Horizontal" Spacing="3" VerticalAlignment="Center" />

                <Border Width="1" Margin="4,2" Background="{StaticResource CoalDividerBrush}" />

                <ToggleButton x:Name="AutoSyncToggle"
                              Click="OnAutoSyncToggle"
                              ToolTipService.ToolTip="Auto-save on edit so OBS / previews refresh live (saved layers only)"
                              loc:Localize.TooltipKey="visualist.canvas.toolbar.autosync.tip"
                              Padding="10,4" MinWidth="0"
                              Content="Auto-Sync"
                              loc:Localize.Key="visualist.canvas.toolbar.autosync" />

                <Border Width="1" Margin="4,2" Background="{StaticResource CoalDividerBrush}" />

                <!-- P3 — snap-to-grid toggle. Before this the snap state was
                     in-memory only with no UI badge, so the user had no way to
                     see or change it (only the Alt-held momentary suppression).
                     Checked = grid + alignment snap on (the default). -->
                <ToggleButton x:Name="SnapToggle"
                              Click="OnSnapToggle"
                              ToolTipService.ToolTip="Snap widgets to the 8px grid and alignment guides while dragging / resizing (hold Alt to suppress momentarily)"
                              loc:Localize.TooltipKey="visualist.canvas.toolbar.snap.tip"
                              Padding="10,4" MinWidth="0">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xF0E2;" FontFamily="Segoe MDL2 Assets" FontSize="11" />
                        <TextBlock Text="Snap" FontSize="12" VerticalAlignment="Center"
                                   loc:Localize.Key="visualist.canvas.toolbar.snap" />
                    </StackPanel>
                </ToggleButton>

                <Border Width="1" Margin="4,2" Background="{StaticResource CoalDividerBrush}" />

                <!-- Zoom cluster — zoom-out / Fit / zoom-in / 1:1. Overscan: zoom
                     out to float the frame in pasteboard space so off-frame
                     content and scaling are visible while composing (DaVinci
                     viewer). Readout shows "Fit" at the uniform fit, else the
                     effective on-screen %. -->
                <Button x:Name="ZoomOutButton" Click="OnZoomOutCommand"
                        ToolTipService.ToolTip="Zoom out (float the frame in pasteboard — see beyond the edge)"
                        loc:Localize.TooltipKey="visualist.canvas.toolbar.zoom_out.tip"
                        Padding="9,4" MinWidth="0" BorderThickness="0"
                        Background="{StaticResource CoalCardBrush}"
                        Foreground="{StaticResource CoalBodyTextBrush}">
                    <FontIcon Glyph="&#xE71F;" FontFamily="Segoe MDL2 Assets" FontSize="11" />
                </Button>
                <Button x:Name="ZoomFitButton" Click="OnZoomFitCommand"
                        ToolTipService.ToolTip="Fit the frame to the view"
                        loc:Localize.TooltipKey="visualist.canvas.toolbar.zoom_fit.tip"
                        Padding="6,4" MinWidth="52" BorderThickness="0"
                        Background="{StaticResource CoalCardBrush}"
                        Foreground="{StaticResource CoalBodyTextBrush}">
                    <TextBlock x:Name="ZoomReadout" Text="Fit" FontSize="12"
                               TextAlignment="Center" VerticalAlignment="Center" />
                </Button>
                <Button x:Name="ZoomInButton" Click="OnZoomInCommand"
                        ToolTipService.ToolTip="Zoom in"
                        loc:Localize.TooltipKey="visualist.canvas.toolbar.zoom_in.tip"
                        Padding="9,4" MinWidth="0" BorderThickness="0"
                        Background="{StaticResource CoalCardBrush}"
                        Foreground="{StaticResource CoalBodyTextBrush}">
                    <FontIcon Glyph="&#xE8A3;" FontFamily="Segoe MDL2 Assets" FontSize="11" />
                </Button>
                <Button x:Name="Zoom100Button" Click="OnZoom100Command"
                        ToolTipService.ToolTip="Actual size (1:1 pixels)"
                        loc:Localize.TooltipKey="visualist.canvas.toolbar.zoom_100.tip"
                        Padding="9,4" MinWidth="0" BorderThickness="0"
                        Background="{StaticResource CoalCardBrush}"
                        Foreground="{StaticResource CoalBodyTextBrush}"
                        Content="1:1" />

                <Border Width="1" Margin="4,2" Background="{StaticResource CoalDividerBrush}" />

                <ToggleButton x:Name="GuidesToggle" Click="OnGuidesToggle"
                              ToolTipService.ToolTip="Show composition guides — rule-of-thirds, centre, title/action-safe"
                              loc:Localize.TooltipKey="visualist.canvas.toolbar.guides.tip"
                              Padding="10,4" MinWidth="0" Content="Guides"
                              loc:Localize.Key="visualist.canvas.toolbar.guides" />
            </StackPanel>
        </Border>

        <Grid Grid.Row="1" x:Name="StageHost" Background="Transparent">
            <!-- Hex-pattern pasteboard backdrop (the "Hex" preview-background variant).
                 Fills the whole stage host BEHIND the layer; the opaque layer rect
                 (StageFrame, inside the Viewbox) sits on top, so the hex shows only
                 around the layer = "hex outside, flat inside", visually framing the
                 layer bounds. IsHitTestVisible=False (set on the control) so canvas
                 pan/zoom/marquee keep firing through it. Collapsed unless Hex is the
                 selected backdrop; toggled in ApplyCanvasBackdrop. -->
            <controls:HexPatternOverlay x:Name="HexBackdrop"
                                        HexRadius="26"
                                        Visibility="Collapsed" />

            <!-- Stage: aspect-ratio-locked via Viewbox(Uniform) wrapping a fixed-size Canvas.
                 P3 — zoom/pan restore. A ScaleTransform + TranslateTransform on the
                 Viewbox layers user zoom/pan ON TOP of the Viewbox's uniform fit, so
                 the aspect-lock stays intact and (critically) all the canvas pointer
                 math is untouched: GetPosition(WidgetSurface) accounts for ancestor
                 RenderTransforms automatically, so drag / lasso / resize keep working
                 in canvas space without inverse-transform code. Ctrl+wheel zooms about
                 the cursor; middle-mouse drag pans. The StageHost grid
                 carries Background="Transparent" so wheel / middle-button events fire
                 in the empty letterbox region around the stage too. -->
            <Viewbox
                x:Name="StageViewbox"
                Stretch="Uniform"
                StretchDirection="Both"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Margin="40"
                RenderTransformOrigin="0,0">
                <Viewbox.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform x:Name="StageScale" ScaleX="1" ScaleY="1" />
                        <TranslateTransform x:Name="StagePan" X="0" Y="0" />
                    </TransformGroup>
                </Viewbox.RenderTransform>
                <Border
                    x:Name="StageFrame"
                    BorderBrush="{StaticResource CoalDividerBrush}"
                    BorderThickness="1"
                    Background="{StaticResource CoalOverlay50Brush}">
                    <Grid>
                        <!-- Background="Transparent" is load-bearing, not cosmetic: a
                             null-Background Canvas is NOT hit-test-visible in its empty
                             regions, so every empty-canvas gesture (right-click → Add
                             Widget, click-to-deselect, marquee/lasso select) silently
                             died after the WinForms→WinUI rework. Transparent keeps the
                             surface invisible while restoring hit-testing; widget views
                             paint on top unaffected. -->
                        <Canvas
                            x:Name="WidgetSurface"
                            Width="1920"
                            Height="1080"
                            Background="Transparent" />

                        <!-- Composition guides — rule-of-thirds + centre cross +
                             broadcast title-safe (80%) / action-safe (90%) rects, in
                             the fixed 1920×1080 frame space so they scale with the
                             Viewbox. IsHitTestVisible=False = click-through (never
                             steals a widget gesture). Toggled by the command-bar
                             "Guides" button. Helps judge cut-outs + scaling. -->
                        <Canvas x:Name="GuideOverlay"
                                Width="1920" Height="1080"
                                IsHitTestVisible="False"
                                Visibility="Collapsed"
                                Opacity="0.35">
                            <Rectangle Canvas.Left="96" Canvas.Top="54" Width="1728" Height="972"
                                       Stroke="{StaticResource CoalPrimaryTextBrush}" StrokeThickness="2" StrokeDashArray="6,6" />
                            <Rectangle Canvas.Left="192" Canvas.Top="108" Width="1536" Height="864"
                                       Stroke="{StaticResource CoalPrimaryTextBrush}" StrokeThickness="2" StrokeDashArray="6,6" />
                            <Line X1="640" Y1="0" X2="640" Y2="1080" Stroke="{StaticResource CoalPrimaryTextBrush}" StrokeThickness="1" />
                            <Line X1="1280" Y1="0" X2="1280" Y2="1080" Stroke="{StaticResource CoalPrimaryTextBrush}" StrokeThickness="1" />
                            <Line X1="0" Y1="360" X2="1920" Y2="360" Stroke="{StaticResource CoalPrimaryTextBrush}" StrokeThickness="1" />
                            <Line X1="0" Y1="720" X2="1920" Y2="720" Stroke="{StaticResource CoalPrimaryTextBrush}" StrokeThickness="1" />
                            <Line X1="936" Y1="540" X2="984" Y2="540" Stroke="{StaticResource CoalPrimaryTextBrush}" StrokeThickness="2" />
                            <Line X1="960" Y1="516" X2="960" Y2="564" Stroke="{StaticResource CoalPrimaryTextBrush}" StrokeThickness="2" />
                        </Canvas>
                    </Grid>
                </Border>
            </Viewbox>

            <!-- Resolution badge — top-left corner of the visible canvas region. -->
            <Border
                x:Name="ResolutionBadge"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Margin="40,18,0,0">
                <TextBlock
                    x:Name="ResolutionLabel"
                    Style="{StaticResource MonoSmallTextStyle}"
                    Text="(no layer loaded)" />
            </Border>

            <!-- R47 — empty-state overlay. Shown when no layer is loaded, so a
                 fresh Visualist session offers New / Open instead of a blank
                 stage. Toggled from Render(). -->
            <Grid x:Name="EmptyStateOverlay"
                  Visibility="Collapsed"
                  Background="{StaticResource CoalShellBrush}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                            Spacing="12" MaxWidth="420">
                    <TextBlock Text="No layer open"
                               HorizontalAlignment="Center"
                               FontSize="16"
                               Foreground="{StaticResource CoalBodyTextBrush}"
                               loc:Localize.Key="visualist.canvas.empty.title" />
                    <TextBlock Text="Create a new .phxlayer or open an existing one to start compositing widgets for an OBS browser source."
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               FontSize="12"
                               Foreground="{StaticResource CoalSecondaryTextBrush}"
                               loc:Localize.Key="visualist.canvas.empty.body" />
                    <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center">
                        <Button x:Name="EmptyNewButton"
                                Click="OnEmptyNewLayer"
                                Padding="14,6"
                                Content="New Layer"
                                loc:Localize.Key="visualist.rail.new_layer" />
                        <Button x:Name="EmptyOpenButton"
                                Click="OnEmptyOpenLayer"
                                Padding="14,6"
                                Content="Open Layer…"
                                loc:Localize.Key="visualist.canvas.empty.open" />
                    </StackPanel>
                </StackPanel>
            </Grid>

            <!-- Context-aware hotkey cheatsheet — anchored bottom-left of the
                 layer canvas. Sibling of the WidgetGraphCanvas instance so the
                 two stay visually consistent across the surfaces a Visualist
                 user switches between. Open/closed state persists via
                 AppConfig.VisualistHotkeyCheatsheetExpanded. -->
            <local:HotkeyCheatsheet x:Name="HotkeyCheatsheetOverlay"
                                    x:FieldModifier="public" />
        </Grid>
    </Grid>
</UserControl>
