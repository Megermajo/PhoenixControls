<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Phoenix.Controls.Visualist.WinUI.MainView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Phoenix.Controls.Visualist.WinUI.Controls"
    xmlns:canvas="using:Phoenix.Controls.Visualist.WinUI.Canvas"
    xmlns:loc="using:Phoenix.Controls.Visualist.WinUI.Localization">

    <!-- Sprint E — pillar-local focus-visual implicit Styles. Merged here
         (rather than in Hub.WinUI's App.xaml) so Visualist's overrides
         win for its own subtree and the file stays Visualist-owned per
         feedback_visualist_architect_chrome_independence.md. -->
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ms-appx:///Phoenix.Controls.Visualist.WinUI/Themes/FocusVisuals.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <!-- R54 — Ctrl+N / Ctrl+O accelerators for the embedded Visualist File menu
         commands (New Layer / Open Layer). Fire when focus is anywhere in the
         Visualist pillar subtree. -->
    <UserControl.KeyboardAccelerators>
        <KeyboardAccelerator Modifiers="Control" Key="N" Invoked="OnNewLayerAccelerator" />
        <KeyboardAccelerator Modifiers="Control" Key="O" Invoked="OnOpenLayerAccelerator" />
    </UserControl.KeyboardAccelerators>

    <!-- Single-HUB collapse: Hub.MainWindow embeds this view inside its
         MainPaneRegion and owns the only visible chrome. There is no
         pillar-local chrome control — the public action methods on this
         MainView (NewLayer, OpenLayerDialog, …) are the entry points,
         dispatched from Hub's Visualist menu via OnMenuItemInvoked. -->
    <Grid Background="{StaticResource CoalShellBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="24" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="LayerRailColumn" Width="200" />
                <ColumnDefinition x:Name="RailSplitterColumn" Width="Auto" />
                <!-- Centre canvas. MinWidth is the XAML floor; because a WinUI star
                     column honours MinWidth only until two fixed siblings both grow
                     greedily, the splitter drag handlers ALSO cap each side column
                     (RailMaxRoomForCenter / InspectorMaxRoomForCenter) so the rail +
                     inspector dragged wide can never starve the centre below
                     CenterMinWidth on a narrow Hub window (T11-9). -->
                <ColumnDefinition Width="*" MinWidth="360" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition x:Name="InspectorColumn" Width="280" />
            </Grid.ColumnDefinitions>

            <controls:LayerRail
                x:Name="LayerRailControl"
                Grid.Column="0"
                DataContext="{x:Bind ViewModel}" />

            <!-- Draggable divider: rail | editing area. Hand-rolled — WinUI 3 has
                 no built-in GridSplitter and we avoid a CommunityToolkit dependency
                 per the per-pillar rule. Widens/narrows the rail; drag logic +
                 resize cursor in code-behind. Width persists to
                 VisualistUserConfig.RailWidth (restored in the ctor).
                 T11-9 — grabber-pill idiom (transparent strip + centred pill),
                 unified with the timeline N/S handle; the pill brightens to ember
                 on hover/drag (SetSplitterPill). Transparent strip stays
                 hit-testable and shows the shell behind it as a thin recessed seam. -->
            <Border x:Name="RailSplitter"
                    Grid.Column="1"
                    Width="6"
                    Background="Transparent"
                    Padding="0"
                    PointerEntered="OnSplitterPointerEntered"
                    PointerExited="OnSplitterPointerExited"
                    PointerPressed="OnRailSplitterPressed"
                    PointerMoved="OnRailSplitterMoved"
                    PointerReleased="OnRailSplitterReleased"
                    PointerCaptureLost="OnRailSplitterReleased"
                    PointerCanceled="OnRailSplitterReleased">
                <Border Width="2" Height="46" CornerRadius="1"
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        IsHitTestVisible="False"
                        Background="{StaticResource CoalDividerBrush}" />
            </Border>

            <!-- Mode switching flows through SelectSubTab (View menu, ← Back,
                 double-click-to-enter). No shell tab bar (removed 2026-06-08 and
                 confirmed 2026-07-20: one canvas holds dozens of widgets, so a
                 per-widget "Fusion tab" maps to nothing single). -->
            <ContentControl
                x:Name="MainPaneRegion"
                Grid.Column="2"
                HorizontalContentAlignment="Stretch"
                VerticalContentAlignment="Stretch" />

            <!-- Draggable divider: editing area | inspector. Same T11-9 grabber-pill
                 idiom as RailSplitter / the timeline handle. -->
            <Border x:Name="InspectorSplitter"
                    Grid.Column="3"
                    Width="6"
                    Background="Transparent"
                    Padding="0"
                    PointerEntered="OnSplitterPointerEntered"
                    PointerExited="OnSplitterPointerExited"
                    PointerPressed="OnInspectorSplitterPressed"
                    PointerMoved="OnInspectorSplitterMoved"
                    PointerReleased="OnInspectorSplitterReleased"
                    PointerCaptureLost="OnInspectorSplitterReleased"
                    PointerCanceled="OnInspectorSplitterReleased">
                <Border Width="2" Height="46" CornerRadius="1"
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        IsHitTestVisible="False"
                        Background="{StaticResource CoalDividerBrush}" />
            </Border>

            <controls:InspectorPanel
                x:Name="InspectorPanelControl"
                Grid.Column="4"
                DataContext="{x:Bind ViewModel}" />
        </Grid>

        <!-- Status bar — 3-zone 24px strip. Visual language mirrors Architect's
             status strip (Architect.WinUI/MainView.xaml:232-302); paint code is
             duplicated locally per feedback_visualist_architect_chrome_independence.md
             (no Shared/UI/). RefreshStatusBar in code-behind drives all three zones. -->
        <Border Grid.Row="1"
                Background="{StaticResource CoalRaisedBrush}"
                BorderBrush="{StaticResource CoalCardBrush}"
                BorderThickness="0,1,0,0"
                AutomationProperties.Name="Status Strip"
                loc:Localize.AutomationKey="visualist.main.status_strip.a11y">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Left zone: traffic-light dot + save status text -->
                <StackPanel Grid.Column="0" Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="10,0,0,0" Spacing="6">
                    <Ellipse x:Name="StatusLight"
                             Width="10" Height="10"
                             Fill="{StaticResource CoalDividerBrush}"
                             Stroke="{StaticResource CoalCardBrush}"
                             StrokeThickness="1"
                             VerticalAlignment="Center" />
                    <TextBlock x:Name="StatusLeft"
                               VerticalAlignment="Center"
                               FontFamily="{StaticResource MonoFont}"
                               FontSize="11"
                               Foreground="{StaticResource CoalPrimaryTextBrush}" />
                </StackPanel>

                <!-- Center zone: active layer filename. R59 — trim long names
                     with an ellipsis (full name on hover, set in RefreshStatusBar). -->
                <TextBlock Grid.Column="1"
                           x:Name="StatusCenter"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           MaxWidth="320"
                           TextTrimming="CharacterEllipsis"
                           FontFamily="{StaticResource MonoFont}"
                           FontSize="11"
                           Foreground="{StaticResource CoalSecondaryTextBrush}" />

                <!-- Right zone: widget count -->
                <StackPanel Grid.Column="2" Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Margin="0,0,12,0" Spacing="10">
                    <TextBlock x:Name="StatusRight"
                               VerticalAlignment="Center"
                               FontFamily="{StaticResource MonoFont}"
                               FontSize="11"
                               Foreground="{StaticResource CoalSecondaryTextBrush}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
