<?xml version="1.0" encoding="utf-8"?>
<!--
    Top tab strip — Logic Canvas | Databank Browser.

    Active-tab style per Track 5 spec: CoalRaisedBrush background + EmberDeepBrush
    1px top inset. Mirrors architect.jsx top-tab strip (28px tall).
-->
<UserControl
    x:Class="Phoenix.Controls.Architect.WinUI.Controls.TopTabBar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="using:Phoenix.Controls.Architect.WinUI.Localization">

    <Border Height="28"
            Background="{StaticResource CoalSurfaceBrush}"
            BorderBrush="{StaticResource CoalCardBrush}"
            BorderThickness="0,0,0,1">
        <StackPanel Orientation="Horizontal"
                    Margin="8,0,0,0"
                    VerticalAlignment="Bottom"
                    Spacing="2">
            <Border x:Name="LogicTab"
                    Tapped="OnLogicTapped"
                    Height="24"
                    Padding="14,0,14,0"
                    CornerRadius="3,3,0,0"
                    AutomationProperties.Name="Logic Canvas tab"
                    loc:Localize.AutomationKey="chrome.architect.tab.logic.a11y">
                <TextBlock x:Name="LogicLabel"
                           Text="Logic Canvas"
                           loc:Localize.Key="chrome.architect.tab.logic"
                           VerticalAlignment="Center"
                           FontFamily="{StaticResource DisplayFont}"
                           FontSize="12"
                           CharacterSpacing="60" />
            </Border>

            <Border x:Name="DatabankTab"
                    Tapped="OnDatabankTapped"
                    Height="24"
                    Padding="14,0,14,0"
                    CornerRadius="3,3,0,0"
                    AutomationProperties.Name="Databank Browser tab"
                    loc:Localize.AutomationKey="chrome.architect.tab.databank.a11y">
                <TextBlock x:Name="DatabankLabel"
                           Text="Databank Browser"
                           loc:Localize.Key="chrome.architect.tab.databank"
                           VerticalAlignment="Center"
                           FontFamily="{StaticResource DisplayFont}"
                           FontSize="12"
                           CharacterSpacing="60" />
            </Border>
        </StackPanel>
    </Border>
</UserControl>
