<?xml version="1.0" encoding="utf-8"?>
<!--
    Architect chrome — three-band custom title bar.

    Layout per redesign-plan/design/project/chrome.jsx + tokens.css:
      Band 1: 3px brass hairline (BrassGradientBrush).
      Band 2: 30px main bar — phoenix mark + wordmark + File/Edit/View/Help menus
              + drag region + filename slot. System min/max/close render in the
              right gutter (via Window.ExtendsContentIntoTitleBar) — we leave
              ~138px reserved for them.
      Band 3: 34px pillar tab strip — HUB / ARCHITECT (active) / VISUALIST.
              Clicks on inactive pillars raise LaunchPillarRequested; Hub's
              MainWindow swaps the embedded pillar view in-process (no
              LauncherService post-T15).

    Per feedback_visualist_architect_chrome_independence.md this UserControl
    is intentionally separate from Hub/Visualist chrome. Stylistic similarity
    today is fine — the duplication preserves freedom to diverge.
-->
<UserControl
    x:Class="Phoenix.Controls.Architect.WinUI.Controls.ArchitectChrome"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <!-- Implicit menu-chrome styles — scoped to ArchitectChrome's
             subtree so Architect's MenuBar picks up SansFont 12 px /
             coal-raised 4 px-radius flyouts. Mirrors HubChrome.xaml's
             equivalent block; the per-pillar duplication is intentional
             per feedback_visualist_architect_chrome_independence.md
             (paint code stays per-pillar, even when each pillar consumes
             the same shared theme dictionary token). -->
        <Style TargetType="MenuFlyoutPresenter" BasedOn="{StaticResource ChromeMenuFlyoutPresenterStyle}" />
        <Style TargetType="MenuBarItem" BasedOn="{StaticResource ChromeMenuBarItemStyle}" />
        <Style TargetType="MenuFlyoutItem" BasedOn="{StaticResource ChromeMenuFlyoutItemStyle}" />
        <Style TargetType="ToggleMenuFlyoutItem" BasedOn="{StaticResource ChromeToggleMenuFlyoutItemStyle}" />

        <!-- Inactive pillar tab -->
        <Style x:Key="PillarTabStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="10,0,14,0" />
            <Setter Property="Height" Value="30" />
            <Setter Property="VerticalAlignment" Value="Bottom" />
            <Setter Property="Foreground" Value="{StaticResource CoalSecondaryTextBrush}" />
            <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="CharacterSpacing" Value="80" />
            <Setter Property="CornerRadius" Value="4,4,0,0" />
            <Setter Property="UseSystemFocusVisuals" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="Root"
                              Background="{TemplateBinding Background}"
                              CornerRadius="{TemplateBinding CornerRadius}">
                            <ContentPresenter
                                Content="{TemplateBinding Content}"
                                Padding="{TemplateBinding Padding}"
                                HorizontalContentAlignment="Left"
                                VerticalContentAlignment="Center" />
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal" />
                                    <VisualState x:Name="PointerOver">
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Root" Storyboard.TargetProperty="Background">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource CoalHoverBrush}" />
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Root" Storyboard.TargetProperty="Background">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource CoalDividerBrush}" />
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Active pillar tab — CoalCardBrush bg, EmberDeep 1px frame on
             top/left/right (no bottom edge so it bleeds into the canvas).
             Built by re-templating Border (not Button) since the active tab
             is non-clickable. -->
        <Style x:Key="ActivePillarTabStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CoalCardBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource EmberDeepBrush}" />
            <Setter Property="BorderThickness" Value="1,1,1,0" />
            <Setter Property="Padding" Value="10,0,14,0" />
            <Setter Property="Height" Value="30" />
            <Setter Property="VerticalAlignment" Value="Bottom" />
            <Setter Property="CornerRadius" Value="4,4,0,0" />
        </Style>

        <Style x:Key="PillarLabelStyle" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="CharacterSpacing" Value="80" />
        </Style>
    </UserControl.Resources>

    <!--
        0.10.0 (arch-ux-state #12) — MinWidth=720 floors the chrome so the
        Hub host (and any sibling Architect window) refuses to shrink the
        title-bar band below 720 DIPs. Paired with WindowMinSize's WM_GETMINMAXINFO
        subclass on the AppWindow so user-drag-resize is also floored at
        720×400. Below 720 the menus + filename slot start eclipsing each
        other; 400 vertical keeps the rail + inspector + canvas all visible.
    -->
    <Grid MinWidth="720">
        <Grid.RowDefinitions>
            <RowDefinition Height="3" />
            <RowDefinition Height="30" />
            <RowDefinition Height="34" />
        </Grid.RowDefinitions>

        <!-- Band 1: brass hairline -->
        <Rectangle Grid.Row="0" Fill="{StaticResource BrassGradientBrush}" />

        <!-- Band 2: main bar -->
        <Border Grid.Row="1"
                Background="{StaticResource CoalRaisedBrush}"
                BorderBrush="{StaticResource CoalCardBrush}"
                BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="138" />
                </Grid.ColumnDefinitions>

                <!-- Phoenix mark + wordmark -->
                <StackPanel Grid.Column="0"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="10,0,0,0"
                            Spacing="8">
                    <Image Source="ms-appx:///Assets/phoenix-mark.png"
                           Width="16" Height="16"
                           VerticalAlignment="Center" />
                    <TextBlock VerticalAlignment="Center"
                               FontSize="13"
                               CharacterSpacing="180"
                               FontFamily="{StaticResource DisplayFont}">
                        <Run Text="PHOENIX " Foreground="{StaticResource Ember200Brush}" />
                        <Run Text="CONTROLS" Foreground="{StaticResource CoalBodyTextBrush}" />
                    </TextBlock>
                    <Rectangle Width="1" Height="14"
                               Fill="{StaticResource CoalHoverBrush}"
                               Margin="6,0,2,0"
                               VerticalAlignment="Center" />
                </StackPanel>

                <!-- Architect-specific menus (chrome.jsx:APP_MENUS["architect"]).
                     x:Name on every MenuBarItem / MenuFlyoutItem so LocalizeMenu()
                     in the code-behind can route each one through Localizer.T(...)
                     after InitializeComponent. Per
                     feedback_visualist_architect_chrome_independence.md the
                     localization plumbing is duplicated per pillar — Visualist's
                     chrome owns its own copy. -->
                <MenuBar x:Name="ChromeMenuBar"
                         Grid.Column="1"
                         Background="Transparent"
                         MaxWidth="500"
                         VerticalAlignment="Center">
                    <MenuBarItem x:Name="MenuFile" Title="File">
                        <MenuFlyoutItem x:Name="MenuFileNew" Text="New Graph..." Click="OnFileNewClicked"
                                        KeyboardAcceleratorTextOverride="Ctrl+N">
                            <MenuFlyoutItem.KeyboardAccelerators>
                                <KeyboardAccelerator Modifiers="Control" Key="N" Invoked="OnMenuAcceleratorInvoked" />
                            </MenuFlyoutItem.KeyboardAccelerators>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem x:Name="MenuFileOpen" Text="Open..." Click="OnFileOpenClicked"
                                        KeyboardAcceleratorTextOverride="Ctrl+O">
                            <MenuFlyoutItem.KeyboardAccelerators>
                                <KeyboardAccelerator Modifiers="Control" Key="O" />
                            </MenuFlyoutItem.KeyboardAccelerators>
                        </MenuFlyoutItem>
                        <!--  File → Open Recent MRU submenu. Items are
                             populated at open-time by MainView
                             (RebuildChromeRecentMenu) from the recent-files
                             history; each routes through
                             ArchitectWindowRegistry.OpenFileAsync. No Click on
                             the parent (a submenu opens its children); the child
                             items get their handlers wired in code so this XAML
                             needs no code-behind handler.
                             x:FieldModifier="public" so MainView (which owns the
                             Chrome instance) can populate Items + subscribe. -->
                        <MenuFlyoutSubItem x:Name="MenuFileOpenRecent"
                                           x:FieldModifier="public"
                                           Text="Open Recent" />
                        <!-- TODO §2 resolution — File → Welcome force-shows the
                             always-available Welcome card overlay on the logic
                             canvas. Non-destructive: the open graph stays loaded
                             behind it (does NOT clear / close). Routes via
                             MainView (FileWelcomeRequested) →
                             LogicCanvasView.RequestShowWelcomeFromShell. -->
                        <MenuFlyoutItem x:Name="MenuFileWelcome" Text="Welcome" Click="OnFileWelcomeClicked" />
                        <MenuFlyoutItem x:Name="MenuFileSave" Text="Save" Click="OnFileSaveClicked"
                                        KeyboardAcceleratorTextOverride="Ctrl+S">
                            <MenuFlyoutItem.KeyboardAccelerators>
                                <KeyboardAccelerator Modifiers="Control" Key="S" />
                            </MenuFlyoutItem.KeyboardAccelerators>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem x:Name="MenuFileSaveAs" Text="Save As..." Click="OnFileSaveAsClicked"
                                        KeyboardAcceleratorTextOverride="Ctrl+Shift+S">
                            <MenuFlyoutItem.KeyboardAccelerators>
                                <KeyboardAccelerator Modifiers="Control,Shift" Key="S" />
                            </MenuFlyoutItem.KeyboardAccelerators>
                        </MenuFlyoutItem>
                        <MenuFlyoutSeparator />
                        <!-- 0.10.0 (arch-ux-state #5) — surface the rolling
                             .phxg.bak[1-3] chain so the user can roll back
                             from a botched edit when Ctrl+Z isn't enough
                             (e.g. they already closed + reopened the file).
                             The handler resolves the backups beside the
                             current LoadedFilePath at click time. -->
                        <MenuFlyoutItem x:Name="MenuFileRestore" Text="Restore previous version…" Click="OnFileRestoreClicked" />
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem x:Name="MenuFileExport" Text="Export to .phx" Click="OnFileExportClicked" />
                    </MenuBarItem>
                    <MenuBarItem x:Name="MenuEdit" Title="Edit">
                        <MenuFlyoutItem x:Name="MenuEditUndo" Text="Undo" Click="OnEditUndoClicked"
                                        KeyboardAcceleratorTextOverride="Ctrl+Z">
                            <MenuFlyoutItem.KeyboardAccelerators>
                                <KeyboardAccelerator Modifiers="Control" Key="Z" Invoked="OnMenuAcceleratorInvoked" />
                            </MenuFlyoutItem.KeyboardAccelerators>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem x:Name="MenuEditRedo" Text="Redo" Click="OnEditRedoClicked"
                                        KeyboardAcceleratorTextOverride="Ctrl+Y">
                            <MenuFlyoutItem.KeyboardAccelerators>
                                <KeyboardAccelerator Modifiers="Control" Key="Y" Invoked="OnMenuAcceleratorInvoked" />
                            </MenuFlyoutItem.KeyboardAccelerators>
                        </MenuFlyoutItem>
                        <MenuFlyoutSeparator />
                        <!-- Ctrl+F so bare F can be Frame Selection (UE Blueprints idiom). -->
                        <MenuFlyoutItem x:Name="MenuEditFind" Text="Find Node..." Click="OnEditFindClicked"
                                        KeyboardAcceleratorTextOverride="Ctrl+F">
                            <MenuFlyoutItem.KeyboardAccelerators>
                                <KeyboardAccelerator Modifiers="Control" Key="F" Invoked="OnMenuAcceleratorInvoked" />
                            </MenuFlyoutItem.KeyboardAccelerators>
                        </MenuFlyoutItem>
                        <!-- 0.10.0 — Group selection (Collapse to Macro). The
                             actual handler lives on the canvas (no
                             selection-aware action on the chrome side yet);
                             this entry surfaces the chord in the menu so
                             users can discover it without right-clicking a
                             multi-selection. -->
                        <MenuFlyoutItem x:Name="MenuEditGroup" Text="Group selection" Click="OnEditGroupClicked"
                                        KeyboardAcceleratorTextOverride="Ctrl+G">
                            <MenuFlyoutItem.KeyboardAccelerators>
                                <KeyboardAccelerator Modifiers="Control" Key="G" Invoked="OnMenuAcceleratorInvoked" />
                            </MenuFlyoutItem.KeyboardAccelerators>
                        </MenuFlyoutItem>
                        <!-- 0.10.0 — bare C drops a comment frame at the
                             viewport centre. KeyboardAcceleratorTextOverride
                             advertises the chord; the canvas's bare-C
                             handler is what actually fires the action when
                             the canvas is focused. -->
                        <MenuFlyoutItem x:Name="MenuEditCommentFrame" Text="Add comment frame" Click="OnEditCommentFrameClicked"
                                        KeyboardAcceleratorTextOverride="C" />
                    </MenuBarItem>
                    <MenuBarItem x:Name="MenuView" Title="View">
                        <MenuFlyoutItem x:Name="MenuViewFrame" Text="Frame Selection" Click="OnViewFrameSelectionClicked"
                                        KeyboardAcceleratorTextOverride="F">
                            <MenuFlyoutItem.KeyboardAccelerators>
                                <KeyboardAccelerator Key="F" Invoked="OnMenuAcceleratorInvoked" />
                            </MenuFlyoutItem.KeyboardAccelerators>
                        </MenuFlyoutItem>
                        <!-- 0.10.0 — Spawn Node (palette). The chord is
                             Ctrl+Space (canvas-side) so the menu hint
                             matches; the menu click reuses Find as a
                             fallback since the spawn palette is
                             pointer-anchored on the canvas. -->
                        <MenuFlyoutItem x:Name="MenuViewSpawn" Text="Spawn node…" Click="OnViewSpawnClicked"
                                        KeyboardAcceleratorTextOverride="Ctrl+Space" />
                        <ToggleMenuFlyoutItem x:Name="MenuViewShowGrid" Text="Show Grid" IsChecked="True" Click="OnViewShowGridClicked" />
                        <!--  — Minimap visibility toggle. Persisted
                             via AppConfig.ArchitectMinimapVisible; the in-overlay
                             × glyph routes through the same path so the
                             toggle stays in sync. -->
                        <ToggleMenuFlyoutItem x:Name="MenuViewMinimap" Text="Minimap" IsChecked="True" Click="OnViewMinimapClicked" />
                        <ToggleMenuFlyoutItem x:Name="LiveDebugToggle" Text="Live Debug Trace" Click="OnLiveDebugToggled"
                                              KeyboardAcceleratorTextOverride="Ctrl+Shift+D">
                            <ToggleMenuFlyoutItem.KeyboardAccelerators>
                                <KeyboardAccelerator Modifiers="Control,Shift" Key="D" Invoked="OnMenuAcceleratorInvoked" />
                            </ToggleMenuFlyoutItem.KeyboardAccelerators>
                        </ToggleMenuFlyoutItem>
                        <!-- B11 (audit/winui-regressions-2026-05-24) — Toggle
                             Inspector. The F4 canvas chord routes through the
                             same handler via MainView's
                             OnInspectorToggleRequestedFromCanvas bridge so
                             menu pick and keyboard chord both flip the same
                             persisted state. -->
                        <MenuFlyoutItem x:Name="MenuViewToggleInspector"
                                        Text="Toggle Inspector"
                                        Click="OnViewToggleInspectorClicked"
                                        KeyboardAcceleratorTextOverride="F4">
                            <MenuFlyoutItem.KeyboardAccelerators>
                                <KeyboardAccelerator Key="F4" Invoked="OnMenuAcceleratorInvoked" />
                            </MenuFlyoutItem.KeyboardAccelerators>
                        </MenuFlyoutItem>
                        <MenuFlyoutSeparator />
                        <!-- 0.10.0 UX P2 — discoverable Bookmark legend.
                             Lists the 9 slot states + the Ctrl/Alt+1..9
                             chord hints in a Flyout so the bookmark
                             feature is no longer invisible to anyone who
                             didn't read the source comments. -->
                        <MenuFlyoutItem x:Name="MenuViewBookmarks" Text="Bookmarks legend…" Click="OnViewBookmarksClicked" />
                        <MenuFlyoutSeparator />
                        <!--  View → Refresh Script Preview (F5). The
                             in-app preview pane was retired in T15 (export-to-
                             .phx is the canonical workflow), so this re-runs the
                             ScriptExporter and writes the .phx beside the loaded
                             graph — a one-key "regenerate compiled script"
                             without walking the File menu. Wired in MainView's
                             HookChromeHandlers (.Click) so this XAML needs no
                             handler in the unowned ArchitectChrome.xaml.cs.
                             x:FieldModifier="public" so MainView can reach it. -->
                        <MenuFlyoutItem x:Name="MenuViewRefreshScript"
                                        x:FieldModifier="public"
                                        Text="Refresh Script Preview"
                                        KeyboardAcceleratorTextOverride="F5">
                            <MenuFlyoutItem.KeyboardAccelerators>
                                <KeyboardAccelerator Key="F5" Invoked="OnMenuAcceleratorInvoked" />
                            </MenuFlyoutItem.KeyboardAccelerators>
                        </MenuFlyoutItem>
                    </MenuBarItem>
                    <!--  P1-A16 — Script menu. Pre-T15 the WinForms
                         MainForm hosted a Script menu with "Sync Event Peers"
                         (and nothing else). The underlying scheduler
                         (EventPairCrossFileSync.SyncAsync) survived T15 but
                         became unreachable from chrome until this entry was
                         restored. Click routes through MainView →
                         LogicCanvasView.RequestSyncEventPeersFromShell so the
                         canvas-side debouncer (ScheduleCrossFileEventPairSync)
                         handles burst-merge across concurrent edits. -->
                    <MenuBarItem x:Name="MenuScript" Title="Script">
                        <MenuFlyoutItem x:Name="MenuScriptSyncEventPeers"
                                        Text="Sync Event Peers"
                                        Click="OnScriptSyncEventPeersClicked"
                                        ToolTipService.ToolTip="Propagate Event.Trigger/Executor/Return socket lists to peer .phxg files in the same project." />
                    </MenuBarItem>
                    <MenuBarItem x:Name="MenuHelp" Title="Help">
                        <MenuFlyoutItem x:Name="MenuHelpNodeRef" Text="Node Reference" Click="OnHelpNodeRefClicked"
                                        KeyboardAcceleratorTextOverride="F1">
                            <MenuFlyoutItem.KeyboardAccelerators>
                                <KeyboardAccelerator Key="F1" Invoked="OnMenuAcceleratorInvoked" />
                            </MenuFlyoutItem.KeyboardAccelerators>
                        </MenuFlyoutItem>
                        <MenuFlyoutSeparator />
                        <!--  P1-A17 — Keyboard Shortcuts… dialog.
                             Two-column reference (Canvas chords + Chrome chords)
                             so the chord vocabulary is discoverable without
                             reading source. Also the F1-without-selection
                             fallback per  P1-A13. -->
                        <MenuFlyoutItem x:Name="MenuHelpShortcuts"
                                        Text="Keyboard Shortcuts…"
                                        Click="OnHelpShortcutsClicked" />
                        <MenuFlyoutSeparator />
                        <!-- 0.11.x polish — opens today's rolling diagnostic log
                             file in the system viewer so the user can scan
                             for UiHangWatchdog's "UI thread unresponsive"
                             markers when the freeze recurs. The log lives
                             under %AppData%/PhoenixControls/logs and survives
                             without the locked SQLite DB. -->
                        <MenuFlyoutItem x:Name="MenuHelpDiagnoseFreeze"
                                        Text="Diagnose freeze…"
                                        Click="OnHelpDiagnoseFreezeClicked"
                                        ToolTipService.ToolTip="Open today's diagnostic log (look for 'UI thread unresponsive' entries)." />
                    </MenuBarItem>
                </MenuBar>

                <!-- Drag region: MainWindow assigns this to Window.SetTitleBar() -->
                <Border x:Name="DragRegion"
                        x:FieldModifier="public"
                        Grid.Column="2"
                        Background="Transparent" />

                <!-- Filename + close-X cluster — 0.11.x polish. The × glyph
                     is a small affordance the user clicks to close the
                     currently-open .phxg without opening a sub-window or
                     hitting File → New. Visibility tracks whether a graph
                     is loaded (see ArchitectChrome.SetCloseFileButtonVisible).
                     MainView listens for FileCloseRequested and routes
                     through the existing dirty-prompt / NewGraph code path. -->
                <StackPanel Grid.Column="3"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="0,0,12,0"
                            Spacing="6">
                    <TextBlock x:Name="FileNameText"
                               VerticalAlignment="Center"
                               FontSize="11"
                               Foreground="{StaticResource CoalSecondaryTextBrush}"
                               FontFamily="{StaticResource MonoFont}"
                               TextTrimming="CharacterEllipsis"
                               MaxWidth="260" />
                    <!-- 0.11.x — sized + coloured to be glance-discoverable.
                         Pre-fix this was 18×18 / 10pt on CoalSecondaryText
                         which rendered as a near-invisible smudge against
                         the dark chrome. Now 22×22 / 13pt on
                         CoalPrimaryText with a CoalHoverBrush highlight on
                         pointer-over so the close affordance reads at a
                         glance the way pre-T15 WinForms did. -->
                    <Button x:Name="CloseFileButton"
                            Width="22"
                            Height="22"
                            Padding="0"
                            MinWidth="0"
                            MinHeight="0"
                            Background="Transparent"
                            BorderThickness="0"
                            CornerRadius="3"
                            Foreground="{StaticResource CoalPrimaryTextBrush}"
                            FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                            FontSize="13"
                            Content="&#xE711;"
                            ToolTipService.ToolTip="Close file"
                            AutomationProperties.Name="Close current file"
                            Visibility="Collapsed"
                            Click="OnCloseFileClicked" />
                </StackPanel>

                <!-- Grid.Column="4" reserved for system min/max/close buttons. -->
            </Grid>
        </Border>

        <!-- Band 3: pillar tab strip -->
        <Border Grid.Row="2"
                Background="{StaticResource CoalSurfaceBrush}"
                BorderBrush="{StaticResource CoalHoverBrush}"
                BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0"
                            Orientation="Horizontal"
                            Margin="10,0,0,0"
                            VerticalAlignment="Bottom"
                            Spacing="2">

                    <!-- HUB (inactive on this pillar) -->
                    <Button Style="{StaticResource PillarTabStyle}"
                            Click="OnHubTabClicked"
                            ToolTipService.ToolTip="Launch Hub"
                            AutomationProperties.Name="Launch Hub pillar">
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Border Width="18" Height="18" CornerRadius="2"
                                    Background="{StaticResource ChromePillarHubGradient}">
                                <TextBlock Text="H"
                                           Foreground="{StaticResource CoalPaperBrush}"
                                           FontFamily="{StaticResource DisplayFont}"
                                           FontWeight="Bold"
                                           FontSize="12"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="HUB" Style="{StaticResource PillarLabelStyle}" />
                        </StackPanel>
                    </Button>

                    <!-- ARCHITECT (active — non-clickable Border) -->
                    <Border Style="{StaticResource ActivePillarTabStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Border Width="18" Height="18" CornerRadius="2"
                                    Background="{StaticResource BrassGradientBrush}">
                                <TextBlock Text="A"
                                           Foreground="{StaticResource CoalShellBrush}"
                                           FontFamily="{StaticResource DisplayFont}"
                                           FontWeight="Bold"
                                           FontSize="12"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="ARCHITECT"
                                       Foreground="{StaticResource CoalPaperBrush}"
                                       Style="{StaticResource PillarLabelStyle}" />
                        </StackPanel>
                    </Border>

                    <!-- VISUALIST (inactive on this pillar) -->
                    <Button Style="{StaticResource PillarTabStyle}"
                            Click="OnVisualistTabClicked"
                            ToolTipService.ToolTip="Launch Visualist"
                            AutomationProperties.Name="Launch Visualist pillar">
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Border Width="18" Height="18" CornerRadius="2"
                                    Background="{StaticResource ChromePillarVisualistGradient}">
                                <TextBlock Text="V"
                                           Foreground="{StaticResource CoalPaperBrush}"
                                           FontFamily="{StaticResource DisplayFont}"
                                           FontWeight="Bold"
                                           FontSize="12"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="VISUALIST" Style="{StaticResource PillarLabelStyle}" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <TextBlock Grid.Column="1"
                           x:Name="VersionLabel"
                           VerticalAlignment="Bottom"
                           Margin="0,0,12,6"
                           FontFamily="{StaticResource MonoFont}"
                           FontSize="10"
                           CharacterSpacing="100"
                           Foreground="{StaticResource CoalSecondaryTextBrush}"
                           TextTrimming="CharacterEllipsis"
                           MaxWidth="160" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
