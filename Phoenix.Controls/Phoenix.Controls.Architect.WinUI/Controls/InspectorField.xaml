<?xml version="1.0" encoding="utf-8"?>
<!--
    Inspector field row — uppercase eyebrow label + writeable value.

    Modes:
      Text  (default): pill-shaped value border. Double-tap (or focus + Enter)
                       reveals an inline TextBox; Enter commits, Esc cancels.
                       Validation feedback through the Error visual state.
      Bool:            ☑ / ☐ glyph row (replaces the previous ToggleSwitch which
                       was visually heavy for an inline field).

    Visual states (named VisualStateGroup "EditState"):
      ReadState  — pill renders the value (or "(empty)" placeholder).
      EditState  — TextBox visible, pill hidden.
      ErrorState — pill border swaps to StatusRedBrush; the parent supplies
                   the failure reason via the ErrorMessage property.

    Mirrors architect.jsx:Field().
-->
<UserControl
    x:Class="Phoenix.Controls.Architect.WinUI.Controls.InspectorField"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <StackPanel Spacing="3">
        <TextBlock x:Name="LabelText"
                   FontFamily="{StaticResource SansFont}"
                   FontSize="9"
                   FontWeight="SemiBold"
                   CharacterSpacing="100"
                   Foreground="{StaticResource CoalSecondaryTextBrush}" />

        <!-- Text mode: pill + (when editing) inline TextBox -->
        <Grid x:Name="TextRoot">
            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup x:Name="EditState">
                    <VisualState x:Name="ReadState">
                        <VisualState.Setters>
                            <Setter Target="ValuePill.Visibility" Value="Visible" />
                            <Setter Target="ValueBox.Visibility"  Value="Collapsed" />
                            <Setter Target="ValuePill.BorderBrush" Value="{StaticResource CoalHoverBrush}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="EditMode">
                        <VisualState.Setters>
                            <Setter Target="ValuePill.Visibility" Value="Collapsed" />
                            <Setter Target="ValueBox.Visibility"  Value="Visible" />
                            <Setter Target="ValuePill.BorderBrush" Value="{ThemeResource BorderPillBrush}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="ErrorState">
                        <VisualState.Setters>
                            <Setter Target="ValuePill.Visibility" Value="Visible" />
                            <Setter Target="ValueBox.Visibility"  Value="Collapsed" />
                            <Setter Target="ValuePill.BorderBrush" Value="{StaticResource StatusRedBrush}" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>

            <Border x:Name="ValuePill"
                    Background="{StaticResource BgPillBrush}"
                    BorderBrush="{StaticResource CoalHoverBrush}"
                    BorderThickness="1"
                    CornerRadius="3"
                    Padding="8,5,8,5"
                    MinHeight="22"
                    DoubleTapped="OnValuePillDoubleTapped">
                <!-- MinHeight keeps an empty pill visibly clickable per
                     ARCH-UI-D4 (empty pill chrome stays visible without
                     any placeholder text). -->
                <TextBlock x:Name="ValueText"
                           FontSize="11"
                           Foreground="{StaticResource CoalPrimaryTextBrush}"
                           TextTrimming="CharacterEllipsis" />
            </Border>

            <TextBox x:Name="ValueBox"
                     Visibility="Collapsed"
                     FontSize="11"
                     Background="{StaticResource CoalShellBrush}"
                     BorderBrush="{StaticResource CoalHoverBrush}"
                     BorderThickness="1"
                     CornerRadius="3"
                     IsSpellCheckEnabled="False"
                     IsTextPredictionEnabled="False"
                     PreventKeyboardDisplayOnProgrammaticFocus="True"
                     LostFocus="OnValueBoxLostFocus"
                     KeyDown="OnValueBoxKeyDown" />
        </Grid>

        <TextBlock x:Name="ErrorMessageText"
                   Visibility="Collapsed"
                   FontSize="10"
                   Foreground="{StaticResource StatusRedBrush}"
                   TextWrapping="Wrap" />

        <!-- Bool mode: ☑ / ☐ glyph row (replaces ToggleSwitch) -->
        <StackPanel x:Name="BoolValuePanel"
                    Orientation="Horizontal"
                    Spacing="6"
                    Visibility="Collapsed">
            <Border x:Name="BoolHit"
                    Padding="2,1,2,1"
                    Background="Transparent"
                    Tapped="OnBoolHitTapped">
                <TextBlock x:Name="BoolGlyph"
                           FontSize="14"
                           Foreground="{StaticResource CoalPrimaryTextBrush}" />
            </Border>
            <TextBlock x:Name="BoolStateText"
                       VerticalAlignment="Center"
                       FontSize="11"
                       Foreground="{StaticResource CoalBodyTextBrush}" />
        </StackPanel>
    </StackPanel>
</UserControl>
