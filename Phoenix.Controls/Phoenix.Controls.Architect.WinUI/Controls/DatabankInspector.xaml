<?xml version="1.0" encoding="utf-8"?>
<!--
    Databank-side inspector. Bound to DatabankInspectorViewModel — the
    eyebrow, title, and Fields collection update as the row selection
    changes in the browser. Fields/Schema toggle at the top lets the user
    flip between the row-as-fields view and the table-schema view.
-->
<UserControl
    x:Class="Phoenix.Controls.Architect.WinUI.Controls.DatabankInspector"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Phoenix.Controls.Architect.WinUI.Controls"
    xmlns:vm="using:Phoenix.Controls.Architect.WinUI.ViewModels">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Padding="12,8,12,8"
                BorderBrush="{StaticResource DividerDotBrush}"
                BorderThickness="0,0,0,1">
            <StackPanel Spacing="2">
                <TextBlock Text="{Binding Eyebrow, FallbackValue=INSPECTOR, TargetNullValue=INSPECTOR}"
                           FontFamily="{StaticResource SansFont}"
                           FontSize="10"
                           FontWeight="SemiBold"
                           CharacterSpacing="180"
                           Foreground="{StaticResource EmberPrimaryBrush}" />
                <TextBlock Text="{Binding DisplayTitle, FallbackValue=—, TargetNullValue=—}"
                           FontFamily="{StaticResource DisplayFont}"
                           FontSize="14"
                           CharacterSpacing="40"
                           Foreground="{StaticResource TextStrongBrush}" />
            </StackPanel>
        </Border>

        <!-- Fields / Schema toggle -->
        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    Spacing="6"
                    Padding="12,6,12,6">
            <ToggleButton x:Name="FieldsToggle"
                          Content="Fields"
                          IsChecked="True"
                          Click="OnFieldsToggleClick" />
            <ToggleButton x:Name="SchemaToggle"
                          Content="Schema"
                          Click="OnSchemaToggleClick" />
        </StackPanel>

        <!-- Fields panel (default) -->
        <ScrollViewer x:Name="FieldsScroll"
                      Grid.Row="2"
                      Padding="12,10,12,10"
                      VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Fields}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Spacing="10" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:InspectorFieldViewModel">
                        <!-- Value is TwoWay (QC19-02): InspectorField's
                             commit path writes back through the VM's Value
                             setter, which fires WriteBackText to persist
                             via DatabankBrowserViewModel.UpdateCellAsync.
                             Pre-fix this was OneTime against a get-only
                             property, so inspector edits silently dropped. -->
                        <local:InspectorField
                            Label="{x:Bind Label, Mode=OneTime}"
                            Value="{x:Bind Value, Mode=TwoWay}"
                            Mono="{x:Bind IsMono, Mode=OneTime}"
                            IsBool="{x:Bind IsBool, Mode=OneTime}"
                            BoolValue="{x:Bind BoolValue, Mode=TwoWay}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Schema panel (hidden until toggled) -->
        <ScrollViewer x:Name="SchemaScroll"
                      Grid.Row="2"
                      Padding="12,10,12,10"
                      Visibility="Collapsed"
                      VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="SchemaList"
                          ItemsSource="{Binding Schema}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Spacing="4" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,2,0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="80" />
                                <ColumnDefinition Width="50" />
                                <ColumnDefinition Width="50" />
                                <ColumnDefinition Width="80" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Text="{Binding Name}"
                                       FontFamily="{StaticResource MonoFont}"
                                       FontSize="11"
                                       Foreground="{StaticResource TextStrongBrush}" />
                            <TextBlock Grid.Column="1"
                                       Text="{Binding SqlType}"
                                       FontFamily="{StaticResource MonoFont}"
                                       FontSize="11"
                                       Foreground="{StaticResource TextLabelBrush}" />
                            <TextBlock Grid.Column="2"
                                       Text="{Binding NotNullDisplay}"
                                       FontFamily="{StaticResource MonoFont}"
                                       FontSize="11"
                                       Foreground="{StaticResource TextSecondaryBrush}" />
                            <TextBlock Grid.Column="3"
                                       Text="{Binding PkDisplay}"
                                       FontFamily="{StaticResource MonoFont}"
                                       FontSize="11"
                                       Foreground="{StaticResource TextSecondaryBrush}" />
                            <TextBlock Grid.Column="4"
                                       Text="{Binding DefaultDisplay}"
                                       FontFamily="{StaticResource MonoFont}"
                                       FontSize="11"
                                       Foreground="{StaticResource TextSecondaryBrush}" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
