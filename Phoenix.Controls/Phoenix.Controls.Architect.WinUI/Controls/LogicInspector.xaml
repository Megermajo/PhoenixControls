<?xml version="1.0" encoding="utf-8"?>
<!--
    Slim Logic-side inspector. Per feedback_node_ui_inline_sockets.md the
    node body owns socket-value editing — the inspector renders only the
    static reference text (eyebrow + title + description) so the panel
    stays out of the muscle-memory editing path.

    Pre-0.10.0 the inspector hosted an arbitrary Fields list; 0.10.0
    collapses that to Description only. Multi-selection / wire selection
    routes through DisplayTitle and continues to use Description for the
    "what kind of thing am I looking at" caption.
-->
<UserControl
    x:Class="Phoenix.Controls.Architect.WinUI.Controls.LogicInspector"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:cv="using:Phoenix.Controls.Architect.WinUI.Canvas.Converters"
    xmlns:loc="using:Phoenix.Controls.Architect.WinUI.Localization">

    <UserControl.Resources>
        <cv:BoolToVisibilityConverter x:Key="BoolVis" />
    </UserControl.Resources>

    <!-- MaxWidth caps the inspector at 320px so the "slim panel" invariant
         (feedback_node_ui_inline_sockets.md) holds regardless of whatever
         host splitter sets the column width.

         ★ 2026-08-14 — MinHeight="280" REMOVED.

         It was added on 2026-05-24 (bb705f86) for a real reason: the
         empty-state TextBlock auto-sized the body to ~16-30 px, and beside
         the chevron strip an expanded inspector looked identical to a
         rolled-up one. That reasoning held WHILE BOTH STATES WERE THE SAME
         WIDTH — height was the only axis left to tell them apart, so
         height had to carry it, and the cost was that a card with nothing
         selected was still a 280 px slab over the graph.

         The host is a floating fixed-width card now: expanded is 320 px
         with a border and a corner radius, rolled up is a 32 px tab. A 10x
         width difference plus a different silhouette does the
         disambiguation, so the body no longer buys it with dead space.
         The empty state below still carries deliberate presence (glyph +
         caption, ~96 px) instead of collapsing to one line; those two
         signals together are what replaces the floor. If an open-empty
         card ever reads as the rolled-up tab again, THIS is the thing to
         restore — not the column. -->
    <Grid MaxWidth="320">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header (eyebrow + display name). 0.11.6 hotfix — Visibility binds
             to HasSelection so the entire header (padding + bottom border)
             disappears when nothing is selected. Pre-fix this Border rendered
             empty (Eyebrow / DisplayTitle = "") but still paid 16 px of
             vertical padding + a 1-px bottom edge, which Majo's 0.11.5 audit
             flagged as a "horizontal scaling bar" stuck to the top of the
             panel. With the MainView chevron strip already labelling the
             section as "INSPECTOR", the empty-state header had no signal
             value — it was pure chrome the user couldn't dismiss. -->
        <Border Grid.Row="0"
                Padding="12,8,12,8"
                BorderBrush="{StaticResource CoalCardBrush}"
                BorderThickness="0,0,0,1"
                Visibility="{Binding HasSelection, Converter={StaticResource BoolVis}}">
            <StackPanel Spacing="2">
                <TextBlock Text="{Binding Eyebrow}"
                           FontFamily="{StaticResource SansFont}"
                           FontSize="10"
                           FontWeight="SemiBold"
                           CharacterSpacing="180"
                           Foreground="{StaticResource EmberPrimaryBrush}" />
                <TextBlock Text="{Binding DisplayTitle}"
                           FontFamily="{StaticResource DisplayFont}"
                           FontSize="14"
                           CharacterSpacing="40"
                           Foreground="{StaticResource CoalPaperBrush}" />
            </StackPanel>
        </Border>

        <!-- Body: the resolved description (Node.Description override → template
             fallback). The inspector intentionally hosts nothing else; per-socket
             editing lives on the node body. -->
        <ScrollViewer Grid.Row="1"
                      Padding="12,10,12,10"
                      VerticalScrollBarVisibility="Auto"
                      Visibility="{Binding HasSelection, Converter={StaticResource BoolVis}}">
            <TextBlock Text="{Binding Description}"
                       FontSize="12"
                       Foreground="{StaticResource CoalBodyTextBrush}"
                       TextWrapping="Wrap"
                       LineHeight="18" />
        </ScrollViewer>

        <!-- Empty state — shows when nothing is selected.

             Carries the card's "I am open" signal now that the 280 px
             MinHeight is gone: a glyph over a caption inside ~96 px of
             padded stack, rather than one centred line that would let an
             open card collapse to the height of the rolled-up tab. Sized
             by its own MinHeight so it never stretches a card that has a
             real selection to show. -->
        <StackPanel Grid.Row="1"
                    MinHeight="96"
                    Padding="16,22,16,22"
                    Spacing="10"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Top"
                    Visibility="{Binding HasSelection, Converter={StaticResource BoolVis}, ConverterParameter=invert}">
            <TextBlock HorizontalAlignment="Center"
                       FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                       FontSize="24"
                       Opacity="0.55"
                       Foreground="{StaticResource CoalSecondaryTextBrush}"
                       Text="&#xE7C4;" />
            <TextBlock HorizontalAlignment="Center"
                       FontSize="12"
                       Foreground="{StaticResource CoalSecondaryTextBrush}"
                       TextAlignment="Center"
                       TextWrapping="Wrap"
                       Text="Select a node or wire to inspect."
                       loc:Localize.Key="architect.inspector.empty.body" />
        </StackPanel>
    </Grid>
</UserControl>
