<?xml version="1.0" encoding="utf-8"?>
<!--
     P1-A17 — Architect keyboard shortcuts reference.

    Two-column reference modal: Canvas chords (LogicCanvasView.Keyboard.cs
    + LogicCanvasView.QuickKeys.cs) on the left, Chrome chords
    (ArchitectChrome.xaml + ArchitectSiblingWindow.xaml KeyboardAccelerators)
    on the right. Discoverability fix for the chord vocabulary that pre-T15
    lived in MainForm.ShowKeyboardShortcuts() and was lost in the WinUI
    rewrite.

    Reachable from:
      • Help → Keyboard Shortcuts… in ArchitectChrome (embedded view).
      • Help → Keyboard Shortcuts… in ArchitectSiblingWindow (multi-window).
      • F1 on an empty canvas ( P1-A13 fallback — F1 with a node
        selected still opens the per-node documentation).

    Per feedback_visualist_architect_chrome_independence.md the visual
    treatment uses Architect-local Phoenix forged-charcoal tokens
    (Coal* / Ember* / Brass* brushes from PhoenixDark.xaml — the same
    cross-pillar theme dictionary entries the Architect chrome already
    consumes). The dialog stays in Architect.WinUI; Visualist would
    author its own analogue if a parallel surface ever ships there.
-->
<ContentDialog
    x:Class="Phoenix.Controls.Architect.WinUI.Dialogs.KeyboardShortcutsDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Keyboard Shortcuts"
    Background="{StaticResource CoalShellBrush}"
    BorderBrush="{StaticResource CoalCardBrush}"
    BorderThickness="1"
    CornerRadius="6"
    CloseButtonText="Close"
    DefaultButton="Close">

    <ContentDialog.Resources>
        <!-- Section-header strip: ember eyebrow + brass hairline. Mirrors the
             Architect chrome's "PHOENIX CONTROLS" wordmark treatment so the
             dialog reads as part of the same surface family. -->
        <Style x:Key="ShortcutSectionEyebrow" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="CharacterSpacing" Value="180" />
            <Setter Property="Foreground" Value="{StaticResource EmberPrimaryBrush}" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>

        <Style x:Key="ShortcutChord" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{StaticResource CoalPaperBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextWrapping" Value="NoWrap" />
        </Style>

        <Style x:Key="ShortcutDescription" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource SansFont}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource CoalBodyTextBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="ShortcutGroupHeader" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource SansFont}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="CharacterSpacing" Value="80" />
            <Setter Property="Foreground" Value="{StaticResource CoalSecondaryTextBrush}" />
            <Setter Property="Margin" Value="0,10,0,4" />
        </Style>
    </ContentDialog.Resources>

    <Grid Width="780" Height="560">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="2" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Eyebrow header — matches the chrome's wordmark band so the
             dialog reads as a continuation of the same shell. -->
        <StackPanel Grid.Row="0" Spacing="2" Margin="0,0,0,8">
            <TextBlock Text="ARCHITECT" Style="{StaticResource ShortcutSectionEyebrow}" />
            <TextBlock FontFamily="{StaticResource SansFont}"
                       FontSize="13"
                       Foreground="{StaticResource CoalSecondaryTextBrush}"
                       Text="Canvas chords on the left, Chrome chords on the right." />
        </StackPanel>

        <!-- Brass hairline, mirrors the chrome's TitleAccentBar. -->
        <Rectangle Grid.Row="1" Fill="{StaticResource BrassGradientBrush}" />

        <!-- Two-column body. Each column is its own ScrollViewer so a
             long Canvas list doesn't push the Chrome list out of view. -->
        <Grid Grid.Row="2" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="1" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ─── Canvas column ───────────────────────────────────────── -->
            <ScrollViewer Grid.Column="0"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Padding="0,0,12,0">
                <StackPanel x:Name="CanvasColumn" Spacing="2">
                    <TextBlock Style="{StaticResource ShortcutSectionEyebrow}" Text="CANVAS" />
                </StackPanel>
            </ScrollViewer>

            <!-- Vertical divider between columns. -->
            <Rectangle Grid.Column="1"
                       Fill="{StaticResource CoalHoverBrush}"
                       HorizontalAlignment="Center"
                       Width="1" />

            <!-- ─── Chrome column ───────────────────────────────────────── -->
            <ScrollViewer Grid.Column="2"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Padding="12,0,0,0">
                <StackPanel x:Name="ChromeColumn" Spacing="2">
                    <TextBlock Style="{StaticResource ShortcutSectionEyebrow}" Text="CHROME" />
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</ContentDialog>
