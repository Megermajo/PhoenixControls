<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="Phoenix.Controls.Architect.WinUI.Dialogs.VarChainTraceDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Trace Variable"
    Background="{StaticResource BgPanelBrush}"
    BorderBrush="{StaticResource BorderSoftBrush}"
    BorderThickness="1"
    CornerRadius="6"
    PrimaryButtonText="Pin to canvas (dim others)"
    CloseButtonText="Close"
    DefaultButton="Primary">

    <Grid Width="640" Height="500">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <InfoBar Grid.Row="0"
                 Severity="Informational"
                 Title="Read-only reference"
                 Message="Click a row to jump to that node on the canvas, or pin a variable to highlight its chain."
                 IsOpen="True"
                 IsClosable="False"
                 Margin="0,0,0,8" />

        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock VerticalAlignment="Center"
                       Margin="0,0,8,0"
                       FontSize="11"
                       Foreground="{StaticResource TextLabelBrush}"
                       Text="Variable" />
            <ComboBox x:Name="VarCombo"
                      Grid.Column="1"
                      IsEditable="True"
                      HorizontalAlignment="Stretch"
                      FontSize="13"
                      TextSubmitted="OnVarSubmitted"
                      SelectionChanged="OnVarSelectionChanged" />
        </Grid>

        <Grid Grid.Row="2" ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!--  WRITERS panel — 3px cyan left accent (VarChainWriterBrush)
                 paired with the cyan halo Architect already uses on writer
                 nodes (see ApplyVarChainHighlights in LogicCanvasViewModel).
                 The right/top/bottom edges keep the neutral BorderSoftBrush
                 so the accent reads as a semantic stripe, not a frame
                 colour change. -->
            <Border Grid.Column="0"
                    Background="{StaticResource SelectionDimBrush}"
                    BorderBrush="{StaticResource VarChainWriterBrush}"
                    BorderThickness="3,0,0,0"
                    CornerRadius="3,0,0,3"
                    Padding="6">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock x:Name="WritersHeader"
                               Margin="0,0,0,4"
                               FontSize="11"
                               CharacterSpacing="80"
                               Foreground="{StaticResource VarChainWriterBrush}" />
                    <!--  IsItemClickEnabled so a row click
                         jumps to (selects + frames + flashes) the node on canvas. -->
                    <ListView x:Name="WritersList" Grid.Row="1"
                              SelectionMode="None"
                              IsItemClickEnabled="True"
                              ItemClick="OnRowClick">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Spacing="1" Margin="0,3,0,3"
                                            ToolTipService.ToolTip="Click to jump to this node">
                                    <TextBlock Text="{Binding Title}"
                                               FontSize="12"
                                               Foreground="{StaticResource TextStrongBrush}" />
                                    <TextBlock Text="{Binding Subtitle}"
                                               FontSize="10"
                                               Foreground="{StaticResource TextLabelBrush}" />
                                    <!--  Short node-id disambiguator
                                         so same-titled nodes (two Var.Set's, etc.)
                                         stay distinguishable while scanning. -->
                                    <TextBlock Text="{Binding ShortNodeId}"
                                               FontSize="9"
                                               Foreground="{StaticResource TextLabelBrush}" />
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <TextBlock x:Name="WritersEmpty" Grid.Row="1"
                               Visibility="Collapsed"
                               Margin="2,6,0,0"
                               FontSize="11"
                               Foreground="{StaticResource TextLabelBrush}"
                               Text="No writers." />
                </Grid>
            </Border>

            <!--  READERS panel — 3px amber left accent
                 (VarChainReaderBrush) mirroring the amber halo used on
                 reader nodes. Same semantic-stripe shape as WRITERS. -->
            <Border Grid.Column="1"
                    Background="{StaticResource SelectionDimBrush}"
                    BorderBrush="{StaticResource VarChainReaderBrush}"
                    BorderThickness="3,0,0,0"
                    CornerRadius="3,0,0,3"
                    Padding="6">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock x:Name="ReadersHeader"
                               Margin="0,0,0,4"
                               FontSize="11"
                               CharacterSpacing="80"
                               Foreground="{StaticResource VarChainReaderBrush}" />
                    <ListView x:Name="ReadersList" Grid.Row="1"
                              SelectionMode="None"
                              IsItemClickEnabled="True"
                              ItemClick="OnRowClick">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Spacing="1" Margin="0,3,0,3"
                                            ToolTipService.ToolTip="Click to jump to this node">
                                    <TextBlock Text="{Binding Title}"
                                               FontSize="12"
                                               Foreground="{StaticResource TextStrongBrush}" />
                                    <TextBlock Text="{Binding Subtitle}"
                                               FontSize="10"
                                               Foreground="{StaticResource TextLabelBrush}" />
                                    <!--  Short node-id disambiguator
                                         so same-titled nodes (two Var.Get's, etc.)
                                         stay distinguishable while scanning. -->
                                    <TextBlock Text="{Binding ShortNodeId}"
                                               FontSize="9"
                                               Foreground="{StaticResource TextLabelBrush}" />
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <TextBlock x:Name="ReadersEmpty" Grid.Row="1"
                               Visibility="Collapsed"
                               Margin="2,6,0,0"
                               FontSize="11"
                               Foreground="{StaticResource TextLabelBrush}"
                               Text="No readers." />
                </Grid>
            </Border>
        </Grid>

        <!--  Aggregate writer/reader count footer, restoring
             the WinForms VarChainTraceForm summary line. Populated in
             RefreshChain via UpdateSummary. -->
        <TextBlock x:Name="SummaryFooter" Grid.Row="3"
                   Margin="2,8,0,0"
                   FontSize="11"
                   Foreground="{StaticResource TextLabelBrush}" />
    </Grid>
</ContentDialog>
