<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="Phoenix.Controls.Architect.WinUI.Dialogs.ConfirmDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{StaticResource BgPanelBrush}"
    BorderBrush="{StaticResource BorderSoftBrush}"
    BorderThickness="1"
    CornerRadius="6"
    MaxWidth="480"
    PrimaryButtonText="Yes"
    CloseButtonText="Cancel"
    DefaultButton="Primary">

    <StackPanel Spacing="10" MinWidth="320">
        <!-- Danger header row — warning glyph + accent bar. Visibility is
             flipped on at runtime via ForDanger. 0.10.0 a11y / UX P2. -->
        <Grid x:Name="DangerHeader" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0"
                    Width="3"
                    Margin="0,0,8,0"
                    Background="{StaticResource ErrBrush}"
                    CornerRadius="1.5" />
            <FontIcon Grid.Column="1"
                      Glyph="&#xE7BA;"
                      FontFamily="Segoe Fluent Icons,Segoe MDL2 Assets"
                      FontSize="16"
                      Foreground="{StaticResource ErrBrush}"
                      HorizontalAlignment="Left"
                      VerticalAlignment="Center" />
        </Grid>
        <TextBlock x:Name="MessageText"
                   FontSize="13"
                   TextWrapping="Wrap"
                   Foreground="{StaticResource TextLabelBrush}" />
    </StackPanel>
</ContentDialog>
