<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="Phoenix.Controls.Architect.WinUI.Dialogs.RecentFilesDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Open Recent"
    Background="{StaticResource BgPanelBrush}"
    BorderBrush="{StaticResource BorderSoftBrush}"
    BorderThickness="1"
    CornerRadius="6"
    CloseButtonText="Cancel"
    DefaultButton="Close">

    <Grid Width="520" Height="400">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <InfoBar Grid.Row="0"
                 Severity="Informational"
                 Title="Read-only reference"
                 Message="This view can stay open while you edit — close manually when done."
                 IsOpen="True"
                 IsClosable="False"
                 Margin="0,0,0,8" />

        <TextBlock Grid.Row="1"
                   Margin="0,0,0,6"
                   FontSize="11"
                   Foreground="{StaticResource TextLabelBrush}"
                   Text="Architect MRU — last 10 graphs opened" />

        <ListView x:Name="RecentList"
                  Grid.Row="2"
                  SelectionMode="Single"
                  IsItemClickEnabled="True"
                  ItemClick="OnItemClick"
                  KeyDown="OnRecentListKeyDown">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <!-- 0.10.0 UX P2: per-row Pin toggle. -->
                    <Grid Margin="0,4,0,4" Opacity="{Binding Opacity}"
                          ToolTipService.ToolTip="{Binding FullPath}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Spacing="2">
                            <TextBlock Text="{Binding FileName}"
                                       FontSize="13"
                                       Foreground="{StaticResource TextStrongBrush}" />
                            <TextBlock Text="{Binding FullPath}"
                                       FontSize="10"
                                       Foreground="{StaticResource TextLabelBrush}"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <Button Grid.Column="1"
                                Width="28"
                                Height="28"
                                Padding="0"
                                Margin="6,0,0,0"
                                Background="Transparent"
                                BorderThickness="0"
                                Content="{Binding PinGlyph}"
                                FontFamily="Segoe Fluent Icons,Segoe MDL2 Assets"
                                FontSize="12"
                                ToolTipService.ToolTip="Pin to top / unpin"
                                AutomationProperties.Name="Pin or unpin this file"
                                Click="OnPinToggleClick" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <TextBlock x:Name="EmptyHint"
                   Grid.Row="2"
                   Visibility="Collapsed"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   FontSize="12"
                   Foreground="{StaticResource TextLabelBrush}"
                   Text="No recent files yet — open a .phxg from File → Open." />

        <Button x:Name="ClearButton"
                Grid.Row="3"
                Margin="0,8,0,0"
                HorizontalAlignment="Left"
                Content="Clear list"
                Click="OnClearClick" />
    </Grid>
</ContentDialog>
