<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="Phoenix.Controls.Architect.WinUI.Dialogs.NameTypeDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{StaticResource BgPanelBrush}"
    BorderBrush="{StaticResource BorderSoftBrush}"
    BorderThickness="1"
    CornerRadius="6"
    PrimaryButtonText="OK"
    CloseButtonText="Cancel"
    DefaultButton="Primary">

    <StackPanel Spacing="10" MinWidth="320">
        <TextBlock x:Name="EyebrowText"
                   FontSize="10"
                   CharacterSpacing="80"
                   Foreground="{StaticResource TextLabelBrush}"
                   Text="DETAILS" />

        <TextBox x:Name="NameBox"
                 PlaceholderText="Name"
                 FontSize="13"
                 KeyDown="OnNameBoxKeyDown" />

        <ComboBox x:Name="TypeBox"
                  HorizontalAlignment="Stretch"
                  Visibility="Collapsed"
                  FontSize="12"
                  SelectedIndex="0"
                  SelectionChanged="OnTypeBoxSelectionChanged">
            <ComboBoxItem Content="String" />
            <ComboBoxItem Content="Number" />
            <ComboBoxItem Content="Bool" />
        </ComboBox>

        <TextBox x:Name="DefaultBox"
                 PlaceholderText="Default value (optional)"
                 Visibility="Collapsed"
                 FontSize="12"
                 KeyDown="OnDefaultBoxKeyDown"
                 TextChanged="OnDefaultBoxTextChanged" />

        <TextBlock x:Name="ErrorText"
                   FontSize="11"
                   Foreground="{StaticResource StatusRedBrush}"
                   Visibility="Collapsed"
                   TextWrapping="Wrap" />
    </StackPanel>
</ContentDialog>
