<?xml version="1.0" encoding="utf-8"?>
<!--
    Sibling-graph Architect window — restores the pre-T15 multi-window
    paradigm: each .phxg gets its own top-level Architect window with its
    own ArchitectViewModel. The Hub-embedded MainView spawns these via
    ArchitectWindowRegistry whenever the user picks New / Open / Open
    Recent / drag-drops a .phxg.

    Chrome decomposition:
      Row 0: ArchitectWindowChrome (custom 32 px caption + brass strip +
             File/Edit/View/Help MenuBar in its SecondarySlot).
      Row 1: 1 px CoalDivider hairline matching MainView.
      Row 2: Three-column body — LeftRail | LogicCanvasView | LogicInspector.
      Row 3: 24 px status strip (Ready / counts).

    Sibling chrome intentionally omits the pillar tab strip (HUB /
    ARCHITECT / VISUALIST) — only the Hub-embedded host window owns that
    affordance per the multi-window spec.

    Per feedback_visualist_architect_chrome_independence.md this window
    stays in Architect.WinUI even though SubGraphWindow shares much of
    the chrome layout. The shared primitive is ArchitectWindowChrome;
    body composition is per-window.
-->
<Window
    x:Class="Phoenix.Controls.Architect.WinUI.Hosting.ArchitectSiblingWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Phoenix.Controls.Architect.WinUI.Controls"
    xmlns:canvas="using:Phoenix.Controls.Architect.WinUI.Canvas">

    <Grid Background="{StaticResource CoalShellBrush}"
          AutomationProperties.Name="Architect Sibling Window">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="24" />
        </Grid.RowDefinitions>

        <!-- Custom chrome — caption + menu strip live inside this primitive's
             SecondarySlot ContentPresenter. Canvas.ZIndex=100 mirrors the
             MainView fix for 0.10.8 readability sweep #5 (chrome reading as
             layered UNDER the canvas) so the chrome paints on top of any
             body content whose RenderTransform happens to overflow its slot. -->
        <controls:ArchitectWindowChrome x:Name="Chrome" Grid.Row="0" Canvas.ZIndex="100">
            <!-- Left caption: file name + folder path + version stack -->
            <controls:ArchitectWindowChrome.LeftCaptionContent>
                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <!-- Match existing ArchitectChrome.xaml convention — the
                         short ms-appx form resolves to the host package's
                         Assets folder (Hub.WinUI ships phoenix-mark.png at
                         that location). Library-prefixed paths
                         (ms-appx:///Phoenix.Controls.Architect.WinUI/Assets/...)
                         work too, but parity with the embedded chrome keeps
                         a future "swap the mark" change in one place. -->
                    <Image Source="ms-appx:///Assets/phoenix-mark.png"
                           Width="16" Height="16"
                           VerticalAlignment="Center" />
                    <StackPanel Orientation="Vertical" VerticalAlignment="Center" Spacing="0">
                        <TextBlock x:Name="CaptionFileName"
                                   FontFamily="{StaticResource SansFont}"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource CoalPaperBrush}"
                                   TextTrimming="CharacterEllipsis"
                                   MaxWidth="320"
                                   Text="(unsaved)" />
                        <TextBlock x:Name="CaptionFilePath"
                                   FontFamily="{StaticResource MonoFont}"
                                   FontSize="9"
                                   Foreground="{StaticResource CoalSecondaryTextBrush}"
                                   TextTrimming="CharacterEllipsis"
                                   MaxWidth="320" />
                    </StackPanel>
                    <!-- 0.11.x polish — × glyph next to the sibling-window
                         file caption. Per the multi-window model, closing
                         the file in a sibling closes the whole window
                         (a sibling with no file is dead weight). File →
                         Close Window provides the same affordance from
                         the menu; this is the glance-discoverable variant. -->
                    <!-- 0.11.x — sized + coloured to match the embedded
                         chrome's close-X (22×22 / 13pt / CoalPrimaryText)
                         so the affordance reads identically in both
                         surfaces and isn't a near-invisible smudge. -->
                    <Button x:Name="CaptionCloseFile"
                            Width="22"
                            Height="22"
                            Padding="0"
                            MinWidth="0"
                            MinHeight="0"
                            Background="Transparent"
                            BorderThickness="0"
                            CornerRadius="3"
                            Foreground="{StaticResource CoalPrimaryTextBrush}"
                            FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                            FontSize="13"
                            Content="&#xE711;"
                            ToolTipService.ToolTip="Close window"
                            AutomationProperties.Name="Close window"
                            VerticalAlignment="Center"
                            Click="OnCaptionCloseFileClicked" />
                    <Rectangle Width="1" Height="14"
                               Fill="{StaticResource CoalHoverBrush}"
                               VerticalAlignment="Center" />
                    <TextBlock x:Name="CaptionVersion"
                               FontFamily="{StaticResource MonoFont}"
                               FontSize="10"
                               CharacterSpacing="100"
                               Foreground="{StaticResource CoalSecondaryTextBrush}"
                               VerticalAlignment="Center" />
                </StackPanel>
            </controls:ArchitectWindowChrome.LeftCaptionContent>

            <!-- Secondary row: File / Edit / View / Help menu strip. No pillar
                 switcher per the multi-window spec. -->
            <controls:ArchitectWindowChrome.SecondaryContent>
                <Border Background="{StaticResource CoalRaisedBrush}"
                        BorderBrush="{StaticResource CoalCardBrush}"
                        BorderThickness="0,0,0,1">
                    <MenuBar x:Name="WindowMenuBar"
                             Background="Transparent"
                             VerticalAlignment="Center"
                             Padding="6,0,0,0">
                        <MenuBarItem x:Name="MenuFile" Title="File">
                            <MenuFlyoutItem x:Name="MenuFileNew" Text="New Graph..." Click="OnFileNewClicked">
                                <MenuFlyoutItem.KeyboardAccelerators>
                                    <KeyboardAccelerator Modifiers="Control" Key="N" Invoked="OnMenuAcceleratorInvoked" />
                                </MenuFlyoutItem.KeyboardAccelerators>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem x:Name="MenuFileOpen" Text="Open..." Click="OnFileOpenClicked">
                                <MenuFlyoutItem.KeyboardAccelerators>
                                    <KeyboardAccelerator Modifiers="Control" Key="O" />
                                </MenuFlyoutItem.KeyboardAccelerators>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem x:Name="MenuFileOpenRecent" Text="Open Recent..." Click="OnFileOpenRecentClicked" />
                            <!-- TODO §2 resolution — File → Welcome parity with the
                                 embedded ArchitectChrome (File menu). Force-shows the
                                 always-available Welcome card overlay on the canvas.
                                 Non-destructive: the open graph stays loaded behind it
                                 (does NOT clear / close). Routes to
                                 LogicCanvasView.RequestShowWelcomeFromShell, the same
                                 canvas method the embedded chrome uses. -->
                            <MenuFlyoutItem x:Name="MenuFileWelcome" Text="Welcome" Click="OnFileWelcomeClicked" />
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem x:Name="MenuFileSave" Text="Save" Click="OnFileSaveClicked">
                                <MenuFlyoutItem.KeyboardAccelerators>
                                    <KeyboardAccelerator Modifiers="Control" Key="S" />
                                </MenuFlyoutItem.KeyboardAccelerators>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem x:Name="MenuFileSaveAs" Text="Save As..." Click="OnFileSaveAsClicked">
                                <MenuFlyoutItem.KeyboardAccelerators>
                                    <KeyboardAccelerator Modifiers="Control,Shift" Key="S" />
                                </MenuFlyoutItem.KeyboardAccelerators>
                            </MenuFlyoutItem>
                            <MenuFlyoutSeparator />
                            <!--  Restore previous version… parity with the
                                 embedded ArchitectChrome (File menu). Surfaces the
                                 rolling .phxg.bak[1-3] chain so the user can roll
                                 back a botched edit after Ctrl+Z is no longer
                                 enough (e.g. closed + reopened the window). -->
                            <MenuFlyoutItem x:Name="MenuFileRestore" Text="Restore previous version…" Click="OnFileRestoreClicked" />
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem x:Name="MenuFileExport" Text="Export to .phx" Click="OnFileExportClicked" />
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem x:Name="MenuFileClose" Text="Close Window" Click="OnFileCloseClicked">
                                <MenuFlyoutItem.KeyboardAccelerators>
                                    <KeyboardAccelerator Modifiers="Control" Key="W" Invoked="OnMenuAcceleratorInvoked" />
                                </MenuFlyoutItem.KeyboardAccelerators>
                            </MenuFlyoutItem>
                        </MenuBarItem>
                        <MenuBarItem x:Name="MenuEdit" Title="Edit">
                            <MenuFlyoutItem x:Name="MenuEditUndo" Text="Undo" Click="OnEditUndoClicked">
                                <MenuFlyoutItem.KeyboardAccelerators>
                                    <KeyboardAccelerator Modifiers="Control" Key="Z" Invoked="OnMenuAcceleratorInvoked" />
                                </MenuFlyoutItem.KeyboardAccelerators>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem x:Name="MenuEditRedo" Text="Redo" Click="OnEditRedoClicked">
                                <MenuFlyoutItem.KeyboardAccelerators>
                                    <KeyboardAccelerator Modifiers="Control" Key="Y" Invoked="OnMenuAcceleratorInvoked" />
                                </MenuFlyoutItem.KeyboardAccelerators>
                            </MenuFlyoutItem>
                            <MenuFlyoutSeparator />
                            <!--  Group + Comment Frame parity with the embedded
                                 ArchitectChrome menu — the sibling window was missing the
                                 collapse-selection-to-macro and add-comment-frame chords. -->
                            <MenuFlyoutItem x:Name="MenuEditGroup" Text="Group Selection" Click="OnEditGroupClicked">
                                <MenuFlyoutItem.KeyboardAccelerators>
                                    <KeyboardAccelerator Modifiers="Control" Key="G" Invoked="OnMenuAcceleratorInvoked" />
                                </MenuFlyoutItem.KeyboardAccelerators>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem x:Name="MenuEditCommentFrame" Text="Add Comment Frame" Click="OnEditCommentFrameClicked">
                                <MenuFlyoutItem.KeyboardAccelerators>
                                    <KeyboardAccelerator Key="C" Invoked="OnMenuAcceleratorInvoked" />
                                </MenuFlyoutItem.KeyboardAccelerators>
                            </MenuFlyoutItem>
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem x:Name="MenuEditFind" Text="Find Node..." Click="OnEditFindClicked">
                                <MenuFlyoutItem.KeyboardAccelerators>
                                    <KeyboardAccelerator Modifiers="Control" Key="F" Invoked="OnMenuAcceleratorInvoked" />
                                </MenuFlyoutItem.KeyboardAccelerators>
                            </MenuFlyoutItem>
                        </MenuBarItem>
                        <MenuBarItem x:Name="MenuView" Title="View">
                            <MenuFlyoutItem x:Name="MenuViewFrame" Text="Frame Selection" Click="OnViewFrameSelectionClicked">
                                <MenuFlyoutItem.KeyboardAccelerators>
                                    <KeyboardAccelerator Key="F" Invoked="OnMenuAcceleratorInvoked" />
                                </MenuFlyoutItem.KeyboardAccelerators>
                            </MenuFlyoutItem>
                            <ToggleMenuFlyoutItem x:Name="MenuViewShowGrid" Text="Show Grid" IsChecked="True" Click="OnViewShowGridClicked" />
                            <!--  — Minimap visibility toggle.
                                 Routes through CanvasView.SetMinimapVisible
                                 so the persistence + in-overlay × sync use
                                 the same path as MainView. -->
                            <ToggleMenuFlyoutItem x:Name="MenuViewMinimap" Text="Minimap" IsChecked="True" Click="OnViewMinimapClicked" />
                            <!--  Live Debug toggle + Spawn Palette parity with
                                 ArchitectChrome. -->
                            <ToggleMenuFlyoutItem x:Name="MenuViewLiveDebug" Text="Live Debug" Click="OnViewLiveDebugClicked">
                                <ToggleMenuFlyoutItem.KeyboardAccelerators>
                                    <KeyboardAccelerator Modifiers="Control,Shift" Key="D" Invoked="OnMenuAcceleratorInvoked" />
                                </ToggleMenuFlyoutItem.KeyboardAccelerators>
                            </ToggleMenuFlyoutItem>
                            <MenuFlyoutItem x:Name="MenuViewSpawn" Text="Spawn Node..." Click="OnViewSpawnPaletteClicked">
                                <MenuFlyoutItem.KeyboardAccelerators>
                                    <KeyboardAccelerator Modifiers="Control" Key="Space" Invoked="OnMenuAcceleratorInvoked" />
                                </MenuFlyoutItem.KeyboardAccelerators>
                            </MenuFlyoutItem>
                            <MenuFlyoutSeparator />
                            <!--  Bookmarks legend… parity with ArchitectChrome's
                                 View menu. Lists the 9 slot states + Ctrl/Alt+1..9 chord
                                 hints so the bookmark feature is discoverable. Routes to
                                 LogicCanvasView.ShowBookmarkLegendFlyout (same canvas
                                 method the embedded chrome uses). -->
                            <MenuFlyoutItem x:Name="MenuViewBookmarks" Text="Bookmarks legend…" Click="OnViewBookmarksClicked" />
                        </MenuBarItem>
                        <!--  P1-A16 — Script menu parity with
                             ArchitectChrome (the Hub-embedded view). Pre-T15
                             MainForm hosted this menu with a single entry
                             ("Sync Event Peers"); the underlying scheduler
                             survived T15 but became unreachable from chrome. -->
                        <MenuBarItem x:Name="MenuScript" Title="Script">
                            <MenuFlyoutItem x:Name="MenuScriptSyncEventPeers"
                                            Text="Sync Event Peers"
                                            Click="OnScriptSyncEventPeersClicked"
                                            ToolTipService.ToolTip="Propagate Event.Trigger/Executor/Return socket lists to peer .phxg files in the same project." />
                        </MenuBarItem>
                        <MenuBarItem x:Name="MenuHelp" Title="Help">
                            <MenuFlyoutItem x:Name="MenuHelpNodeRef" Text="Node Reference" Click="OnHelpNodeRefClicked">
                                <MenuFlyoutItem.KeyboardAccelerators>
                                    <KeyboardAccelerator Key="F1" Invoked="OnMenuAcceleratorInvoked" />
                                </MenuFlyoutItem.KeyboardAccelerators>
                            </MenuFlyoutItem>
                            <MenuFlyoutSeparator />
                            <!--  P1-A17 — Keyboard Shortcuts… dialog
                                 parity with the Hub-embedded chrome. F1-on-
                                 empty-canvas also routes here per
                                  P1-A13. -->
                            <MenuFlyoutItem x:Name="MenuHelpShortcuts"
                                            Text="Keyboard Shortcuts…"
                                            Click="OnHelpShortcutsClicked" />
                        </MenuBarItem>
                    </MenuBar>
                </Border>
            </controls:ArchitectWindowChrome.SecondaryContent>
        </controls:ArchitectWindowChrome>

        <!-- Body: rail | canvas | inspector. 0.11.x polish — the docked
             inspector column is back per Majo's "inspector should be part
             of this window, not float underneath" feedback. Mirrors
             MainView's 4-column layout (rail | rail-splitter | canvas |
             inspector) so a sibling-Architect window has the same docked
             inspector affordance as the embedded MainView. The floating
             InspectorWindow path stays in the codebase as an opt-in popout
             but is no longer the default for sibling windows. -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="RailColumn"      Width="220" MinWidth="32" MaxWidth="360" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition x:Name="InspectorColumn" Width="0" MinWidth="0" MaxWidth="500" />
            </Grid.ColumnDefinitions>

            <controls:LeftRail x:Name="Rail" Grid.Column="0" Canvas.ZIndex="2"
                               AutomationProperties.Name="Left Rail" />

            <Border Grid.Column="1"
                    Canvas.ZIndex="1"
                    Background="{StaticResource CoalShellBrush}"
                    BorderBrush="{StaticResource CoalCardBrush}"
                    BorderThickness="1,0,0,0"
                    AutomationProperties.Name="Logic Canvas">
                <canvas:LogicCanvasView x:Name="CanvasView" />
            </Border>

            <!-- Right column: roll-up inspector card. Default-open per
                 AppConfig.ArchitectInspectorVisible (true by default).
                 Mirrors MainView.xaml's chevron pattern. -->
            <Grid Grid.Column="2"
                  Canvas.ZIndex="2"
                  Background="{x:Null}"
                  VerticalAlignment="Top"
                  AutomationProperties.Name="Inspector">
                <Border x:Name="InspectorCardRoot"
                        Background="{StaticResource CoalSurfaceBrush}"
                        BorderBrush="{StaticResource CoalCardBrush}"
                        BorderThickness="1,0,0,1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0"
                                Padding="6,5,6,5"
                                BorderBrush="{StaticResource CoalCardBrush}"
                                BorderThickness="0,0,0,1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           Text="INSPECTOR"
                                           VerticalAlignment="Center"
                                           Margin="6,0,0,0"
                                           FontFamily="{StaticResource DisplayFont}"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           CharacterSpacing="180"
                                           Foreground="{StaticResource CoalPaperBrush}" />
                                <Button x:Name="InspectorChevronButton"
                                        Grid.Column="1"
                                        Width="32"
                                        Height="26"
                                        Padding="0"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Foreground="{StaticResource CoalPaperBrush}"
                                        FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                        FontSize="14"
                                        ToolTipService.ToolTip="Roll up Inspector"
                                        AutomationProperties.Name="Roll up Inspector"
                                        Content="&#xE70D;"
                                        Click="OnInspectorChevronClicked" />
                            </Grid>
                        </Border>

                        <ContentControl x:Name="InspectorRegion"
                                        Grid.Row="1"
                                        VerticalAlignment="Top"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Stretch"
                                        VerticalContentAlignment="Stretch" />
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- Status strip — 24 px parity with MainView. Right zone surfaces
             node/link counts; left zone Ready / Saved / Error. -->
        <Border Grid.Row="2"
                Background="{StaticResource CoalRaisedBrush}"
                BorderBrush="{StaticResource CoalCardBrush}"
                BorderThickness="0,1,0,0"
                AutomationProperties.Name="Status Strip">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="10,0,0,0"
                            Spacing="6">
                    <Ellipse x:Name="StatusLight"
                             Width="10" Height="10"
                             Fill="{StaticResource CoalDividerBrush}"
                             Stroke="{StaticResource CoalCardBrush}"
                             StrokeThickness="1"
                             VerticalAlignment="Center" />
                    <TextBlock x:Name="StatusLeft"
                               VerticalAlignment="Center"
                               FontFamily="{StaticResource MonoFont}"
                               FontSize="11"
                               Foreground="{StaticResource CoalPrimaryTextBrush}"
                               Text="Ready" />
                </StackPanel>

                <TextBlock Grid.Column="1"
                           x:Name="StatusRight"
                           VerticalAlignment="Center"
                           Margin="0,0,12,0"
                           FontFamily="{StaticResource MonoFont}"
                           FontSize="11"
                           Foreground="{StaticResource CoalSecondaryTextBrush}" />
            </Grid>
        </Border>
    </Grid>
</Window>
