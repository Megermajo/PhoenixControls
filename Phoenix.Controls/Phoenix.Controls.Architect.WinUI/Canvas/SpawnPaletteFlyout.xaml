<?xml version="1.0" encoding="utf-8"?>
<Flyout
    x:Class="Phoenix.Controls.Architect.WinUI.Canvas.SpawnPaletteFlyout"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="using:Phoenix.Controls.Architect.WinUI.Localization">

    <Flyout.FlyoutPresenterStyle>
        <!-- 0.10.0 redesign R6 — coal-3 card body so the flyout reads as the
             same forged inlay as the dialog / panel chrome around it.
             CoalDivider hairline + Radius3 corner picks up the rest of the
             card-edge cadence in PhoenixDark.xaml. -->
        <Style TargetType="FlyoutPresenter">
            <Setter Property="Background"      Value="{StaticResource CoalCardBrush}" />
            <Setter Property="BorderBrush"     Value="{StaticResource CoalDividerBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius"    Value="{StaticResource Radius3Corner}" />
            <Setter Property="Padding"         Value="0" />
            <Setter Property="MaxWidth"        Value="380" />
            <Setter Property="MaxHeight"       Value="520" />
        </Style>
    </Flyout.FlyoutPresenterStyle>

    <Grid Width="360" Height="500" Background="{StaticResource CoalCardBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header band — one tier brighter than the card body so the eyebrow
             "SPAWN NODE" line reads as a labelled lid rather than a flat row. -->
        <Border Grid.Row="0"
                Background="{StaticResource CoalHoverBrush}"
                BorderBrush="{StaticResource CoalDividerBrush}"
                BorderThickness="0,0,0,1"
                Padding="12,8">
            <TextBlock Text="SPAWN NODE"
                       Style="{StaticResource EyebrowTextStyle}"
                       loc:Localize.Key="architect.canvas.spawn.header.eyebrow" />
        </Border>

        <TextBox x:Name="SearchBox"
                 Grid.Row="1"
                 Margin="10,8,10,4"
                 PlaceholderText="search…"
                 FontFamily="{StaticResource MonoFont}"
                 FontSize="12"
                 Background="{StaticResource CoalRaisedBrush}"
                 Foreground="{StaticResource CoalPrimaryTextBrush}"
                 BorderBrush="{StaticResource CoalDividerBrush}"
                 AutomationProperties.Name="Filter nodes to spawn"
                 loc:Localize.PlaceholderKey="architect.canvas.spawn.search.placeholder"
                 loc:Localize.AutomationKey="architect.canvas.spawn.search.a11y" />

        <ListView x:Name="TemplateList"
                  Grid.Row="2"
                  Margin="0,4,0,8"
                  SelectionMode="Single"
                  Background="Transparent"
                  ItemsSource="{x:Null}">
            <ListView.ItemContainerStyle>
                <!-- Per-item IsClickable lights up clickable rows; header rows
                     stay non-interactive so the section dividers don't accept
                     taps. -->
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid Padding="0,2" AutomationProperties.Name="{Binding Title}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="6" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="3" CornerRadius="1.5"
                                Background="{Binding HeaderBrush}"
                                Visibility="{Binding ClickableVis}" />
                        <!-- Header row: EyebrowTextStyle (SemiBold sans, tracked-out
                             small caps) — matches the redesign R6 category headers
                             so the spawn palette and the rest of the chrome share
                             the same eyebrow vocabulary. -->
                        <TextBlock Grid.Column="1"
                                   Text="{Binding Title}"
                                   Margin="6,4,0,0"
                                   Style="{StaticResource EyebrowTextStyle}"
                                   Visibility="{Binding HeaderVis}" />
                        <!-- Clickable row: title + category. Matched-substring
                             highlight applied via TextHighlighter in code-behind
                             when the filter pass realizes each container. -->
                        <StackPanel Grid.Column="1" Margin="8,0,0,0"
                                    Visibility="{Binding ClickableVis}">
                            <TextBlock x:Name="TitleText"
                                       Text="{Binding DisplayTitle}"
                                       FontFamily="{StaticResource SansFont}"
                                       FontSize="12"
                                       Foreground="{StaticResource CoalPrimaryTextBrush}" />
                            <TextBlock Text="{Binding Category}"
                                       FontFamily="{StaticResource MonoFont}"
                                       FontSize="9"
                                       Foreground="{StaticResource CoalSecondaryTextBrush}"
                                       CharacterSpacing="120"
                                       Visibility="{Binding CategoryLabelVis}" />
                        </StackPanel>
                        <!-- Ember NEW badge (0.10.0 redesign R6) — visible only
                             for templates flagged in SpawnPaletteFlyout's
                             s_newTemplateTitles set. Tiny pill, brass fill,
                             coal-shell text, right-aligned so it reads as a
                             marker rather than an action. -->
                        <Border Grid.Column="2"
                                Visibility="{Binding NewBadgeVis}"
                                Background="{StaticResource EmberShadowBrush}"
                                CornerRadius="2"
                                Padding="5,1"
                                Margin="6,4,8,0"
                                VerticalAlignment="Top">
                            <TextBlock Text="NEW"
                                       FontFamily="{StaticResource SansFont}"
                                       FontSize="8"
                                       FontWeight="SemiBold"
                                       CharacterSpacing="120"
                                       Foreground="{StaticResource CoalShellBrush}"
                                       loc:Localize.Key="architect.canvas.spawn.new_badge" />
                        </Border>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Flyout>
