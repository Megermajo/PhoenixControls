<?xml version="1.0" encoding="utf-8" ?>
<ContentDialog
    x:Class="Phoenix.Controls.Hub.WinUI.Dialogs.UpdaterProgressDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    DefaultButton="None"
    Background="{StaticResource CoalSurfaceBrush}"
    RequestedTheme="Dark">
    <!-- Cancel is a secondary action — restyle to CoalSecondary so the
         button doesn't visually outrank the action it's cancelling.
         (EmberPrimary is reserved for the affirmative CTA, which the
         updater flow doesn't expose: the dialog is purely progress +
         cancel; success closes itself when Hub exits for the swap.) -->

    <ContentDialog.Resources>
        <!-- Local-only styles. UpdaterProgress* prefix makes the locality
             explicit so a future reviewer can grep for shared-vs-local origin. -->
        <Style x:Key="UpdaterProgressEyebrow" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{StaticResource Ember200Brush}" />
            <Setter Property="CharacterSpacing" Value="180" />
        </Style>
        <Style x:Key="UpdaterProgressBody" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource SansFont}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{StaticResource CoalBodyTextBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </ContentDialog.Resources>

    <!-- HUB-UX P2 — failure-escalation frame. On terminal "failed" phase
         we re-tint BorderBrush to ErrBrush so the whole dialog reads as
         "something broke", not just the inline status text. Border stays
         transparent in the steady state so the ContentDialog's own chrome
         is what the user sees during normal progress. -->
    <Border x:Name="DialogFrame"
            BorderBrush="Transparent"
            BorderThickness="2"
            CornerRadius="2"
            Padding="6">
    <Grid Width="520" MinHeight="180">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" /> <!--  unresponsive banner -->
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Phase eyebrow ("DOWNLOADING…", "VERIFYING…", etc.) — wrapped
             in a horizontal stack so the failure-state warning glyph
             (FailureIcon) can sit beside it on terminal errors. -->
        <StackPanel Grid.Row="0"
                    Orientation="Horizontal"
                    Spacing="8"
                    Margin="0,0,0,6">
            <FontIcon x:Name="FailureIcon"
                      Glyph="&#xE7BA;"
                      FontSize="14"
                      Foreground="{StaticResource ErrBrush}"
                      VerticalAlignment="Center"
                      Visibility="Collapsed" />
            <TextBlock x:Name="PhaseEyebrowText"
                       Style="{StaticResource UpdaterProgressEyebrow}"
                       VerticalAlignment="Center" />
        </StackPanel>

        <!-- Bar + percent.  Percent text sits to the right; bar takes the rest. -->
        <Grid Grid.Row="1" ColumnSpacing="10" Margin="0,4,0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ProgressBar Grid.Column="0"
                         x:Name="ProgressBarControl"
                         Minimum="0"
                         Maximum="100"
                         Value="0"
                         Height="6"
                         Foreground="{StaticResource Ember200Brush}"
                         Background="{StaticResource CoalRaisedBrush}"
                         IsIndeterminate="True" />
            <TextBlock Grid.Column="1"
                       x:Name="PercentText"
                       FontFamily="{StaticResource MonoFont}"
                       FontSize="11"
                       Foreground="{StaticResource CoalSecondaryTextBrush}"
                       VerticalAlignment="Center"
                       Text="" />
        </Grid>

        <!-- Status text from Updater. -->
        <TextBlock Grid.Row="2"
                   x:Name="StatusText"
                   Style="{StaticResource UpdaterProgressBody}"
                   Margin="0,8,0,4" />

        <!--  Unresponsive-Updater escape hatch. Shown when the
             dialog has been parked on await_hub_exit for >60s with no
             progress — meaning the Updater was likely killed externally
             (Task Manager, AV quarantine, OS reboot) and Hub is now stuck
             waiting on a process that will never write again. Inline
             message + Close button rescue the user without a modal
             confirmation dance. Collapsed by default. -->
        <Border Grid.Row="3"
                x:Name="UnresponsiveBanner"
                Visibility="Collapsed"
                Background="{StaticResource CoalRaisedBrush}"
                BorderBrush="{StaticResource ErrBrush}"
                BorderThickness="1"
                CornerRadius="2"
                Padding="10,8"
                Margin="0,10,0,0">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <FontIcon Glyph="&#xE7BA;"
                          FontSize="14"
                          Foreground="{StaticResource ErrBrush}"
                          VerticalAlignment="Center" />
                <TextBlock x:Name="UnresponsiveBannerText"
                           Style="{StaticResource UpdaterProgressBody}"
                           VerticalAlignment="Center" />
            </StackPanel>
        </Border>

        <!-- Divider before the action row. -->
        <Border Grid.Row="4"
                Height="1"
                Margin="0,12,0,8"
                Background="{StaticResource CoalDividerBrush}" />

        <!-- Action row. CancelButton is the steady-state action; CloseButton
             is the  watchdog-only escape (Collapsed by default,
             surfaced once the unresponsive threshold trips). -->
        <StackPanel Grid.Row="5"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Spacing="8">
            <Button x:Name="CloseButton"
                    Visibility="Collapsed"
                    Click="OnCloseClicked"
                    Style="{StaticResource CoalSecondaryButtonStyle}" />
            <Button x:Name="CancelButton"
                    Click="OnCancelClicked"
                    Style="{StaticResource CoalSecondaryButtonStyle}" />
        </StackPanel>
    </Grid>
    </Border>
</ContentDialog>
