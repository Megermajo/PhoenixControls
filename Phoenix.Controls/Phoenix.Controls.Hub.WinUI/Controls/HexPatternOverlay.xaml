<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Phoenix.Controls.Hub.WinUI.Controls.HexPatternOverlay"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    IsHitTestVisible="False">

    <!-- Hex stroke pattern overlay layered on top of the flat coal background
         (HUB-UX-D2: "very discreet hexagonal pattern"). Render-only — never
         hit-tests, so panels above keep their normal pointer routing.
         The Canvas is populated in code-behind on SizeChanged with a
         flat-top hex grid sized to fill its bounds. Stroke-only, ~6% alpha
         against the parent CoalShell. -->
    <Canvas x:Name="HexCanvas"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            UseLayoutRounding="False" />
</UserControl>
