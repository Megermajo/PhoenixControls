<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Phoenix.Controls.Hub.WinUI.Controls.HubChrome"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Phoenix.Controls.Hub.WinUI.Controls">

    <UserControl.Resources>
        <!-- Implicit MenuFlyoutPresenter style — applies to every submenu
             popup hosted by HubMenuBar. Scoped here (not the App-wide
             dictionary) so non-chrome MenuFlyouts elsewhere in Hub still
             get the system default. Mirrors the explicit-key
             ChromeMenuFlyoutPresenterStyle in PhoenixDark.xaml. -->
        <Style TargetType="MenuFlyoutPresenter" BasedOn="{StaticResource ChromeMenuFlyoutPresenterStyle}" />
    </UserControl.Resources>

    <Grid Background="{StaticResource CoalSurfaceBrush}">
        <Grid.RowDefinitions>
            <!-- HubChrome row heights — tokens authored in HubBrushes.xaml so
                 the three-row chrome cadence (brass / main / pillar tabs)
                 has a single source of truth. (Hub UI sweep P2.) -->
            <RowDefinition Height="{StaticResource HubChromeBrassRowHeight}" />
            <RowDefinition Height="{StaticResource HubChromeMainRowHeight}" />
            <RowDefinition Height="{StaticResource HubChromePillarRowHeight}" />
        </Grid.RowDefinitions>

        <!-- 1) Brass hairline (decorative — screen-reader hides) -->
        <Border Grid.Row="0"
                Background="{StaticResource BrassGradientBrush}"
                AutomationProperties.AccessibilityView="Raw" />

        <!-- 2) Main bar: mark + name + menus + divider + drag region + traffic lights
             0.11.x polish — filename + close-X moved to the pillar row
             (Grid.Row="2") so the document-close affordance no longer
             sits cheek-to-jowl with the system close button. -->
        <Grid Grid.Row="1" Padding="10,0,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />     <!-- mark + name + divider -->
                <ColumnDefinition Width="Auto" />     <!-- menu bar -->
                <ColumnDefinition Width="Auto" />     <!-- divider between menus and drag region -->
                <ColumnDefinition Width="*" />        <!-- drag region -->
                <ColumnDefinition Width="Auto" />     <!-- Ko-fi support button (left of the traffic lights) -->
                <ColumnDefinition Width="Auto" />     <!-- custom traffic lights (3 x 38 = 114 px) -->
            </Grid.ColumnDefinitions>
            <Grid.Background>
                <StaticResource ResourceKey="PanelHeaderGradientBrush" />
            </Grid.Background>

            <StackPanel Grid.Column="0" Orientation="Horizontal"
                        VerticalAlignment="Center" Spacing="8">
                <!-- Perf-review M21: DecodePixelWidth tells WinUI to decode at
                     the 18 DIP display size instead of the PNG's native
                     resolution. Without this the full-size bitmap stayed in
                     memory for an 18 px chrome icon. -->
                <Image Width="18" Height="18" Stretch="Uniform">
                    <Image.Source>
                        <BitmapImage UriSource="ms-appx:///Assets/phoenix-mark.png" DecodePixelWidth="36" />
                    </Image.Source>
                </Image>
                <TextBlock VerticalAlignment="Center"
                           FontFamily="{StaticResource DisplayFont}"
                           FontSize="13"
                           CharacterSpacing="180">
                    <Run Text="PHOENIX" Foreground="{StaticResource Ember200Brush}" />
                    <Run Text="  CONTROLS" Foreground="{StaticResource CoalBodyTextBrush}" />
                </TextBlock>
                <Border Width="1" Height="14"
                        Background="{StaticResource CoalHoverBrush}"
                        Margin="8,0,8,0"
                        AutomationProperties.AccessibilityView="Raw" />
            </StackPanel>

            <!-- WinUI 3 MenuBar — items populated in code-behind from APP_MENUS["hub"] table -->
            <MenuBar x:Name="HubMenuBar"
                     Grid.Column="1"
                     VerticalAlignment="Center"
                     Background="Transparent" />

            <!-- Hairline divider — disambiguates the seam between the menu strip
                 and the drag region so a click just past the last menu item no
                 longer accidentally starts a window-drag (TODO 2026-05-07 P1).
                 AccessibilityView=Raw — pure decoration, screen-reader hides. -->
            <Border Grid.Column="2"
                    Width="1"
                    Margin="6,6,8,6"
                    Background="{StaticResource CoalDividerBrush}"
                    AutomationProperties.AccessibilityView="Raw" />

            <!-- 3) Drag region — passed to Window.SetTitleBar for native window-drag behavior -->
            <Grid x:Name="DragRegion" x:FieldModifier="public" Grid.Column="3" Background="Transparent" />

            <!-- Discrete Ko-fi "support development" chrome button. Lives in the
                 main bar to the LEFT of the system traffic lights (Majo 2026-06-27
                 — moved here from the SettingsDialog footer, where it rendered
                 below the ContentDialog's clipped content area and never showed).
                 It sits in its own column OUTSIDE the DragRegion above, so — like
                 the traffic-light buttons — it receives normal pointer input even
                 though it's inside the extended title-bar area. The control owns
                 its own localized label + Ko-fi launch (KofiSupportButton). -->
            <local:KofiSupportButton Grid.Column="4"
                                     VerticalAlignment="Center"
                                     Margin="0,0,10,0" />

            <!-- Custom 38 x 30 traffic lights (redesign R2 / chrome.jsx
                 TrafficLight). MainWindow flips the AppWindow presenter to
                 SetBorderAndTitleBar(true, false) on construction so the
                 system caption is gone — the chrome owns the entire 30 px
                 main bar including the buttons. Wired up in code-behind
                 so the click handlers reach AppWindow.Minimize / Restore /
                 Close without coupling the UserControl to a specific
                 Window instance. -->
            <StackPanel Grid.Column="5" Orientation="Horizontal">
                <local:TrafficLightButton x:Name="MinButton" Kind="Minimize" />
                <local:TrafficLightButton x:Name="MaxButton" Kind="MaximizeRestore" />
                <local:TrafficLightButton x:Name="CloseButton" Kind="Close" />
            </StackPanel>
        </Grid>

        <!-- 3) Pillar tab strip + version -->
        <Grid Grid.Row="2" Padding="10,0"
              Background="{StaticResource CoalSurfaceBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <local:PillarTab x:Name="HubTab"
                             Grid.Column="0"
                             Pillar="Hub"
                             IsActive="True" />

            <local:PillarTab x:Name="ArchitectTab"
                             Grid.Column="1"
                             Pillar="Architect"
                             Margin="2,0,0,0" />

            <local:PillarTab x:Name="VisualistTab"
                             Grid.Column="2"
                             Pillar="Visualist"
                             Margin="2,0,0,0" />

            <!-- 4th tab: Giveaway. NOT a PillarKind pillar (those ordinals are
                 load-bearing and represent only the three surface-swap
                 surfaces). This tab opens an independent pop-out window via a
                 distinct GiveawayTabClicked event — it never swaps
                 MainPaneRegion content and never becomes "active", so it stays
                 in the inactive PillarTab visual state. Styled to match
                 PillarTab inline (G sigil box + "GIVEAWAY" label). -->
            <Border x:Name="GiveawayTab"
                    Grid.Column="3"
                    Height="30"
                    Margin="2,0,0,0"
                    Padding="10,0,14,0"
                    CornerRadius="4,4,0,0"
                    VerticalAlignment="Bottom"
                    Background="Transparent"
                    IsTabStop="True"
                    UseSystemFocusVisuals="True"
                    FocusVisualPrimaryBrush="{StaticResource EmberPrimaryBrush}"
                    FocusVisualSecondaryBrush="{StaticResource CoalCardBrush}"
                    PointerEntered="OnGiveawayTabPointerEntered"
                    PointerExited="OnGiveawayTabPointerExited"
                    PointerPressed="OnGiveawayTabPointerPressed"
                    KeyDown="OnGiveawayTabKeyDown"
                    AutomationProperties.Name="Giveaway"
                    ToolTipService.ToolTip="Giveaway — opens in its own window">
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Border Width="18" Height="18"
                            CornerRadius="2"
                            BorderThickness="1"
                            BorderBrush="{StaticResource CoalDividerSubtleBrush}"
                            Background="{StaticResource EmberShadowBrush}">
                        <TextBlock Text="G"
                                   FontFamily="{StaticResource DisplayFont}"
                                   FontSize="12" FontWeight="Bold"
                                   Foreground="{StaticResource CoalPaperBrush}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>
                    <TextBlock x:Name="GiveawayTabLabel"
                               Text="GIVEAWAY"
                               FontFamily="{StaticResource DisplayFont}"
                               FontSize="14"
                               CharacterSpacing="80"
                               VerticalAlignment="Center">
                        <TextBlock.Foreground>
                            <SolidColorBrush x:Name="GiveawayTabLabelBrush" Color="#9C8A72" />
                        </TextBlock.Foreground>
                    </TextBlock>
                </StackPanel>
            </Border>

            <Grid x:Name="PillarStripDragRegion" Grid.Column="4" Background="Transparent" />

            <!-- 0.11.x polish — pillar-row right-edge cluster. Version
                 stamp anchored to the TOP of the row; the document
                 filename + close-X cluster directly UNDER it, anchored
                 to the BOTTOM of the row. Pre-fix the close-X lived in
                 the main bar (Row 1) immediately to the left of the
                 system minimize / maximize / close buttons, which read
                 as a fourth window-close button. Anchoring it under the
                 version stamp puts it in the per-document chrome strip
                 where it logically belongs, visually distinct from the
                 window controls overhead.

                 Both children sit directly in column 5 (no wrapping
                 panel) so VerticalAlignment Top / Bottom span the full
                 pillar row height (34 px token); the version's natural
                 ~14 px and the close-X's 18 px fit inside that envelope
                 without needing to grow the row. -->
            <TextBlock x:Name="VersionStamp"
                       Grid.Column="5"
                       VerticalAlignment="Top"
                       HorizontalAlignment="Right"
                       Margin="0,2,0,0"
                       FontFamily="{StaticResource MonoFont}"
                       FontSize="10"
                       CharacterSpacing="100"
                       Foreground="{StaticResource CoalSecondaryTextBrush}"
                       Text="v0.0.0 — DEV" />
            <StackPanel Grid.Column="5"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Bottom"
                        Margin="0,0,0,2"
                        Spacing="6">
                <TextBlock x:Name="FilenameText"
                           VerticalAlignment="Center"
                           FontSize="11"
                           FontFamily="{StaticResource MonoFont}"
                           Foreground="{StaticResource CoalSecondaryTextBrush}"
                           Text="" />
                <!-- 16 × 16 / 10pt — kept compact so the cluster fits
                     inside the 34 px pillar-row envelope alongside the
                     version stamp above. -->
                <Button x:Name="CloseFileButton"
                        Width="16"
                        Height="16"
                        Padding="0"
                        MinWidth="0"
                        MinHeight="0"
                        Background="Transparent"
                        BorderThickness="0"
                        CornerRadius="3"
                        Foreground="{StaticResource CoalPrimaryTextBrush}"
                        FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                        FontSize="10"
                        Content="&#xE711;"
                        ToolTipService.ToolTip="Close file"
                        AutomationProperties.Name="Close current file"
                        Visibility="Collapsed"
                        Click="OnCloseFileClicked" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
