<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Phoenix.Controls.Hub.WinUI.Panels.ScriptPanel.ScriptStatusDot"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- M36 (2026-05-14): the amber (Queued/Running) and red (Errored)
         continuous pulses used to be XAML Storyboards animating the
         Ellipse's ScaleTransform. Replaced with Composition-API animations
         in code-behind (StartAmberPulse / StartRedPulse) so the pulse runs
         on the DComp render thread and integrates with M17's per-Window
         activation gate via AnimationController.Pause / Resume. The
         ScaleTransform on the Ellipse was likewise dropped so Composition's
         Visual.Scale isn't multiplied with a residual XAML transform. -->

    <!-- §4.6 — filled circle with a 1px black @ 30% alpha border for
         definition. Stroke is painted on the Ellipse directly rather than
         wrapping in a Border so the pulse ScaleTransform animates the
         border in lockstep with the fill (a wrapping Border would skip
         the storyboard target). StrokeThickness=1 keeps the 6px footprint
         the existing layout reserves. -->
    <Ellipse x:Name="DotEllipse"
             Width="10" Height="10"
             Fill="{x:Bind DotBrush, Mode=OneWay}"
             Stroke="{StaticResource StatusDotBorderBrush}"
             StrokeThickness="1"
             RenderTransformOrigin="0.5,0.5"
             ToolTipService.ToolTip="{x:Bind StateText, Mode=OneWay}"
             AutomationProperties.Name="{x:Bind StateText, Mode=OneWay}">
        <Ellipse.RenderTransform>
            <ScaleTransform x:Name="DotScale" ScaleX="1" ScaleY="1" />
        </Ellipse.RenderTransform>
    </Ellipse>
</UserControl>
