<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Phoenix.Controls.Hub.WinUI.Panels.ScriptPanel.ScriptView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:hdr="using:Phoenix.Controls.Hub.WinUI.Panels.Common"
    xmlns:local="using:Phoenix.Controls.Hub.WinUI.Panels.ScriptPanel"
    HorizontalAlignment="Stretch"
    VerticalAlignment="Stretch"
    HorizontalContentAlignment="Stretch"
    VerticalContentAlignment="Stretch"
    AutomationProperties.Name="Scripts panel"
    AutomationProperties.HelpText="One row per script in the active data/logic folder, with traffic-light status, CPU and RAM cost, and run count. Right-click a row for open, reload, reveal, and last-error actions.">

    <UserControl.Resources>
        <Style x:Key="ScriptPanelColumnHeaderText" TargetType="TextBlock">
            <Setter Property="FontFamily"        Value="{StaticResource SansFont}" />
            <Setter Property="FontSize"          Value="9" />
            <Setter Property="FontWeight"        Value="Bold" />
            <Setter Property="CharacterSpacing"  Value="120" />
            <Setter Property="Foreground"        Value="{StaticResource CoalSecondaryTextBrush}" />
        </Style>
    </UserControl.Resources>

    <Border Background="{StaticResource CoalSurfaceBrush}"
            BorderBrush="{StaticResource CoalDividerBrush}"
            BorderThickness="1"
            CornerRadius="{StaticResource Radius3Corner}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />   <!-- panel header -->
                <RowDefinition Height="Auto" />   <!-- sticky column header -->
                <RowDefinition Height="*" />      <!-- script rows -->
            </Grid.RowDefinitions>

            <hdr:PanelHeader Grid.Row="0"
                             Eyebrow="03"
                             TitleKey="panel.scripts.title"
                             Title="Scripts">
                <hdr:PanelHeader.RightContent>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock FontFamily="{StaticResource MonoFont}"
                                   FontSize="10"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource CoalSecondaryTextBrush}"
                                   Text="{x:Bind ViewModel.SummaryText, Mode=OneWay}" />
                        <Border Width="1" Background="{StaticResource CoalDividerBrush}" Margin="2,2" />
                        <Button x:Name="PopOutButton"
                                Background="Transparent"
                                BorderThickness="0"
                                Padding="6,2"
                                Foreground="{StaticResource CoalSecondaryTextBrush}"
                                Click="OnPopOutClick">
                            <!-- Hub UI sweep 2026-05-22 — added "pop-out"
                                 label next to the icon (matches SystemLog
                                 pattern). Tooltip + AutomationProperties.Name
                                 + label text flow from
                                 ScriptView.ApplyLocalizedStrings via Localizer.T. -->
                            <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                <PathIcon Data="{StaticResource PhoenixIcon_PopOut}"
                                          Width="{StaticResource IconSizeS}"
                                          Height="{StaticResource IconSizeS}"
                                          Foreground="{StaticResource CoalSecondaryTextBrush}" />
                                <TextBlock x:Name="PopOutLabel"
                                           FontFamily="{StaticResource SansFont}"
                                           FontSize="11"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </hdr:PanelHeader.RightContent>
            </hdr:PanelHeader>

            <!-- Sticky column header row -->
            <Border Grid.Row="1"
                    Background="{StaticResource CoalRaisedBrush}"
                    BorderBrush="{StaticResource CoalDividerBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="14,6">
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="26" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="95" />
                        <ColumnDefinition Width="70" />
                        <ColumnDefinition Width="70" />
                        <ColumnDefinition Width="60" />
                        <ColumnDefinition Width="60" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" />
                    <TextBlock Grid.Column="1" x:Name="HeaderScript" Style="{StaticResource ScriptPanelColumnHeaderText}" />
                    <TextBlock Grid.Column="2" x:Name="HeaderStatus" Style="{StaticResource ScriptPanelColumnHeaderText}" />
                    <TextBlock Grid.Column="3" x:Name="HeaderTime"   Style="{StaticResource ScriptPanelColumnHeaderText}" />
                    <TextBlock Grid.Column="4" x:Name="HeaderRam"    Style="{StaticResource ScriptPanelColumnHeaderText}" />
                    <TextBlock Grid.Column="5" x:Name="HeaderRuns"   Style="{StaticResource ScriptPanelColumnHeaderText}" />
                    <!-- B5 (audit 2026-05-24) — concurrent-slot column.
                         Header label "QUEUE" surfaces the "N / M"
                         in-flight vs configured concurrency cap. -->
                    <TextBlock Grid.Column="6" x:Name="HeaderQueue"  Style="{StaticResource ScriptPanelColumnHeaderText}" />
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="2"
                          x:Name="ScriptScrollViewer"
                          HorizontalScrollMode="Disabled"
                          HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto">
                <ItemsRepeater x:Name="ScriptRepeater"
                               ItemsSource="{x:Bind ViewModel.Rows, Mode=OneWay}"
                               ElementPrepared="OnRowElementPrepared"
                               ElementClearing="OnRowElementClearing">
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="local:ScriptRowVm">
                            <!-- Multi-select restoration (Lane C, 2026-06-01):
                                 the outer Border carries the data-row visuals
                                 (errored tint via RowBackgroundBrush + disabled
                                 RowOpacity). The selection tint can't bind to
                                 the VM (ScriptRowVm has no IsSelected and is
                                 out-of-lane), so the inner SelectionOverlay
                                 Border is driven imperatively from code-behind
                                 via ElementPrepared / ElementClearing + the
                                 _selectedRows set. It sits *behind* the column
                                 Grid (first child, lower z-order) so the gold
                                 SelectionDimBrush tints the whole row without
                                 obscuring text. -->
                            <Border BorderBrush="{StaticResource CoalRaisedBrush}"
                                    BorderThickness="0,0,0,1"
                                    Padding="14,6"
                                    Background="{x:Bind RowBackgroundBrush, Mode=OneWay}"
                                    Opacity="{x:Bind RowOpacity, Mode=OneWay}"
                                    RightTapped="OnRowRightTapped"
                                    Tapped="OnRowTapped">
                                <Grid>
                                    <Border x:Name="SelectionOverlay"
                                            Visibility="Collapsed"
                                            Background="{StaticResource SelectionDimBrush}"
                                            BorderBrush="{StaticResource SelectionBrush}"
                                            BorderThickness="0,0,2,0"
                                            Margin="-14,-6" />
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="26" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="95" />
                                            <ColumnDefinition Width="70" />
                                            <ColumnDefinition Width="70" />
                                            <ColumnDefinition Width="60" />
                                            <ColumnDefinition Width="60" />
                                        </Grid.ColumnDefinitions>

                                    <CheckBox Grid.Column="0"
                                              MinWidth="20"
                                              IsChecked="{x:Bind IsEnabled, Mode=OneWay}"
                                              Click="OnEnableCheckClick" />

                                    <TextBlock Grid.Column="1"
                                               VerticalAlignment="Center"
                                               FontFamily="{StaticResource MonoFont}"
                                               FontSize="12"
                                               Foreground="{StaticResource CoalPrimaryTextBrush}"
                                               Text="{x:Bind ScriptName, Mode=OneWay}"
                                               ToolTipService.ToolTip="{x:Bind ScriptName, Mode=OneWay}"
                                               TextTrimming="CharacterEllipsis" />

                                    <StackPanel Grid.Column="2"
                                                Orientation="Horizontal"
                                                Spacing="6"
                                                VerticalAlignment="Center">
                                        <local:ScriptStatusDot State="{x:Bind State, Mode=OneWay}" />
                                        <TextBlock VerticalAlignment="Center"
                                                   FontSize="11"
                                                   Foreground="{x:Bind StateBrush, Mode=OneWay}"
                                                   Text="{x:Bind StateText, Mode=OneWay}" />
                                    </StackPanel>

                                    <TextBlock Grid.Column="3"
                                               VerticalAlignment="Center"
                                               FontFamily="{StaticResource MonoFont}"
                                               FontSize="11"
                                               Foreground="{StaticResource CoalBodyTextBrush}"
                                               Text="{x:Bind CpuText, Mode=OneWay}" />

                                    <TextBlock Grid.Column="4"
                                               VerticalAlignment="Center"
                                               FontFamily="{StaticResource MonoFont}"
                                               FontSize="11"
                                               Foreground="{StaticResource CoalBodyTextBrush}"
                                               Text="{x:Bind RamText, Mode=OneWay}" />

                                    <TextBlock Grid.Column="5"
                                               VerticalAlignment="Center"
                                               FontFamily="{StaticResource MonoFont}"
                                               FontSize="11"
                                               Foreground="{StaticResource CoalSecondaryTextBrush}"
                                               Text="{x:Bind RunsText, Mode=OneWay}" />
                                    <!-- B5 (audit 2026-05-24) — N / M queue
                                         depth surfaced from
                                         ScriptManager.GetQueueDepth via the
                                         row VM. Re-raises on every Status
                                         change so a slot acquire / release
                                         flicker propagates here. -->
                                    <TextBlock Grid.Column="6"
                                               VerticalAlignment="Center"
                                               FontFamily="{StaticResource MonoFont}"
                                               FontSize="11"
                                               Foreground="{StaticResource CoalSecondaryTextBrush}"
                                               Text="{x:Bind QueueDepthText, Mode=OneWay}" />
                                    </Grid>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
            </ScrollViewer>
        </Grid>
    </Border>
</UserControl>
