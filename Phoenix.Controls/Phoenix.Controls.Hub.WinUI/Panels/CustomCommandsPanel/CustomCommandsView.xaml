<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Phoenix.Controls.Hub.WinUI.Panels.CustomCommandsPanel.CustomCommandsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Phoenix.Controls.Hub.WinUI.Panels.CustomCommandsPanel"
    xmlns:cmn="using:Phoenix.Controls.Hub.WinUI.Panels.Common"
    xmlns:loc="using:Phoenix.Controls.Hub.WinUI.Localization"
    HorizontalAlignment="Stretch"
    VerticalAlignment="Stretch"
    HorizontalContentAlignment="Stretch"
    VerticalContentAlignment="Stretch"
    AutomationProperties.Name="Custom Commands page"
    AutomationProperties.HelpText="Create text/variable-only chat commands: enable the tool, add / edit / delete commands, set their response text, aliases, roles and cooldowns, and consult the variable library."
    loc:Localize.AutomationKey="panel.customcommands.page.a11y"
    loc:Localize.HelpTextKey="panel.customcommands.page.help">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Checked type by type per the shell contract. After the conversions
                     this page still declares TextBox (trigger, response, aliases,
                     counter name, both cooldowns) so the merge stays: it moves their
                     hover / focus / placeholder / selection states off the viewer's OS
                     accent and onto the house tokens. There is no ComboBox, no
                     ToggleSwitch, no CheckBox and no Pivot left in this file — the
                     master switch and the per-row enable are cmn:TogglePill, and the
                     six role boxes live inside RoleCheckRow, which merges the
                     dictionary itself. -->
                <ResourceDictionary Source="ms-appx:///Panels/Common/ToolControlStyles.xaml" />
                <!-- Keyed-only style dictionary: strip buttons, section cards, band
                     borders and the recurring text tiers. Contains no implicit Style. -->
                <ResourceDictionary Source="ms-appx:///Panels/Common/ToolShellStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Variable-library voices: mono ember token / sans coal description. -->
            <Style x:Key="CcLibToken" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
                <Setter Property="FontSize" Value="11" />
                <Setter Property="Foreground" Value="{StaticResource EmberPrimaryBrush}" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <Style x:Key="CcLibDesc" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource SansFont}" />
                <Setter Property="FontSize" Value="11" />
                <Setter Property="Foreground" Value="{StaticResource CoalSecondaryTextBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <!-- ══════════════ Roster row (300 px column) ══════════════
                 A summary row — this template did not exist before the house-shell
                 rebuild, when every row rendered the whole editor. The Button is the
                 selection surface; the enable pill nested inside it is its own Button
                 and swallows the press, so toggling a command does not also select it.

                 Padding sits on the inner Grid rather than the Button so the 2px
                 accent rail can run flush along the row's left edge. -->
            <DataTemplate x:Key="CommandRosterRowTemplate" x:DataType="local:CommandRowVm">
                <Button HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch"
                        Padding="0"
                        CornerRadius="0"
                        Background="{x:Bind RowBackground, Mode=OneWay}"
                        BorderBrush="{StaticResource CoalRaisedBrush}"
                        BorderThickness="0,0,0,1"
                        Click="OnCommandRowClick"
                        AutomationProperties.Name="{x:Bind TriggerDisplay, Mode=OneWay}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Enabled accent rail — ember when live, divider-coal when off. -->
                        <Border Grid.Column="0" Width="2"
                                Background="{x:Bind EnabledAccentBrush, Mode=OneWay}" />

                        <Grid Grid.Column="1" Padding="12,7" ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Spacing="2">
                                <TextBlock Text="{x:Bind TriggerDisplay, Mode=OneWay}"
                                           FontFamily="{StaticResource MonoFont}"
                                           FontSize="12" FontWeight="SemiBold"
                                           Foreground="{StaticResource EmberPrimaryBrush}"
                                           TextTrimming="CharacterEllipsis"
                                           TextWrapping="NoWrap" />
                                <TextBlock Text="{x:Bind ResponsePreview, Mode=OneWay}"
                                           FontFamily="{StaticResource SansFont}"
                                           FontSize="11"
                                           Foreground="{StaticResource CoalSecondaryTextBrush}"
                                           TextTrimming="CharacterEllipsis"
                                           TextWrapping="NoWrap" />
                            </StackPanel>

                            <Button Grid.Column="1"
                                    Padding="6,4"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    VerticalAlignment="Center"
                                    Click="OnRowEnabledClick"
                                    AutomationProperties.Name="Command enabled"
                                    ToolTipService.ToolTip="Enable or disable this command"
                                    loc:Localize.AutomationKey="panel.customcommands.roster.enabled.a11y"
                                    loc:Localize.TooltipKey="panel.customcommands.roster.enabled.tip">
                                <cmn:TogglePill IsOn="{x:Bind Enabled, Mode=OneWay}" />
                            </Button>
                        </Grid>
                    </Grid>
                </Button>
            </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Background="{StaticResource CoalSurfaceBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />   <!-- 48 px header band -->
            <RowDefinition Height="*" />      <!-- two-column body -->
        </Grid.RowDefinitions>

        <!-- ══════════════════ ROW 0 — HEADER BAND ══════════════════
             One 48 px row where three used to stack: the action strip, the
             pinned state-sentence band in the detail column, and the status
             pill. All three answered the same question — is this tool on —
             in three vocabularies (Commands off / DISABLED / dormant).

             The pill CONTROL and CustomCommandsService.PillState are untouched
             (PreBuildStatusPillTests still guards the predicate); only the
             render site moved, into PageHeader.SetState from code-behind.

             DELETE COMMAND is not here. It acts on the selection, so it moved
             into the selected-command card below, beside the thing it deletes —
             a destructive verb in the page header is one mis-aim away from a
             command the streamer wasn't looking at. -->
        <cmn:ToolPageHeader Grid.Row="0" x:Name="PageHeader" />

        <!-- ══════════════════ ROW 1 — TWO-COLUMN BODY ══════════════════ -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />     <!-- LEFT: detail  -->
                <ColumnDefinition Width="300" />   <!-- RIGHT: roster -->
            </Grid.ColumnDefinitions>
            <!-- No ColumnSpacing. The right column's left border IS the divider. -->

            <!-- ───────────── LEFT: detail ─────────────
                 The pinned state band that used to sit above this scroller is
                 gone: it rendered a master-state sentence carrying the same
                 boolean the header band's switch and state phrase now carry.

                 ★ NO IsEnabled GATE HERE, and that is deliberate. The master switch
                 gates whether chat can run these commands; it has never gated
                 AUTHORING them. Greying this scroller out would remove working
                 functionality (writing a command list while the tool is off), not
                 reflect the switch. -->
            <ScrollViewer Grid.Column="0"
                          x:Name="DetailScroll"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollMode="Disabled">
                <StackPanel Spacing="12" Padding="14">

                    <!-- The COMMANDS / ENABLED stat tiles were removed here: two
                         hero numerals reading 0 and 0 on a fresh install, sitting
                         above the first thing anyone came to this page to edit.
                         The one count worth a glance — how many commands exist —
                         is in the roster column's own header (CountText). -->

                    <TextBlock Style="{StaticResource ToolMonoHintTextStyle}"
                               Text="Text-only chat commands — !command sends the response with tokens filled in. API calls need Architect (Command.OnCustom)."
                               loc:Localize.Key="panel.customcommands.intro.hint" />

                    <!-- ═══ CHAT COMMANDS ═══
                         Every word this tool answers to, ALIASES INCLUDED — which
                         is the part the page could not show before. The roster on
                         the right is one line per command and names only the
                         trigger, so an alias lived exclusively inside the
                         comma-separated field of the command that owns it: to
                         learn what the channel could type you had to click every
                         command in turn.

                         Tool-wide, so it stays on screen with nothing selected —
                         the same reading as the VARIABLE LIBRARY further down,
                         and the reason it sits ABOVE the per-command editor
                         rather than inside it. -->
                    <cmn:ToolCommandList Commands="{x:Bind ViewModel.ChatCommands, Mode=OneWay}"
                                         AutomationProperties.Name="Custom chat commands"
                                         loc:Localize.AutomationKey="panel.customcommands.chat_commands.a11y" />

                    <!-- ═══ SELECTED COMMAND — the editor that used to be inline
                         on every roster row ═══ -->
                    <Border Style="{StaticResource ToolSectionCardStyle}"
                            Visibility="{x:Bind ViewModel.DetailVisibility, Mode=OneWay}">
                        <StackPanel Spacing="10">

                            <!-- Header: !trigger + the enable pill + DELETE.
                                 DELETE came down from the old action strip when
                                 that strip was replaced by the 48 px header band.
                                 It always acted on the SELECTION, so this card is
                                 where it belongs — the same handler, the same
                                 ViewModel.RemoveSelectedCommand(). -->
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE756;" FontSize="12"
                                              Foreground="{StaticResource EmberPrimaryBrush}" VerticalAlignment="Center" />
                                    <!-- Ember is the house CTA/eyebrow accent, never an editable
                                         value: the field takes the primary text brush and the
                                         ember stays on the leading "!" that labels it. -->
                                    <TextBlock Text="!"
                                               FontFamily="{StaticResource MonoFont}" FontSize="12" FontWeight="SemiBold"
                                               Foreground="{StaticResource EmberPrimaryBrush}" VerticalAlignment="Center" />
                                    <TextBox Text="{x:Bind ViewModel.SelectedCommand.Trigger, Mode=TwoWay}"
                                             PlaceholderText="command" Width="180"
                                             FontFamily="{StaticResource MonoFont}" FontSize="12"
                                             Foreground="{StaticResource CoalPrimaryTextBrush}"
                                             VerticalAlignment="Center"
                                             AutomationProperties.Name="Command word"
                                             loc:Localize.AutomationKey="panel.customcommands.editor.trigger.a11y" />
                                    <TextBlock Text="{x:Bind ViewModel.SelectedCommand.CounterHint, Mode=OneWay}"
                                               Style="{StaticResource ToolMonoHintTextStyle}"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                                <Button Grid.Column="1"
                                        Style="{StaticResource ToolChipButtonStyle}"
                                        Click="OnEditorEnabledClick"
                                        AutomationProperties.Name="Command enabled"
                                        ToolTipService.ToolTip="Enable or disable this command"
                                        loc:Localize.AutomationKey="panel.customcommands.editor.enabled.a11y"
                                        loc:Localize.TooltipKey="panel.customcommands.editor.enabled.tip">
                                    <cmn:TogglePill IsOn="{x:Bind ViewModel.SelectedCommand.Enabled, Mode=OneWay}"
                                                    Label="Enabled"
                                                    loc:Localize.Key="panel.customcommands.editor.enabled.label" />
                                </Button>

                                <!-- DANGER. Only the glyph is red; the chrome is the
                                     neutral verb's, which is the house rule. -->
                                <Button Grid.Column="2"
                                        Style="{StaticResource ToolDangerButtonStyle}"
                                        IsEnabled="{x:Bind ViewModel.HasSelection, Mode=OneWay}"
                                        Click="OnDeleteCommandClick"
                                        AutomationProperties.Name="Delete the selected command"
                                        loc:Localize.AutomationKey="panel.customcommands.delete.a11y">
                                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE74D;" FontSize="11"
                                                  Foreground="{StaticResource ErrBrush}" />
                                        <TextBlock Text="DELETE" Style="{StaticResource ToolStripLabelTextStyle}"
                                                   loc:Localize.Key="panel.customcommands.delete.label" />
                                    </StackPanel>
                                </Button>
                            </Grid>

                            <Border Height="1" Background="{StaticResource CoalCardBrush}" />

                            <!-- Response template. AcceptsReturn is load-bearing: the
                                 service splits a multi-line response into one chat
                                 message PER non-empty line. -->
                            <StackPanel Spacing="6">
                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <TextBlock Text="RESPONSE" Style="{StaticResource ToolEyebrowTextStyle}" VerticalAlignment="Center"
                                               loc:Localize.Key="panel.customcommands.response.eyebrow" />
                                    <TextBlock Text="{}{user} · {args} · {target} · {count} · full list below"
                                               Style="{StaticResource ToolMonoHintTextStyle}" VerticalAlignment="Center"
                                               loc:Localize.Key="panel.customcommands.response.tokens_hint" />
                                </StackPanel>
                                <TextBox Text="{x:Bind ViewModel.SelectedCommand.Response, Mode=TwoWay}"
                                         PlaceholderText="e.g. @{target} was hugged by {user}!"
                                         TextWrapping="Wrap" AcceptsReturn="True"
                                         MinHeight="72"
                                         HorizontalAlignment="Stretch"
                                         AutomationProperties.Name="Command response"
                                         loc:Localize.PlaceholderKey="panel.customcommands.response.placeholder"
                                         loc:Localize.AutomationKey="panel.customcommands.response.a11y" />
                            </StackPanel>

                            <Border Height="1" Background="{StaticResource CoalCardBrush}" />

                            <!-- Aliases + counter name + cooldowns -->
                            <StackPanel Spacing="6">
                                <TextBlock Text="ALIASES · COUNTER · COOLDOWNS" Style="{StaticResource ToolEyebrowTextStyle}"
                                           loc:Localize.Key="panel.customcommands.aliases.eyebrow" />
                                <Grid ColumnSpacing="10" RowSpacing="6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Aliases" Style="{StaticResource ToolSettingsLabelTextStyle}"
                                               loc:Localize.Key="panel.customcommands.aliases.label" />
                                    <TextBox Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="3"
                                             Text="{x:Bind ViewModel.SelectedCommand.AliasesText, Mode=TwoWay}"
                                             PlaceholderText="e.g. hugs, cuddle" HorizontalAlignment="Stretch"
                                             AutomationProperties.Name="Command aliases"
                                             loc:Localize.PlaceholderKey="panel.customcommands.aliases.placeholder"
                                             loc:Localize.AutomationKey="panel.customcommands.aliases.a11y" />

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Counter" Style="{StaticResource ToolSettingsLabelTextStyle}"
                                               loc:Localize.Key="panel.customcommands.counter.label" />
                                    <TextBox Grid.Row="1" Grid.Column="1"
                                             Text="{x:Bind ViewModel.SelectedCommand.CounterName, Mode=TwoWay}"
                                             PlaceholderText="defaults to the command word" HorizontalAlignment="Stretch"
                                             AutomationProperties.Name="Counter name"
                                             loc:Localize.PlaceholderKey="panel.customcommands.counter.placeholder"
                                             loc:Localize.AutomationKey="panel.customcommands.counter.a11y" />
                                    <StackPanel Grid.Row="1" Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                        <TextBlock Text="User CD (s)" Style="{StaticResource ToolSettingsLabelTextStyle}"
                                                   loc:Localize.Key="panel.customcommands.cooldown.user.label" />
                                        <TextBox Text="{x:Bind ViewModel.SelectedCommand.UserCooldownText, Mode=TwoWay}" Width="56"
                                                 FontFamily="{StaticResource MonoFont}" FontSize="11" TextAlignment="Right"
                                                 AutomationProperties.Name="Per-user cooldown in seconds"
                                                 loc:Localize.AutomationKey="panel.customcommands.cooldown.user.a11y" />
                                    </StackPanel>
                                    <StackPanel Grid.Row="1" Grid.Column="3" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                        <TextBlock Text="Global CD (s)" Style="{StaticResource ToolSettingsLabelTextStyle}"
                                                   loc:Localize.Key="panel.customcommands.cooldown.global.label" />
                                        <TextBox Text="{x:Bind ViewModel.SelectedCommand.GlobalCooldownText, Mode=TwoWay}" Width="56"
                                                 FontFamily="{StaticResource MonoFont}" FontSize="11" TextAlignment="Right"
                                                 AutomationProperties.Name="Global cooldown in seconds"
                                                 loc:Localize.AutomationKey="panel.customcommands.cooldown.global.a11y" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>

                            <Border Height="1" Background="{StaticResource CoalCardBrush}" />

                            <!-- Roles. A full-width star host, which is what
                                 WrapRowPanel needs to fold rather than clip. -->
                            <StackPanel Spacing="6">
                                <TextBlock Text="WHO CAN RUN IT" Style="{StaticResource ToolEyebrowTextStyle}"
                                           loc:Localize.Key="panel.customcommands.roles.eyebrow" />
                                <cmn:RoleCheckRow Roles="{x:Bind ViewModel.SelectedCommand.Roles, Mode=OneWay}" />
                            </StackPanel>

                        </StackPanel>
                    </Border>

                    <!-- Editor placeholder. It stands in for the editor card ONLY —
                         the variable library below documents the whole tool and
                         stays on screen with nothing selected. -->
                    <Border Style="{StaticResource ToolSectionCardStyle}"
                            Visibility="{x:Bind ViewModel.EmptyVisibility, Mode=OneWay}">
                        <StackPanel Spacing="6" HorizontalAlignment="Center" Padding="0,14">
                            <TextBlock Text="No command selected"
                                       FontFamily="{StaticResource DisplayFont}"
                                       FontSize="20"
                                       Foreground="{StaticResource CoalSecondaryTextBrush}"
                                       HorizontalAlignment="Center"
                                       loc:Localize.Key="panel.customcommands.empty.title" />
                            <TextBlock Text="Pick one from the list on the right, or add a new command."
                                       FontFamily="{StaticResource SansFont}"
                                       FontSize="12"
                                       Foreground="{StaticResource CoalSecondaryTextBrush}"
                                       HorizontalAlignment="Center" TextAlignment="Center"
                                       loc:Localize.Key="panel.customcommands.empty.body" />
                        </StackPanel>
                    </Border>

                    <!-- ═══ Variable library reference — directly under the response
                         box it documents, and never gated on selection: the token
                         list is the same for every command. ═══ -->
                    <Border Style="{StaticResource ToolSectionCardStyle}">
                        <StackPanel Spacing="10">
                            <StackPanel Spacing="6">
                                <TextBlock Text="VARIABLE LIBRARY" Style="{StaticResource ToolEyebrowTextStyle}"
                                           loc:Localize.Key="panel.customcommands.library.eyebrow" />
                                <Border Height="1" Background="{StaticResource CoalDividerBrush}" />
                            </StackPanel>
                            <TextBlock Style="{StaticResource ToolMonoHintTextStyle}"
                                       Text="Case-insensitive; an unknown {token} is left as-is."
                                       loc:Localize.Key="panel.customcommands.library.hint" />
                            <!-- Recessed token strip -->
                            <Border Background="{StaticResource CoalShellBrush}"
                                    BorderBrush="{StaticResource CoalCardBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{StaticResource Radius1Corner}">
                                <StackPanel>
                                    <Border BorderBrush="{StaticResource CoalCardBrush}" BorderThickness="0,0,0,1" Padding="12,7">
                                        <Grid ColumnSpacing="14">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="150" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{}{user}" Style="{StaticResource CcLibToken}" />
                                            <TextBlock Grid.Column="1" Text="The chatter who ran the command." Style="{StaticResource CcLibDesc}"
                                                       loc:Localize.Key="panel.customcommands.library.user.desc" />
                                        </Grid>
                                    </Border>
                                    <Border BorderBrush="{StaticResource CoalCardBrush}" BorderThickness="0,0,0,1" Padding="12,7">
                                        <Grid ColumnSpacing="14">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="150" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{}{args}" Style="{StaticResource CcLibToken}" />
                                            <TextBlock Grid.Column="1" Text="Everything typed after the command word." Style="{StaticResource CcLibDesc}"
                                                       loc:Localize.Key="panel.customcommands.library.args.desc" />
                                        </Grid>
                                    </Border>
                                    <Border BorderBrush="{StaticResource CoalCardBrush}" BorderThickness="0,0,0,1" Padding="12,7">
                                        <Grid ColumnSpacing="14">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="150" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{}{target}" Style="{StaticResource CcLibToken}" />
                                            <TextBlock Grid.Column="1" Text="The first word after the command (a leading @ is stripped); falls back to the chatter." Style="{StaticResource CcLibDesc}"
                                                       loc:Localize.Key="panel.customcommands.library.target.desc" />
                                        </Grid>
                                    </Border>
                                    <Border BorderBrush="{StaticResource CoalCardBrush}" BorderThickness="0,0,0,1" Padding="12,7">
                                        <Grid ColumnSpacing="14">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="150" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{}{channel}" Style="{StaticResource CcLibToken}" />
                                            <TextBlock Grid.Column="1" Text="Your channel (broadcaster) name." Style="{StaticResource CcLibDesc}"
                                                       loc:Localize.Key="panel.customcommands.library.channel.desc" />
                                        </Grid>
                                    </Border>
                                    <Border BorderBrush="{StaticResource CoalCardBrush}" BorderThickness="0,0,0,1" Padding="12,7">
                                        <Grid ColumnSpacing="14">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="150" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{}{random}" Style="{StaticResource CcLibToken}" />
                                            <TextBlock Grid.Column="1" Text="A random number 1–100. Use {random.N} for 1–N or {random.A-B} for A–B." Style="{StaticResource CcLibDesc}"
                                                       loc:Localize.Key="panel.customcommands.library.random.desc" />
                                        </Grid>
                                    </Border>
                                    <Border BorderBrush="{StaticResource CoalCardBrush}" BorderThickness="0,0,0,1" Padding="12,7">
                                        <Grid ColumnSpacing="14">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="150" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{}{count}" Style="{StaticResource CcLibToken}" />
                                            <TextBlock Grid.Column="1" Text="The current value of this command's counter (from the Counters tool). Read-only." Style="{StaticResource CcLibDesc}"
                                                       loc:Localize.Key="panel.customcommands.library.count.desc" />
                                        </Grid>
                                    </Border>
                                    <Border BorderBrush="{StaticResource CoalCardBrush}" BorderThickness="0,0,0,1" Padding="12,7">
                                        <Grid ColumnSpacing="14">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="150" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{}{count.next}" Style="{StaticResource CcLibToken}" />
                                            <TextBlock Grid.Column="1" Text="Adds one to this command's counter and shows the new value." Style="{StaticResource CcLibDesc}"
                                                       loc:Localize.Key="panel.customcommands.library.count_next.desc" />
                                        </Grid>
                                    </Border>
                                    <Border BorderBrush="{StaticResource CoalCardBrush}" BorderThickness="0,0,0,1" Padding="12,7">
                                        <Grid ColumnSpacing="14">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="150" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{}{uptime}" Style="{StaticResource CcLibToken}" />
                                            <TextBlock Grid.Column="1" Text="Time live so far (e.g. 2h 15m). Blank while offline." Style="{StaticResource CcLibDesc}"
                                                       loc:Localize.Key="panel.customcommands.library.uptime.desc" />
                                        </Grid>
                                    </Border>
                                    <Border BorderBrush="{StaticResource CoalCardBrush}" BorderThickness="0,0,0,1" Padding="12,7">
                                        <Grid ColumnSpacing="14">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="150" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{}{game}" Style="{StaticResource CcLibToken}" />
                                            <TextBlock Grid.Column="1" Text="Current category. Blank until Phoenix has read it from your channel." Style="{StaticResource CcLibDesc}"
                                                       loc:Localize.Key="panel.customcommands.library.game.desc" />
                                        </Grid>
                                    </Border>
                                    <Border Padding="12,7">
                                        <Grid ColumnSpacing="14">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="150" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{}{title}" Style="{StaticResource CcLibToken}" />
                                            <TextBlock Grid.Column="1" Text="Current stream title. Blank until Phoenix has read it from your channel." Style="{StaticResource CcLibDesc}"
                                                       loc:Localize.Key="panel.customcommands.library.title.desc" />
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>

            <!-- ───────────── RIGHT: command roster ─────────────
                 Honest label: these are the commands as CONFIGURED. The column is a
                 picker, not an event stream. Fixed 300 px rather than 0.9* so the
                 roster reads the same at every window width — and so the editor,
                 which is the reason the page exists, takes every pixel the window
                 gains instead of splitting them with a list of one-line rows. -->
            <Border Grid.Column="1"
                    Background="{StaticResource CoalSurfaceBrush}"
                    BorderBrush="{StaticResource CoalCardBrush}"
                    BorderThickness="1,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />  <!-- header       -->
                        <RowDefinition Height="Auto" />  <!-- column band  -->
                        <RowDefinition Height="*" />     <!-- roster       -->
                    </Grid.RowDefinitions>

                    <cmn:PanelHeader Grid.Row="0" Eyebrow="CONFIGURED" Title="Commands"
                                     EyebrowKey="panel.common.eyebrow.configured"
                                     TitleKey="panel.customcommands.roster.title">
                        <cmn:PanelHeader.RightContent>
                            <TextBlock Text="{x:Bind ViewModel.CountText, Mode=OneWay}"
                                       FontFamily="{StaticResource MonoFont}" FontSize="11"
                                       Foreground="{StaticResource CoalSecondaryTextBrush}"
                                       VerticalAlignment="Center" />
                        </cmn:PanelHeader.RightContent>
                    </cmn:PanelHeader>

                    <Border Grid.Row="1" Style="{StaticResource ToolBandBorderStyle}">
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="COMMAND · RESPONSE" Style="{StaticResource ToolColumnLabelTextStyle}" VerticalAlignment="Center"
                                       loc:Localize.Key="panel.customcommands.roster.column.command" />
                            <TextBlock Grid.Column="1" Text="ON" Style="{StaticResource ToolColumnLabelTextStyle}" VerticalAlignment="Center"
                                       loc:Localize.Key="panel.customcommands.roster.column.on" />
                        </Grid>
                    </Border>

                    <ScrollViewer Grid.Row="2"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollMode="Disabled">
                        <ItemsRepeater ItemsSource="{x:Bind ViewModel.Commands, Mode=OneWay}"
                                       cmn:RowDataContext.Supply="True"
                                       ItemTemplate="{StaticResource CommandRosterRowTemplate}"
                                       AutomationProperties.Name="Custom commands"
                                       loc:Localize.AutomationKey="panel.customcommands.roster.list.a11y" />
                    </ScrollViewer>

                    <!-- Roster-empty state — a sibling in the roster cell, never inside
                         the scroller. "No commands exist", not "nothing is selected".
                         One line, top aligned: a 20 px DisplayFont headline plus a
                         second explanatory sentence, floated in the middle of a tall
                         empty column, made the absence of commands look like an event.
                         It is just an empty list. -->
                    <TextBlock Grid.Row="2"
                               Visibility="{x:Bind ViewModel.NoCommandsVisibility, Mode=OneWay}"
                               Style="{StaticResource ToolMonoHintTextStyle}"
                               VerticalAlignment="Top"
                               Margin="14,10"
                               Text="No commands yet — use + ADD COMMAND above."
                               loc:Localize.Key="panel.customcommands.roster.empty.hint" />

                    <!-- The ACTIVITY feed lived here. It is a watch surface: what a
                         command answered 40 seconds ago tells you nothing while you
                         are editing a cooldown, and it cost the roster the bottom of
                         its column. The ring itself (ToolActivityRing, keyed
                         CustomCommandsService.ActivityTool) still records every fire. -->
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
