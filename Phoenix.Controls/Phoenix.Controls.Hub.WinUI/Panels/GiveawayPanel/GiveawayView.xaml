<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Phoenix.Controls.Hub.WinUI.Panels.GiveawayPanel.GiveawayView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Phoenix.Controls.Hub.WinUI.Panels.GiveawayPanel"
    xmlns:hdr="using:Phoenix.Controls.Hub.WinUI.Panels.Common"
    HorizontalAlignment="Stretch"
    VerticalAlignment="Stretch"
    HorizontalContentAlignment="Stretch"
    VerticalContentAlignment="Stretch"
    AutomationProperties.Name="Giveaway page"
    AutomationProperties.HelpText="Run a giveaway: create one, pick the active giveaway, watch entrants and tickets roll in, and draw a weighted winner.">

    <UserControl.Resources>
        <!-- Brushes the design uses as inline CSS gradients / fills that don't
             have a single existing theme token. Everything else binds the
             existing PhoenixDark keys directly. -->

        <!-- Brass hero CTA fill ("Draw winner") — the brushed-brass gradient
             from tokens.css .brass, with the same top→bottom stops the JSX
             primary ToolButton uses. -->
        <LinearGradientBrush x:Key="GvBrassHeroBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Offset="0.00" Color="#F0B463" />
            <GradientStop Offset="0.30" Color="#E5A24E" />
            <GradientStop Offset="0.70" Color="#C8822B" />
            <GradientStop Offset="1.00" Color="#A6661A" />
        </LinearGradientBrush>

        <!-- Draw-winner overlay scrim — coal at ~0.78 alpha with an ember
             radial glow centred behind the card (approximates the JSX
             radial-gradient + rgba(11,9,7,0.78) backdrop). -->
        <SolidColorBrush x:Key="GvScrimBrush" Color="#C70B0907" />

        <!-- Open status-pill background tint (ok green at ~10% alpha) -->
        <SolidColorBrush x:Key="GvStatusOpenFillBrush" Color="#1A6FA46B" />
        <SolidColorBrush x:Key="GvStatusOpenBorderBrush" Color="#806FA46B" />

        <!-- Default badge / toggle ember tints (ember at low alpha) -->
        <SolidColorBrush x:Key="GvEmberTint08Brush" Color="#14E5A24E" />
        <SolidColorBrush x:Key="GvEmberTint10Brush" Color="#1AE5A24E" />
        <SolidColorBrush x:Key="GvEmberBorderBrush" Color="#73E5A24E" />
    </UserControl.Resources>

    <Grid Background="{StaticResource CoalSurfaceBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ════════════════════ TOP ACTION STRIP ════════════════════ -->
        <Border Grid.Row="0"
                Background="{StaticResource CoalSurfaceBrush}"
                BorderBrush="{StaticResource CoalDividerBrush}"
                BorderThickness="0,0,0,1"
                Padding="14,10">
            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />   <!-- Create -->
                    <ColumnDefinition Width="Auto" />   <!-- Picker -->
                    <ColumnDefinition Width="*" />      <!-- spacer -->
                    <ColumnDefinition Width="Auto" />   <!-- Close (danger) -->
                    <ColumnDefinition Width="Auto" />   <!-- Draw (primary hero) -->
                </Grid.ColumnDefinitions>

                <!-- [Create new giveaway] -->
                <Button Grid.Column="0"
                        x:Name="CreateButton"
                        Height="30"
                        Padding="14,0"
                        Background="{StaticResource CoalCardBrush}"
                        BorderBrush="{StaticResource CoalDividerBrush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource Radius1Corner}"
                        Click="OnCreateClick"
                        AutomationProperties.Name="Create new giveaway">
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE710;" FontSize="11"
                                  Foreground="{StaticResource CoalBodyTextBrush}" />
                        <TextBlock Text="CREATE NEW GIVEAWAY"
                                   FontFamily="{StaticResource SansFont}"
                                   FontSize="11" FontWeight="Bold" CharacterSpacing="100"
                                   Foreground="{StaticResource CoalBodyTextBrush}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <!-- Giveaway PICKER — a button that opens a search/filter Flyout -->
                <Button Grid.Column="1"
                        x:Name="PickerButton"
                        Width="360"
                        Height="30"
                        Padding="10,0"
                        HorizontalContentAlignment="Stretch"
                        Background="{StaticResource CoalShellBrush}"
                        BorderBrush="{StaticResource CoalDividerBrush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource Radius1Corner}"
                        AutomationProperties.Name="Active giveaway picker">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Grid.Column="0" FontFamily="Segoe MDL2 Assets" Glyph="&#xE721;" FontSize="12"
                                  Foreground="{StaticResource EmberPrimaryBrush}" VerticalAlignment="Center" />
                        <!-- Selected title + id (or placeholder) -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <TextBlock Text="{x:Bind ViewModel.PickerButtonTitle, Mode=OneWay}"
                                       FontFamily="{StaticResource SansFont}"
                                       FontSize="12" FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis"
                                       Foreground="{StaticResource CoalPrimaryTextBrush}"
                                       VerticalAlignment="Center" />
                            <TextBlock Text="{x:Bind ViewModel.PickerButtonId, Mode=OneWay}"
                                       FontFamily="{StaticResource MonoFont}"
                                       FontSize="11"
                                       Foreground="{StaticResource CoalSecondaryTextBrush}"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                        <!-- DEFAULT pin badge -->
                        <Border Grid.Column="2"
                                Visibility="{x:Bind ViewModel.PickerButtonDefaultVisibility, Mode=OneWay}"
                                Background="{StaticResource GvEmberTint08Brush}"
                                BorderBrush="{StaticResource GvEmberBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource Radius1Corner}"
                                Padding="5,2"
                                VerticalAlignment="Center"
                                ToolTipService.ToolTip="Default — public=true nodes target this giveaway">
                            <StackPanel Orientation="Horizontal" Spacing="3">
                                <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE718;" FontSize="9"
                                          Foreground="{StaticResource EmberPrimaryBrush}" />
                                <TextBlock Text="DEFAULT"
                                           FontFamily="{StaticResource MonoFont}"
                                           FontSize="9" FontWeight="Bold" CharacterSpacing="120"
                                           Foreground="{StaticResource EmberPrimaryBrush}"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <FontIcon Grid.Column="3" FontFamily="Segoe MDL2 Assets" Glyph="&#xE70D;" FontSize="10"
                                  Foreground="{StaticResource CoalSecondaryTextBrush}" VerticalAlignment="Center" />
                    </Grid>

                    <Button.Flyout>
                        <Flyout x:Name="PickerFlyout" Placement="Bottom">
                            <Flyout.FlyoutPresenterStyle>
                                <Style TargetType="FlyoutPresenter">
                                    <Setter Property="Background" Value="{StaticResource CoalRaisedBrush}" />
                                    <Setter Property="BorderBrush" Value="{StaticResource CoalDividerBrush}" />
                                    <Setter Property="BorderThickness" Value="1" />
                                    <Setter Property="CornerRadius" Value="{StaticResource Radius2Corner}" />
                                    <Setter Property="Padding" Value="4" />
                                    <Setter Property="MaxWidth" Value="420" />
                                    <Setter Property="MinWidth" Value="360" />
                                </Style>
                            </Flyout.FlyoutPresenterStyle>
                            <Grid Width="360" RowSpacing="4">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <!-- Filter box -->
                                <TextBox Grid.Row="0"
                                         x:Name="PickerFilterBox"
                                         PlaceholderText="filter by title or id…"
                                         Background="{StaticResource CoalShellBrush}"
                                         Foreground="{StaticResource CoalPrimaryTextBrush}"
                                         BorderBrush="{StaticResource CoalDividerBrush}"
                                         BorderThickness="1"
                                         FontFamily="{StaticResource MonoFont}"
                                         FontSize="11"
                                         Margin="2,2,2,4"
                                         Text="{x:Bind ViewModel.PickerFilter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                                <!-- Results -->
                                <ScrollViewer Grid.Row="1"
                                              MaxHeight="260"
                                              VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollMode="Disabled">
                                    <ItemsRepeater ItemsSource="{x:Bind ViewModel.PickerItems, Mode=OneWay}">
                                        <ItemsRepeater.ItemTemplate>
                                            <DataTemplate x:DataType="local:GiveawayPickerItemVm">
                                                <Button HorizontalAlignment="Stretch"
                                                        HorizontalContentAlignment="Stretch"
                                                        Background="Transparent"
                                                        BorderThickness="0"
                                                        Padding="10,7"
                                                        Click="OnPickerItemClick"
                                                        Tag="{x:Bind Id}">
                                                    <Grid ColumnSpacing="8">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Grid.Column="0" Spacing="2">
                                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                                <TextBlock Text="{x:Bind Title}"
                                                                           FontFamily="{StaticResource SansFont}"
                                                                           FontSize="12" FontWeight="SemiBold"
                                                                           TextTrimming="CharacterEllipsis"
                                                                           Foreground="{StaticResource CoalPrimaryTextBrush}" />
                                                                <TextBlock Text="DEFAULT"
                                                                           Visibility="{x:Bind DefaultBadgeVisibility}"
                                                                           FontFamily="{StaticResource MonoFont}"
                                                                           FontSize="9" CharacterSpacing="100"
                                                                           Foreground="{StaticResource EmberPrimaryBrush}"
                                                                           VerticalAlignment="Center" />
                                                            </StackPanel>
                                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                                <TextBlock Text="{x:Bind DisplayId}"
                                                                           FontFamily="{StaticResource MonoFont}"
                                                                           FontSize="10"
                                                                           Foreground="{StaticResource CoalSecondaryTextBrush}" />
                                                                <TextBlock Text="·" FontFamily="{StaticResource MonoFont}"
                                                                           FontSize="10"
                                                                           Foreground="{StaticResource CoalSecondaryTextBrush}" />
                                                                <TextBlock Text="{x:Bind StatusText}"
                                                                           FontFamily="{StaticResource MonoFont}"
                                                                           FontSize="10"
                                                                           Foreground="{x:Bind StatusBrush}" />
                                                            </StackPanel>
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                                            <TextBlock Text="{x:Bind EntrantsText}"
                                                                       FontFamily="{StaticResource MonoFont}"
                                                                       FontSize="11"
                                                                       HorizontalAlignment="Right"
                                                                       Foreground="{StaticResource CoalBodyTextBrush}" />
                                                            <TextBlock Text="{x:Bind TicketsText}"
                                                                       FontFamily="{StaticResource MonoFont}"
                                                                       FontSize="10"
                                                                       HorizontalAlignment="Right"
                                                                       Foreground="{StaticResource CoalSecondaryTextBrush}" />
                                                        </StackPanel>
                                                    </Grid>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsRepeater.ItemTemplate>
                                    </ItemsRepeater>
                                </ScrollViewer>

                                <Border Grid.Row="2" Height="1" Margin="6,4"
                                        Background="{StaticResource CoalDividerBrush}" />

                                <!-- New giveaway from this filter -->
                                <Button Grid.Row="3"
                                        x:Name="PickerCreateButton"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Left"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Padding="10,7"
                                        Click="OnPickerCreateClick">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE710;" FontSize="11"
                                                  Foreground="{StaticResource Ember200Brush}" />
                                        <TextBlock Text="New giveaway from this filter…"
                                                   FontFamily="{StaticResource SansFont}"
                                                   FontSize="12" FontWeight="SemiBold"
                                                   Foreground="{StaticResource Ember200Brush}"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </Flyout>
                    </Button.Flyout>
                </Button>

                <!-- [Close giveaway] — danger, disabled unless open -->
                <Button Grid.Column="3"
                        x:Name="CloseButton"
                        Height="30"
                        Padding="14,0"
                        Background="{StaticResource CoalCardBrush}"
                        BorderBrush="{StaticResource CoalDividerBrush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource Radius1Corner}"
                        IsEnabled="{x:Bind ViewModel.CanClose, Mode=OneWay}"
                        Click="OnCloseGiveawayClick"
                        AutomationProperties.Name="Close giveaway">
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE711;" FontSize="11"
                                  Foreground="{StaticResource ErrBrush}" />
                        <TextBlock Text="CLOSE GIVEAWAY"
                                   FontFamily="{StaticResource SansFont}"
                                   FontSize="11" FontWeight="Bold" CharacterSpacing="100"
                                   Foreground="{StaticResource CoalBodyTextBrush}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <!-- [Draw winner] — brass PRIMARY hero CTA -->
                <Button Grid.Column="4"
                        x:Name="DrawButton"
                        Height="30"
                        Padding="14,0"
                        Background="{StaticResource GvBrassHeroBrush}"
                        BorderBrush="{StaticResource Ember600Brush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource Radius1Corner}"
                        IsEnabled="{x:Bind ViewModel.CanDraw, Mode=OneWay}"
                        Click="OnDrawWinnerClick"
                        ToolTipService.ToolTip="Pick a winner — weighted by ticket count (subscriber bonus factor applies)"
                        AutomationProperties.Name="Draw winner">
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE735;" FontSize="11"
                                  Foreground="{StaticResource CoalShellBrush}" />
                        <TextBlock Text="DRAW WINNER"
                                   FontFamily="{StaticResource SansFont}"
                                   FontSize="11" FontWeight="Bold" CharacterSpacing="100"
                                   Foreground="{StaticResource CoalShellBrush}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <!-- ════════════════════ TWO-COLUMN BODY ════════════════════ -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.4*" />
                <ColumnDefinition Width="0.9*" />
            </Grid.ColumnDefinitions>

            <!-- ───────────── LEFT: GiveawayDetail ───────────── -->
            <ScrollViewer Grid.Column="0"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollMode="Disabled"
                          Visibility="{x:Bind ViewModel.DetailVisibility, Mode=OneWay}">
                <StackPanel Spacing="12" Padding="14">

                    <!-- Title + meta + set-default toggle -->
                    <Grid ColumnSpacing="14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Spacing="4">
                            <TextBlock Text="ACTIVE GIVEAWAY"
                                       FontFamily="{StaticResource SansFont}"
                                       FontSize="10" FontWeight="SemiBold" CharacterSpacing="180"
                                       Foreground="{StaticResource EmberPrimaryBrush}" />
                            <TextBlock Text="{x:Bind ViewModel.Title, Mode=OneWay}"
                                       FontFamily="{StaticResource DisplayFont}"
                                       FontSize="28" CharacterSpacing="20"
                                       TextWrapping="Wrap"
                                       Foreground="{StaticResource CoalPaperBrush}" />
                            <!-- Meta line. Built from discrete TextBlocks rather than
                                 inline Runs because x:Bind is not supported on Run.Text
                                 in WinUI 3 (the markup compiler crashes on it). -->
                            <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,2,0,0">
                                <TextBlock Text="id" FontFamily="{StaticResource MonoFont}" FontSize="11"
                                           Foreground="{StaticResource CoalSecondaryTextBrush}" VerticalAlignment="Center" />
                                <TextBlock Text="{x:Bind ViewModel.MetaId, Mode=OneWay}"
                                           FontFamily="{StaticResource MonoFont}" FontSize="11"
                                           Foreground="{StaticResource CoalPrimaryTextBrush}" VerticalAlignment="Center" />
                                <TextBlock Text="·" FontFamily="{StaticResource MonoFont}" FontSize="11" Margin="6,0,2,0"
                                           Foreground="{StaticResource CoalSecondaryTextBrush}" VerticalAlignment="Center" />
                                <TextBlock Text="opened" FontFamily="{StaticResource MonoFont}" FontSize="11"
                                           Foreground="{StaticResource CoalSecondaryTextBrush}" VerticalAlignment="Center" />
                                <TextBlock Text="{x:Bind ViewModel.MetaOpenedAt, Mode=OneWay}"
                                           FontFamily="{StaticResource MonoFont}" FontSize="11"
                                           Foreground="{StaticResource CoalPrimaryTextBrush}" VerticalAlignment="Center" />
                                <TextBlock Text="·" FontFamily="{StaticResource MonoFont}" FontSize="11" Margin="6,0,2,0"
                                           Foreground="{StaticResource CoalSecondaryTextBrush}" VerticalAlignment="Center" />
                                <TextBlock Text="by" FontFamily="{StaticResource MonoFont}" FontSize="11"
                                           Foreground="{StaticResource CoalSecondaryTextBrush}" VerticalAlignment="Center" />
                                <TextBlock Text="{x:Bind ViewModel.MetaOpenedBy, Mode=OneWay}"
                                           FontFamily="{StaticResource MonoFont}" FontSize="11"
                                           Foreground="{StaticResource CoalPrimaryTextBrush}" VerticalAlignment="Center" />
                            </StackPanel>
                        </StackPanel>

                        <!-- Set-default toggle -->
                        <Button Grid.Column="1"
                                x:Name="DefaultToggleButton"
                                VerticalAlignment="Top"
                                Padding="8,5,10,5"
                                CornerRadius="{StaticResource Radius1Corner}"
                                Background="Transparent"
                                BorderThickness="0"
                                Click="OnToggleDefaultClick"
                                ToolTipService.ToolTip="When ON, this is the active giveaway across the app.">
                            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                <!-- Toggle pill -->
                                <Border x:Name="DefaultTogglePill"
                                        Width="26" Height="14" CornerRadius="8"
                                        BorderBrush="{StaticResource CoalDividerBrush}"
                                        BorderThickness="1">
                                    <Ellipse x:Name="DefaultToggleKnob"
                                             Width="10" Height="10"
                                             HorizontalAlignment="Left"
                                             VerticalAlignment="Center"
                                             Margin="1,0,0,0" />
                                </Border>
                                <TextBlock x:Name="DefaultToggleLabel"
                                           Text="{x:Bind ViewModel.DefaultToggleLabel, Mode=OneWay}"
                                           FontFamily="{StaticResource SansFont}"
                                           FontSize="11" FontWeight="Bold" CharacterSpacing="100"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </Grid>

                    <!-- Status pill -->
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Border Background="{StaticResource GvStatusOpenFillBrush}"
                                BorderBrush="{StaticResource GvStatusOpenBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource Radius1Corner}"
                                Padding="8,3">
                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <Ellipse x:Name="StatusPulseDot"
                                         Width="6" Height="6"
                                         VerticalAlignment="Center"
                                         Visibility="{x:Bind ViewModel.StatusDotPulseVisibility, Mode=OneWay}"
                                         Fill="{x:Bind ViewModel.StatusPillBrush, Mode=OneWay}" />
                                <TextBlock Text="{x:Bind ViewModel.StatusPillText, Mode=OneWay}"
                                           FontFamily="{StaticResource MonoFont}"
                                           FontSize="10" FontWeight="Bold" CharacterSpacing="160"
                                           Foreground="{x:Bind ViewModel.StatusPillBrush, Mode=OneWay}"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <TextBlock Text="{x:Bind ViewModel.StatusHint, Mode=OneWay}"
                                   Visibility="{x:Bind ViewModel.StatusHintVisibility, Mode=OneWay}"
                                   FontFamily="{StaticResource MonoFont}"
                                   FontSize="11"
                                   Foreground="{StaticResource CoalSecondaryTextBrush}"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <!-- Stat tiles -->
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <local:GvStatTile Grid.Column="0" Eyebrow="ENTRANTS"
                                          Value="{x:Bind ViewModel.EntrantsValue, Mode=OneWay}" />
                        <local:GvStatTile Grid.Column="1" Eyebrow="TICKETS"
                                          Accent="True"
                                          Value="{x:Bind ViewModel.TicketsValue, Mode=OneWay}" />
                        <local:GvStatTile Grid.Column="2" Eyebrow="AVG / USER"
                                          Value="{x:Bind ViewModel.AvgValue, Mode=OneWay}" />
                        <local:GvStatTile Grid.Column="3" Eyebrow="LAST ENTRY"
                                          Value="{x:Bind ViewModel.LastEntryValue, Mode=OneWay}" />
                    </Grid>

                    <!-- Settings card — collapsible; the header row IS the
                         toggle. Both remaining settings are editable inputs:
                         entry itself is script-driven (the GiveawayTicket .phx
                         calls giveaway.ticket), so there is no entry command /
                         tickets-per-message / draw-method row any more. -->
                    <Border Background="{StaticResource CoalShellBrush}"
                            BorderBrush="{StaticResource CoalCardBrush}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource Radius1Corner}"
                            Padding="14,10">
                        <StackPanel Spacing="0">
                            <Button x:Name="SettingsHeaderButton"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Stretch"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Padding="0,2"
                                    Click="OnToggleSettingsClick"
                                    ToolTipService.ToolTip="Collapse / expand the settings panel"
                                    AutomationProperties.Name="{x:Bind ViewModel.SettingsToggleAutomationName, Mode=OneWay}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="SETTINGS"
                                               FontFamily="{StaticResource SansFont}"
                                               FontSize="10" FontWeight="SemiBold" CharacterSpacing="180"
                                               Foreground="{StaticResource EmberPrimaryBrush}"
                                               VerticalAlignment="Center" />
                                    <FontIcon Grid.Column="1"
                                              FontFamily="Segoe MDL2 Assets"
                                              Glyph="{x:Bind ViewModel.SettingsChevronGlyph, Mode=OneWay}"
                                              FontSize="10"
                                              Foreground="{StaticResource CoalSecondaryTextBrush}"
                                              VerticalAlignment="Center" />
                                </Grid>
                            </Button>
                            <StackPanel Spacing="0"
                                        Visibility="{x:Bind ViewModel.SettingsBodyVisibility, Mode=OneWay}"
                                        Margin="0,6,0,0">
                                <!-- Subscriber bonus — ticket-weight FACTOR applied to
                                     subscribers at draw time (their sub status is
                                     gathered fresh via Streamer.bot right before the
                                     draw). 1 = no bonus; saves on Enter / focus loss,
                                     Escape reverts. -->
                                <Border BorderBrush="{StaticResource CoalCardBrush}"
                                        BorderThickness="0,0,0,1"
                                        Padding="0,5">
                                    <Grid ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="130" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0"
                                                   FontFamily="{StaticResource MonoFont}"
                                                   FontSize="11" CharacterSpacing="40"
                                                   Foreground="{StaticResource CoalSecondaryTextBrush}"
                                                   VerticalAlignment="Center"
                                                   TextWrapping="Wrap"
                                                   Text="Subscriber bonus" />
                                        <TextBox Grid.Column="1"
                                                 x:Name="SubBonusBox"
                                                 Width="72"
                                                 Background="{StaticResource CoalShellBrush}"
                                                 Foreground="{StaticResource CoalPrimaryTextBrush}"
                                                 BorderBrush="{StaticResource CoalDividerBrush}"
                                                 BorderThickness="1"
                                                 FontFamily="{StaticResource MonoFont}"
                                                 FontSize="11"
                                                 TextAlignment="Right"
                                                 VerticalAlignment="Center"
                                                 IsEnabled="{x:Bind ViewModel.HasSelection, Mode=OneWay}"
                                                 KeyDown="OnSubBonusKeyDown"
                                                 LostFocus="OnSubBonusLostFocus"
                                                 AutomationProperties.Name="Subscriber ticket-weight factor (1 = no bonus)"
                                                 Text="{x:Bind ViewModel.SubBonusDraft, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBlock Grid.Column="2"
                                                   FontFamily="{StaticResource MonoFont}"
                                                   FontSize="10"
                                                   Foreground="{StaticResource CoalSecondaryTextBrush}"
                                                   VerticalAlignment="Center"
                                                   TextWrapping="Wrap"
                                                   Text="× ticket weight for subs at draw · 1 = no bonus" />
                                    </Grid>
                                </Border>
                                <!-- Moderator bonus — mirror of the subscriber row.
                                     Mod status comes from the IsSub/IsMod flags the
                                     entry script recorded (no live re-check); factors
                                     multiply for entrants who are both. -->
                                <Border BorderBrush="{StaticResource CoalCardBrush}"
                                        BorderThickness="0,0,0,1"
                                        Padding="0,5">
                                    <Grid ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="130" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0"
                                                   FontFamily="{StaticResource MonoFont}"
                                                   FontSize="11" CharacterSpacing="40"
                                                   Foreground="{StaticResource CoalSecondaryTextBrush}"
                                                   VerticalAlignment="Center"
                                                   TextWrapping="Wrap"
                                                   Text="Moderator bonus" />
                                        <TextBox Grid.Column="1"
                                                 x:Name="ModBonusBox"
                                                 Width="72"
                                                 Background="{StaticResource CoalShellBrush}"
                                                 Foreground="{StaticResource CoalPrimaryTextBrush}"
                                                 BorderBrush="{StaticResource CoalDividerBrush}"
                                                 BorderThickness="1"
                                                 FontFamily="{StaticResource MonoFont}"
                                                 FontSize="11"
                                                 TextAlignment="Right"
                                                 VerticalAlignment="Center"
                                                 IsEnabled="{x:Bind ViewModel.HasSelection, Mode=OneWay}"
                                                 KeyDown="OnModBonusKeyDown"
                                                 LostFocus="OnModBonusLostFocus"
                                                 AutomationProperties.Name="Moderator ticket-weight factor (1 = no bonus)"
                                                 Text="{x:Bind ViewModel.ModBonusDraft, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBlock Grid.Column="2"
                                                   FontFamily="{StaticResource MonoFont}"
                                                   FontSize="10"
                                                   Foreground="{StaticResource CoalSecondaryTextBrush}"
                                                   VerticalAlignment="Center"
                                                   TextWrapping="Wrap"
                                                   Text="× ticket weight for mods at draw · 1 = no bonus" />
                                    </Grid>
                                </Border>
                                <!-- Max tickets per user — 0 = unlimited; saves on
                                     Enter / focus loss, Escape reverts. -->
                                <Border BorderBrush="{StaticResource CoalCardBrush}"
                                        BorderThickness="0,0,0,1"
                                        Padding="0,5">
                                    <Grid ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="130" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0"
                                                   FontFamily="{StaticResource MonoFont}"
                                                   FontSize="11" CharacterSpacing="40"
                                                   Foreground="{StaticResource CoalSecondaryTextBrush}"
                                                   VerticalAlignment="Center"
                                                   TextWrapping="Wrap"
                                                   Text="Max tickets per user" />
                                        <TextBox Grid.Column="1"
                                                 x:Name="CapPerUserBox"
                                                 Width="72"
                                                 Background="{StaticResource CoalShellBrush}"
                                                 Foreground="{StaticResource CoalPrimaryTextBrush}"
                                                 BorderBrush="{StaticResource CoalDividerBrush}"
                                                 BorderThickness="1"
                                                 FontFamily="{StaticResource MonoFont}"
                                                 FontSize="11"
                                                 TextAlignment="Right"
                                                 VerticalAlignment="Center"
                                                 IsEnabled="{x:Bind ViewModel.HasSelection, Mode=OneWay}"
                                                 KeyDown="OnCapPerUserKeyDown"
                                                 LostFocus="OnCapPerUserLostFocus"
                                                 AutomationProperties.Name="Max tickets per user (0 = unlimited)"
                                                 Text="{x:Bind ViewModel.CapPerUserDraft, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBlock Grid.Column="2"
                                                   FontFamily="{StaticResource MonoFont}"
                                                   FontSize="10"
                                                   Foreground="{StaticResource CoalSecondaryTextBrush}"
                                                   VerticalAlignment="Center"
                                                   Text="0 = unlimited" />
                                    </Grid>
                                </Border>
                                <!-- Ticket price — channel points per ticket charged by
                                     Giveaway.Ticket nodes that carry a currency table and
                                     follow this giveaway (Public on); 0 = free. Saves on
                                     Enter / focus loss, Escape reverts. Last row → no
                                     bottom divider. -->
                                <Border BorderThickness="0"
                                        Padding="0,5">
                                    <Grid ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="130" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0"
                                                   FontFamily="{StaticResource MonoFont}"
                                                   FontSize="11" CharacterSpacing="40"
                                                   Foreground="{StaticResource CoalSecondaryTextBrush}"
                                                   VerticalAlignment="Center"
                                                   TextWrapping="Wrap"
                                                   Text="Ticket price" />
                                        <TextBox Grid.Column="1"
                                                 x:Name="TicketPriceBox"
                                                 Width="72"
                                                 Background="{StaticResource CoalShellBrush}"
                                                 Foreground="{StaticResource CoalPrimaryTextBrush}"
                                                 BorderBrush="{StaticResource CoalDividerBrush}"
                                                 BorderThickness="1"
                                                 FontFamily="{StaticResource MonoFont}"
                                                 FontSize="11"
                                                 TextAlignment="Right"
                                                 VerticalAlignment="Center"
                                                 IsEnabled="{x:Bind ViewModel.HasSelection, Mode=OneWay}"
                                                 KeyDown="OnTicketPriceKeyDown"
                                                 LostFocus="OnTicketPriceLostFocus"
                                                 ToolTipService.ToolTip="Channel points one ticket costs in THIS giveaway. Charged by Giveaway.Ticket entry nodes that have a currency table set and Public on; a Public-off node uses its own Price pill instead. 0 = free entry."
                                                 AutomationProperties.Name="Ticket price in channel points (0 = free)"
                                                 Text="{x:Bind ViewModel.TicketPriceDraft, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBlock Grid.Column="2"
                                                   FontFamily="{StaticResource MonoFont}"
                                                   FontSize="10"
                                                   Foreground="{StaticResource CoalSecondaryTextBrush}"
                                                   VerticalAlignment="Center"
                                                   TextWrapping="Wrap"
                                                   Text="channel points per ticket · 0 = free · charged by entry nodes with a currency table" />
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Activity log -->
                    <Border Background="{StaticResource CoalShellBrush}"
                            BorderBrush="{StaticResource CoalCardBrush}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource Radius1Corner}"
                            MinHeight="160">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0"
                                    BorderBrush="{StaticResource CoalCardBrush}"
                                    BorderThickness="0,0,0,1"
                                    Padding="12,6">
                                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                    <TextBlock Text="ACTIVITY"
                                               FontFamily="{StaticResource SansFont}"
                                               FontSize="10" FontWeight="SemiBold" CharacterSpacing="180"
                                               Foreground="{StaticResource EmberPrimaryBrush}" />
                                    <TextBlock Text="this giveaway"
                                               FontFamily="{StaticResource MonoFont}"
                                               FontSize="10"
                                               Foreground="{StaticResource CoalSecondaryTextBrush}"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>
                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollMode="Disabled" MaxHeight="240">
                                <ItemsRepeater ItemsSource="{x:Bind ViewModel.Activity, Mode=OneWay}"
                                               AutomationProperties.Name="Giveaway activity log">
                                    <ItemsRepeater.ItemTemplate>
                                        <DataTemplate x:DataType="local:GiveawayActivityRowVm">
                                            <Grid Padding="12,3" ColumnSpacing="8"
                                                  BorderBrush="{StaticResource CoalRaisedBrush}"
                                                  BorderThickness="0,0,0,1">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="86" />
                                                    <ColumnDefinition Width="30" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{x:Bind Time}"
                                                           FontFamily="{StaticResource MonoFont}" FontSize="11"
                                                           Foreground="{StaticResource CoalSecondaryTextBrush}" />
                                                <TextBlock Grid.Column="1" Text="{x:Bind Level}"
                                                           FontFamily="{StaticResource MonoFont}" FontSize="11"
                                                           FontWeight="Bold"
                                                           Foreground="{x:Bind LevelBrush}" />
                                                <TextBlock Grid.Column="2" Text="{x:Bind Message}"
                                                           FontFamily="{StaticResource MonoFont}" FontSize="11"
                                                           TextWrapping="Wrap"
                                                           Foreground="{x:Bind MessageBrush}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsRepeater.ItemTemplate>
                                </ItemsRepeater>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- Empty state (no giveaway selected) -->
            <StackPanel Grid.Column="0"
                        Visibility="{x:Bind ViewModel.EmptyVisibility, Mode=OneWay}"
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        Spacing="8">
                <TextBlock Text="No giveaway selected"
                           FontFamily="{StaticResource DisplayFont}"
                           FontSize="20"
                           Foreground="{StaticResource CoalSecondaryTextBrush}"
                           HorizontalAlignment="Center" />
                <TextBlock Text="Create one or pick an existing giveaway from the strip above."
                           FontFamily="{StaticResource SansFont}"
                           FontSize="12"
                           Foreground="{StaticResource CoalSecondaryTextBrush}"
                           HorizontalAlignment="Center" />
            </StackPanel>

            <!-- ───────────── RIGHT: EntrantList ───────────── -->
            <Border Grid.Column="1"
                    Background="{StaticResource CoalSurfaceBrush}"
                    BorderBrush="{StaticResource CoalCardBrush}"
                    BorderThickness="1,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Header: LIVE · Entrants + counts -->
                    <hdr:PanelHeader Grid.Row="0" Eyebrow="LIVE" Title="Entrants">
                        <hdr:PanelHeader.RightContent>
                            <!-- Discrete TextBlocks — x:Bind is unsupported on Run.Text. -->
                            <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                <TextBlock Text="{x:Bind ViewModel.EntrantCountText, Mode=OneWay}"
                                           FontFamily="{StaticResource MonoFont}" FontSize="11"
                                           Foreground="{StaticResource CoalBodyTextBrush}" VerticalAlignment="Center" />
                                <TextBlock Text="users" FontFamily="{StaticResource MonoFont}" FontSize="11"
                                           Foreground="{StaticResource CoalSecondaryTextBrush}" VerticalAlignment="Center" />
                                <TextBlock Text="·" FontFamily="{StaticResource MonoFont}" FontSize="11" Margin="4,0"
                                           Foreground="{StaticResource CoalDividerBrush}" VerticalAlignment="Center" />
                                <TextBlock Text="{x:Bind ViewModel.TotalTicketsText, Mode=OneWay}"
                                           FontFamily="{StaticResource MonoFont}" FontSize="11"
                                           Foreground="{StaticResource Ember200Brush}" VerticalAlignment="Center" />
                                <TextBlock Text="tickets" FontFamily="{StaticResource MonoFont}" FontSize="11"
                                           Foreground="{StaticResource CoalSecondaryTextBrush}" VerticalAlignment="Center" />
                            </StackPanel>
                        </hdr:PanelHeader.RightContent>
                    </hdr:PanelHeader>

                    <!-- Column header row -->
                    <Border Grid.Row="1"
                            Background="{StaticResource CoalRaisedBrush}"
                            BorderBrush="{StaticResource CoalDividerBrush}"
                            BorderThickness="0,0,0,1"
                            Padding="14,6">
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="26" />
                                <ColumnDefinition Width="22" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="#"
                                       FontFamily="{StaticResource SansFont}" FontSize="9" FontWeight="Bold"
                                       CharacterSpacing="140"
                                       Foreground="{StaticResource CoalSecondaryTextBrush}" />
                            <TextBlock Grid.Column="2" Text="USER"
                                       FontFamily="{StaticResource SansFont}" FontSize="9" FontWeight="Bold"
                                       CharacterSpacing="140"
                                       Foreground="{StaticResource CoalSecondaryTextBrush}" />
                            <TextBlock Grid.Column="3" Text="TICKETS ▾"
                                       FontFamily="{StaticResource SansFont}" FontSize="9" FontWeight="Bold"
                                       CharacterSpacing="140"
                                       Foreground="{StaticResource CoalSecondaryTextBrush}" />
                        </Grid>
                    </Border>

                    <!-- Entrant rows -->
                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollMode="Disabled">
                        <ItemsRepeater ItemsSource="{x:Bind ViewModel.Entrants, Mode=OneWay}"
                                       AutomationProperties.LiveSetting="Polite"
                                       AutomationProperties.Name="Entrants sorted by tickets">
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="local:GiveawayEntrantRowVm">
                                    <Grid Padding="0" Background="{x:Bind RowBackground}"
                                          BorderBrush="{StaticResource CoalRaisedBrush}"
                                          BorderThickness="0,0,0,1">
                                        <!-- Weight bar overlay (proportional ember fade) -->
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="{x:Bind BarColumnLength}" />
                                                <ColumnDefinition Width="{x:Bind RestColumnLength}" />
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Background="{x:Bind BarBrush}" />
                                        </Grid>
                                        <!-- Row content -->
                                        <Grid Padding="14,7" ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="26" />
                                                <ColumnDefinition Width="22" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{x:Bind RankText}"
                                                       FontFamily="{StaticResource MonoFont}" FontSize="11"
                                                       FontWeight="SemiBold"
                                                       VerticalAlignment="Center"
                                                       Foreground="{x:Bind RankBrush}" />
                                            <!-- Role badge (BR/M/V/S) -->
                                            <Border Grid.Column="1"
                                                    Visibility="{x:Bind RoleBadgeVisibility}"
                                                    Width="18" Height="14"
                                                    CornerRadius="{StaticResource Radius1Corner}"
                                                    Background="{x:Bind RoleBrush}"
                                                    VerticalAlignment="Center"
                                                    HorizontalAlignment="Left">
                                                <TextBlock Text="{x:Bind RoleLabel}"
                                                           FontFamily="{StaticResource MonoFont}" FontSize="9"
                                                           FontWeight="Bold"
                                                           Foreground="{StaticResource CoalShellBrush}"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center" />
                                            </Border>
                                            <TextBlock Grid.Column="2" Text="{x:Bind Username}"
                                                       FontFamily="{StaticResource SansFont}" FontSize="12"
                                                       FontWeight="Medium"
                                                       TextTrimming="CharacterEllipsis"
                                                       VerticalAlignment="Center"
                                                       Foreground="{StaticResource CoalPrimaryTextBrush}" />
                                            <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="4"
                                                        VerticalAlignment="Center">
                                                <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE8EC;" FontSize="10"
                                                          Opacity="0.55"
                                                          Foreground="{x:Bind TicketsBrush}" />
                                                <TextBlock Text="{x:Bind TicketsText}"
                                                           FontFamily="{StaticResource MonoFont}" FontSize="12"
                                                           FontWeight="SemiBold"
                                                           Foreground="{x:Bind TicketsBrush}" />
                                            </StackPanel>
                                        </Grid>
                                    </Grid>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                    </ScrollViewer>

                    <!-- Footer -->
                    <Border Grid.Row="3"
                            Background="{StaticResource CoalRaisedBrush}"
                            BorderBrush="{StaticResource CoalDividerBrush}"
                            BorderThickness="0,1,0,0"
                            Padding="14,6">
                        <Grid>
                            <TextBlock Text="sorted by tickets · live"
                                       FontFamily="{StaticResource MonoFont}" FontSize="10"
                                       Foreground="{StaticResource CoalSecondaryTextBrush}"
                                       HorizontalAlignment="Left" />
                            <TextBlock Text="live"
                                       FontFamily="{StaticResource MonoFont}" FontSize="10"
                                       Foreground="{StaticResource Ember200Brush}"
                                       HorizontalAlignment="Right" />
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- ════════════════════ DRAW-WINNER OVERLAY ════════════════════ -->
        <Grid Grid.Row="0" Grid.RowSpan="2"
              x:Name="WinnerOverlay"
              Background="{StaticResource GvScrimBrush}"
              Visibility="{x:Bind ViewModel.WinnerOverlayVisibility, Mode=OneWay}">
            <Border Width="520"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="{StaticResource CoalSurfaceBrush}"
                    BorderBrush="{StaticResource EmberShadowBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource Radius2Corner}"
                    Padding="36,32,36,28">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="2" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <!-- Brass top edge -->
                    <Border Grid.Row="0" Background="{StaticResource BrassGradientBrush}"
                            Margin="-36,-32,-36,0" />
                    <StackPanel Grid.Row="1" Spacing="0" HorizontalAlignment="Center" Margin="0,18,0,0">
                        <TextBlock Text="WINNER DRAWN · WEIGHTED"
                                   FontFamily="{StaticResource SansFont}"
                                   FontSize="10" FontWeight="SemiBold" CharacterSpacing="180"
                                   Foreground="{StaticResource EmberPrimaryBrush}"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,8" />
                        <TextBlock Text="{x:Bind ViewModel.WinnerGiveawayTitle, Mode=OneWay}"
                                   FontFamily="{StaticResource DisplayFont}"
                                   FontSize="18" CharacterSpacing="40"
                                   Foreground="{StaticResource CoalBodyTextBrush}"
                                   HorizontalAlignment="Center" TextAlignment="Center"
                                   Margin="0,0,0,18" />
                        <TextBlock Text="{x:Bind ViewModel.WinnerName, Mode=OneWay}"
                                   FontFamily="{StaticResource DisplayFont}"
                                   FontSize="56" FontWeight="SemiBold" CharacterSpacing="20"
                                   Foreground="{StaticResource CoalPaperBrush}"
                                   HorizontalAlignment="Center" TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,6" />
                        <TextBlock Text="{x:Bind ViewModel.WinnerOddsText, Mode=OneWay}"
                                   FontFamily="{StaticResource MonoFont}"
                                   FontSize="11" CharacterSpacing="160"
                                   Foreground="{StaticResource Ember200Brush}"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,22" />
                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                            <Button x:Name="ReDrawButton" Height="30" Padding="14,0"
                                    Background="{StaticResource CoalCardBrush}"
                                    BorderBrush="{StaticResource CoalDividerBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{StaticResource Radius1Corner}"
                                    Click="OnReDrawClick">
                                <TextBlock Text="RE-DRAW" FontFamily="{StaticResource SansFont}"
                                           FontSize="11" FontWeight="Bold" CharacterSpacing="100"
                                           Foreground="{StaticResource CoalBodyTextBrush}" />
                            </Button>
                            <Button x:Name="CopyNameButton" Height="30" Padding="14,0"
                                    Background="{StaticResource CoalCardBrush}"
                                    BorderBrush="{StaticResource CoalDividerBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{StaticResource Radius1Corner}"
                                    Click="OnCopyNameClick">
                                <TextBlock Text="COPY NAME" FontFamily="{StaticResource SansFont}"
                                           FontSize="11" FontWeight="Bold" CharacterSpacing="100"
                                           Foreground="{StaticResource CoalBodyTextBrush}" />
                            </Button>
                            <Button x:Name="AnnounceButton" Height="30" Padding="14,0"
                                    Background="{StaticResource GvBrassHeroBrush}"
                                    BorderBrush="{StaticResource Ember600Brush}"
                                    BorderThickness="1"
                                    CornerRadius="{StaticResource Radius1Corner}"
                                    Click="OnAnnounceClick">
                                <TextBlock Text="ANNOUNCE IN CHAT" FontFamily="{StaticResource SansFont}"
                                           FontSize="11" FontWeight="Bold" CharacterSpacing="100"
                                           Foreground="{StaticResource CoalShellBrush}" />
                            </Button>
                        </StackPanel>
                        <TextBlock Text="shown on stream overlay"
                                   FontFamily="{StaticResource MonoFont}"
                                   FontSize="10" CharacterSpacing="40"
                                   Foreground="{StaticResource CoalSecondaryTextBrush}"
                                   HorizontalAlignment="Center"
                                   Margin="0,14,0,0" />
                        <!-- Dismiss affordance -->
                        <Button x:Name="WinnerCloseButton" Click="OnWinnerCloseClick"
                                HorizontalAlignment="Center" Margin="0,10,0,0"
                                Background="Transparent" BorderThickness="0" Padding="6,2">
                            <TextBlock Text="dismiss"
                                       FontFamily="{StaticResource MonoFont}" FontSize="10"
                                       Foreground="{StaticResource CoalSecondaryTextBrush}" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- ════════════════════ CREATE GIVEAWAY OVERLAY ════════════════════ -->
        <Grid Grid.Row="0" Grid.RowSpan="2"
              x:Name="CreateOverlay"
              Background="{StaticResource GvScrimBrush}"
              Visibility="Collapsed">
            <Border Width="420"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="{StaticResource CoalSurfaceBrush}"
                    BorderBrush="{StaticResource EmberShadowBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource Radius2Corner}"
                    Padding="28,24">
                <StackPanel Spacing="14">
                    <TextBlock Text="NEW GIVEAWAY"
                               FontFamily="{StaticResource SansFont}"
                               FontSize="10" FontWeight="SemiBold" CharacterSpacing="180"
                               Foreground="{StaticResource EmberPrimaryBrush}" />
                    <TextBlock Text="Name the giveaway"
                               FontFamily="{StaticResource DisplayFont}"
                               FontSize="22"
                               Foreground="{StaticResource CoalPaperBrush}" />
                    <TextBox x:Name="CreateTitleBox"
                             PlaceholderText="e.g. Forged Coffee Mug · Nov stream"
                             Background="{StaticResource CoalShellBrush}"
                             Foreground="{StaticResource CoalPrimaryTextBrush}"
                             BorderBrush="{StaticResource CoalDividerBrush}"
                             BorderThickness="1"
                             FontFamily="{StaticResource SansFont}"
                             FontSize="13"
                             KeyDown="OnCreateTitleKeyDown"
                             Text="{x:Bind ViewModel.CreateTitleDraft, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                        <Button x:Name="CreateCancelButton" Height="30" Padding="14,0"
                                Background="{StaticResource CoalCardBrush}"
                                BorderBrush="{StaticResource CoalDividerBrush}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource Radius1Corner}"
                                Click="OnCreateCancelClick">
                            <TextBlock Text="CANCEL" FontFamily="{StaticResource SansFont}"
                                       FontSize="11" FontWeight="Bold" CharacterSpacing="100"
                                       Foreground="{StaticResource CoalBodyTextBrush}" />
                        </Button>
                        <Button x:Name="CreateConfirmButton" Height="30" Padding="14,0"
                                Background="{StaticResource GvBrassHeroBrush}"
                                BorderBrush="{StaticResource Ember600Brush}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource Radius1Corner}"
                                Click="OnCreateConfirmClick">
                            <TextBlock Text="CREATE" FontFamily="{StaticResource SansFont}"
                                       FontSize="11" FontWeight="Bold" CharacterSpacing="100"
                                       Foreground="{StaticResource CoalShellBrush}" />
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
