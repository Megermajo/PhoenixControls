<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Phoenix.Controls.Hub.WinUI.Panels.GiveawayPanel.GiveawayView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Phoenix.Controls.Hub.WinUI.Panels.GiveawayPanel"
    xmlns:hdr="using:Phoenix.Controls.Hub.WinUI.Panels.Common"
    xmlns:loc="using:Phoenix.Controls.Hub.WinUI.Localization"
    HorizontalAlignment="Stretch"
    VerticalAlignment="Stretch"
    HorizontalContentAlignment="Stretch"
    VerticalContentAlignment="Stretch"
    AutomationProperties.Name="Giveaway page"
    AutomationProperties.HelpText="Run a giveaway: create one, pick the active giveaway, watch entrants and tickets roll in, and draw a weighted winner."
    loc:Localize.AutomationKey="panel.giveaway.page.a11y"
    loc:Localize.HelpTextKey="panel.giveaway.page.help">

    <UserControl.Resources>
        <ResourceDictionary>
            <!-- The page's chrome recipes now come from the house dictionary
                 instead of being retyped inline. Three page-local declarations
                 died with it: GvBrassHeroBrush (identical four stops to
                 ToolBrassHeroBrush), GvScrimBrush (identical to ToolScrimBrush)
                 and the GvStatusOpen* pair, which only ever painted the status
                 pill the header band replaced. -->
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ms-appx:///Panels/Common/ToolShellStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Default-pin badge tint on the picker button. Kept local: it is a
                 badge fill, not one of the shell's CTA/card/text tiers, and no
                 ToolShellStyles key carries these two alphas. -->
            <SolidColorBrush x:Key="GvEmberTint08Brush" Color="#14E5A24E" />
            <SolidColorBrush x:Key="GvEmberBorderBrush" Color="#73E5A24E" />
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Background="{StaticResource CoalSurfaceBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ════════════════════ HEADER BAND (48 px) ════════════════════
             Tool name · master switch (= set-default) · one state phrase.
             It replaces the hand-rolled set-default pill that used to sit in
             the detail card and the status-pill row beneath it — the same
             giveaway state was being rendered twice, in two vocabularies, one
             of them with its own storyboard. The pill's PREDICATES are
             untouched: the phrase is still VM.StatusPillText gated by
             VM.IsOpen. -->
        <hdr:ToolPageHeader Grid.Row="0" x:Name="PageHeader" />

        <!-- ════════════════════ VERB STRIP ════════════════════
             Pinned, not scrolled: with zero giveaways the detail column is
             collapsed, so CREATE and the picker have to live outside it or the
             page is unusable on a fresh install. Padding tightened 10 → 4
             because the band above now carries the page's breathing room. -->
        <Border Grid.Row="1"
                Background="{StaticResource CoalSurfaceBrush}"
                BorderBrush="{StaticResource CoalDividerBrush}"
                BorderThickness="0,0,0,1"
                Padding="14,4">
            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />   <!-- Create -->
                    <ColumnDefinition Width="Auto" />   <!-- Picker -->
                    <ColumnDefinition Width="*" />      <!-- spacer -->
                    <ColumnDefinition Width="Auto" />   <!-- Close (danger) -->
                    <ColumnDefinition Width="Auto" />   <!-- Draw (primary hero) -->
                </Grid.ColumnDefinitions>

                <!-- [Create new giveaway] -->
                <Button Grid.Column="0"
                        x:Name="CreateButton"
                        Style="{StaticResource ToolSecondaryButtonStyle}"
                        Click="OnCreateClick"
                        AutomationProperties.Name="Create new giveaway"
                        loc:Localize.AutomationKey="panel.giveaway.strip.create.a11y">
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE710;" FontSize="11"
                                  Foreground="{StaticResource CoalBodyTextBrush}" />
                        <TextBlock Text="CREATE NEW GIVEAWAY"
                                   Style="{StaticResource ToolStripLabelTextStyle}"
                                   loc:Localize.Key="panel.giveaway.strip.create.label" />
                    </StackPanel>
                </Button>

                <!-- Giveaway PICKER — a button that opens a search/filter Flyout -->
                <Button Grid.Column="1"
                        x:Name="PickerButton"
                        Width="360"
                        Height="30"
                        Padding="10,0"
                        HorizontalContentAlignment="Stretch"
                        Background="{StaticResource CoalShellBrush}"
                        BorderBrush="{StaticResource CoalDividerBrush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource Radius1Corner}"
                        AutomationProperties.Name="Active giveaway picker"
                        loc:Localize.AutomationKey="panel.giveaway.picker.button.a11y">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Grid.Column="0" FontFamily="Segoe MDL2 Assets" Glyph="&#xE721;" FontSize="12"
                                  Foreground="{StaticResource EmberPrimaryBrush}" VerticalAlignment="Center" />
                        <!-- Selected title + id (or placeholder) -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <TextBlock Text="{x:Bind ViewModel.PickerButtonTitle, Mode=OneWay}"
                                       FontFamily="{StaticResource SansFont}"
                                       FontSize="12" FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis"
                                       Foreground="{StaticResource CoalPrimaryTextBrush}"
                                       VerticalAlignment="Center" />
                            <TextBlock Text="{x:Bind ViewModel.PickerButtonId, Mode=OneWay}"
                                       FontFamily="{StaticResource MonoFont}"
                                       FontSize="11"
                                       Foreground="{StaticResource CoalSecondaryTextBrush}"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                        <!-- DEFAULT pin badge -->
                        <Border Grid.Column="2"
                                Visibility="{x:Bind ViewModel.PickerButtonDefaultVisibility, Mode=OneWay}"
                                Background="{StaticResource GvEmberTint08Brush}"
                                BorderBrush="{StaticResource GvEmberBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource Radius1Corner}"
                                Padding="5,2"
                                VerticalAlignment="Center"
                                ToolTipService.ToolTip="Default — public=true nodes target this giveaway"
                                loc:Localize.TooltipKey="panel.giveaway.picker.default_badge.tip">
                            <StackPanel Orientation="Horizontal" Spacing="3">
                                <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE718;" FontSize="9"
                                          Foreground="{StaticResource EmberPrimaryBrush}" />
                                <TextBlock Text="DEFAULT"
                                           FontFamily="{StaticResource MonoFont}"
                                           FontSize="9" FontWeight="Bold" CharacterSpacing="120"
                                           Foreground="{StaticResource EmberPrimaryBrush}"
                                           VerticalAlignment="Center"
                                           loc:Localize.Key="panel.giveaway.picker.default_badge.label" />
                            </StackPanel>
                        </Border>
                        <FontIcon Grid.Column="3" FontFamily="Segoe MDL2 Assets" Glyph="&#xE70D;" FontSize="10"
                                  Foreground="{StaticResource CoalSecondaryTextBrush}" VerticalAlignment="Center" />
                    </Grid>

                    <Button.Flyout>
                        <Flyout x:Name="PickerFlyout" Placement="Bottom">
                            <Flyout.FlyoutPresenterStyle>
                                <Style TargetType="FlyoutPresenter">
                                    <Setter Property="Background" Value="{StaticResource CoalRaisedBrush}" />
                                    <Setter Property="BorderBrush" Value="{StaticResource CoalDividerBrush}" />
                                    <Setter Property="BorderThickness" Value="1" />
                                    <Setter Property="CornerRadius" Value="{StaticResource Radius2Corner}" />
                                    <Setter Property="Padding" Value="4" />
                                    <Setter Property="MaxWidth" Value="420" />
                                    <Setter Property="MinWidth" Value="360" />
                                </Style>
                            </Flyout.FlyoutPresenterStyle>
                            <Grid Width="360" RowSpacing="4">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <!-- Filter box -->
                                <TextBox Grid.Row="0"
                                         x:Name="PickerFilterBox"
                                         PlaceholderText="filter by title or id…"
                                         loc:Localize.PlaceholderKey="panel.giveaway.picker.filter.placeholder"
                                         Background="{StaticResource CoalShellBrush}"
                                         Foreground="{StaticResource CoalPrimaryTextBrush}"
                                         BorderBrush="{StaticResource CoalDividerBrush}"
                                         BorderThickness="1"
                                         FontFamily="{StaticResource MonoFont}"
                                         FontSize="11"
                                         Margin="2,2,2,4"
                                         Text="{x:Bind ViewModel.PickerFilter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                                <!-- Results -->
                                <ScrollViewer Grid.Row="1"
                                              MaxHeight="260"
                                              VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollMode="Disabled">
                                    <ItemsRepeater ItemsSource="{x:Bind ViewModel.PickerItems, Mode=OneWay}"
                                                   hdr:RowDataContext.Supply="True">
                                        <ItemsRepeater.ItemTemplate>
                                            <DataTemplate x:DataType="local:GiveawayPickerItemVm">
                                                <Button HorizontalAlignment="Stretch"
                                                        HorizontalContentAlignment="Stretch"
                                                        Background="Transparent"
                                                        BorderThickness="0"
                                                        Padding="10,7"
                                                        Click="OnPickerItemClick"
                                                        Tag="{x:Bind Id}">
                                                    <Grid ColumnSpacing="8">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Grid.Column="0" Spacing="2">
                                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                                <TextBlock Text="{x:Bind Title}"
                                                                           FontFamily="{StaticResource SansFont}"
                                                                           FontSize="12" FontWeight="SemiBold"
                                                                           TextTrimming="CharacterEllipsis"
                                                                           Foreground="{StaticResource CoalPrimaryTextBrush}" />
                                                                <TextBlock Text="DEFAULT"
                                                                           Visibility="{x:Bind DefaultBadgeVisibility}"
                                                                           FontFamily="{StaticResource MonoFont}"
                                                                           FontSize="9" CharacterSpacing="100"
                                                                           Foreground="{StaticResource EmberPrimaryBrush}"
                                                                           VerticalAlignment="Center"
                                                                           loc:Localize.Key="panel.giveaway.picker.item.default_badge" />
                                                            </StackPanel>
                                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                                <TextBlock Text="{x:Bind DisplayId}"
                                                                           FontFamily="{StaticResource MonoFont}"
                                                                           FontSize="10"
                                                                           Foreground="{StaticResource CoalSecondaryTextBrush}" />
                                                                <TextBlock Text="·" FontFamily="{StaticResource MonoFont}"
                                                                           FontSize="10"
                                                                           Foreground="{StaticResource CoalSecondaryTextBrush}" />
                                                                <TextBlock Text="{x:Bind StatusText}"
                                                                           FontFamily="{StaticResource MonoFont}"
                                                                           FontSize="10"
                                                                           Foreground="{x:Bind StatusBrush}" />
                                                            </StackPanel>
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                                            <TextBlock Text="{x:Bind EntrantsText}"
                                                                       FontFamily="{StaticResource MonoFont}"
                                                                       FontSize="11"
                                                                       HorizontalAlignment="Right"
                                                                       Foreground="{StaticResource CoalBodyTextBrush}" />
                                                            <TextBlock Text="{x:Bind TicketsText}"
                                                                       FontFamily="{StaticResource MonoFont}"
                                                                       FontSize="10"
                                                                       HorizontalAlignment="Right"
                                                                       Foreground="{StaticResource CoalSecondaryTextBrush}" />
                                                        </StackPanel>
                                                    </Grid>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsRepeater.ItemTemplate>
                                    </ItemsRepeater>
                                </ScrollViewer>

                                <Border Grid.Row="2" Height="1" Margin="6,4"
                                        Background="{StaticResource CoalDividerBrush}" />

                                <!-- New giveaway from this filter -->
                                <Button Grid.Row="3"
                                        x:Name="PickerCreateButton"
                                        HorizontalAlignment="Stretch"
                                        HorizontalContentAlignment="Left"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Padding="10,7"
                                        Click="OnPickerCreateClick">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE710;" FontSize="11"
                                                  Foreground="{StaticResource Ember200Brush}" />
                                        <TextBlock Text="New giveaway from this filter…"
                                                   FontFamily="{StaticResource SansFont}"
                                                   FontSize="12" FontWeight="SemiBold"
                                                   Foreground="{StaticResource Ember200Brush}"
                                                   VerticalAlignment="Center"
                                                   loc:Localize.Key="panel.giveaway.picker.create.label" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </Flyout>
                    </Button.Flyout>
                </Button>

                <!-- [Close giveaway] — danger, disabled unless open -->
                <Button Grid.Column="3"
                        x:Name="CloseButton"
                        Style="{StaticResource ToolDangerButtonStyle}"
                        IsEnabled="{x:Bind ViewModel.CanClose, Mode=OneWay}"
                        Click="OnCloseGiveawayClick"
                        AutomationProperties.Name="Close giveaway"
                        loc:Localize.AutomationKey="panel.giveaway.strip.close.a11y">
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE711;" FontSize="11"
                                  Foreground="{StaticResource ErrBrush}" />
                        <TextBlock Text="CLOSE GIVEAWAY"
                                   Style="{StaticResource ToolStripLabelTextStyle}"
                                   loc:Localize.Key="panel.giveaway.strip.close.label" />
                    </StackPanel>
                </Button>

                <!-- [Draw winner] — the page's ONE brass CTA. Its Opacity is
                     gated to 0 from code-behind while either overlay is up
                     (ApplyBrassGate): both overlays are 0.78-alpha scrims that
                     cover this row, so brass used to smear through beside the
                     overlay's own brass CTA — two brass CTAs on screen at once.
                     Opacity, not Visibility: collapsing the strip's last column
                     slides CLOSE GIVEAWAY sideways, and that reflow is visible
                     through the scrim. -->
                <Button Grid.Column="4"
                        x:Name="DrawButton"
                        Style="{StaticResource ToolBrassCtaStyle}"
                        IsEnabled="{x:Bind ViewModel.CanDraw, Mode=OneWay}"
                        Click="OnDrawWinnerClick"
                        ToolTipService.ToolTip="Pick a winner — weighted by ticket count (subscriber bonus factor applies)"
                        AutomationProperties.Name="Draw winner"
                        loc:Localize.TooltipKey="panel.giveaway.strip.draw.tip"
                        loc:Localize.AutomationKey="panel.giveaway.strip.draw.a11y">
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE735;" FontSize="11"
                                  Foreground="{StaticResource CoalShellBrush}" />
                        <TextBlock Text="DRAW WINNER"
                                   Style="{StaticResource ToolBrassCtaLabelTextStyle}"
                                   loc:Localize.Key="panel.giveaway.strip.draw.label" />
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <!-- ════════════════════ TWO-COLUMN BODY ════════════════════
             The live column is a fixed 300 px, not a proportional share: the
             entrant list is four narrow cells and a weight bar, so a star width
             only ever bought it whitespace on a wide monitor while stealing it
             from the settings rows on a narrow one. -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="300" />
            </Grid.ColumnDefinitions>

            <!-- ───────────── LEFT: GiveawayDetail ───────────── -->
            <ScrollViewer Grid.Column="0"
                          x:Name="DetailScroll"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollMode="Disabled"
                          Visibility="{x:Bind ViewModel.DetailVisibility, Mode=OneWay}">
                <StackPanel Spacing="12" Padding="14">

                    <!-- Title + meta. The "ACTIVE GIVEAWAY" eyebrow is gone: the
                         header band names the tool 24 px above it and the picker
                         button names the selected giveaway on the row between —
                         it was a third label over a string already rendered
                         twice. The set-default pill that sat to its right is now
                         the band's master switch. -->
                    <StackPanel Spacing="4">
                            <TextBlock Text="{x:Bind ViewModel.Title, Mode=OneWay}"
                                       FontFamily="{StaticResource DisplayFont}"
                                       FontSize="28" CharacterSpacing="20"
                                       TextWrapping="Wrap"
                                       Foreground="{StaticResource CoalPaperBrush}" />
                            <!-- Meta line. Built from discrete TextBlocks rather than
                                 inline Runs because x:Bind is not supported on Run.Text
                                 in WinUI 3 (the markup compiler crashes on it). -->
                            <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,2,0,0">
                                <TextBlock Text="id" FontFamily="{StaticResource MonoFont}" FontSize="11"
                                           Foreground="{StaticResource CoalSecondaryTextBrush}" VerticalAlignment="Center"
                                           loc:Localize.Key="panel.giveaway.detail.meta.id.label" />
                                <TextBlock Text="{x:Bind ViewModel.MetaId, Mode=OneWay}"
                                           FontFamily="{StaticResource MonoFont}" FontSize="11"
                                           Foreground="{StaticResource CoalPrimaryTextBrush}" VerticalAlignment="Center" />
                                <TextBlock Text="·" FontFamily="{StaticResource MonoFont}" FontSize="11" Margin="6,0,2,0"
                                           Foreground="{StaticResource CoalSecondaryTextBrush}" VerticalAlignment="Center" />
                                <TextBlock Text="opened" FontFamily="{StaticResource MonoFont}" FontSize="11"
                                           Foreground="{StaticResource CoalSecondaryTextBrush}" VerticalAlignment="Center"
                                           loc:Localize.Key="panel.giveaway.detail.meta.opened.label" />
                                <TextBlock Text="{x:Bind ViewModel.MetaOpenedAt, Mode=OneWay}"
                                           FontFamily="{StaticResource MonoFont}" FontSize="11"
                                           Foreground="{StaticResource CoalPrimaryTextBrush}" VerticalAlignment="Center" />
                                <TextBlock Text="·" FontFamily="{StaticResource MonoFont}" FontSize="11" Margin="6,0,2,0"
                                           Foreground="{StaticResource CoalSecondaryTextBrush}" VerticalAlignment="Center" />
                                <TextBlock Text="by" FontFamily="{StaticResource MonoFont}" FontSize="11"
                                           Foreground="{StaticResource CoalSecondaryTextBrush}" VerticalAlignment="Center"
                                           loc:Localize.Key="panel.giveaway.detail.meta.by.label" />
                                <TextBlock Text="{x:Bind ViewModel.MetaOpenedBy, Mode=OneWay}"
                                           FontFamily="{StaticResource MonoFont}" FontSize="11"
                                           Foreground="{StaticResource CoalPrimaryTextBrush}" VerticalAlignment="Center" />
                            </StackPanel>
                    </StackPanel>

                    <!-- The status-pill row that stood here (tinted pill + pulsing
                         dot + "entries accepted from chat" hint) is gone. It was
                         the third rendering of one boolean; the band's state
                         phrase carries it, off the same VM.StatusPillText /
                         VM.IsOpen predicates. -->

                    <!-- Stat tiles. Giveaway is a WATCH surface, so the strip
                         stays — on the common ToolStatTile now, not the
                         byte-identical page-local GvStatTile it used to mint. -->
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <hdr:ToolStatTile Grid.Column="0" Caption="ENTRANTS"
                                          Value="{x:Bind ViewModel.EntrantsValue, Mode=OneWay}"
                                          loc:Localize.Key="panel.giveaway.stats.entrants.caption" />
                        <hdr:ToolStatTile Grid.Column="1" Caption="TICKETS"
                                          Accent="True"
                                          Value="{x:Bind ViewModel.TicketsValue, Mode=OneWay}"
                                          loc:Localize.Key="panel.giveaway.stats.tickets.caption" />
                        <hdr:ToolStatTile Grid.Column="2" Caption="AVG / USER"
                                          Value="{x:Bind ViewModel.AvgValue, Mode=OneWay}"
                                          loc:Localize.Key="panel.giveaway.stats.avg.caption" />
                        <hdr:ToolStatTile Grid.Column="3" Caption="LAST ENTRY"
                                          Value="{x:Bind ViewModel.LastEntryValue, Mode=OneWay}"
                                          loc:Localize.Key="panel.giveaway.stats.last_entry.caption" />
                    </Grid>

                    <!-- Settings card — collapsible; the header row IS the
                         toggle. Both remaining settings are editable inputs:
                         entry itself is script-driven (the GiveawayTicket .phx
                         calls giveaway.ticket), so there is no entry command /
                         tickets-per-message / draw-method row any more. -->
                    <Border Style="{StaticResource ToolSectionCardStyle}">
                        <StackPanel Spacing="0">
                            <Button x:Name="SettingsHeaderButton"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Stretch"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Padding="0,2"
                                    Click="OnToggleSettingsClick"
                                    ToolTipService.ToolTip="Collapse / expand the settings panel"
                                    loc:Localize.TooltipKey="panel.giveaway.settings.toggle.tip"
                                    AutomationProperties.Name="{x:Bind ViewModel.SettingsToggleAutomationName, Mode=OneWay}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="SETTINGS"
                                               Style="{StaticResource ToolEyebrowTextStyle}"
                                               VerticalAlignment="Center"
                                               loc:Localize.Key="panel.giveaway.settings.eyebrow" />
                                    <FontIcon Grid.Column="1"
                                              FontFamily="Segoe MDL2 Assets"
                                              Glyph="{x:Bind ViewModel.SettingsChevronGlyph, Mode=OneWay}"
                                              FontSize="10"
                                              Foreground="{StaticResource CoalSecondaryTextBrush}"
                                              VerticalAlignment="Center" />
                                </Grid>
                            </Button>
                            <StackPanel x:Name="SettingsBody"
                                        Spacing="0"
                                        Visibility="{x:Bind ViewModel.SettingsBodyVisibility, Mode=OneWay}"
                                        Margin="0,6,0,0">
                                <!-- Subscriber bonus — ticket-weight FACTOR applied to
                                     subscribers at draw time (their sub status is
                                     gathered fresh via Streamer.bot right before the
                                     draw). 1 = no bonus; saves on Enter / focus loss,
                                     Escape reverts. -->
                                <Border BorderBrush="{StaticResource CoalCardBrush}"
                                        BorderThickness="0,0,0,1"
                                        Padding="0,5">
                                    <Grid ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="130" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0"
                                                   Style="{StaticResource ToolSettingsLabelTextStyle}"
                                                   Text="Subscriber bonus"
                                                   loc:Localize.Key="panel.giveaway.settings.sub_bonus.label" />
                                        <TextBox Grid.Column="1"
                                                 x:Name="SubBonusBox"
                                                 Width="72"
                                                 Background="{StaticResource CoalShellBrush}"
                                                 Foreground="{StaticResource CoalPrimaryTextBrush}"
                                                 BorderBrush="{StaticResource CoalDividerBrush}"
                                                 BorderThickness="1"
                                                 FontFamily="{StaticResource MonoFont}"
                                                 FontSize="11"
                                                 TextAlignment="Right"
                                                 VerticalAlignment="Center"
                                                 IsEnabled="{x:Bind ViewModel.HasSelection, Mode=OneWay}"
                                                 KeyDown="OnSubBonusKeyDown"
                                                 LostFocus="OnSubBonusLostFocus"
                                                 AutomationProperties.Name="Subscriber ticket-weight factor (1 = no bonus)"
                                                 loc:Localize.AutomationKey="panel.giveaway.settings.sub_bonus.a11y"
                                                 Text="{x:Bind ViewModel.SubBonusDraft, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBlock Grid.Column="2"
                                                   Style="{StaticResource ToolMonoHintTextStyle}"
                                                   VerticalAlignment="Center"
                                                   Text="× ticket weight for subs at draw · 1 = no bonus"
                                                   loc:Localize.Key="panel.giveaway.settings.sub_bonus.hint" />
                                    </Grid>
                                </Border>
                                <!-- Moderator bonus — mirror of the subscriber row.
                                     Mod status comes from the IsSub/IsMod flags the
                                     entry script recorded (no live re-check); factors
                                     multiply for entrants who are both. -->
                                <Border BorderBrush="{StaticResource CoalCardBrush}"
                                        BorderThickness="0,0,0,1"
                                        Padding="0,5">
                                    <Grid ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="130" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0"
                                                   Style="{StaticResource ToolSettingsLabelTextStyle}"
                                                   Text="Moderator bonus"
                                                   loc:Localize.Key="panel.giveaway.settings.mod_bonus.label" />
                                        <TextBox Grid.Column="1"
                                                 x:Name="ModBonusBox"
                                                 Width="72"
                                                 Background="{StaticResource CoalShellBrush}"
                                                 Foreground="{StaticResource CoalPrimaryTextBrush}"
                                                 BorderBrush="{StaticResource CoalDividerBrush}"
                                                 BorderThickness="1"
                                                 FontFamily="{StaticResource MonoFont}"
                                                 FontSize="11"
                                                 TextAlignment="Right"
                                                 VerticalAlignment="Center"
                                                 IsEnabled="{x:Bind ViewModel.HasSelection, Mode=OneWay}"
                                                 KeyDown="OnModBonusKeyDown"
                                                 LostFocus="OnModBonusLostFocus"
                                                 AutomationProperties.Name="Moderator ticket-weight factor (1 = no bonus)"
                                                 loc:Localize.AutomationKey="panel.giveaway.settings.mod_bonus.a11y"
                                                 Text="{x:Bind ViewModel.ModBonusDraft, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBlock Grid.Column="2"
                                                   Style="{StaticResource ToolMonoHintTextStyle}"
                                                   VerticalAlignment="Center"
                                                   Text="× ticket weight for mods at draw · 1 = no bonus"
                                                   loc:Localize.Key="panel.giveaway.settings.mod_bonus.hint" />
                                    </Grid>
                                </Border>
                                <!-- Max tickets per user — 0 = unlimited; saves on
                                     Enter / focus loss, Escape reverts. -->
                                <Border BorderBrush="{StaticResource CoalCardBrush}"
                                        BorderThickness="0,0,0,1"
                                        Padding="0,5">
                                    <Grid ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="130" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0"
                                                   Style="{StaticResource ToolSettingsLabelTextStyle}"
                                                   Text="Max tickets per user"
                                                   loc:Localize.Key="panel.giveaway.settings.cap_per_user.label" />
                                        <TextBox Grid.Column="1"
                                                 x:Name="CapPerUserBox"
                                                 Width="72"
                                                 Background="{StaticResource CoalShellBrush}"
                                                 Foreground="{StaticResource CoalPrimaryTextBrush}"
                                                 BorderBrush="{StaticResource CoalDividerBrush}"
                                                 BorderThickness="1"
                                                 FontFamily="{StaticResource MonoFont}"
                                                 FontSize="11"
                                                 TextAlignment="Right"
                                                 VerticalAlignment="Center"
                                                 IsEnabled="{x:Bind ViewModel.HasSelection, Mode=OneWay}"
                                                 KeyDown="OnCapPerUserKeyDown"
                                                 LostFocus="OnCapPerUserLostFocus"
                                                 AutomationProperties.Name="Max tickets per user (0 = unlimited)"
                                                 loc:Localize.AutomationKey="panel.giveaway.settings.cap_per_user.a11y"
                                                 Text="{x:Bind ViewModel.CapPerUserDraft, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBlock Grid.Column="2"
                                                   Style="{StaticResource ToolMonoHintTextStyle}"
                                                   VerticalAlignment="Center"
                                                   Text="0 = unlimited"
                                                   loc:Localize.Key="panel.giveaway.settings.cap_per_user.hint" />
                                    </Grid>
                                </Border>
                                <!-- Ticket price — channel points per ticket charged by
                                     Giveaway.Ticket nodes that carry a currency table and
                                     follow this giveaway (Public on); 0 = free. Saves on
                                     Enter / focus loss, Escape reverts. Last row → no
                                     bottom divider. -->
                                <Border BorderThickness="0"
                                        Padding="0,5">
                                    <Grid ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="130" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0"
                                                   Style="{StaticResource ToolSettingsLabelTextStyle}"
                                                   Text="Ticket price"
                                                   loc:Localize.Key="panel.giveaway.settings.ticket_price.label" />
                                        <TextBox Grid.Column="1"
                                                 x:Name="TicketPriceBox"
                                                 Width="72"
                                                 Background="{StaticResource CoalShellBrush}"
                                                 Foreground="{StaticResource CoalPrimaryTextBrush}"
                                                 BorderBrush="{StaticResource CoalDividerBrush}"
                                                 BorderThickness="1"
                                                 FontFamily="{StaticResource MonoFont}"
                                                 FontSize="11"
                                                 TextAlignment="Right"
                                                 VerticalAlignment="Center"
                                                 IsEnabled="{x:Bind ViewModel.HasSelection, Mode=OneWay}"
                                                 KeyDown="OnTicketPriceKeyDown"
                                                 LostFocus="OnTicketPriceLostFocus"
                                                 ToolTipService.ToolTip="Channel points one ticket costs in THIS giveaway. Charged by Giveaway.Ticket entry nodes that have a currency table set and Public on; a Public-off node uses its own Price pill instead. 0 = free entry."
                                                 AutomationProperties.Name="Ticket price in channel points (0 = free)"
                                                 loc:Localize.TooltipKey="panel.giveaway.settings.ticket_price.tip"
                                                 loc:Localize.AutomationKey="panel.giveaway.settings.ticket_price.a11y"
                                                 Text="{x:Bind ViewModel.TicketPriceDraft, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBlock Grid.Column="2"
                                                   Style="{StaticResource ToolMonoHintTextStyle}"
                                                   VerticalAlignment="Center"
                                                   Text="channel points per ticket · 0 = free · charged by entry nodes with a currency table"
                                                   loc:Localize.Key="panel.giveaway.settings.ticket_price.hint" />
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Activity log. Kept: this is the giveaway's own audit trail
                         (who entered, when it closed, who was drawn), not the
                         shared ToolActivityFeed watch-strip the config pages
                         drop — Giveaway has no ToolActivityFeed instance.
                         Padding is overridden to 0 because the card's header row
                         is full-bleed with its own inset. -->
                    <Border Style="{StaticResource ToolSectionCardStyle}"
                            Padding="0"
                            MinHeight="160">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0"
                                    BorderBrush="{StaticResource CoalCardBrush}"
                                    BorderThickness="0,0,0,1"
                                    Padding="12,6">
                                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                    <TextBlock Text="ACTIVITY"
                                               Style="{StaticResource ToolEyebrowTextStyle}"
                                               loc:Localize.Key="panel.giveaway.activity.eyebrow" />
                                    <TextBlock Text="this giveaway"
                                               Style="{StaticResource ToolMonoHintTextStyle}"
                                               VerticalAlignment="Center"
                                               loc:Localize.Key="panel.giveaway.activity.scope_hint" />
                                </StackPanel>
                            </Border>
                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollMode="Disabled" MaxHeight="240">
                                <ItemsRepeater ItemsSource="{x:Bind ViewModel.Activity, Mode=OneWay}"
                                               hdr:RowDataContext.Supply="True"
                                               AutomationProperties.Name="Giveaway activity log"
                                               loc:Localize.AutomationKey="panel.giveaway.activity.list.a11y">
                                    <ItemsRepeater.ItemTemplate>
                                        <DataTemplate x:DataType="local:GiveawayActivityRowVm">
                                            <Grid Padding="12,3" ColumnSpacing="8"
                                                  BorderBrush="{StaticResource CoalRaisedBrush}"
                                                  BorderThickness="0,0,0,1">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="86" />
                                                    <ColumnDefinition Width="30" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{x:Bind Time}"
                                                           FontFamily="{StaticResource MonoFont}" FontSize="11"
                                                           Foreground="{StaticResource CoalSecondaryTextBrush}" />
                                                <TextBlock Grid.Column="1" Text="{x:Bind Level}"
                                                           FontFamily="{StaticResource MonoFont}" FontSize="11"
                                                           FontWeight="Bold"
                                                           Foreground="{x:Bind LevelBrush}" />
                                                <TextBlock Grid.Column="2" Text="{x:Bind Message}"
                                                           FontFamily="{StaticResource MonoFont}" FontSize="11"
                                                           TextWrapping="Wrap"
                                                           Foreground="{x:Bind MessageBrush}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsRepeater.ItemTemplate>
                                </ItemsRepeater>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- Empty state (no giveaway selected) -->
            <StackPanel Grid.Column="0"
                        Visibility="{x:Bind ViewModel.EmptyVisibility, Mode=OneWay}"
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        Spacing="8">
                <TextBlock Text="No giveaway selected"
                           Style="{StaticResource ToolEmptyTitleTextStyle}"
                           loc:Localize.Key="panel.giveaway.empty.title" />
                <TextBlock Text="Create one or pick an existing giveaway from the strip above."
                           Style="{StaticResource ToolHintTextStyle}"
                           TextAlignment="Center"
                           HorizontalAlignment="Center"
                           loc:Localize.Key="panel.giveaway.empty.body" />
            </StackPanel>

            <!-- ───────────── RIGHT: EntrantList ───────────── -->
            <Border Grid.Column="1"
                    Background="{StaticResource CoalSurfaceBrush}"
                    BorderBrush="{StaticResource CoalCardBrush}"
                    BorderThickness="1,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Header: LIVE · Entrants + counts -->
                    <hdr:PanelHeader Grid.Row="0" Eyebrow="LIVE" Title="Entrants"
                                     EyebrowKey="panel.common.eyebrow.live"
                                     TitleKey="panel.giveaway.entrants.title">
                        <hdr:PanelHeader.RightContent>
                            <!-- Discrete TextBlocks — x:Bind is unsupported on Run.Text. -->
                            <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                <TextBlock Text="{x:Bind ViewModel.EntrantCountText, Mode=OneWay}"
                                           FontFamily="{StaticResource MonoFont}" FontSize="11"
                                           Foreground="{StaticResource CoalBodyTextBrush}" VerticalAlignment="Center" />
                                <TextBlock Text="users" FontFamily="{StaticResource MonoFont}" FontSize="11"
                                           Foreground="{StaticResource CoalSecondaryTextBrush}" VerticalAlignment="Center"
                                           loc:Localize.Key="panel.giveaway.entrants.count.users.unit" />
                                <TextBlock Text="·" FontFamily="{StaticResource MonoFont}" FontSize="11" Margin="4,0"
                                           Foreground="{StaticResource CoalDividerBrush}" VerticalAlignment="Center" />
                                <TextBlock Text="{x:Bind ViewModel.TotalTicketsText, Mode=OneWay}"
                                           FontFamily="{StaticResource MonoFont}" FontSize="11"
                                           Foreground="{StaticResource Ember200Brush}" VerticalAlignment="Center" />
                                <TextBlock Text="tickets" FontFamily="{StaticResource MonoFont}" FontSize="11"
                                           Foreground="{StaticResource CoalSecondaryTextBrush}" VerticalAlignment="Center"
                                           loc:Localize.Key="panel.giveaway.entrants.count.tickets.unit" />
                            </StackPanel>
                        </hdr:PanelHeader.RightContent>
                    </hdr:PanelHeader>

                    <!-- Column header row -->
                    <Border Grid.Row="1" Style="{StaticResource ToolBandBorderStyle}">
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="26" />
                                <ColumnDefinition Width="22" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="#"
                                       Style="{StaticResource ToolColumnLabelTextStyle}"
                                       loc:Localize.Key="panel.giveaway.entrants.column.rank" />
                            <TextBlock Grid.Column="2" Text="USER"
                                       Style="{StaticResource ToolColumnLabelTextStyle}"
                                       loc:Localize.Key="panel.giveaway.entrants.column.user" />
                            <TextBlock Grid.Column="3" Text="TICKETS ▾"
                                       Style="{StaticResource ToolColumnLabelTextStyle}"
                                       loc:Localize.Key="panel.giveaway.entrants.column.tickets" />
                        </Grid>
                    </Border>

                    <!-- Empty state for the live column: ONE mono line, pinned to
                         the top of the list area. Not centred in the tall void
                         and not a DisplayFont headline — an absence must not
                         outrank the entrants it is standing in for. -->
                    <TextBlock Grid.Row="2"
                               Text="no entrants yet"
                               Visibility="{x:Bind ViewModel.EntrantsEmptyVisibility, Mode=OneWay}"
                               Style="{StaticResource ToolMonoHintTextStyle}"
                               VerticalAlignment="Top"
                               Margin="14,10,14,0"
                               loc:Localize.Key="panel.giveaway.entrants.empty.body" />

                    <!-- Entrant rows -->
                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollMode="Disabled">
                        <ItemsRepeater ItemsSource="{x:Bind ViewModel.Entrants, Mode=OneWay}"
                                       hdr:RowDataContext.Supply="True"
                                       AutomationProperties.LiveSetting="Polite"
                                       AutomationProperties.Name="Entrants sorted by tickets"
                                       loc:Localize.AutomationKey="panel.giveaway.entrants.list.a11y">
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate x:DataType="local:GiveawayEntrantRowVm">
                                    <Grid Padding="0" Background="{x:Bind RowBackground}"
                                          BorderBrush="{StaticResource CoalRaisedBrush}"
                                          BorderThickness="0,0,0,1">
                                        <!-- Weight bar overlay (proportional ember fade) -->
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="{x:Bind BarColumnLength}" />
                                                <ColumnDefinition Width="{x:Bind RestColumnLength}" />
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Background="{x:Bind BarBrush}" />
                                        </Grid>
                                        <!-- Row content -->
                                        <Grid Padding="14,7" ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="26" />
                                                <ColumnDefinition Width="22" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{x:Bind RankText}"
                                                       FontFamily="{StaticResource MonoFont}" FontSize="11"
                                                       FontWeight="SemiBold"
                                                       VerticalAlignment="Center"
                                                       Foreground="{x:Bind RankBrush}" />
                                            <!-- Role badge (BR/M/V/S) -->
                                            <Border Grid.Column="1"
                                                    Visibility="{x:Bind RoleBadgeVisibility}"
                                                    Width="18" Height="14"
                                                    CornerRadius="{StaticResource Radius1Corner}"
                                                    Background="{x:Bind RoleBrush}"
                                                    VerticalAlignment="Center"
                                                    HorizontalAlignment="Left">
                                                <TextBlock Text="{x:Bind RoleLabel}"
                                                           FontFamily="{StaticResource MonoFont}" FontSize="9"
                                                           FontWeight="Bold"
                                                           Foreground="{StaticResource CoalShellBrush}"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center" />
                                            </Border>
                                            <TextBlock Grid.Column="2" Text="{x:Bind Username}"
                                                       FontFamily="{StaticResource SansFont}" FontSize="12"
                                                       FontWeight="Medium"
                                                       TextTrimming="CharacterEllipsis"
                                                       VerticalAlignment="Center"
                                                       Foreground="{StaticResource CoalPrimaryTextBrush}" />
                                            <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="4"
                                                        VerticalAlignment="Center">
                                                <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE8EC;" FontSize="10"
                                                          Opacity="0.55"
                                                          Foreground="{x:Bind TicketsBrush}" />
                                                <TextBlock Text="{x:Bind TicketsText}"
                                                           FontFamily="{StaticResource MonoFont}" FontSize="12"
                                                           FontWeight="SemiBold"
                                                           Foreground="{x:Bind TicketsBrush}" />
                                            </StackPanel>
                                        </Grid>
                                    </Grid>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                    </ScrollViewer>

                    <!-- Footer -->
                    <!-- Footer. Same band recipe, hairline on the TOP edge. The
                         left caption dropped its trailing "· live": the right
                         cell already says it, in ember, 260 px away. -->
                    <Border Grid.Row="3"
                            Style="{StaticResource ToolBandBorderStyle}"
                            BorderThickness="0,1,0,0">
                        <Grid>
                            <TextBlock Text="sorted by tickets"
                                       Style="{StaticResource ToolMonoHintTextStyle}"
                                       HorizontalAlignment="Left"
                                       loc:Localize.Key="panel.giveaway.entrants.footer.sort" />
                            <TextBlock Text="live"
                                       FontFamily="{StaticResource MonoFont}" FontSize="10"
                                       Foreground="{StaticResource Ember200Brush}"
                                       HorizontalAlignment="Right"
                                       loc:Localize.Key="panel.giveaway.entrants.footer.live" />
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- ════════════════════ DRAW-WINNER OVERLAY ════════════════════ -->
        <Grid Grid.Row="0" Grid.RowSpan="3"
              x:Name="WinnerOverlay"
              Background="{StaticResource ToolScrimBrush}"
              Visibility="{x:Bind ViewModel.WinnerOverlayVisibility, Mode=OneWay}">
            <Border x:Name="WinnerCard"
                    Width="520"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="{StaticResource CoalSurfaceBrush}"
                    BorderBrush="{StaticResource EmberShadowBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource Radius2Corner}"
                    Padding="36,32,36,28">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="2" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <!-- Brass top edge. Re-pointed off the chrome-strip token
                         onto ToolBrassHeroBrush so the whole page paints brass
                         from exactly ONE definition. -->
                    <Border Grid.Row="0" Background="{StaticResource ToolBrassHeroBrush}"
                            Margin="-36,-32,-36,0" />
                    <StackPanel Grid.Row="1" Spacing="0" HorizontalAlignment="Center" Margin="0,18,0,0">
                        <TextBlock Text="WINNER DRAWN · WEIGHTED"
                                   Style="{StaticResource ToolEyebrowTextStyle}"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,8"
                                   loc:Localize.Key="panel.giveaway.winner.eyebrow" />
                        <TextBlock Text="{x:Bind ViewModel.WinnerGiveawayTitle, Mode=OneWay}"
                                   FontFamily="{StaticResource DisplayFont}"
                                   FontSize="18" CharacterSpacing="40"
                                   Foreground="{StaticResource CoalBodyTextBrush}"
                                   HorizontalAlignment="Center" TextAlignment="Center"
                                   Margin="0,0,0,18" />
                        <TextBlock x:Name="WinnerNameText"
                                   Text="{x:Bind ViewModel.WinnerName, Mode=OneWay}"
                                   FontFamily="{StaticResource DisplayFont}"
                                   FontSize="56" FontWeight="SemiBold" CharacterSpacing="20"
                                   Foreground="{StaticResource CoalPaperBrush}"
                                   HorizontalAlignment="Center" TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,6" />
                        <TextBlock Text="{x:Bind ViewModel.WinnerOddsText, Mode=OneWay}"
                                   FontFamily="{StaticResource MonoFont}"
                                   FontSize="11" CharacterSpacing="160"
                                   Foreground="{StaticResource Ember200Brush}"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,22" />
                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                            <Button x:Name="ReDrawButton"
                                    Style="{StaticResource ToolSecondaryButtonStyle}"
                                    Click="OnReDrawClick">
                                <TextBlock Text="RE-DRAW"
                                           Style="{StaticResource ToolStripLabelTextStyle}"
                                           loc:Localize.Key="panel.giveaway.winner.redraw.label" />
                            </Button>
                            <Button x:Name="CopyNameButton"
                                    Style="{StaticResource ToolSecondaryButtonStyle}"
                                    Click="OnCopyNameClick">
                                <TextBlock Text="COPY NAME"
                                           Style="{StaticResource ToolStripLabelTextStyle}"
                                           loc:Localize.Key="panel.giveaway.winner.copy.label" />
                            </Button>
                            <!-- The modal's own brass CTA. Legal because the page's
                                 DRAW WINNER is faded out for exactly as long as
                                 this overlay is up. -->
                            <Button x:Name="AnnounceButton"
                                    Style="{StaticResource ToolBrassCtaStyle}"
                                    Click="OnAnnounceClick">
                                <TextBlock Text="ANNOUNCE IN CHAT"
                                           Style="{StaticResource ToolBrassCtaLabelTextStyle}"
                                           loc:Localize.Key="panel.giveaway.winner.announce.label" />
                            </Button>
                        </StackPanel>
                        <TextBlock Text="shown on stream overlay"
                                   Style="{StaticResource ToolMonoHintTextStyle}"
                                   CharacterSpacing="40"
                                   HorizontalAlignment="Center"
                                   Margin="0,14,0,0"
                                   loc:Localize.Key="panel.giveaway.winner.overlay_hint" />
                        <!-- Dismiss affordance -->
                        <Button x:Name="WinnerCloseButton" Click="OnWinnerCloseClick"
                                HorizontalAlignment="Center" Margin="0,10,0,0"
                                Background="Transparent" BorderThickness="0" Padding="6,2">
                            <TextBlock Text="dismiss"
                                       Style="{StaticResource ToolMonoHintTextStyle}"
                                       loc:Localize.Key="panel.giveaway.winner.dismiss.label" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- ════════════════════ CREATE GIVEAWAY OVERLAY ════════════════════ -->
        <Grid Grid.Row="0" Grid.RowSpan="3"
              x:Name="CreateOverlay"
              Background="{StaticResource ToolScrimBrush}"
              Visibility="Collapsed">
            <Border Width="420"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="{StaticResource CoalSurfaceBrush}"
                    BorderBrush="{StaticResource EmberShadowBrush}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource Radius2Corner}"
                    Padding="28,24">
                <StackPanel Spacing="14">
                    <TextBlock Text="NEW GIVEAWAY"
                               Style="{StaticResource ToolEyebrowTextStyle}"
                               loc:Localize.Key="panel.giveaway.create.eyebrow" />
                    <TextBlock Text="Name the giveaway"
                               FontFamily="{StaticResource DisplayFont}"
                               FontSize="22"
                               Foreground="{StaticResource CoalPaperBrush}"
                               loc:Localize.Key="panel.giveaway.create.title" />
                    <TextBox x:Name="CreateTitleBox"
                             PlaceholderText="e.g. Forged Coffee Mug · Nov stream"
                             loc:Localize.PlaceholderKey="panel.giveaway.create.name.placeholder"
                             Background="{StaticResource CoalShellBrush}"
                             Foreground="{StaticResource CoalPrimaryTextBrush}"
                             BorderBrush="{StaticResource CoalDividerBrush}"
                             BorderThickness="1"
                             FontFamily="{StaticResource SansFont}"
                             FontSize="13"
                             KeyDown="OnCreateTitleKeyDown"
                             Text="{x:Bind ViewModel.CreateTitleDraft, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                        <Button x:Name="CreateCancelButton"
                                Style="{StaticResource ToolSecondaryButtonStyle}"
                                Click="OnCreateCancelClick">
                            <TextBlock Text="CANCEL"
                                       Style="{StaticResource ToolStripLabelTextStyle}"
                                       loc:Localize.Key="panel.giveaway.create.cancel.label" />
                        </Button>
                        <!-- Same rule as ANNOUNCE: this modal owns the brass while
                             it is up, and DRAW WINNER behind it is faded out. -->
                        <Button x:Name="CreateConfirmButton"
                                Style="{StaticResource ToolBrassCtaStyle}"
                                Click="OnCreateConfirmClick">
                            <TextBlock Text="CREATE"
                                       Style="{StaticResource ToolBrassCtaLabelTextStyle}"
                                       loc:Localize.Key="panel.giveaway.create.confirm.label" />
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
