<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Phoenix.Controls.Hub.WinUI.Panels.GiveawayPanel.GvStatTile"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    HorizontalAlignment="Stretch">

    <!-- One stat tile (giveaway.jsx StateStat) — eyebrow label + large
         display-font value. The Tickets tile passes Accent=True so its value
         renders in ember (Ember200) per the design's accented tile. -->
    <Border Background="{StaticResource CoalShellBrush}"
            BorderBrush="{StaticResource CoalCardBrush}"
            BorderThickness="1"
            CornerRadius="{StaticResource Radius1Corner}"
            Padding="12,10">
        <StackPanel Spacing="6">
            <TextBlock x:Name="EyebrowText"
                       FontFamily="{StaticResource SansFont}"
                       FontSize="10" FontWeight="SemiBold" CharacterSpacing="180"
                       Foreground="{StaticResource EmberPrimaryBrush}"
                       Text="{x:Bind Eyebrow, Mode=OneWay}" />
            <TextBlock x:Name="ValueText"
                       FontFamily="{StaticResource DisplayFont}"
                       FontSize="26" CharacterSpacing="20"
                       Text="{x:Bind Value, Mode=OneWay}" />
        </StackPanel>
    </Border>
</UserControl>
