<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Phoenix.Controls.Hub.WinUI.Panels.GiveawayPanel.GvSettingRow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    HorizontalAlignment="Stretch">

    <!-- One settings row (giveaway.jsx CodePath) — fixed-width mono label +
         mono value, with a hairline bottom divider. The JSX uses a dashed
         border; WinUI Border has no dashed stroke, so a solid coal divider
         stands in (matches the panel's other seams). IsLast drops the
         divider on the final row. -->
    <Border x:Name="RowBorder"
            BorderBrush="{StaticResource CoalCardBrush}"
            BorderThickness="0,0,0,1"
            Padding="0,5">
        <Grid ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="130" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0"
                       FontFamily="{StaticResource MonoFont}"
                       FontSize="11" CharacterSpacing="40"
                       Foreground="{StaticResource CoalSecondaryTextBrush}"
                       VerticalAlignment="Center"
                       Text="{x:Bind Label, Mode=OneWay}" />
            <TextBlock Grid.Column="1"
                       FontFamily="{StaticResource MonoFont}"
                       FontSize="12"
                       Foreground="{StaticResource CoalPrimaryTextBrush}"
                       VerticalAlignment="Center"
                       TextWrapping="Wrap"
                       Text="{x:Bind Value, Mode=OneWay}" />
        </Grid>
    </Border>
</UserControl>
