<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Phoenix.Controls.Hub.WinUI.Panels.EventLogPanel.EventLogView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:hdr="using:Phoenix.Controls.Hub.WinUI.Panels.Common"
    xmlns:local="using:Phoenix.Controls.Hub.WinUI.Panels.EventLogPanel"
    HorizontalAlignment="Stretch"
    VerticalAlignment="Stretch"
    HorizontalContentAlignment="Stretch"
    VerticalContentAlignment="Stretch"
    AutomationProperties.Name="Event Log panel"
    AutomationProperties.HelpText="Live tail of the last 250 rows from the SQLite EventLog table (external triggers + audit events). Polls at 2 Hz; newest entries on top.">

    <UserControl.Resources>
        <!-- Dense per-row template — strip the default Fluent ListViewItem padding
             so the panel reads as a tight data feed rather than a touch-target list.
             Mirrors the SystemLog panel's row container style. -->
        <Style x:Key="EventLogItemContainerStyle" TargetType="ListViewItem">
            <Setter Property="Padding"                    Value="0" />
            <Setter Property="MinHeight"                  Value="0" />
            <Setter Property="Margin"                     Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment"   Value="Top" />
        </Style>
    </UserControl.Resources>

    <Border Background="{StaticResource CoalSurfaceBrush}"
            BorderBrush="{StaticResource CoalDividerBrush}"
            BorderThickness="1"
            CornerRadius="{StaticResource Radius3Corner}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <hdr:PanelHeader Grid.Row="0"
                             Eyebrow="05"
                             TitleKey="panel.eventlog.title"
                             Title="Event Log">
                <hdr:PanelHeader.RightContent>
                    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                        <TextBox x:Name="SearchBox"
                                 Width="160"
                                 Height="22"
                                 FontFamily="{StaticResource MonoFont}"
                                 FontSize="11"
                                 Background="{StaticResource CoalShellBrush}"
                                 Foreground="{StaticResource CoalPaperBrush}"
                                 BorderBrush="{StaticResource CoalDividerBrush}"
                                 BorderThickness="1"
                                 Padding="6,1"
                                 VerticalAlignment="Center"
                                 PlaceholderText="search…"
                                 TextChanged="OnSearchTextChanged" />
                        <Button x:Name="PopOutButton"
                                Background="Transparent"
                                BorderThickness="0"
                                Padding="6,2"
                                Foreground="{StaticResource CoalSecondaryTextBrush}"
                                Click="OnPopOutClick">
                            <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                <PathIcon Data="{StaticResource PhoenixIcon_PopOut}"
                                          Width="{StaticResource IconSizeS}"
                                          Height="{StaticResource IconSizeS}"
                                          Foreground="{StaticResource CoalSecondaryTextBrush}" />
                                <TextBlock Text="pop-out"
                                           FontFamily="{StaticResource SansFont}"
                                           FontSize="11"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </hdr:PanelHeader.RightContent>
            </hdr:PanelHeader>

            <ListView x:Name="EventList"
                      Grid.Row="1"
                      ItemsSource="{x:Bind ViewModel.VisibleRows, Mode=OneWay}"
                      ItemContainerStyle="{StaticResource EventLogItemContainerStyle}"
                      SelectionMode="Extended"
                      IsItemClickEnabled="False"
                      Background="Transparent"
                      BorderThickness="0"
                      Padding="0,2,0,2"
                      ScrollViewer.HorizontalScrollMode="Disabled"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                      ScrollViewer.VerticalScrollBarVisibility="Visible"
                      AutomationProperties.LiveSetting="Polite"
                      AutomationProperties.Name="Event log entries">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="local:EventLogRowVm">
                        <Border Padding="14,2,14,2"
                                BorderBrush="{StaticResource CoalRaisedBrush}"
                                BorderThickness="0,0,0,1">
                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="72" />
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="140" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0"
                                           Text="{x:Bind TimestampText}"
                                           FontFamily="{StaticResource MonoFont}"
                                           FontSize="10.5"
                                           Foreground="{StaticResource CoalSecondaryTextBrush}"
                                           VerticalAlignment="Top" />
                                <TextBlock Grid.Column="1"
                                           Text="{x:Bind Source}"
                                           FontFamily="{StaticResource MonoFont}"
                                           FontSize="10.5"
                                           Foreground="{StaticResource InfoBrush}"
                                           TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Top" />
                                <TextBlock Grid.Column="2"
                                           Text="{x:Bind EventType}"
                                           FontFamily="{StaticResource MonoFont}"
                                           FontSize="10.5"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource CoalPrimaryTextBrush}"
                                           TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Top" />
                                <TextBlock Grid.Column="3"
                                           Text="{x:Bind PayloadSummary}"
                                           FontFamily="{StaticResource MonoFont}"
                                           FontSize="10.5"
                                           Foreground="{StaticResource CoalSecondaryTextBrush}"
                                           TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Top" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>
    </Border>
</UserControl>
