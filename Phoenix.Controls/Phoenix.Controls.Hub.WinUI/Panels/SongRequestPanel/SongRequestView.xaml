<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Phoenix.Controls.Hub.WinUI.Panels.SongRequestPanel.SongRequestView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Phoenix.Controls.Hub.WinUI.Panels.SongRequestPanel"
    xmlns:cmn="using:Phoenix.Controls.Hub.WinUI.Panels.Common"
    xmlns:loc="using:Phoenix.Controls.Hub.WinUI.Localization"
    HorizontalAlignment="Stretch"
    VerticalAlignment="Stretch"
    HorizontalContentAlignment="Stretch"
    VerticalContentAlignment="Stretch"
    AutomationProperties.Name="Song Requests page"
    AutomationProperties.HelpText="A YouTube song-request queue: moderate it, and set the command words, role gates, caps and price."
    loc:Localize.AutomationKey="panel.songrequest.page.a11y"
    loc:Localize.HelpTextKey="panel.songrequest.page.help">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- KEPT: the settings section still declares ~20 TextBox instances and
                     ToolControlStyles carries the implicit coal/ember TextBox style. The
                     page's ToggleSwitch and its one CheckBox both became TogglePills, and
                     there is no ComboBox and no Pivot — but RoleCheckRow (hosted below)
                     is CheckBox-based and merges this same dictionary itself. -->
                <ResourceDictionary Source="ms-appx:///Panels/Common/ToolControlStyles.xaml" />
                <!-- Keyed-only style dictionary: the shell chrome recipes. Contains no
                     implicit styles, and is merged PER VIEW, never into App.xaml. -->
                <ResourceDictionary Source="ms-appx:///Panels/Common/ToolShellStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Nested row inside a section card. Same tokens as ToolSectionCardStyle,
                 kept separate because every use site sets its own padding. -->
            <Style x:Key="SrRecessed" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource CoalShellBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource CoalCardBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="{StaticResource Radius1Corner}" />
            </Style>

            <Style x:Key="SrRowLabel" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
                <Setter Property="FontSize" Value="11" />
                <Setter Property="CharacterSpacing" Value="40" />
                <Setter Property="Foreground" Value="{StaticResource CoalSecondaryTextBrush}" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>

            <!-- Row-scale action button. Deliberately NOT ToolSecondaryButtonStyle: that
                 style is the 30px strip height, which is too tall to stack three of
                 inside a list row at the 300 px column width. -->
            <Style x:Key="SrRowButton" TargetType="Button">
                <Setter Property="Height" Value="24" />
                <Setter Property="Padding" Value="10,0" />
                <Setter Property="Background" Value="{StaticResource CoalCardBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource CoalDividerBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="{StaticResource Radius1Corner}" />
            </Style>

            <Style x:Key="SrRowButtonLabel" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource SansFont}" />
                <Setter Property="FontSize" Value="10" />
                <Setter Property="FontWeight" Value="Bold" />
                <Setter Property="CharacterSpacing" Value="80" />
                <Setter Property="Foreground" Value="{StaticResource CoalBodyTextBrush}" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <!-- One waiting request, folded to two lines for the 300 px live column:
                 position + title, then the meta line, then the row actions. Approve /
                 Deny only materialise for a request still awaiting a verdict; every
                 action addresses the entry by its stable Id, never by position. -->
            <DataTemplate x:Key="SongQueueRowTemplate" x:DataType="local:SongRequestRowVm">
                <Grid Padding="14,7"
                      ColumnSpacing="8"
                      BorderBrush="{StaticResource CoalRaisedBrush}"
                      BorderThickness="0,0,0,1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="30" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="{x:Bind PositionText}"
                               FontFamily="{StaticResource MonoFont}"
                               FontSize="13" FontWeight="SemiBold"
                               Foreground="{StaticResource EmberPrimaryBrush}"
                               VerticalAlignment="Top" />

                    <StackPanel Grid.Column="1" Spacing="4">
                        <TextBlock Text="{x:Bind Title}"
                                   FontFamily="{StaticResource SansFont}"
                                   FontSize="12"
                                   Foreground="{StaticResource CoalPrimaryTextBrush}"
                                   TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="{x:Bind RequesterHint}"
                                       FontFamily="{StaticResource MonoFont}" FontSize="10"
                                       Foreground="{StaticResource CoalSecondaryTextBrush}" />
                            <TextBlock Text="{x:Bind DurationText}"
                                       FontFamily="{StaticResource MonoFont}" FontSize="10"
                                       Foreground="{StaticResource CoalSecondaryTextBrush}" />
                            <TextBlock Text="{x:Bind StatusText}"
                                       FontFamily="{StaticResource MonoFont}" FontSize="9"
                                       CharacterSpacing="80"
                                       Foreground="{StaticResource CoalMutedTextBrush}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,2,0,0">
                            <Button Style="{StaticResource SrRowButton}"
                                    Visibility="{x:Bind PendingVisibility}"
                                    Click="OnApproveClick"
                                    AutomationProperties.Name="Approve request"
                                    loc:Localize.AutomationKey="panel.songrequest.queue.approve.a11y">
                                <TextBlock Text="APPROVE"
                                           Style="{StaticResource SrRowButtonLabel}"
                                           Foreground="{StaticResource Ember200Brush}"
                                           loc:Localize.Key="panel.songrequest.queue.approve.label" />
                            </Button>
                            <Button Style="{StaticResource SrRowButton}"
                                    Visibility="{x:Bind PendingVisibility}"
                                    Click="OnDenyClick"
                                    AutomationProperties.Name="Deny request"
                                    loc:Localize.AutomationKey="panel.songrequest.queue.deny.a11y">
                                <TextBlock Text="DENY" Style="{StaticResource SrRowButtonLabel}"
                                           loc:Localize.Key="panel.songrequest.queue.deny.label" />
                            </Button>
                            <Button Style="{StaticResource SrRowButton}"
                                    Click="OnRemoveClick"
                                    AutomationProperties.Name="Remove request"
                                    loc:Localize.AutomationKey="panel.songrequest.queue.remove.a11y">
                                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE74D;" FontSize="10"
                                              Foreground="{StaticResource ErrBrush}" />
                                    <TextBlock Text="REMOVE" Style="{StaticResource SrRowButtonLabel}"
                                               loc:Localize.Key="panel.songrequest.queue.remove.label" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Background="{StaticResource CoalSurfaceBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />   <!-- 48px header band -->
            <RowDefinition Height="*" />      <!-- two-column body -->
        </Grid.RowDefinitions>

        <!-- ══════════════════ ROW 0 — HEADER BAND ══════════════════
             ONE 48 px row replaces THREE: the action strip (master chip + pill + CTA +
             refresh + clear), the state-sentence banner that was pinned over the detail
             column, and the ToolStatusPill. Between them they rendered the same boolean
             three times in three vocabularies — DISABLED / dormant / "the tool is
             dormant; no requests are accepted" — above a strip of stat tiles reading
             0 · IDLE · 50% on a fresh install.

             ★ The pill CONTROL is not deleted from the codebase, and neither is the
             state machine behind it. SongRequestService.ComputePillState still owns the
             predicate — including QueueingNothingRenders, which exists precisely so this
             page can never claim "playing" while not a single browser surface is
             attached — and PreBuildStatusPillTests still guards it. What moved is only
             the RENDER SITE: the code-behind reads that SAME enum and projects it onto
             the band's one lowercase phrase. No service-side state logic changed.

             Verbs. PLAY is the band's single brass CTA: it is the one verb that acts on
             the tool as a whole ("resume the held track, or start the queue") rather
             than on the track the PLAYER section names, and it stays out of that card so
             it is reachable while SETTINGS is showing. REFRESH is the band's icon verb —
             still the only manual way to re-evaluate the API-key and Loyalty hints.
             CLEAR is a QUEUE verb, so it moved to the queue column's own header, beside
             the count it empties. -->
        <cmn:ToolPageHeader Grid.Row="0" x:Name="PageHeader" />

        <!-- ══════════════════ ROW 1 — TWO-COLUMN BODY ══════════════════ -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />     <!-- LEFT: detail     -->
                <!-- Fixed, not proportional: the queue is a fixed-width live column, so
                     the settings column takes every pixel the page gains instead of the
                     rail widening a list of two-line rows. -->
                <ColumnDefinition Width="300" />   <!-- RIGHT: the queue -->
            </Grid.ColumnDefinitions>
            <!-- No ColumnSpacing. The right column's left border IS the divider. -->

            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />   <!-- section nav     -->
                    <RowDefinition Height="*" />      <!-- detail scroller -->
                </Grid.RowDefinitions>

                <!-- Section nav. The settings body is ~35 controls plus four role rows,
                     which does not read as one list at this column width, so the host
                     owns each body and its Visibility and the selector emits an index.
                     Vertical padding is 0 deliberately: the selector is a 40 px text nav
                     that already carries its own row height, and the 10 px it used to sit
                     inside was what made the nav read as a third stacked control tier. -->
                <Border Grid.Row="0"
                        Background="{StaticResource CoalSurfaceBrush}"
                        BorderBrush="{StaticResource CoalDividerBrush}"
                        BorderThickness="0,0,0,1"
                        Padding="14,0">
                    <cmn:ToolSectionSelector Sections="{x:Bind ViewModel.SectionNames}"
                                             SelectedIndex="{x:Bind ViewModel.SelectedSection, Mode=TwoWay}"
                                             AutomationProperties.Name="Song request sections"
                                             loc:Localize.AutomationKey="panel.songrequest.sections.a11y" />
                </Border>

                <!-- ONE detail scroller for BOTH sections. Each section is a StackPanel
                     whose Visibility this host owns — the same shape the Automod and
                     Loyalty pages use; ToolSectionSelector owns no content of its own.

                     The hero stat strip that used to be this scroller's first child (IN
                     QUEUE / PLAYER STATE / VOLUME) is gone: a config surface is where you
                     go to CHANGE a setting, and three tiles reading 0 · IDLE · 50% cost
                     ~87 px above every field on the page to say nothing a streamer opened
                     this page to learn. The one count worth a glance — how many requests
                     are waiting — lives in the queue column's own header, next to the
                     rows it counts. -->
                <ScrollViewer Grid.Row="1"
                              x:Name="DetailScroll"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollMode="Disabled">
                    <StackPanel Spacing="12" Padding="14">

                        <!-- ══════ SECTION 0 — PLAYER ══════ -->
                        <StackPanel Spacing="12"
                                    Visibility="{x:Bind ViewModel.PlayerSectionVisibility, Mode=OneWay}">

                            <TextBlock Style="{StaticResource ToolHintTextStyle}"
                                       Text="Viewers request with !sr (rename it below) — a link, a video id or search words. Searching by name needs a YouTube Data API key (Settings → Connection); links and ids do not."
                                       loc:Localize.Key="panel.songrequest.player.intro" />

                            <!-- Standing honesty banner: the audio player is a browser
                                 widget, not a Hub affordance, and the page must not imply
                                 otherwise. -->
                            <Border Style="{StaticResource SrRecessed}" Padding="12,10">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="WHERE THE MUSIC PLAYS" Style="{StaticResource ToolSubLabelTextStyle}"
                                               loc:Localize.Key="panel.songrequest.player.where.title" />
                                    <TextBlock Text="{x:Bind ViewModel.PlayerAvailabilityText}"
                                               Style="{StaticResource ToolHintTextStyle}" />
                                </StackPanel>
                            </Border>

                            <!-- Selection + transport. No seek bar, no elapsed clock, no
                                 progress ring: Hub knows which track is selected and
                                 whether it is meant to be playing, and shows only that. -->
                            <Border Style="{StaticResource ToolSectionCardStyle}">
                                <StackPanel Spacing="10">
                                    <TextBlock Text="SELECTED TRACK" Style="{StaticResource ToolEyebrowTextStyle}"
                                               loc:Localize.Key="panel.songrequest.player.selected.eyebrow" />
                                    <Border Height="1" Background="{StaticResource CoalCardBrush}" />

                                    <StackPanel Spacing="3">
                                        <TextBlock Text="{x:Bind ViewModel.CurrentTitle, Mode=OneWay}"
                                                   FontFamily="{StaticResource SansFont}" FontSize="14"
                                                   Foreground="{StaticResource CoalPrimaryTextBrush}"
                                                   TextWrapping="Wrap" />
                                        <StackPanel Orientation="Horizontal" Spacing="10">
                                            <TextBlock Text="{x:Bind ViewModel.CurrentRequesterHint, Mode=OneWay}"
                                                       Style="{StaticResource ToolMonoHintTextStyle}" VerticalAlignment="Center" />
                                            <TextBlock Text="{x:Bind ViewModel.CurrentVideoHint, Mode=OneWay}"
                                                       Style="{StaticResource ToolMonoHintTextStyle}" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- PAUSE and SKIP act on the track this card names, so
                                         they stay beside it. PLAY moved to the strip's
                                         primary slot — it is the page's one brass CTA and no
                                         surface may carry two. -->
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Button Style="{StaticResource ToolSecondaryButtonStyle}"
                                                Click="OnPauseClick"
                                                AutomationProperties.Name="Pause"
                                                loc:Localize.AutomationKey="panel.songrequest.player.pause.a11y">
                                            <TextBlock Text="PAUSE" Style="{StaticResource ToolStripLabelTextStyle}"
                                                       loc:Localize.Key="panel.songrequest.player.pause.label" />
                                        </Button>
                                        <Button Style="{StaticResource ToolSecondaryButtonStyle}"
                                                Click="OnSkipClick"
                                                ToolTipService.ToolTip="Skip the playing track — does nothing while the player is idle"
                                                AutomationProperties.Name="Skip to the next request"
                                                loc:Localize.TooltipKey="panel.songrequest.player.skip.tip"
                                                loc:Localize.AutomationKey="panel.songrequest.player.skip.a11y">
                                            <TextBlock Text="SKIP" Style="{StaticResource ToolStripLabelTextStyle}"
                                                       loc:Localize.Key="panel.songrequest.player.skip.label" />
                                        </Button>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- ══════ SECTION 1 — SETTINGS ══════ -->
                        <StackPanel Spacing="12"
                                    Visibility="{x:Bind ViewModel.SettingsSectionVisibility, Mode=OneWay}">

                            <!-- Viewer command words -->
                            <Border Style="{StaticResource ToolSectionCardStyle}">
                                <StackPanel Spacing="8">
                                    <TextBlock Text="VIEWER COMMANDS" Style="{StaticResource ToolEyebrowTextStyle}"
                                               loc:Localize.Key="panel.songrequest.commands.viewer.eyebrow" />
                                    <Grid ColumnSpacing="12" RowSpacing="6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Request" Style="{StaticResource SrRowLabel}"
                                                   loc:Localize.Key="panel.songrequest.commands.viewer.request.label" />
                                        <TextBox Grid.Row="0" Grid.Column="1" Text="{x:Bind ViewModel.RequestCommand, Mode=TwoWay}"
                                                 FontFamily="{StaticResource MonoFont}" FontSize="11" PlaceholderText="sr"
                                                 AutomationProperties.Name="Request command word"
                                                 loc:Localize.AutomationKey="panel.songrequest.commands.viewer.request.a11y" />
                                        <TextBlock Grid.Row="0" Grid.Column="2" Text="Now playing" Style="{StaticResource SrRowLabel}"
                                                   loc:Localize.Key="panel.songrequest.commands.viewer.current.label" />
                                        <TextBox Grid.Row="0" Grid.Column="3" Text="{x:Bind ViewModel.CurrentCommand, Mode=TwoWay}"
                                                 FontFamily="{StaticResource MonoFont}" FontSize="11" PlaceholderText="song"
                                                 AutomationProperties.Name="Now playing command word"
                                                 loc:Localize.AutomationKey="panel.songrequest.commands.viewer.current.a11y" />

                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Up next" Style="{StaticResource SrRowLabel}"
                                                   loc:Localize.Key="panel.songrequest.commands.viewer.next.label" />
                                        <TextBox Grid.Row="1" Grid.Column="1" Text="{x:Bind ViewModel.NextCommand, Mode=TwoWay}"
                                                 FontFamily="{StaticResource MonoFont}" FontSize="11" PlaceholderText="next"
                                                 AutomationProperties.Name="Up next command word"
                                                 loc:Localize.AutomationKey="panel.songrequest.commands.viewer.next.a11y" />
                                        <TextBlock Grid.Row="1" Grid.Column="2" Text="My place" Style="{StaticResource SrRowLabel}"
                                                   loc:Localize.Key="panel.songrequest.commands.viewer.when.label" />
                                        <TextBox Grid.Row="1" Grid.Column="3" Text="{x:Bind ViewModel.WhenCommand, Mode=TwoWay}"
                                                 FontFamily="{StaticResource MonoFont}" FontSize="11" PlaceholderText="when"
                                                 AutomationProperties.Name="My place command word"
                                                 loc:Localize.AutomationKey="panel.songrequest.commands.viewer.when.a11y" />

                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Wrong song" Style="{StaticResource SrRowLabel}"
                                                   loc:Localize.Key="panel.songrequest.commands.viewer.wrongsong.label" />
                                        <TextBox Grid.Row="2" Grid.Column="1" Text="{x:Bind ViewModel.WrongSongCommand, Mode=TwoWay}"
                                                 FontFamily="{StaticResource MonoFont}" FontSize="11" PlaceholderText="wrongsong"
                                                 AutomationProperties.Name="Wrong song command word"
                                                 loc:Localize.AutomationKey="panel.songrequest.commands.viewer.wrongsong.a11y" />
                                        <TextBlock Grid.Row="2" Grid.Column="2" Text="Vote skip" Style="{StaticResource SrRowLabel}"
                                                   loc:Localize.Key="panel.songrequest.commands.viewer.voteskip.label" />
                                        <TextBox Grid.Row="2" Grid.Column="3" Text="{x:Bind ViewModel.VoteSkipCommand, Mode=TwoWay}"
                                                 FontFamily="{StaticResource MonoFont}" FontSize="11" PlaceholderText="voteskip"
                                                 AutomationProperties.Name="Vote skip command word"
                                                 loc:Localize.AutomationKey="panel.songrequest.commands.viewer.voteskip.a11y" />

                                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Volume" Style="{StaticResource SrRowLabel}"
                                                   loc:Localize.Key="panel.songrequest.commands.viewer.volume.label" />
                                        <TextBox Grid.Row="3" Grid.Column="1" Text="{x:Bind ViewModel.VolumeCommand, Mode=TwoWay}"
                                                 FontFamily="{StaticResource MonoFont}" FontSize="11" PlaceholderText="volume"
                                                 AutomationProperties.Name="Volume command word"
                                                 loc:Localize.AutomationKey="panel.songrequest.commands.viewer.volume.a11y" />

                                        <TextBlock Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="4"
                                                   Style="{StaticResource ToolMonoHintTextStyle}" VerticalAlignment="Center"
                                                   Text="!volume reads the level · !volume &lt;0-100&gt; sets it (playback roles only)"
                                                   loc:Localize.Key="panel.songrequest.commands.viewer.volume.hint" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Moderator command words -->
                            <Border Style="{StaticResource ToolSectionCardStyle}">
                                <StackPanel Spacing="8">
                                    <TextBlock Text="MODERATOR COMMANDS" Style="{StaticResource ToolEyebrowTextStyle}"
                                               loc:Localize.Key="panel.songrequest.commands.mod.eyebrow" />
                                    <Grid ColumnSpacing="12" RowSpacing="6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Skip" Style="{StaticResource SrRowLabel}"
                                                   loc:Localize.Key="panel.songrequest.commands.mod.skip.label" />
                                        <TextBox Grid.Row="0" Grid.Column="1" Text="{x:Bind ViewModel.SkipCommand, Mode=TwoWay}"
                                                 FontFamily="{StaticResource MonoFont}" FontSize="11" PlaceholderText="skip"
                                                 AutomationProperties.Name="Skip command word"
                                                 loc:Localize.AutomationKey="panel.songrequest.commands.mod.skip.a11y" />
                                        <TextBlock Grid.Row="0" Grid.Column="2" Text="Pause" Style="{StaticResource SrRowLabel}"
                                                   loc:Localize.Key="panel.songrequest.commands.mod.pause.label" />
                                        <TextBox Grid.Row="0" Grid.Column="3" Text="{x:Bind ViewModel.PauseCommand, Mode=TwoWay}"
                                                 FontFamily="{StaticResource MonoFont}" FontSize="11" PlaceholderText="pause"
                                                 AutomationProperties.Name="Pause command word"
                                                 loc:Localize.AutomationKey="panel.songrequest.commands.mod.pause.a11y" />

                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Play" Style="{StaticResource SrRowLabel}"
                                                   loc:Localize.Key="panel.songrequest.commands.mod.play.label" />
                                        <TextBox Grid.Row="1" Grid.Column="1" Text="{x:Bind ViewModel.PlayCommand, Mode=TwoWay}"
                                                 FontFamily="{StaticResource MonoFont}" FontSize="11" PlaceholderText="play"
                                                 AutomationProperties.Name="Play command word"
                                                 loc:Localize.AutomationKey="panel.songrequest.commands.mod.play.a11y" />
                                        <TextBlock Grid.Row="1" Grid.Column="2" Text="Remove" Style="{StaticResource SrRowLabel}"
                                                   loc:Localize.Key="panel.songrequest.commands.mod.remove.label" />
                                        <TextBox Grid.Row="1" Grid.Column="3" Text="{x:Bind ViewModel.RemoveCommand, Mode=TwoWay}"
                                                 FontFamily="{StaticResource MonoFont}" FontSize="11" PlaceholderText="removesong"
                                                 AutomationProperties.Name="Remove command word"
                                                 loc:Localize.AutomationKey="panel.songrequest.commands.mod.remove.a11y" />

                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Clear" Style="{StaticResource SrRowLabel}"
                                                   loc:Localize.Key="panel.songrequest.commands.mod.clear.label" />
                                        <TextBox Grid.Row="2" Grid.Column="1" Text="{x:Bind ViewModel.ClearCommand, Mode=TwoWay}"
                                                 FontFamily="{StaticResource MonoFont}" FontSize="11" PlaceholderText="srclear"
                                                 AutomationProperties.Name="Clear command word"
                                                 loc:Localize.AutomationKey="panel.songrequest.commands.mod.clear.a11y" />

                                        <TextBlock Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="4"
                                                   Style="{StaticResource ToolMonoHintTextStyle}" VerticalAlignment="Center"
                                                   Text="These are generic words — rename any that clash with another bot in your channel."
                                                   loc:Localize.Key="panel.songrequest.commands.mod.hint" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Caps -->
                            <Border Style="{StaticResource ToolSectionCardStyle}">
                                <StackPanel Spacing="8">
                                    <TextBlock Text="LIMITS" Style="{StaticResource ToolEyebrowTextStyle}"
                                               loc:Localize.Key="panel.songrequest.limits.eyebrow" />
                                    <Grid ColumnSpacing="12" RowSpacing="6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="150" />
                                            <ColumnDefinition Width="90" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Queue size" Style="{StaticResource SrRowLabel}"
                                                   loc:Localize.Key="panel.songrequest.limits.queue_size.label" />
                                        <TextBox Grid.Row="0" Grid.Column="1" Text="{x:Bind ViewModel.MaxQueueLength, Mode=TwoWay}"
                                                 FontFamily="{StaticResource MonoFont}" FontSize="11"
                                                 AutomationProperties.Name="Maximum queue size"
                                                 loc:Localize.AutomationKey="panel.songrequest.limits.queue_size.a11y" />
                                        <TextBlock Grid.Row="0" Grid.Column="2" Style="{StaticResource ToolMonoHintTextStyle}" VerticalAlignment="Center" Text="0 = no limit."
                                                   loc:Localize.Key="panel.songrequest.limits.queue_size.hint" />

                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Per viewer" Style="{StaticResource SrRowLabel}"
                                                   loc:Localize.Key="panel.songrequest.limits.per_viewer.label" />
                                        <TextBox Grid.Row="1" Grid.Column="1" Text="{x:Bind ViewModel.MaxPerUser, Mode=TwoWay}"
                                                 FontFamily="{StaticResource MonoFont}" FontSize="11"
                                                 AutomationProperties.Name="Maximum requests per viewer"
                                                 loc:Localize.AutomationKey="panel.songrequest.limits.per_viewer.a11y" />
                                        <TextBlock Grid.Row="1" Grid.Column="2" Style="{StaticResource ToolMonoHintTextStyle}" VerticalAlignment="Center" Text="waiting requests per viewer · 0 = no limit"
                                                   loc:Localize.Key="panel.songrequest.limits.per_viewer.hint" />

                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Max length (s)" Style="{StaticResource SrRowLabel}"
                                                   loc:Localize.Key="panel.songrequest.limits.max_length.label" />
                                        <TextBox Grid.Row="2" Grid.Column="1" Text="{x:Bind ViewModel.MaxDurationSeconds, Mode=TwoWay}"
                                                 FontFamily="{StaticResource MonoFont}" FontSize="11"
                                                 AutomationProperties.Name="Maximum song length in seconds"
                                                 loc:Localize.AutomationKey="panel.songrequest.limits.max_length.a11y" />
                                        <TextBlock Grid.Row="2" Grid.Column="2" Style="{StaticResource ToolMonoHintTextStyle}" VerticalAlignment="Center"
                                                   Text="{x:Bind ViewModel.DurationCapHint, Mode=OneWay}" />

                                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Cooldown (s)" Style="{StaticResource SrRowLabel}"
                                                   loc:Localize.Key="panel.songrequest.limits.cooldown.label" />
                                        <TextBox Grid.Row="3" Grid.Column="1" Text="{x:Bind ViewModel.RequestCooldownSeconds, Mode=TwoWay}"
                                                 FontFamily="{StaticResource MonoFont}" FontSize="11"
                                                 AutomationProperties.Name="Per viewer request cooldown in seconds"
                                                 loc:Localize.AutomationKey="panel.songrequest.limits.cooldown.a11y" />
                                        <TextBlock Grid.Row="3" Grid.Column="2" Style="{StaticResource ToolMonoHintTextStyle}" VerticalAlignment="Center" Text="Per viewer, between requests. 0 = none."
                                                   loc:Localize.Key="panel.songrequest.limits.cooldown.hint" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Price + moderation + volume -->
                            <Border Style="{StaticResource ToolSectionCardStyle}">
                                <StackPanel Spacing="8">
                                    <TextBlock Text="PRICE · MODERATION · PLAYER" Style="{StaticResource ToolEyebrowTextStyle}"
                                               loc:Localize.Key="panel.songrequest.price.eyebrow" />
                                    <Grid ColumnSpacing="12" RowSpacing="6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="150" />
                                            <ColumnDefinition Width="90" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Points cost" Style="{StaticResource SrRowLabel}"
                                                   loc:Localize.Key="panel.songrequest.price.cost.label" />
                                        <TextBox Grid.Row="0" Grid.Column="1" Text="{x:Bind ViewModel.PointCost, Mode=TwoWay}"
                                                 FontFamily="{StaticResource MonoFont}" FontSize="11"
                                                 AutomationProperties.Name="Points cost per request"
                                                 loc:Localize.AutomationKey="panel.songrequest.price.cost.a11y" />
                                        <TextBlock Grid.Row="0" Grid.Column="2" Style="{StaticResource ToolMonoHintTextStyle}" VerticalAlignment="Center"
                                                   Text="{x:Bind ViewModel.PriceHint, Mode=OneWay}" />

                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Sub discount (%)" Style="{StaticResource SrRowLabel}"
                                                   loc:Localize.Key="panel.songrequest.price.sub_discount.label" />
                                        <TextBox Grid.Row="1" Grid.Column="1" Text="{x:Bind ViewModel.SubDiscountPercent, Mode=TwoWay}"
                                                 FontFamily="{StaticResource MonoFont}" FontSize="11"
                                                 AutomationProperties.Name="Subscriber discount percent"
                                                 loc:Localize.AutomationKey="panel.songrequest.price.sub_discount.a11y" />
                                        <TextBlock Grid.Row="1" Grid.Column="2" Style="{StaticResource ToolMonoHintTextStyle}" VerticalAlignment="Center" Text="off the cost for subscribers · rounded up"
                                                   loc:Localize.Key="panel.songrequest.price.sub_discount.hint" />

                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Vote-skip votes" Style="{StaticResource SrRowLabel}"
                                                   loc:Localize.Key="panel.songrequest.price.voteskip_votes.label" />
                                        <TextBox Grid.Row="2" Grid.Column="1" Text="{x:Bind ViewModel.VoteSkipThreshold, Mode=TwoWay}"
                                                 FontFamily="{StaticResource MonoFont}" FontSize="11"
                                                 AutomationProperties.Name="Vote skip threshold"
                                                 loc:Localize.AutomationKey="panel.songrequest.price.voteskip_votes.a11y" />
                                        <TextBlock Grid.Row="2" Grid.Column="2" Style="{StaticResource ToolMonoHintTextStyle}" VerticalAlignment="Center" Text="distinct viewers needed · 0 = off · votes reset each song"
                                                   loc:Localize.Key="panel.songrequest.price.voteskip_votes.hint" />

                                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Player volume" Style="{StaticResource SrRowLabel}"
                                                   loc:Localize.Key="panel.songrequest.price.volume.label" />
                                        <TextBox Grid.Row="3" Grid.Column="1" Text="{x:Bind ViewModel.PlayerVolume, Mode=TwoWay}"
                                                 FontFamily="{StaticResource MonoFont}" FontSize="11"
                                                 AutomationProperties.Name="Player volume"
                                                 loc:Localize.AutomationKey="panel.songrequest.price.volume.a11y" />
                                        <TextBlock Grid.Row="3" Grid.Column="2" Style="{StaticResource ToolMonoHintTextStyle}" VerticalAlignment="Center" Text="0-100 · published to the overlay player · !volume writes the same number"
                                                   loc:Localize.Key="panel.songrequest.price.volume.hint" />

                                        <!-- Was a CheckBox; the house boolean is a display-only
                                             TogglePill inside a borderless labelled Button. -->
                                        <Button Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="3"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Padding="0,4"
                                                HorizontalAlignment="Left"
                                                Click="OnToggleRequireApprovalClick"
                                                AutomationProperties.Name="Require approval"
                                                loc:Localize.AutomationKey="panel.songrequest.price.require_approval.a11y">
                                            <cmn:TogglePill IsOn="{x:Bind ViewModel.RequireApproval, Mode=OneWay}"
                                                            Label="Hold new requests for a moderator's approval"
                                                            loc:Localize.Key="panel.songrequest.price.require_approval.label" />
                                        </Button>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Roles. One per row, each inside a star-width column:
                                 RoleCheckRow lays out in WrapRowPanel, which needs a
                                 finite-width measure host and degenerates to a single
                                 clipped row in an Auto column or a horizontal stack. -->
                            <Border Style="{StaticResource ToolSectionCardStyle}">
                                <StackPanel Spacing="10">
                                    <TextBlock Text="PERMISSIONS" Style="{StaticResource ToolEyebrowTextStyle}"
                                               loc:Localize.Key="panel.songrequest.permissions.eyebrow" />

                                    <StackPanel Spacing="4">
                                        <TextBlock Text="WHO CAN REQUEST" Style="{StaticResource ToolSubLabelTextStyle}"
                                                   loc:Localize.Key="panel.songrequest.permissions.request.title" />
                                        <cmn:RoleCheckRow Roles="{x:Bind ViewModel.RequestRoles, Mode=OneWay}" />
                                    </StackPanel>

                                    <StackPanel Spacing="4">
                                        <TextBlock Text="WHO CAN QUERY THE QUEUE" Style="{StaticResource ToolSubLabelTextStyle}"
                                                   loc:Localize.Key="panel.songrequest.permissions.view.title" />
                                        <cmn:RoleCheckRow Roles="{x:Bind ViewModel.ViewRoles, Mode=OneWay}" />
                                    </StackPanel>

                                    <StackPanel Spacing="4">
                                        <TextBlock Text="WHO CAN VOTE-SKIP" Style="{StaticResource ToolSubLabelTextStyle}"
                                                   loc:Localize.Key="panel.songrequest.permissions.voteskip.title" />
                                        <cmn:RoleCheckRow Roles="{x:Bind ViewModel.VoteSkipRoles, Mode=OneWay}" />
                                    </StackPanel>

                                    <StackPanel Spacing="4">
                                        <TextBlock Text="WHO CAN CONTROL PLAYBACK" Style="{StaticResource ToolSubLabelTextStyle}"
                                                   loc:Localize.Key="panel.songrequest.permissions.playback.title" />
                                        <cmn:RoleCheckRow Roles="{x:Bind ViewModel.ModRoles, Mode=OneWay}" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- What this tool answers to in chat. Inside the SETTINGS
                                 section, last, directly under the boxes and the role rows
                                 that decide every line of it — the PLAYER section is about
                                 the track that is selected, not about the verbs, so a
                                 command list there would be answering a question that
                                 section never asks. Thirteen rows for twelve words: the
                                 volume verb is gated twice and the two gates are the one
                                 thing the boxes above cannot show. -->
                            <cmn:ToolCommandList Commands="{x:Bind ViewModel.ChatCommands, Mode=OneWay}"
                                                 AutomationProperties.Name="Song request chat commands"
                                                 loc:Localize.AutomationKey="panel.songrequest.chat_commands.a11y" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- ═══════════ RIGHT — the queue (the one legal PanelHeader) ═══════════ -->
            <Border Grid.Column="1"
                    Background="{StaticResource CoalSurfaceBrush}"
                    BorderBrush="{StaticResource CoalCardBrush}"
                    BorderThickness="1,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />   <!-- header -->
                        <RowDefinition Height="*" />      <!-- rows   -->
                    </Grid.RowDefinitions>

                    <!-- The count and the verb that empties it live together, in the
                         header of the column they describe — not in a hero tile above the
                         settings fields, and not on the page strip. CLEAR keeps its own
                         handler, its danger recipe and its refund tooltip unchanged; only
                         its host moved. -->
                    <cmn:PanelHeader Grid.Row="0" Eyebrow="LIVE" Title="The queue"
                                     EyebrowKey="panel.common.eyebrow.live"
                                     TitleKey="panel.songrequest.queue.title">
                        <cmn:PanelHeader.RightContent>
                            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                <TextBlock Text="{x:Bind ViewModel.CountText, Mode=OneWay}"
                                           FontFamily="{StaticResource MonoFont}" FontSize="11"
                                           Foreground="{StaticResource CoalSecondaryTextBrush}"
                                           VerticalAlignment="Center" />
                                <Button Style="{StaticResource ToolDangerButtonStyle}"
                                        Height="26"
                                        Padding="10,0"
                                        Click="OnClearClick"
                                        AutomationProperties.Name="Clear the queue"
                                        ToolTipService.ToolTip="Empty the queue and refund every charged request"
                                        loc:Localize.AutomationKey="panel.songrequest.queue.clear.a11y"
                                        loc:Localize.TooltipKey="panel.songrequest.queue.clear.tip">
                                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                        <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE74D;" FontSize="10"
                                                  Foreground="{StaticResource ErrBrush}" />
                                        <TextBlock Text="CLEAR" Style="{StaticResource ToolStripLabelTextStyle}"
                                                   loc:Localize.Key="panel.songrequest.queue.clear.label" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </cmn:PanelHeader.RightContent>
                    </cmn:PanelHeader>

                    <Grid Grid.Row="1">
                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollMode="Disabled">
                            <ItemsRepeater ItemsSource="{x:Bind ViewModel.Queue, Mode=OneWay}"
                                           cmn:RowDataContext.Supply="True"
                                           ItemTemplate="{StaticResource SongQueueRowTemplate}"
                                           AutomationProperties.LiveSetting="Polite"
                                           AutomationProperties.Name="Waiting requests"
                                           loc:Localize.AutomationKey="panel.songrequest.queue.list.a11y" />
                        </ScrollViewer>

                        <!-- Empty state — a SIBLING of the scroller, never inside it. ONE
                             mono line at the top of the column: a DisplayFont headline
                             centred in a tall empty void was the loudest thing on the page
                             on a fresh install, and it was announcing an absence. -->
                        <TextBlock Visibility="{x:Bind ViewModel.EmptyVisibility, Mode=OneWay}"
                                   Style="{StaticResource ToolMonoHintTextStyle}"
                                   VerticalAlignment="Top"
                                   Margin="14,12,14,0"
                                   Text="Nothing queued — viewers add songs from chat."
                                   loc:Localize.Key="panel.songrequest.queue.empty.body" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
