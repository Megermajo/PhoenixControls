<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Phoenix.Controls.Hub.WinUI.Panels.StatusStrip.StatusStripView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Phoenix.Controls.Hub.WinUI.Panels.StatusStrip"
    xmlns:loc="using:Phoenix.Controls.Hub.WinUI.Localization"
    HorizontalAlignment="Stretch"
    HorizontalContentAlignment="Stretch">

    <!-- QC44-01 (2026-05-15): rebuilt to Design_Orders §4.8. The strip used
         to be a left-zone-only 44px row; the spec wants 24px, three zones
         (left status + center contextual + right meta), and a clock in the
         right zone.
         §4.8 mock-up showed the version next to the clock here too — that
         was pulled in 0.10.2 after Majo flagged it as a duplicate of the
         chrome's VersionStamp (HubChrome.xaml.cs), which sits ~30px above
         and reads the same GitInfoService value. The chrome's stamp is the
         canonical version display; the strip keeps the clock only. -->
    <Border Height="24"
            Background="{StaticResource CoalSurfaceBrush}"
            BorderBrush="{StaticResource CoalDividerBrush}"
            BorderThickness="0,1,0,0">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Left status zone — Streamer.bot / HUD Overlay / IPC Bus dots.
                 Visualist + Architect dots dropped post-T15: both pillars are
                 embedded in the same Hub process now, so a "Disconnected"
                 indicator was always misleading. The remaining three dots
                 are genuine external service signals. -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <local:StatusDot x:Name="StreamerBotDot"
                                 Label="Streamer.bot"
                                 Sub="{x:Bind ViewModel.StreamerBotSub, Mode=OneWay}"
                                 State="{x:Bind ViewModel.StreamerBot, Mode=OneWay}"
                                 Clicked="OnStreamerBotDotClicked" />
                <local:StatusDot x:Name="HudOverlayDot"
                                 Label="HUD Overlay"
                                 loc:Localize.Key="panel.statusstrip.dot.hud_overlay.label"
                                 loc:Localize.Property="Label"
                                 Sub="{x:Bind ViewModel.HudOverlaySub, Mode=OneWay}"
                                 State="{x:Bind ViewModel.HudOverlay, Mode=OneWay}"
                                 Clicked="OnHudOverlayDotClicked" />
                <local:StatusDot x:Name="IpcBusDot"
                                 Label="IPC Bus"
                                 loc:Localize.Key="panel.statusstrip.dot.ipc_bus.label"
                                 loc:Localize.Property="Label"
                                 Sub="{x:Bind ViewModel.IpcBusSub, Mode=OneWay}"
                                 State="{x:Bind ViewModel.IpcBus, Mode=OneWay}"
                                 Clicked="OnIpcBusDotClicked" />
            </StackPanel>

            <!-- §4.8 zone separator — 1px CoalDividerBrush divider with 8px
                 vertical inset between left and center zones. Spec calls for
                 dotted; WinUI 3 Borders don't natively dash, so a solid 1px
                 Border at reduced opacity is the practical equivalent.
                 Placed in column 0 with HorizontalAlignment="Right" to keep
                 the three-column layout intact. -->
            <Border Grid.Column="0"
                    Width="1"
                    Height="14"
                    Margin="8,4"
                    Background="{StaticResource CoalDividerBrush}"
                    Opacity="0.4"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Right" />

            <!-- Center contextual zone — §4.8 calls for short status phrases
                 ("Script Engine ready", per-layer FPS readout) to surface
                 here. B8 (audit 2026-05-24) wires the "Layers: N" + "FPS:
                 X.X" readouts that the §4.8 mock-up already calls out;
                 CenterContextual remains available as a generic slot that
                 future call sites can publish to. -->
            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        Spacing="14"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center">
                <TextBlock FontFamily="{StaticResource MonoFont}"
                           FontSize="11"
                           Foreground="{StaticResource CoalSecondaryTextBrush}"
                           VerticalAlignment="Center"
                           Text="{x:Bind ViewModel.LayersText, Mode=OneWay}" />
                <TextBlock FontFamily="{StaticResource MonoFont}"
                           FontSize="11"
                           Foreground="{StaticResource CoalSecondaryTextBrush}"
                           VerticalAlignment="Center"
                           Text="{x:Bind ViewModel.FpsText, Mode=OneWay}" />
                <TextBlock FontFamily="{StaticResource SansFont}"
                           FontSize="11"
                           Foreground="{StaticResource CoalSecondaryTextBrush}"
                           VerticalAlignment="Center"
                           Text="{x:Bind ViewModel.CenterContextual, Mode=OneWay}" />
            </StackPanel>

            <!-- §4.8 zone separator between center and right zones. Same
                 treatment as the left/center divider above. -->
            <Border Grid.Column="1"
                    Width="1"
                    Height="14"
                    Margin="8,4"
                    Background="{StaticResource CoalDividerBrush}"
                    Opacity="0.4"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Right" />

            <!-- Right meta zone — clock only (HH:mm, MonoFont). The version
                 stamp lives on HubChrome's VersionStamp and was removed from
                 here in 0.10.2 to drop the duplicate display. -->
            <StackPanel Grid.Column="2"
                        Orientation="Horizontal"
                        Spacing="10"
                        VerticalAlignment="Center"
                        Margin="0,0,12,0">
                <!-- B44 (audit 2026-05-24, finished sweep) — WebSocketServer
                     status badge. Now reads live state through HubHost.
                     WebSocketServer's ConnectedClientCount + IsListening:
                       • disabled              — TextBlock hidden entirely
                       • "WSS :PORT · 0 clients" — listening, 0 active (dimmed)
                       • "WSS :PORT · N clients" — listening, N>0 active
                       • "WSS :PORT · starting" — toggle on, bind not yet done
                     Polled every 1s by StatusStripViewModel.RefreshStats. The
                     audit calls out three concrete affordances over the prior
                     "WS: off" placeholder: hide-when-disabled (Visibility),
                     dim-on-idle (Opacity), and a richer label ("N clients"
                     reads more naturally than "WS: 3 / :18083"). -->
                <TextBlock VerticalAlignment="Center"
                           FontFamily="{StaticResource MonoFont}"
                           FontSize="11"
                           Foreground="{StaticResource CoalSecondaryTextBrush}"
                           Visibility="{x:Bind ViewModel.WsBadgeVisibility, Mode=OneWay}"
                           Opacity="{x:Bind ViewModel.WsBadgeOpacity, Mode=OneWay}"
                           Text="{x:Bind ViewModel.WsText, Mode=OneWay}" />
                <TextBlock VerticalAlignment="Center"
                           FontFamily="{StaticResource MonoFont}"
                           FontSize="11"
                           Foreground="{StaticResource CoalSecondaryTextBrush}"
                           Text="{x:Bind ViewModel.Clock, Mode=OneWay}" />
            </StackPanel>

        </Grid>
    </Border>
</UserControl>
