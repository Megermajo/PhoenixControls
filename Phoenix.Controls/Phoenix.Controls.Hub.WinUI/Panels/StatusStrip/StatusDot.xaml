<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Phoenix.Controls.Hub.WinUI.Panels.StatusStrip.StatusDot"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    IsTabStop="True"
    UseSystemFocusVisuals="True"
    FocusVisualPrimaryBrush="{StaticResource EmberPrimaryBrush}"
    FocusVisualSecondaryBrush="{StaticResource CoalCardBrush}"
    AutomationProperties.Name="{x:Bind TooltipText, Mode=OneWay}"
    KeyDown="OnRootKeyDown">

    <!-- M36 (2026-05-14): the StatusDot pulse (3 cycles × 2s with AutoReverse,
         then static) used to be a XAML Storyboard animating the Ellipse's
         ScaleTransform + Opacity. Replaced with a Composition-API animation
         in code-behind (StartPulse / StopPulse) — DComp-driven, runs
         off-thread, and works with M17's per-Window activation gate via
         AnimationController.Pause / Resume rather than Storyboard
         pause-restart. The ScaleTransform on the Ellipse below was likewise
         dropped so Composition's Visual.Scale isn't multiplied with a
         residual XAML transform.
         QC44-01 (2026-05-15): switched to single-line horizontal layout so
         the dots fit Design_Orders §4.8's 24px strip height. The Sub text
         (port/URL) is no longer rendered visibly — it remains accessible
         via the tooltip ("Streamer.bot — connected\nws://127.0.0.1:8080"),
         per the existing RecomputeTooltip path. -->

    <Border x:Name="DotBorder"
            Padding="10,0"
            Background="Transparent"
            BorderBrush="{StaticResource CoalDividerBrush}"
            BorderThickness="0,0,1,0"
            ToolTipService.ToolTip="{x:Bind TooltipText, Mode=OneWay}"
            Tapped="OnDotTapped"
            PointerEntered="OnDotPointerEntered"
            PointerExited="OnDotPointerExited">
        <StackPanel Orientation="Horizontal"
                    Spacing="6"
                    VerticalAlignment="Center">

            <Ellipse x:Name="DotEllipse"
                     Width="8" Height="8"
                     VerticalAlignment="Center"
                     Fill="{x:Bind DotBrush, Mode=OneWay}" />

            <TextBlock VerticalAlignment="Center"
                       FontFamily="{StaticResource SansFont}"
                       FontSize="11"
                       FontWeight="SemiBold"
                       CharacterSpacing="80"
                       Foreground="{StaticResource CoalPrimaryTextBrush}"
                       Text="{x:Bind LabelUpper, Mode=OneWay}" />
        </StackPanel>
    </Border>
</UserControl>
