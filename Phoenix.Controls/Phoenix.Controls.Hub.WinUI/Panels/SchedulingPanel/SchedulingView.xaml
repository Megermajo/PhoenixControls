<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Phoenix.Controls.Hub.WinUI.Panels.SchedulingPanel.SchedulingView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Phoenix.Controls.Hub.WinUI.Panels.SchedulingPanel"
    xmlns:cmn="using:Phoenix.Controls.Hub.WinUI.Panels.Common"
    xmlns:loc="using:Phoenix.Controls.Hub.WinUI.Localization"
    HorizontalAlignment="Stretch"
    VerticalAlignment="Stretch"
    HorizontalContentAlignment="Stretch"
    VerticalContentAlignment="Stretch"
    AutomationProperties.Name="Scheduling page"
    AutomationProperties.HelpText="Configure automatic recurring chat messages: enable the tool, choose whether to post only while live, add schedules, and set each one's message, interval and minimum-chat-lines gate."
    loc:Localize.AutomationKey="panel.scheduling.page.a11y"
    loc:Localize.HelpTextKey="panel.scheduling.page.help">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- KEPT: this page still declares TextBox (name, message, interval,
                     min-chat-lines) and ToolControlStyles carries the implicit
                     coal/ember TextBox style. It also now dresses the ToggleSwitch
                     inside cmn:ToolPageHeader — implicit-style lookup walks UP out of
                     a nested UserControl at runtime, unlike the StaticResource walk,
                     which does not. There is no CheckBox, no ComboBox and no Pivot. -->
                <ResourceDictionary Source="ms-appx:///Panels/Common/ToolControlStyles.xaml" />
                <!-- Keyed-only style dictionary: the shell chrome recipes. Contains no
                     implicit styles, and is merged PER VIEW, never into App.xaml. -->
                <ResourceDictionary Source="ms-appx:///Panels/Common/ToolShellStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- ══════════ Live-column roster row ══════════
                 Two Buttons side by side rather than one row-Button containing the
                 toggle: nested Buttons swallow each other's Click. The left Button IS
                 the row (it owns selection and keyboard focus), the right one owns the
                 enable pill. TogglePill is display-only — the Button carries the Click
                 and the accessible name. -->
            <DataTemplate x:Key="ScheduleRosterRowTemplate" x:DataType="local:ScheduleRowVm">
                <Grid Background="{x:Bind RowBackground, Mode=OneWay}"
                      BorderBrush="{StaticResource CoalRaisedBrush}"
                      BorderThickness="0,0,0,1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0"
                            Background="Transparent"
                            BorderThickness="0"
                            CornerRadius="0"
                            Padding="14,7"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch"
                            Click="OnSelectScheduleClick"
                            AutomationProperties.Name="Open this schedule"
                            ToolTipService.ToolTip="Open this schedule in the editor"
                            loc:Localize.AutomationKey="panel.scheduling.roster.open.a11y"
                            loc:Localize.TooltipKey="panel.scheduling.roster.open.tip">
                        <StackPanel Spacing="2">
                            <TextBlock Text="{x:Bind TitleEyebrow, Mode=OneWay}"
                                       FontFamily="{StaticResource SansFont}"
                                       FontSize="11" FontWeight="SemiBold" CharacterSpacing="120"
                                       TextTrimming="CharacterEllipsis"
                                       Foreground="{StaticResource CoalPrimaryTextBrush}" />
                            <TextBlock Text="{x:Bind FireCountText, Mode=OneWay}"
                                       FontFamily="{StaticResource MonoFont}"
                                       FontSize="10"
                                       Foreground="{StaticResource CoalSecondaryTextBrush}" />
                        </StackPanel>
                    </Button>

                    <Button Grid.Column="1"
                            Background="Transparent"
                            BorderThickness="0"
                            CornerRadius="0"
                            Padding="8,0,14,0"
                            VerticalAlignment="Stretch"
                            Click="OnRowEnabledClick"
                            AutomationProperties.Name="Schedule enabled"
                            ToolTipService.ToolTip="Turn this schedule on or off"
                            loc:Localize.AutomationKey="panel.scheduling.roster.enabled.a11y"
                            loc:Localize.TooltipKey="panel.scheduling.roster.enabled.tip">
                        <cmn:TogglePill IsOn="{x:Bind Enabled, Mode=OneWay}" />
                    </Button>
                </Grid>
            </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Background="{StaticResource CoalSurfaceBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />   <!-- 48 px header band -->
            <RowDefinition Height="*" />      <!-- two-column body   -->
        </Grid.RowDefinitions>

        <!-- ══════════════════ ROW 0 — HEADER BAND ══════════════════
             ONE 48 px row where three used to stack. The action strip, the pinned
             state-sentence band and the ToolStatusPill between them rendered the
             SAME boolean three times in three vocabularies (ENABLED / DISABLED /
             dormant), above a strip of hero stat tiles reading 0 0 0 — ~231 px
             before a single setting was reachable on a page whose whole job is
             changing one.

             Title, master switch, state phrase and the one brass verb are wired in
             code-behind (see the constructor). The phrase projects the SAME
             predicate the pill did — SchedulingService.PillState — only rendered
             here instead of in a chip; the service state machine and
             PreBuildStatusPillTests are untouched.

             Two strip controls the band deliberately cannot host moved DOWN into
             the detail column rather than being dropped: ONLY WHILE LIVE (a real
             page-level setting, not a status) and DELETE (acts on the selection,
             so it belongs beside the thing it deletes). -->
        <cmn:ToolPageHeader Grid.Row="0" x:Name="PageHeader" />

        <!-- ══════════════════ ROW 1 — TWO-COLUMN BODY ══════════════════ -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />     <!-- LEFT: detail  -->
                <ColumnDefinition Width="300" />   <!-- RIGHT: roster -->
            </Grid.ColumnDefinitions>
            <!-- No ColumnSpacing. The right column's left border IS the divider. -->

            <!-- The detail scroller is ALWAYS visible; only the editor cards inside it
                 are selection-gated, and the gate is a StackPanel VISIBILITY, never
                 the cards' CONTENT: every TextBox stays in the tree so a focused edit
                 commits on LostFocus before a roster click swaps the selection. -->
            <ScrollViewer Grid.Column="0"
                          x:Name="DetailScroll"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollMode="Disabled">
                <StackPanel Spacing="12" Padding="14">

                    <!-- ── POSTING — page level, never selection-gated ──
                         ONLY WHILE LIVE is a PAGE gate, not a field of the picked
                         schedule, so it cannot be mistaken for one here either; it is
                         simply first, because it is the first thing on this page a
                         streamer can actually change.

                         The sentence under it carries the non-obvious half: with no
                         live detection wired up the service latch defaults to LIVE,
                         so "only while live" does not silently mute a channel that
                         never reports going live.

                         The send-health line stays with it. A dropped post is never
                         counted as a fire, so without it the page just looks idle for
                         no visible reason — and it is Collapsed whenever sends are
                         landing, so it costs zero chrome on a healthy install. -->
                    <Border Style="{StaticResource ToolSectionCardStyle}">
                        <StackPanel Spacing="10">
                            <Button Style="{StaticResource ToolChipButtonStyle}"
                                    HorizontalAlignment="Left"
                                    Click="OnToggleOnlyWhenLiveClick"
                                    AutomationProperties.Name="Only post while live"
                                    loc:Localize.AutomationKey="panel.scheduling.posting.only_live.a11y"
                                    ToolTipService.ToolTip="{x:Bind ViewModel.LiveGateText, Mode=OneWay}">
                                <cmn:TogglePill IsOn="{x:Bind ViewModel.OnlyWhenLive, Mode=OneWay}"
                                                Label="ONLY WHILE LIVE"
                                                loc:Localize.Key="panel.scheduling.posting.only_live.label" />
                            </Button>

                            <TextBlock Text="{x:Bind ViewModel.LiveGateText, Mode=OneWay}"
                                       Style="{StaticResource ToolMonoHintTextStyle}" />

                            <TextBlock Text="{x:Bind ViewModel.SendFailureText, Mode=OneWay}"
                                       Visibility="{x:Bind ViewModel.SendFailureVisibility, Mode=OneWay}"
                                       FontFamily="{StaticResource MonoFont}" FontSize="11"
                                       Foreground="{StaticResource ErrBrush}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <!-- ── THE SELECTION-GATED EDITOR ── -->
                    <StackPanel Spacing="12"
                                Visibility="{x:Bind ViewModel.DetailVisibility, Mode=OneWay}">

                        <!-- ── MESSAGE ── -->
                        <Border Style="{StaticResource ToolSectionCardStyle}">
                            <StackPanel Spacing="10">
                                <TextBlock Text="MESSAGE" Style="{StaticResource ToolEyebrowTextStyle}"
                                           loc:Localize.Key="panel.scheduling.message.eyebrow" />

                                <Grid ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Name"
                                               Style="{StaticResource ToolSettingsLabelTextStyle}"
                                               loc:Localize.Key="panel.scheduling.message.name.label" />
                                    <TextBox Grid.Column="1"
                                             Text="{x:Bind ViewModel.SelectedSchedule.Name, Mode=TwoWay}"
                                             PlaceholderText="defaults to the message preview"
                                             HorizontalAlignment="Stretch"
                                             AutomationProperties.Name="Schedule name"
                                             loc:Localize.PlaceholderKey="panel.scheduling.message.name.placeholder"
                                             loc:Localize.AutomationKey="panel.scheduling.message.name.a11y" />
                                </Grid>

                                <StackPanel Spacing="4">
                                    <TextBlock Text="Chat line"
                                               Style="{StaticResource ToolSettingsLabelTextStyle}"
                                               HorizontalAlignment="Left"
                                               loc:Localize.Key="panel.scheduling.message.line.label" />
                                    <TextBox Text="{x:Bind ViewModel.SelectedSchedule.Message, Mode=TwoWay}"
                                             PlaceholderText="e.g. We've been live for {uptime}."
                                             AcceptsReturn="True"
                                             TextWrapping="Wrap"
                                             MinHeight="72"
                                             HorizontalAlignment="Stretch"
                                             AutomationProperties.Name="Message posted to chat"
                                             loc:Localize.PlaceholderKey="panel.scheduling.message.line.placeholder"
                                             loc:Localize.AutomationKey="panel.scheduling.message.line.a11y" />
                                    <TextBlock Style="{StaticResource ToolMonoHintTextStyle}"
                                               Text="Tokens: {count} = times posted · {random} · {random.N} · {random.A-B} · {uptime} · {channel} · {game} · {title}"
                                               loc:Localize.Key="panel.scheduling.message.tokens_hint" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- ── CADENCE ── -->
                        <Border Style="{StaticResource ToolSectionCardStyle}">
                            <StackPanel Spacing="10">
                                <TextBlock Text="CADENCE" Style="{StaticResource ToolEyebrowTextStyle}"
                                           loc:Localize.Key="panel.scheduling.cadence.eyebrow" />

                                <Grid ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Post every"
                                               Style="{StaticResource ToolSettingsLabelTextStyle}"
                                               loc:Localize.Key="panel.scheduling.cadence.interval.label" />
                                    <TextBox Grid.Column="1"
                                             Text="{x:Bind ViewModel.SelectedSchedule.IntervalMinutesText, Mode=TwoWay}"
                                             Width="72"
                                             FontFamily="{StaticResource MonoFont}" FontSize="11"
                                             TextAlignment="Right"
                                             AutomationProperties.Name="Interval in minutes"
                                             loc:Localize.AutomationKey="panel.scheduling.cadence.interval.a11y" />
                                    <TextBlock Grid.Column="2" Text="minutes"
                                               Style="{StaticResource ToolSettingsLabelTextStyle}"
                                               Margin="8,0,0,0"
                                               loc:Localize.Key="panel.scheduling.cadence.interval.unit" />
                                </Grid>

                                <Grid ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Min chat lines"
                                               Style="{StaticResource ToolSettingsLabelTextStyle}"
                                               loc:Localize.Key="panel.scheduling.cadence.min_lines.label" />
                                    <TextBox Grid.Column="1"
                                             Text="{x:Bind ViewModel.SelectedSchedule.MinChatLinesText, Mode=TwoWay}"
                                             Width="72"
                                             FontFamily="{StaticResource MonoFont}" FontSize="11"
                                             TextAlignment="Right"
                                             AutomationProperties.Name="Minimum chat lines gate"
                                             loc:Localize.AutomationKey="panel.scheduling.cadence.min_lines.a11y" />
                                    <TextBlock Grid.Column="2"
                                               Text="lines since the last post before this one fires again (0 = off)"
                                               Style="{StaticResource ToolMonoHintTextStyle}"
                                               Margin="8,0,0,0"
                                               loc:Localize.Key="panel.scheduling.cadence.min_lines.hint" />
                                </Grid>

                                <Border Height="1" Background="{StaticResource CoalCardBrush}" />

                                <TextBlock Text="{x:Bind ViewModel.SelectedSchedule.FireCountText, Mode=OneWay}"
                                           FontFamily="{StaticResource MonoFont}" FontSize="10"
                                           CharacterSpacing="120"
                                           Foreground="{StaticResource CoalSecondaryTextBrush}" />
                            </StackPanel>
                        </Border>

                        <!-- Closing note + the danger verb. DELETE came down from the
                             action strip: it always acted on the SELECTION, and the
                             selection is what this column is showing, so the button
                             now sits under the thing it deletes instead of at the far
                             end of a strip. The IsEnabled gate is kept even though the
                             whole block is selection-gated — the binding is the
                             contract, the Visibility is the layout. -->
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Style="{StaticResource ToolMonoHintTextStyle}"
                                       VerticalAlignment="Center"
                                       Text="Posts a chat line on a fixed interval. Architect equivalent: Schedule.Recurring → Chat.Send."
                                       loc:Localize.Key="panel.scheduling.footer.architect_hint" />
                            <Button Grid.Column="1"
                                    Style="{StaticResource ToolDangerButtonStyle}"
                                    IsEnabled="{x:Bind ViewModel.HasSelection, Mode=OneWay}"
                                    Click="OnDeleteScheduleClick"
                                    AutomationProperties.Name="Delete the selected schedule"
                                    ToolTipService.ToolTip="Delete the schedule shown here"
                                    loc:Localize.AutomationKey="panel.scheduling.delete.a11y"
                                    loc:Localize.TooltipKey="panel.scheduling.delete.tip">
                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE74D;" FontSize="11"
                                              Foreground="{StaticResource ErrBrush}" />
                                    <TextBlock Text="DELETE" Style="{StaticResource ToolStripLabelTextStyle}"
                                               loc:Localize.Key="panel.scheduling.delete.label" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </StackPanel>

                    <!-- Empty pane. INSIDE the scroller rather than overlaying it as a
                         sibling, because the page-level POSTING card above is on screen
                         whether or not a schedule is picked and a centred overlay would
                         land on top of it in a short column. -->
                    <StackPanel Visibility="{x:Bind ViewModel.EmptyVisibility, Mode=OneWay}"
                                HorizontalAlignment="Center"
                                Spacing="8" Margin="0,24,0,8">
                        <TextBlock Text="{x:Bind ViewModel.EmptyTitle, Mode=OneWay}"
                                   FontFamily="{StaticResource DisplayFont}"
                                   FontSize="20"
                                   Foreground="{StaticResource CoalSecondaryTextBrush}"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="{x:Bind ViewModel.EmptySubtitle, Mode=OneWay}"
                                   FontFamily="{StaticResource SansFont}"
                                   FontSize="12"
                                   Foreground="{StaticResource CoalSecondaryTextBrush}"
                                   HorizontalAlignment="Center"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <!-- ═══════════ RIGHT — the roster (the one legal PanelHeader) ═══════════
                 Fixed 300 px, not a proportion: a list of one-line rows does not get
                 wider with the window, and a star width made the editor column shrink
                 to pay for whitespace beside the roster.

                 The one count worth a glance lives in this header (CountText:
                 "N total · M on"). That is where a count belongs — not in a strip of
                 hero tiles above the settings. -->
            <Border Grid.Column="1"
                    Background="{StaticResource CoalSurfaceBrush}"
                    BorderBrush="{StaticResource CoalCardBrush}"
                    BorderThickness="1,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />   <!-- header       -->
                        <RowDefinition Height="Auto" />   <!-- column band  -->
                        <RowDefinition Height="*" />      <!-- roster       -->
                    </Grid.RowDefinitions>

                    <cmn:PanelHeader Grid.Row="0" Eyebrow="LIVE" Title="Schedules"
                                     EyebrowKey="panel.common.eyebrow.live"
                                     TitleKey="panel.scheduling.roster.title">
                        <cmn:PanelHeader.RightContent>
                            <TextBlock Text="{x:Bind ViewModel.CountText, Mode=OneWay}"
                                       FontFamily="{StaticResource MonoFont}" FontSize="11"
                                       Foreground="{StaticResource CoalSecondaryTextBrush}" />
                        </cmn:PanelHeader.RightContent>
                    </cmn:PanelHeader>

                    <Border Grid.Row="1" Style="{StaticResource ToolBandBorderStyle}">
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="SCHEDULE · POSTED"
                                       FontFamily="{StaticResource SansFont}" FontSize="9" FontWeight="Bold"
                                       CharacterSpacing="140"
                                       Foreground="{StaticResource CoalSecondaryTextBrush}"
                                       loc:Localize.Key="panel.scheduling.roster.column.schedule" />
                            <TextBlock Grid.Column="1" Text="ON"
                                       FontFamily="{StaticResource SansFont}" FontSize="9" FontWeight="Bold"
                                       CharacterSpacing="140"
                                       Foreground="{StaticResource CoalSecondaryTextBrush}"
                                       loc:Localize.Key="panel.scheduling.roster.column.on" />
                        </Grid>
                    </Border>

                    <ScrollViewer Grid.Row="2"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollMode="Disabled">
                        <ItemsRepeater ItemsSource="{x:Bind ViewModel.Schedules, Mode=OneWay}"
                                       cmn:RowDataContext.Supply="True"
                                       ItemTemplate="{StaticResource ScheduleRosterRowTemplate}"
                                       AutomationProperties.LiveSetting="Polite"
                                       AutomationProperties.Name="Your schedules"
                                       loc:Localize.AutomationKey="panel.scheduling.roster.list.a11y" />
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
