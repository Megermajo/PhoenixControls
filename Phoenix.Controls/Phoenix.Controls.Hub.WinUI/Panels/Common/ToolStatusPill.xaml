<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Phoenix.Controls.Hub.WinUI.Panels.Common.ToolStatusPill"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        House status pill — the Giveaway strip chip (GiveawayView.xaml:412-438)
        promoted to a control for the rebuilt tool pages' action strip.

        Geometry verbatim: Padding 8,3 at Radius1Corner, a 6px dot and a
        MonoFont 10 Bold CharacterSpacing 160 label sharing one accent brush,
        with an optional MonoFont 11 coal-secondary hint trailing outside the
        chip.

        The chip ground (Background / BorderBrush) is NOT declared here: it is
        the accent-alpha pair computed in code-behind from the Accent colour.
        See ToolStatusPill.xaml.cs for why that differs from the reference.

        Two Auto columns rather than a StackPanel with Spacing, so an empty Hint
        contributes no phantom gap — the hint carries its own left Margin.
    -->
    <Grid VerticalAlignment="Center">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <Border x:Name="Chip"
                Grid.Column="0"
                BorderThickness="1"
                CornerRadius="{StaticResource Radius1Corner}"
                Padding="8,3"
                VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <!-- The dot is shown only while pulsing. Every state in the
                     build spec's per-tool pill tables is either "pulsing" or
                     "hidden"; there is no visible-but-static dot state. -->
                <Ellipse x:Name="PulseDot"
                         Width="6"
                         Height="6"
                         VerticalAlignment="Center"
                         Visibility="Collapsed" />
                <TextBlock x:Name="PillText"
                           FontFamily="{StaticResource MonoFont}"
                           FontSize="10"
                           FontWeight="Bold"
                           CharacterSpacing="160"
                           VerticalAlignment="Center" />
            </StackPanel>
        </Border>

        <TextBlock x:Name="HintText"
                   Grid.Column="1"
                   Margin="8,0,0,0"
                   Visibility="Collapsed"
                   FontFamily="{StaticResource MonoFont}"
                   FontSize="11"
                   Foreground="{StaticResource CoalSecondaryTextBrush}"
                   VerticalAlignment="Center" />
    </Grid>
</UserControl>
