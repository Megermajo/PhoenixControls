<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Phoenix.Controls.Hub.WinUI.Panels.Common.PanelHeader"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    HorizontalAlignment="Stretch"
    HorizontalContentAlignment="Stretch">

    <!-- Hub UI sweep 2026-05-22 — bottom hairline switched from the
         barely-visible CoalDividerBrush to PanelHeaderAccentBrush so the
         seam between header and body reads cleanly against the widened
         PanelHeaderGradientBrush. Ember-deep at low alpha — accent
         edge, not chrome stripe. -->
    <Border BorderBrush="{StaticResource PanelHeaderAccentBrush}"
            BorderThickness="0,0,0,1"
            Padding="{StaticResource PanelHeaderPadding}"
            Background="{StaticResource PanelHeaderGradientBrush}">

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- 0.10.8 alignment sweep — both ends of the header anchor to
                 the same vertical center.
                 Pre-fix: the left StackPanel was VerticalAlignment=Bottom
                 while the right ContentControl was Center, so the title
                 baseline and the right-side chips/buttons ended a few
                 pixels apart on every panel (Majo's 0.10.7 report:
                 "Alignment of all icons and text in panel headers off").
                 Now the left StackPanel is also Center; the two inner
                 TextBlocks explicit-bottom themselves so the small
                 eyebrow rides the title's baseline (typographic
                 convention) instead of floating in the title's
                 vertical middle. -->
            <StackPanel Grid.Column="0"
                        Orientation="Horizontal"
                        Spacing="8"
                        VerticalAlignment="Center">
                <TextBlock x:Name="EyebrowText"
                           FontFamily="{StaticResource SansFont}"
                           FontSize="10"
                           FontWeight="SemiBold"
                           CharacterSpacing="120"
                           Foreground="{StaticResource CoalBodyTextBrush}"
                           VerticalAlignment="Bottom"
                           Text="{x:Bind Eyebrow, Mode=OneWay}" />
                <TextBlock x:Name="TitleText"
                           FontFamily="{StaticResource DisplayFont}"
                           FontSize="15"
                           CharacterSpacing="50"
                           Foreground="{StaticResource CoalPrimaryTextBrush}"
                           VerticalAlignment="Bottom"
                           Text="{x:Bind Title, Mode=OneWay}" />
            </StackPanel>

            <ContentControl Grid.Column="2"
                            x:Name="RightHost"
                            Content="{x:Bind RightContent, Mode=OneWay}"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Right" />
        </Grid>
    </Border>
</UserControl>
