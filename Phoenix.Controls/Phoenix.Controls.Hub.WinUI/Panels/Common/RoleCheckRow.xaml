<?xml version="1.0" encoding="utf-8" ?>
<!--
    RoleCheckRow (T11-3) — the ONE shared role gate the five config tools duplicated
    ~10× inline (Everyone / Sub / VIP / Mod / Broadcaster, plus Regular since C18d).
    Each tool has its own structurally-identical *RolesVm (6 two-way bool? props on an
    ObservableObject); this control binds against whichever one is handed to its
    `Roles` DP via classic {Binding} (late-bound by property name), so the per-tool
    RolesVm classes stay exactly as they are — no generic refactor. Ember/coal
    checkbox styling comes from the merged ToolControlStyles.xaml.

    Regular is appended LAST rather than slotted into the privilege ladder, matching
    the suite-wide convention (Chat.Message / Twitch.GetUser both append IsRegular
    after the platform flags) and leaving every existing box where the streamer's
    muscle memory expects it.
-->
<UserControl
    x:Class="Phoenix.Controls.Hub.WinUI.Panels.Common.RoleCheckRow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:common="using:Phoenix.Controls.Hub.WinUI.Panels.Common"
    xmlns:loc="using:Phoenix.Controls.Hub.WinUI.Localization">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="ms-appx:///Panels/Common/ToolControlStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- The bottom margin is the row gap the wrapping panel uses when the host is too
                 narrow for one row. It is unconditional, so the wide single-row hosts pay 2px of
                 height for it too — cheaper than a second style or a panel-set attached property. -->
            <Style x:Key="RoleCheck" TargetType="CheckBox">
                <Setter Property="FontFamily" Value="{StaticResource SansFont}" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="Margin" Value="0,0,12,2" />
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <!-- DataContext is set to the bound *RolesVm in code-behind (OnRolesChanged);
         the checkboxes bind against it by property name. WrapRowPanel (not a
         horizontal StackPanel) so the six boxes fold onto a second row in the narrow
         multi-column hosts instead of being clipped off the right edge. -->
    <common:WrapRowPanel x:Name="RootPanel">
        <!-- ★ Everyone is EXCLUSIVE and that was invisible until 2026-08-14.
             Six equal checkboxes read as six independent settings, so a page
             could show Everyone ticked next to five live boxes that changed
             nothing — the role model was only legible in one place in the whole
             app (the command catalogue's collapsed Roles summary). The
             code-behind now dims and disables the other five while Everyone is
             on. See RoleCheckRow.xaml.cs for why they are NOT cleared. -->
        <CheckBox x:Name="EveryoneBox"    Style="{StaticResource RoleCheck}" Content="Everyone"    IsChecked="{Binding Everyone, Mode=TwoWay}"
                  loc:Localize.Key="panel.common.role.everyone" />
        <CheckBox x:Name="SubBox"         Style="{StaticResource RoleCheck}" Content="Sub"         IsChecked="{Binding Subscriber, Mode=TwoWay}"
                  loc:Localize.Key="panel.common.role.sub" />
        <CheckBox x:Name="VipBox"         Style="{StaticResource RoleCheck}" Content="VIP"         IsChecked="{Binding Vip, Mode=TwoWay}"
                  loc:Localize.Key="panel.common.role.vip" />
        <CheckBox x:Name="ModBox"         Style="{StaticResource RoleCheck}" Content="Mod"         IsChecked="{Binding Moderator, Mode=TwoWay}"
                  loc:Localize.Key="panel.common.role.mod" />
        <CheckBox x:Name="BroadcasterBox" Style="{StaticResource RoleCheck}" Content="Broadcaster" IsChecked="{Binding Broadcaster, Mode=TwoWay}"
                  loc:Localize.Key="panel.common.role.broadcaster" />
        <!-- The tooltip carries the one thing the label cannot: Regular is not a
             platform rank, so it resolves to false for everyone while the
             User-Management tool is off (UserManagementService.Effective). -->
        <CheckBox x:Name="RegularBox" Style="{StaticResource RoleCheck}" Content="Regular"     IsChecked="{Binding Regular, Mode=TwoWay}"
                  loc:Localize.Key="panel.common.role.regular"
                  loc:Localize.TooltipKey="panel.common.role.regular.tip"
                  ToolTipService.ToolTip="Regular — resolved by User-Management; nobody matches while that tool is off." />
    </common:WrapRowPanel>
</UserControl>
