<?xml version="1.0" encoding="utf-8" ?>
<!--
    C16 (audit/winui-regressions-2026-05-24) — Hub "Recent Webhooks" tail panel.

    Mirrors the EventLog panel's shape (B43 sweep) at a smaller scope:
    search-only filtering, no level chips, no per-row context menu. Source
    of activity is HUDServer.OnWebhookFired — the panel subscribes through
    HubHost.HUD so the dispatch is decoupled from any specific HUDServer
    instance lifetime.

    Visual treatment uses Coal* / Ember* / Brass* tokens to keep the
    panel visually consistent with the EventLog + StatusStrip + Chat
    panels already in the workspace.
-->
<UserControl
    x:Class="Phoenix.Controls.Hub.WinUI.Panels.WebhookPanel.WebhookView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:hdr="using:Phoenix.Controls.Hub.WinUI.Panels.Common"
    xmlns:local="using:Phoenix.Controls.Hub.WinUI.Panels.WebhookPanel"
    xmlns:loc="using:Phoenix.Controls.Hub.WinUI.Localization"
    HorizontalAlignment="Stretch"
    VerticalAlignment="Stretch"
    HorizontalContentAlignment="Stretch"
    VerticalContentAlignment="Stretch"
    AutomationProperties.Name="Recent Webhooks panel"
    AutomationProperties.HelpText="Live tail of the last 100 webhook fires accepted by HUDServer (/webhook/&lt;name&gt;). Streams via HUDServer.OnWebhookFired; newest entries on top."
    loc:Localize.AutomationKey="panel.webhook.aria.name"
    loc:Localize.HelpTextKey="panel.webhook.aria.help">

    <UserControl.Resources>
        <!-- Dense per-row template — strip the default Fluent ListViewItem padding
             so the panel reads as a tight data feed. Mirrors EventLog panel. -->
        <Style x:Key="WebhookItemContainerStyle" TargetType="ListViewItem">
            <Setter Property="Padding"                    Value="0" />
            <Setter Property="MinHeight"                  Value="0" />
            <Setter Property="Margin"                     Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment"   Value="Top" />
        </Style>
    </UserControl.Resources>

    <Border Background="{StaticResource CoalSurfaceBrush}"
            BorderBrush="{StaticResource CoalDividerBrush}"
            BorderThickness="1"
            CornerRadius="{StaticResource Radius3Corner}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <hdr:PanelHeader Grid.Row="0"
                             Eyebrow="06"
                             TitleKey="panel.webhook.title"
                             Title="Recent Webhooks">
                <hdr:PanelHeader.RightContent>
                    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                        <TextBox x:Name="SearchBox"
                                 Width="160"
                                 Height="22"
                                 FontFamily="{StaticResource MonoFont}"
                                 FontSize="11"
                                 Background="{StaticResource CoalShellBrush}"
                                 Foreground="{StaticResource CoalPaperBrush}"
                                 BorderBrush="{StaticResource CoalDividerBrush}"
                                 BorderThickness="1"
                                 Padding="6,1"
                                 VerticalAlignment="Center"
                                 PlaceholderText="endpoint / IP…"
                                 loc:Localize.PlaceholderKey="panel.webhook.search.placeholder"
                                 TextChanged="OnSearchTextChanged" />
                        <Button x:Name="PopOutButton"
                                Background="Transparent"
                                BorderThickness="0"
                                Padding="6,2"
                                Foreground="{StaticResource CoalSecondaryTextBrush}"
                                Click="OnPopOutClick">
                            <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                <PathIcon Data="{StaticResource PhoenixIcon_PopOut}"
                                          Width="{StaticResource IconSizeS}"
                                          Height="{StaticResource IconSizeS}"
                                          Foreground="{StaticResource CoalSecondaryTextBrush}" />
                                <TextBlock Text="pop-out"
                                           FontFamily="{StaticResource SansFont}"
                                           FontSize="11"
                                           VerticalAlignment="Center"
                                           loc:Localize.Key="panel.common.button.popout" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </hdr:PanelHeader.RightContent>
            </hdr:PanelHeader>

            <ListView x:Name="WebhookList"
                      Grid.Row="1"
                      ItemsSource="{x:Bind ViewModel.VisibleRows, Mode=OneWay}"
                      ItemContainerStyle="{StaticResource WebhookItemContainerStyle}"
                      SelectionMode="Extended"
                      IsItemClickEnabled="False"
                      Background="Transparent"
                      BorderThickness="0"
                      Padding="0,2,0,2"
                      ScrollViewer.HorizontalScrollMode="Disabled"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                      ScrollViewer.VerticalScrollBarVisibility="Visible"
                      AutomationProperties.LiveSetting="Polite"
                      AutomationProperties.Name="Webhook activity entries"
                      loc:Localize.AutomationKey="panel.webhook.list.a11y">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="local:WebhookRowVm">
                        <Border Padding="14,2,14,2"
                                BorderBrush="{StaticResource CoalRaisedBrush}"
                                BorderThickness="0,0,0,1">
                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="72" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="140" />
                                    <ColumnDefinition Width="70" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0"
                                           Text="{x:Bind TimestampText}"
                                           FontFamily="{StaticResource MonoFont}"
                                           FontSize="10.5"
                                           Foreground="{StaticResource CoalSecondaryTextBrush}"
                                           VerticalAlignment="Top" />
                                <TextBlock Grid.Column="1"
                                           Text="{x:Bind Endpoint}"
                                           FontFamily="{StaticResource MonoFont}"
                                           FontSize="10.5"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource Ember200Brush}"
                                           TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Top" />
                                <TextBlock Grid.Column="2"
                                           Text="{x:Bind RemoteAddress}"
                                           FontFamily="{StaticResource MonoFont}"
                                           FontSize="10.5"
                                           Foreground="{StaticResource CoalSecondaryTextBrush}"
                                           TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Top" />
                                <TextBlock Grid.Column="3"
                                           Text="{x:Bind PayloadSizeText}"
                                           FontFamily="{StaticResource MonoFont}"
                                           FontSize="10.5"
                                           Foreground="{StaticResource CoalPrimaryTextBrush}"
                                           VerticalAlignment="Top"
                                           TextAlignment="Right" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>
    </Border>
</UserControl>
