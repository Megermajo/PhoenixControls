<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Phoenix.Controls.Hub.WinUI.Panels.RanksPanel.RanksView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Phoenix.Controls.Hub.WinUI.Panels.RanksPanel"
    xmlns:common="using:Phoenix.Controls.Hub.WinUI.Panels.Common"
    xmlns:loc="using:Phoenix.Controls.Hub.WinUI.Localization"
    HorizontalAlignment="Stretch"
    VerticalAlignment="Stretch"
    HorizontalContentAlignment="Stretch"
    VerticalContentAlignment="Stretch"
    AutomationProperties.Name="Ranks page"
    AutomationProperties.HelpText="Watched time or points become named ranks, with a chat command, an overlay board and an optional group grant per rank."
    loc:Localize.AutomationKey="panel.ranks.page.a11y"
    loc:Localize.HelpTextKey="panel.ranks.page.help">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- ToolControlStyles stays merged: this page keeps stock TextBoxes
                     (every command word, every threshold, all six reply templates) AND
                     stock ComboBoxes (the metric picker plus one editable group picker per
                     rung). Its CheckBox override reaches the shared RoleCheckRow, and its
                     ToggleSwitch override now reaches the header band's master switch —
                     implicit styles resolve UP the parented tree, so a control inside
                     ToolPageHeader lands on this view's dictionaries. Both overrides set
                     FontFamily and nothing else, so neither can move the band's geometry.
                     No Pivot on this page. -->
                <ResourceDictionary Source="ms-appx:///Panels/Common/ToolControlStyles.xaml" />
                <!-- Keyed-only shell recipes. Contains no implicit style. -->
                <ResourceDictionary Source="ms-appx:///Panels/Common/ToolShellStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- ── Page-local literals only ─────────────────────────────────── -->

            <!-- Nested strip inside a section card. Same tokens as ToolSectionCardStyle,
                 kept separate because every use site sets its own padding. -->
            <Style x:Key="RkRecessed" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource CoalShellBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource CoalCardBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="{StaticResource Radius1Corner}" />
            </Style>

            <!-- Borderless host for a converted CheckBox / ToggleSwitch. The Button owns
                 the Click, the accessible name and the IsEnabled gate; the TogglePill
                 inside is display-only. IsEnabled must stay on a Control — never on the
                 pill's parent Grid or on a Border. -->
            <Style x:Key="RkCheckButton" TargetType="Button">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="0,5,10,5" />
                <Setter Property="CornerRadius" Value="{StaticResource Radius1Corner}" />
                <Setter Property="HorizontalAlignment" Value="Left" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <!-- One rung of the ladder: enabled pill, name, threshold + unit, the optional
                 group grant, a passive "unreachable" caption and the remove button.

                 Every TextBox here commits on PropertyChanged, not LostFocus — Ranks is the
                 only tool in the family that does, and it is what makes the eyebrow, the
                 hours hint and the reachability caption track the digits as they are typed.
                 Do not "normalise" these to LostFocus. -->
            <DataTemplate x:Key="RankRowTemplate" x:DataType="local:RankRowVm">
                <Border Style="{StaticResource RkRecessed}"
                        Margin="0,0,0,6"
                        Padding="12,10">
                    <StackPanel Spacing="8">
                        <TextBlock Text="{x:Bind TitleEyebrow, Mode=OneWay}" Style="{StaticResource ToolSubLabelTextStyle}" />

                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Button Grid.Column="0"
                                    Style="{StaticResource RkCheckButton}"
                                    Click="OnToggleRankEnabledClick"
                                    ToolTipService.ToolTip="A disabled rung is skipped when a viewer's rank is resolved."
                                    AutomationProperties.Name="Rank enabled"
                                    loc:Localize.TooltipKey="panel.ranks.row.enabled.tip"
                                    loc:Localize.AutomationKey="panel.ranks.row.enabled.a11y">
                                <common:TogglePill IsOn="{x:Bind Enabled, Mode=OneWay}"
                                                   Label="{x:Bind EnabledLabel, Mode=OneWay}" />
                            </Button>

                            <TextBox Grid.Column="1"
                                     Text="{x:Bind Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     PlaceholderText="e.g. Silver"
                                     HorizontalAlignment="Stretch"
                                     AutomationProperties.Name="Rank name"
                                     loc:Localize.PlaceholderKey="panel.ranks.row.name.placeholder"
                                     loc:Localize.AutomationKey="panel.ranks.row.name.a11y" />

                            <TextBox Grid.Column="2"
                                     Text="{x:Bind ThresholdText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     FontFamily="{StaticResource MonoFont}" FontSize="11"
                                     Width="88"
                                     AutomationProperties.Name="Rank threshold"
                                     loc:Localize.AutomationKey="panel.ranks.row.threshold.a11y" />

                            <StackPanel Grid.Column="3" Spacing="0" VerticalAlignment="Center">
                                <TextBlock Text="{x:Bind UnitLabel, Mode=OneWay}" Style="{StaticResource ToolSettingsLabelTextStyle}" />
                                <TextBlock Text="{x:Bind ThresholdHint, Mode=OneWay}" Style="{StaticResource ToolMonoHintTextStyle}" VerticalAlignment="Center" />
                            </StackPanel>

                            <!-- The house row-delete grammar — red glyph plus a visible
                                 label. A bare trash glyph would leave this destructive
                                 control legible only to a screen reader. -->
                            <Button Grid.Column="4"
                                    Style="{StaticResource ToolDangerButtonStyle}"
                                    Click="OnRemoveRankClick"
                                    VerticalAlignment="Center"
                                    AutomationProperties.Name="Remove this rank"
                                    loc:Localize.AutomationKey="panel.ranks.row.remove.a11y">
                                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE74D;" FontSize="11"
                                              Foreground="{StaticResource ErrBrush}" />
                                    <TextBlock Text="REMOVE" Style="{StaticResource ToolStripLabelTextStyle}"
                                               loc:Localize.Key="panel.ranks.row.remove.label" />
                                </StackPanel>
                            </Button>
                        </Grid>

                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="grants group" Style="{StaticResource ToolSettingsLabelTextStyle}"
                                       loc:Localize.Key="panel.ranks.row.grant.label" />

                            <!-- Editable (the AlertsView layer-id idiom): the list is filled from
                                 the live User Management groups, and an empty box means no grant.
                                 A name that matches nothing is a logged no-op, never an invented
                                 group. -->
                            <ComboBox Grid.Column="1"
                                      IsEditable="True"
                                      ItemsSource="{x:Bind GroupOptions, Mode=OneWay}"
                                      Text="{x:Bind GrantGroup, Mode=TwoWay}"
                                      MinWidth="180"
                                      FontFamily="{StaticResource MonoFont}" FontSize="11"
                                      PlaceholderText="(no grant)"
                                      AutomationProperties.Name="User group granted at this rank"
                                      loc:Localize.PlaceholderKey="panel.ranks.row.grant.placeholder"
                                      loc:Localize.AutomationKey="panel.ranks.row.grant.a11y" />

                            <TextBlock Grid.Column="2"
                                       Style="{StaticResource ToolMonoHintTextStyle}"
                                       VerticalAlignment="Center"
                                       Visibility="{x:Bind UnreachableVisibility, Mode=OneWay}"
                                       Foreground="{StaticResource EmberPrimaryBrush}"
                                       Text="{x:Bind UnreachableText, Mode=OneWay}" />
                        </Grid>
                    </StackPanel>
                </Border>
            </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Background="{StaticResource CoalSurfaceBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ══════════════════ ROW 0 — HEADER BAND ══════════════════

             ONE 48 px row where three used to stack. The action strip, the
             state-sentence band under it and the ToolStatusPill between them all
             rendered the SAME boolean in three vocabularies (OFF / DISABLED /
             dormant) before a single setting was reachable. The band carries the
             name, the master switch, one lowercase state phrase, and the page's
             two verbs — the groups refresh and the one brass CTA.

             ★ The pill is re-scoped, not deleted. RanksService.PillState and
             PreBuildStatusPillTests are untouched; this band renders the result of
             that same state machine (RanksView.xaml.cs → ApplyHeaderState), which
             is why no wording here may claim a state the service does not report.

             Everything the strip used to do is wired in code-behind: the switch,
             the CTA (ADD RANK) and the refresh (the User-Management group list). -->
        <common:ToolPageHeader Grid.Row="0" x:Name="PageHeader" />

        <!-- ══════════════════ ROW 1 — TWO-COLUMN BODY ══════════════════ -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <!-- The live column is a FIXED 300 px, not a share of the window: it
                     holds one mono line per standing, so a proportional width made it
                     grow into empty space on a wide monitor while the editing column —
                     the reason the page exists — stayed cramped. -->
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="300" />
            </Grid.ColumnDefinitions>

            <!-- ───────── LEFT: metric, the ladder, chat ─────────
                 One row now. The state-sentence band that used to pin above this
                 scroller said, at length, what the header band's state phrase says in
                 three words; it was the second of the three renderings of the same
                 boolean. -->
            <Grid Grid.Column="0">

                <!-- No IsEnabled gate here, deliberately: this page has never greyed its
                     body while the tool is off. It now has no IsEnabled binding ANYWHERE —
                     the last one greyed the watch-time pair on the points metric, and those
                     two toggles are gone (see the card below). If one is ever wanted again,
                     the standing rule still holds: IsEnabled is declared on Control, not
                     UIElement, so it may sit on a Button or this ScrollViewer and never on a
                     Border or a StackPanel. -->
                <ScrollViewer x:Name="DetailScroll"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollMode="Disabled">
                    <StackPanel Spacing="12" Padding="14">

                        <!-- The four hero stat tiles that used to open this scroller
                             (MEASURES / RANKS / RANK-UPS / TRACKED LAST TICK) are gone:
                             ~75 px of DisplayFont reading 0 0 0 on a fresh install, above
                             the settings the streamer came here to change. Their VM
                             projections were removed in the orphan-cleanup pass once
                             every consumer was accounted for. -->

                        <TextBlock Style="{StaticResource ToolHintTextStyle}"
                                   Text="Watched time or points become named ranks. WatchTime and Ranks are open databank tables, so db.* nodes can read them."
                                   loc:Localize.Key="panel.ranks.intro.hint" />

                        <!-- ── What the ladder measures ── -->
                        <Border Style="{StaticResource ToolSectionCardStyle}">
                            <StackPanel Spacing="10">
                                <StackPanel Spacing="6">
                                    <TextBlock Text="METRIC" Style="{StaticResource ToolEyebrowTextStyle}"
                                               loc:Localize.Key="panel.ranks.metric.eyebrow" />
                                    <Border Height="1" Background="{StaticResource CoalDividerBrush}" />
                                </StackPanel>

                                <Grid ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <ComboBox Grid.Column="0"
                                              SelectedIndex="{x:Bind ViewModel.MetricIndex, Mode=TwoWay}"
                                              MinWidth="180"
                                              AutomationProperties.Name="Ladder metric"
                                              loc:Localize.AutomationKey="panel.ranks.metric.picker.a11y">
                                        <!-- Display labels only: the picker two-way-binds SelectedIndex, so
                                             translating these can never change the stored metric constant. -->
                                        <ComboBoxItem Content="Watched time"
                                                      loc:Localize.Key="panel.ranks.metric.option.watch_time" />
                                        <ComboBoxItem Content="Loyalty points"
                                                      loc:Localize.Key="panel.ranks.metric.option.points" />
                                    </ComboBox>
                                    <TextBlock Grid.Column="1" Style="{StaticResource ToolMonoHintTextStyle}"
                                               VerticalAlignment="Center"
                                               Text="{x:Bind ViewModel.MetricHint, Mode=OneWay}" />
                                </Grid>

                                <!-- ★ READ-ONLY. This card used to carry the two watch-time
                                     switches; they are gone because recording is no longer a
                                     Ranks setting. Minutes now accrue in the always-on
                                     ViewerPresenceService under AppConfig's own
                                     WatchTimeTrackingEnabled / WatchTimeOnlyWhenLive, which
                                     feed the User-Management watch-hour rules and !watchtime
                                     as much as this ladder — so the switches moved to the one
                                     page that owns viewers. The card STAYS, rather than
                                     vanishing with its toggles, because a watch-time ladder
                                     that will not move has exactly one cause and this is where
                                     a streamer comes looking for it.

                                     No IsEnabled gate any more either: it is not a setting to
                                     grey out on the points metric, it is a statement of fact
                                     that stays true whichever metric the ladder measures. -->
                                <Border Style="{StaticResource RkRecessed}" Padding="12,10">
                                    <StackPanel Spacing="6">
                                        <TextBlock Text="COUNTING WATCHED TIME" Style="{StaticResource ToolSubLabelTextStyle}"
                                                   loc:Localize.Key="panel.ranks.watchtime.title" />
                                        <TextBlock Style="{StaticResource ToolHintTextStyle}"
                                                   Text="{x:Bind ViewModel.WatchTimeStateText, Mode=OneWay}"
                                                   AutomationProperties.Name="Watch-time recording state"
                                                   loc:Localize.AutomationKey="panel.ranks.watchtime.state.a11y" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- ── The ladder ──
                             It lives in the DETAIL column even though it is a list: every
                             rung is an editing surface (a toggle, two text boxes, an
                             editable picker, a delete and a wrapping caption across five
                             columns) and none of that is usable at the live column's width. -->
                        <Border Style="{StaticResource ToolSectionCardStyle}">
                            <StackPanel Spacing="10">
                                <StackPanel Spacing="6">
                                    <TextBlock Text="THE LADDER" Style="{StaticResource ToolEyebrowTextStyle}"
                                               loc:Localize.Key="panel.ranks.ladder.eyebrow" />
                                    <Border Height="1" Background="{StaticResource CoalDividerBrush}" />
                                </StackPanel>

                                <TextBlock Style="{StaticResource ToolHintTextStyle}"
                                           Text="A viewer holds the highest enabled rank they have reached; thresholds start at 1. A granted group is added once and never taken back."
                                           loc:Localize.Key="panel.ranks.ladder.hint" />

                                <ItemsRepeater ItemsSource="{x:Bind ViewModel.Ranks}"
                                               common:RowDataContext.Supply="True"
                                               ItemTemplate="{StaticResource RankRowTemplate}"
                                               AutomationProperties.Name="Rank ladder"
                                               loc:Localize.AutomationKey="panel.ranks.ladder.list.a11y" />

                                <!-- Empty state — the house two-line recipe (headline
                                     DisplayFont 20 + sub SansFont 12, both
                                     CoalSecondaryText, centred), not the 10 px mono hint
                                     this used to be. -->
                                <StackPanel Spacing="6"
                                            Padding="0,14"
                                            HorizontalAlignment="Center"
                                            Visibility="{x:Bind ViewModel.LadderEmptyVisibility, Mode=OneWay}">
                                    <TextBlock Text="No ranks yet"
                                               FontFamily="{StaticResource DisplayFont}"
                                               FontSize="20"
                                               Foreground="{StaticResource CoalSecondaryTextBrush}"
                                               HorizontalAlignment="Center"
                                               loc:Localize.Key="panel.ranks.ladder.empty.title" />
                                    <TextBlock Text="ADD RANK in the header starts the ladder at 1."
                                               FontFamily="{StaticResource SansFont}"
                                               FontSize="12"
                                               Foreground="{StaticResource CoalSecondaryTextBrush}"
                                               HorizontalAlignment="Center" TextAlignment="Center"
                                               loc:Localize.Key="panel.ranks.ladder.empty.body" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- ── Chat + announcement ── -->
                        <Border Style="{StaticResource ToolSectionCardStyle}">
                            <StackPanel Spacing="10">
                                <StackPanel Spacing="6">
                                    <TextBlock Text="CHAT" Style="{StaticResource ToolEyebrowTextStyle}"
                                               loc:Localize.Key="panel.ranks.chat.eyebrow" />
                                    <Border Height="1" Background="{StaticResource CoalDividerBrush}" />
                                </StackPanel>

                                <!-- Two lines rather than the old eight-column single row: the
                                     detail column is narrower than the full-width page this
                                     replaced, and HorizontalScrollMode is Disabled, so an
                                     over-wide Auto row would clip the cooldown box rather
                                     than scroll to it. -->
                                <Button Style="{StaticResource RkCheckButton}"
                                        Click="OnToggleChatEnabledClick"
                                        AutomationProperties.Name="Answer rank commands in chat"
                                        loc:Localize.AutomationKey="panel.ranks.chat.enabled.a11y">
                                    <common:TogglePill IsOn="{x:Bind ViewModel.ChatEnabled, Mode=OneWay}"
                                                       Label="Answer in chat"
                                                       loc:Localize.Key="panel.ranks.chat.enabled.label" />
                                </Button>

                                <Grid ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="!" Style="{StaticResource ToolSettingsLabelTextStyle}" />
                                    <TextBox Grid.Column="1"
                                             Text="{x:Bind ViewModel.RankCommand, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             FontFamily="{StaticResource MonoFont}" FontSize="11"
                                             Width="110"
                                             AutomationProperties.Name="My rank command word"
                                             loc:Localize.AutomationKey="panel.ranks.chat.rank_command.a11y" />
                                    <TextBlock Grid.Column="2" Text="!" Style="{StaticResource ToolSettingsLabelTextStyle}" />
                                    <TextBox Grid.Column="3"
                                             Text="{x:Bind ViewModel.TopCommand, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             FontFamily="{StaticResource MonoFont}" FontSize="11"
                                             Width="110"
                                             AutomationProperties.Name="Leaderboard command word"
                                             loc:Localize.AutomationKey="panel.ranks.chat.top_command.a11y" />
                                    <TextBlock Grid.Column="4" Text="cooldown" Style="{StaticResource ToolSettingsLabelTextStyle}"
                                               loc:Localize.Key="panel.ranks.chat.cooldown.label" />
                                    <TextBox Grid.Column="5"
                                             Text="{x:Bind ViewModel.CooldownText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             FontFamily="{StaticResource MonoFont}" FontSize="11"
                                             Width="64"
                                             AutomationProperties.Name="Per-user cooldown in seconds"
                                             loc:Localize.AutomationKey="panel.ranks.chat.cooldown.a11y" />
                                </Grid>

                                <TextBlock Style="{StaticResource ToolMonoHintTextStyle}"
                                           VerticalAlignment="Center"
                                           Text="seconds per viewer · Loyalty answers !top first while it is on, so a rank command named top never fires"
                                           loc:Localize.Key="panel.ranks.chat.cooldown.hint" />

                                <StackPanel Spacing="4">
                                    <TextBlock Text="WHO CAN ASK" Style="{StaticResource ToolSubLabelTextStyle}"
                                               loc:Localize.Key="panel.ranks.chat.roles.title" />
                                    <common:RoleCheckRow Roles="{x:Bind ViewModel.ViewRoles, Mode=OneWay}" />
                                </StackPanel>

                                <Border Style="{StaticResource RkRecessed}" Padding="12,10">
                                    <StackPanel Spacing="8">
                                        <TextBlock Text="REPLIES" Style="{StaticResource ToolSubLabelTextStyle}"
                                                   loc:Localize.Key="panel.ranks.replies.title" />
                                        <TextBlock Style="{StaticResource ToolHintTextStyle}"
                                                   Text="Tokens: {user} {rank} {value} {unit} {next} {needed}."
                                                   loc:Localize.Key="panel.ranks.replies.tokens_hint" />
                                        <TextBox Header="Has a rank, more to climb"
                                                 Text="{x:Bind ViewModel.RankReplyMessage, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 HorizontalAlignment="Stretch"
                                                 AutomationProperties.Name="Reply when the viewer has a rank"
                                                 loc:Localize.HeaderKey="panel.ranks.replies.rank.label"
                                                 loc:Localize.AutomationKey="panel.ranks.replies.rank.a11y" />
                                        <TextBox Header="At the top rank"
                                                 Text="{x:Bind ViewModel.TopRankReplyMessage, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 HorizontalAlignment="Stretch"
                                                 AutomationProperties.Name="Reply at the top rank"
                                                 loc:Localize.HeaderKey="panel.ranks.replies.top_rank.label"
                                                 loc:Localize.AutomationKey="panel.ranks.replies.top_rank.a11y" />
                                        <TextBox Header="No rank yet"
                                                 Text="{x:Bind ViewModel.UnrankedReplyMessage, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 HorizontalAlignment="Stretch"
                                                 AutomationProperties.Name="Reply when the viewer has no rank"
                                                 loc:Localize.HeaderKey="panel.ranks.replies.unranked.label"
                                                 loc:Localize.AutomationKey="panel.ranks.replies.unranked.a11y" />
                                        <!-- Its own template because the unranked one names a {next}
                                             rank that does not exist yet on an empty ladder. -->
                                        <TextBox Header="No ranks set up yet"
                                                 Text="{x:Bind ViewModel.NoLadderReplyMessage, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 HorizontalAlignment="Stretch"
                                                 AutomationProperties.Name="Reply when the ladder has no ranks"
                                                 loc:Localize.HeaderKey="panel.ranks.replies.no_ladder.label"
                                                 loc:Localize.AutomationKey="panel.ranks.replies.no_ladder.a11y" />
                                        <Grid ColumnSpacing="10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBox Grid.Column="0"
                                                     Header="Leaderboard — {count} {list}"
                                                     Text="{x:Bind ViewModel.TopReplyMessage, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     HorizontalAlignment="Stretch"
                                                     AutomationProperties.Name="Leaderboard reply"
                                                     loc:Localize.HeaderKey="panel.ranks.replies.leaderboard.label"
                                                     loc:Localize.AutomationKey="panel.ranks.replies.leaderboard.a11y" />
                                            <TextBlock Grid.Column="1" Text="places" Style="{StaticResource ToolSettingsLabelTextStyle}"
                                                       loc:Localize.Key="panel.ranks.replies.leaderboard.places.label" />
                                            <TextBox Grid.Column="2"
                                                     Text="{x:Bind ViewModel.LeaderboardSizeText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     FontFamily="{StaticResource MonoFont}" FontSize="11"
                                                     Width="64"
                                                     VerticalAlignment="Bottom"
                                                     AutomationProperties.Name="How many places the leaderboard prints"
                                                     loc:Localize.AutomationKey="panel.ranks.replies.leaderboard.places.a11y" />
                                        </Grid>
                                        <TextBox Header="Leaderboard, empty"
                                                 Text="{x:Bind ViewModel.TopEmptyMessage, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 HorizontalAlignment="Stretch"
                                                 AutomationProperties.Name="Empty leaderboard reply"
                                                 loc:Localize.HeaderKey="panel.ranks.replies.top_empty.label"
                                                 loc:Localize.AutomationKey="panel.ranks.replies.top_empty.a11y" />
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource RkRecessed}" Padding="12,10">
                                    <StackPanel Spacing="8">
                                        <TextBlock Text="RANK-UP ANNOUNCEMENT" Style="{StaticResource ToolSubLabelTextStyle}"
                                                   loc:Localize.Key="panel.ranks.announce.title" />
                                        <Grid ColumnSpacing="10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Button Grid.Column="0"
                                                    Style="{StaticResource RkCheckButton}"
                                                    Click="OnToggleAnnounceEnabledClick"
                                                    AutomationProperties.Name="Announce rank-ups in chat"
                                                    loc:Localize.AutomationKey="panel.ranks.announce.enabled.a11y">
                                                <common:TogglePill IsOn="{x:Bind ViewModel.AnnounceEnabled, Mode=OneWay}"
                                                                   Label="Announce"
                                                                   loc:Localize.Key="panel.ranks.announce.enabled.label" />
                                            </Button>
                                            <TextBox Grid.Column="1"
                                                     Text="{x:Bind ViewModel.AnnounceMessage, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     PlaceholderText="{}{user} just reached {rank}!"
                                                     HorizontalAlignment="Stretch"
                                                     AutomationProperties.Name="Rank-up announcement"
                                                     loc:Localize.PlaceholderKey="panel.ranks.announce.message.placeholder"
                                                     loc:Localize.AutomationKey="panel.ranks.announce.message.a11y" />
                                        </Grid>
                                        <TextBlock Style="{StaticResource ToolHintTextStyle}"
                                                   Text="Tokens: {user} {rank} {value} {unit} · Rank.OnRankUp fires either way."
                                                   loc:Localize.Key="panel.ranks.announce.tokens_hint" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- What this tool answers to in chat. Below the CHAT card whose
                             two boxes and role row decide every line of it, so the answer
                             to "what did I just change" is the next thing on screen. It
                             renders the page's own unsaved state, not the service's. -->
                        <common:ToolCommandList Commands="{x:Bind ViewModel.ChatCommands, Mode=OneWay}"
                                                AutomationProperties.Name="Rank chat commands"
                                                loc:Localize.AutomationKey="panel.ranks.commands.a11y" />

                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- ───────── RIGHT: the live board ───────── -->
            <Border Grid.Column="1"
                    Background="{StaticResource CoalSurfaceBrush}"
                    BorderBrush="{StaticResource CoalCardBrush}"
                    BorderThickness="1,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <common:PanelHeader Grid.Row="0" Eyebrow="LIVE" Title="Board"
                                            EyebrowKey="panel.common.eyebrow.live"
                                            TitleKey="panel.ranks.board.title">
                            <common:PanelHeader.RightContent>
                                <Button Style="{StaticResource ToolSecondaryButtonStyle}"
                                        Padding="10,0"
                                        Click="OnRefreshBoardClick"
                                        ToolTipService.ToolTip="Re-read the standings"
                                        AutomationProperties.Name="Refresh the leaderboard"
                                        loc:Localize.TooltipKey="panel.ranks.board.refresh.tip"
                                        loc:Localize.AutomationKey="panel.ranks.board.refresh.a11y">
                                    <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE72C;" FontSize="12"
                                              Foreground="{StaticResource CoalBodyTextBrush}" />
                                </Button>
                            </common:PanelHeader.RightContent>
                        </common:PanelHeader>

                        <!-- Plain strings, so the row template uses classic {Binding} on the
                             item itself rather than x:Bind + x:DataType. That is unchanged by
                             the ItemsRepeater conversion. -->
                        <ScrollViewer Grid.Row="1"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollMode="Disabled">
                            <ItemsRepeater ItemsSource="{x:Bind ViewModel.Leaderboard}"
                                           common:RowDataContext.Supply="True"
                                           AutomationProperties.LiveSetting="Polite"
                                           AutomationProperties.Name="Rank leaderboard"
                                           loc:Localize.AutomationKey="panel.ranks.board.list.a11y">
                                <ItemsRepeater.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{StaticResource CoalRaisedBrush}"
                                                BorderThickness="0,0,0,1"
                                                Padding="14,7">
                                            <TextBlock Text="{Binding}"
                                                       FontFamily="{StaticResource MonoFont}" FontSize="11"
                                                       Foreground="{StaticResource CoalPrimaryTextBrush}"
                                                       TextWrapping="Wrap" />
                                        </Border>
                                    </DataTemplate>
                                </ItemsRepeater.ItemTemplate>
                            </ItemsRepeater>
                        </ScrollViewer>

                        <!-- Empty state — a SIBLING of the scroller in the same cell,
                             never inside it. ONE mono line, pinned to the top where the
                             first standing will appear: the two-line DisplayFont recipe
                             floated a 20 px headline in the middle of a full-height void,
                             which made "nothing here yet" the loudest thing in the
                             column. -->
                        <TextBlock Grid.Row="1"
                                   Margin="14,10,14,0"
                                   VerticalAlignment="Top"
                                   Style="{StaticResource ToolMonoHintTextStyle}"
                                   Visibility="{x:Bind ViewModel.LeaderboardEmptyVisibility, Mode=OneWay}"
                                   Text="no standings yet"
                                   loc:Localize.Key="panel.ranks.board.empty.title" />
                    </Grid>

                    <!-- Overlay publish — the board's own output, so it stays beside the
                         board it publishes. -->
                    <Border Grid.Row="1"
                            Background="{StaticResource CoalRaisedBrush}"
                            BorderBrush="{StaticResource CoalDividerBrush}"
                            BorderThickness="0,1,0,0"
                            Padding="14,6">
                        <StackPanel Spacing="4">
                            <Button Style="{StaticResource RkCheckButton}"
                                    Click="OnToggleOverlayEnabledClick"
                                    AutomationProperties.Name="Publish the board to the overlay"
                                    loc:Localize.AutomationKey="panel.ranks.overlay.enabled.a11y">
                                <common:TogglePill IsOn="{x:Bind ViewModel.OverlayEnabled, Mode=OneWay}"
                                                   Label="Publish to the overlay"
                                                   loc:Localize.Key="panel.ranks.overlay.enabled.label" />
                            </Button>
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="places on the overlay" Style="{StaticResource ToolSettingsLabelTextStyle}"
                                           loc:Localize.Key="panel.ranks.overlay.size.label" />
                                <TextBox Grid.Column="1"
                                         Text="{x:Bind ViewModel.OverlaySizeText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         FontFamily="{StaticResource MonoFont}" FontSize="11"
                                         Width="64"
                                         AutomationProperties.Name="Overlay board size"
                                         loc:Localize.AutomationKey="panel.ranks.overlay.size.a11y" />
                                <!-- "rank.leaderboard" is the HUD data key — an identifier that stays
                                     English inside whatever the sentence around it becomes. -->
                                <TextBlock Grid.Column="2" Style="{StaticResource ToolMonoHintTextStyle}"
                                           VerticalAlignment="Center"
                                           Text="key: rank.leaderboard"
                                           loc:Localize.Key="panel.ranks.overlay.hud_key" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- The activity feed that used to close this column is gone. It was a
                         watch-surface element on a config surface: what promoted forty
                         seconds ago does not help anyone editing a threshold, and it was
                         session-scoped anyway (DB.Ranks holds only the CURRENT rank per
                         viewer, so nothing in it survived a Hub restart). The VM's Activity
                         collection and its ring subscription were removed with the feed in
                         the orphan-cleanup pass; RanksService still records into the ring. -->
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
